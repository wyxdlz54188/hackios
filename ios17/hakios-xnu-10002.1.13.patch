+static int
+ramfs_pathconf(struct vnop_pathconf_args *ap)
+{
+	switch (ap->a_name) {
+	case _PC_LINK_MAX:
+		*ap->a_retval = 32767;
+		return 0;
+	case _PC_NAME_MAX:
+		*ap->a_retval = RAMFS_MAX_NAME;
