+/* ---- the shared memory (hakios.wifi.c, step 1) --------------------------------------------------- */
+
+#define SMEM_PHYS               0x80900000UL
+#define SMEM_SIZE               0x00200000u
+#define SMEM_US                 0
+#define SMEM_ADSP               2               /* dt: qcom,remote-pid of qcom,smp2p-adsp and qcom,glink/adsp */
+#define SMEM_GLOBAL             0xfffe
+#define SMEM_CANARY             0xa5a5
+
+struct smem_table_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+};
+struct smem_table {
+	uint8_t magic[4];
+	uint32_t version, count, reserved[5];
+};
+struct smem_partition {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, free_uncached, free_cached, reserved[3];
+};
+struct smem_entry {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_header;
+	uint32_t reserved;
+};
+struct smem_item {
+	uint32_t item, offset, size;
+};
+
+/*
+ * The DSP's items (dt: qcom,smem of qcom,smp2p-adsp, <443 429>: the item the DSP writes first, then
+ * ours -- the Wi-Fi's <617 616> are in the same order; taken the other way round, the DSP made
+ * our item its own and never said "up" --, and qcom,smem-id of qcom,lpass@3700000).
+ */
+#define ITEM_SMP2P_OURS         429
+#define ITEM_SMP2P_THEIRS       443
+#define ITEM_CRASH_REASON       423
+
+static const volatile uint8_t *smem;
+
+static bool
+smem_peek(uint64_t offset, void *to, uint32_t size)
+{
+	if (smem == NULL) {
+		smem = (const volatile uint8_t *)ml_io_map_unmappable(SMEM_PHYS, SMEM_SIZE, VM_WIMG_WCOMB);
+	}
+	if (offset + size > SMEM_SIZE) {
+		return false;
+	}
+	for (uint32_t i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = smem[offset + i];
+	}
+	return true;
+}
+
+static void
+smem_poke(uint32_t offset, uint32_t value)
+{
+	wr((vm_offset_t)smem + offset, value);
+}
+
+static uint32_t
+smem_word(uint32_t offset)
+{
+	return rd((vm_offset_t)smem + offset);
+}
+
+static uint32_t
+smem_partition(uint16_t one, uint16_t other, uint32_t *cacheline, uint32_t *size)
+{
+	struct smem_table table;
+	struct smem_table_entry entry;
+	struct smem_partition header;
+
+	if (!smem_peek(SMEM_SIZE - 0x1000, &table, sizeof(table)) || memcmp(table.magic, "$TOC", 4) != 0 || table.version != 1 ||
+	    table.count > 64) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < table.count; i++) {
+		if (!smem_peek(SMEM_SIZE - 0x1000 + sizeof(table) + i * sizeof(entry), &entry, sizeof(entry)) || entry.offset == 0 ||
+		    entry.size == 0) {
+			continue;
+		}
+		if (!((entry.host0 == one && entry.host1 == other) || (entry.host0 == other && entry.host1 == one))) {
+			continue;
+		}
+		if ((uint64_t)entry.offset + entry.size > SMEM_SIZE - 0x1000 || !smem_peek(entry.offset, &header, sizeof(header)) ||
+		    memcmp(header.magic, "$PRT", 4) != 0 || header.size != entry.size) {
+			return 0;
+		}
+		*cacheline = entry.cacheline;
+		*size = entry.size;
+		return entry.offset;
+	}
+	return 0;
+}
+
+static unsigned
+smem_items(uint32_t partition, uint32_t cacheline, struct smem_item *found, unsigned max)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	uint32_t at, step_back;
+	unsigned count = 0;
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.size ||
+	    header.free_cached > header.size) {
+		return 0;
+	}
+	for (at = sizeof(header); at + sizeof(entry) <= header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > header.size) {
+			break;
+		}
+		/*
+		 * The DSP can write this header: padding larger than the item would make the size below wrap to about 4 GB,
+		 * and an item that ends beyond its partition would send the readers out of the shared memory. Stop at it.
+		 */
+		if (entry.padding_data > entry.size ||
+		    (uint64_t)at + sizeof(entry) + entry.padding_header + entry.size > header.size) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at + sizeof(entry) + entry.padding_header;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return count;
+	}
+	step_back = ((uint32_t)sizeof(entry) + cacheline - 1) & ~(cacheline - 1);
+	for (at = header.size - step_back; at > header.free_cached && at < header.size;) {
+		/* (padding larger than the item would make the size below wrap to about 4 GB) */
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > at ||
+		    entry.padding_data > entry.size) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at - entry.size;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		if (entry.size + step_back > at) {
+			break;
+		}
+		at -= entry.size + step_back;
+	}
+	return count;
+}
+
+/* An item the DSP and we share: in the partition of the two, or else in the global one. Where it is; 0: nowhere. */
+static uint32_t
+smem_item(uint32_t item, uint32_t *size)
+{
+	static struct smem_item found[256];
+	static const uint16_t hosts[2][2] = { { SMEM_US, SMEM_ADSP }, { SMEM_GLOBAL, SMEM_GLOBAL } };
+
+	for (unsigned h = 0; h < 2; h++) {
+		uint32_t cacheline = 0, partition_size = 0;
+		uint32_t partition = smem_partition(hosts[h][0], hosts[h][1], &cacheline, &partition_size);
+		unsigned count = smem_items(partition, cacheline, found, 256);
+
+		for (unsigned i = 0; i < count && i < 256; i++) {
+			if (found[i].item == item) {
+				*size = found[i].size;
+				return found[i].offset;
+			}
+		}
+	}
+	return 0;
+}
+
+static void
+show_partition(void)
+{
+	static struct smem_item found[256];
+	struct smem_partition header;
+	uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+	unsigned count;
+	char line[320];
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("adsp: %u: there is no partition for us and the audio DSP (0 and 2)\n", step);
+		return;
+	}
+	count = smem_items(partition, cacheline, found, 256);
+	printf("adsp: %u: the partition for us and the audio DSP (0 and 2): at %#lx, %#x bytes, of which %#x free; %u items\n", step,
+	    SMEM_PHYS + partition, size, header.free_cached - header.free_uncached, count);
+	for (unsigned i = 0; i < count && i < 256;) {
+		int at = 0;
+
+		for (unsigned n = 0; n < 12 && i < count && i < 256; n++, i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %u (%u)", found[i].item, found[i].size);
+		}
+		printf("adsp: %u:   items (bytes):%s\n", step, line);
+	}
+}
+
+/* ---- SMP2P ---------------------------------------------------------------------------------------- */
+
+struct smp2p {
+	uint32_t magic;
+	uint32_t version;
+	uint16_t local, remote, total, valid;
+	uint32_t flags;
+	struct {
+		char name[16];
+		uint32_t value;
+	} entry[16];
+};
+#define SMP2P_MAGIC             0x504d5324
+#define SMP2P_VERSION           1
+#define SMP2P_RESTART_ACKS      1u
+#define SMP2P_RESTART_DONE      (1u << 0)
+#define SMP2P_RESTART_ACK       (1u << 1)
+#define SMP2P_AT_VERSION        4
+#define SMP2P_AT_PROCESSORS     8
+#define SMP2P_AT_COUNTS         12
+#define SMP2P_AT_FLAGS          16
+#define SMP2P_AT_NAME(i)        (20 + 20 * (i))
+#define SMP2P_AT_VALUE(i)       (36 + 20 * (i))
+
+/* The bits of the DSP's entry "slave-kernel" (dt: the interrupts of qcom,lpass@3700000). */
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+#define DSP_SHUTDOWN_ACK        (1u << 7)
+
+/* Our entry (dt: the child "master-kernel" of qcom,smp2p-adsp; "qcom,force-stop" of qcom,lpass@3700000). */
+#define OUR_ENTRY_STOP          "master-kernel"
+#define DSP_STOP                (1u << 0)
+
+static bool
+dsp_words(struct smp2p *words)
+{
+	static uint32_t at;
+	uint32_t size = 0;
+
+	if (at == 0) {
+		at = smem_item(ITEM_SMP2P_THEIRS, &size);
+		if (at == 0 || size < sizeof(*words)) {
+			at = 0;
+			return false;
+		}
+	}
+	return smem_peek(at, words, sizeof(*words)) && words->magic == SMP2P_MAGIC;
+}
+
+static int
+smp2p_entry(const struct smp2p *words, const char *name)
+{
+	for (unsigned i = 0; i < words->valid && i < 16; i++) {
+		if (strncmp(words->entry[i].name, name, sizeof(words->entry[i].name)) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static uint32_t
+dsp_state(const struct smp2p *words)
+{
+	int entry = smp2p_entry(words, "slave-kernel");
+
+	return entry < 0 ? 0 : words->entry[entry].value;
+}
+
+static void
+show_words(const char *prefix, const struct smp2p *words)
+{
+	char line[320];
+	int at = 0;
+
+	line[0] = 0;
+	for (unsigned i = 0; i < words->valid && i < 16 && at < (int)sizeof(line) - 40; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %.16s = %#x;", words->entry[i].name, words->entry[i].value);
+	}
+	printf("adsp: %u: %s: SMP2P version %u, features %#x, from processor %u to %u, flags %#x, %u of %u entries:%s\n", step, prefix,
+	    words->version & 0xff, words->version >> 8, words->local, words->remote, words->flags, words->valid, words->total, line);
+}
+
+static void
+show_crash_reason(void)
+{
+	char text[81];
+	uint32_t size = 0, at = smem_item(ITEM_CRASH_REASON, &size);
+
+	if (at == 0 || size == 0) {
+		printf("adsp: %u: item %u, the DSP's last words: not there\n", step, ITEM_CRASH_REASON);
+		return;
+	}
+	bzero(text, sizeof(text));
+	smem_peek(at, text, size < sizeof(text) - 1 ? size : sizeof(text) - 1);
+	if (text[0] == 0) {
+		printf("adsp: %u: item %u, the DSP's last words (%u bytes): none\n", step, ITEM_CRASH_REASON, size);
+	} else {
+		printf("adsp: %u: THE AUDIO DSP'S LAST WORDS (item %u, %u bytes): \"%s\"\n", step, ITEM_CRASH_REASON, size, text);
+	}
+}
+
+/* ---- the doorbells, and the mailbox to the always-on processor (hakios.wifi.c, steps 2 and 7) ------ */
+
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c
+#define QMP_VERSION             0x04
+#define QMP_THEIR_LINK          0x0c
+#define QMP_THEIR_LINK_ACK      0x10
+#define QMP_THEIR_CHANNEL       0x14
+#define QMP_THEIR_CHANNEL_ACK   0x18
+#define QMP_OUR_LINK            0x24
+#define QMP_OUR_LINK_ACK        0x28
+#define QMP_OUR_CHANNEL         0x2c
+#define QMP_OUR_CHANNEL_ACK     0x30
+#define QMP_OUR_BOX_SIZE        0x34
+#define QMP_OUR_BOX             0x38
+#define QMP_UP                  0x0000ffffu
+#define QMP_DOWN                0xffff0000u
+#define QMP_MESSAGE             64
+
+static struct block aoss = { "mailbox", 0x0c300000, 0x400 };
+
+#define IPCC_SEND               0x0c
+#define IPCC_RECEIVED           0x10
+#define IPCC_ENABLE             0x14
+#define IPCC_DISABLE            0x18
+#define IPCC_CLEAR              0x1c
+#define IPCC_NOBODY             0xffffffffu
+#define IPCC_AOP                0u
+#define IPCC_LPASS              3u              /* dt: mboxes of qcom,smp2p-adsp and qcom,glink/adsp */
+#define IPCC_GLINK              0u
+#define IPCC_SMP2P              2u
+
+static struct block ipcc = { "ipcc", 0x00408000, 0x1000 };
+
+static struct {
+	uint32_t glink, smp2p, said;
+	uint64_t since;
+} doorbell;
+
+/*
+ * The audio DSP's rings, counted and cleared. Another's ring (the Wi-Fi DSP's, the always-on
+ * processor's) is left for whoever listens for it: IPCC names the same one until it is cleared,
+ * so the look ends there.
+ */
+static void
+doorbells(void)
+{
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t who = rd(ipcc.base + IPCC_RECEIVED);
+
+		if (who == IPCC_NOBODY || who >> 16 != IPCC_LPASS) {
+			return;
+		}
+		wr(ipcc.base + IPCC_CLEAR, who);
+		doorbell.glink += (who & 0xffff) == IPCC_GLINK;
+		doorbell.smp2p += (who & 0xffff) == IPCC_SMP2P;
+		if (doorbell.said < 24) {
+			uint64_t now = now_us() - doorbell.since;
+
+			doorbell.said++;
+			printf("adsp: doorbell: +%llu.%03llu ms: signal %u of the audio DSP; heard and cleared\n", now / 1000, now % 1000,
+			    who & 0xffff);
+		}
+	}
+}
+
+static uint32_t our_box;                /* where in the message memory our mailbox is; 0: not open */
+
+static bool
+mailbox_wait(uint32_t offset, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if (rd(aoss.base + offset) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return rd(aoss.base + offset) == value;
+}
+
+static void
+ring_aop(void)
+{
+	wr(ipcc.base + IPCC_SEND, IPCC_AOP << 16 | 0);
+}
+
+/* Linux's qmp_open(), as hakios.wifi.c does it; what is done already is found done. Under the mailbox's lock. */
+static bool
+mailbox_open(void)
+{
+	uint32_t box, size;
+
+	need(&aoss);
+	need(&ipcc);
+	if (get(&aoss, "magic", QMP_MAGIC) != QMP_MAGIC_VALUE || get(&aoss, "version", QMP_VERSION) != 1) {
+		printf("adsp: %u: not a mailbox this knows\n", step);
+		return false;
+	}
+	box = get(&aoss, "our mailbox", QMP_OUR_BOX);
+	size = get(&aoss, "our mailbox's size", QMP_OUR_BOX_SIZE);
+	/* (box and size come from the always-on processor: "box + size" could wrap in 32 bits and pass, so it is compared as a difference) */
+	if (size < QMP_MESSAGE + 4 || box < 0x3c || box >= aoss.size || size > aoss.size - box || (box & 3)) {
+		printf("adsp: %u: our mailbox is not where a message fits\n", step);
+		return false;
+	}
+	if (rd(aoss.base + QMP_OUR_LINK) == QMP_UP && rd(aoss.base + QMP_OUR_LINK_ACK) == QMP_UP &&
+	    rd(aoss.base + QMP_OUR_CHANNEL) == QMP_UP && rd(aoss.base + QMP_THEIR_CHANNEL) == QMP_UP &&
+	    rd(aoss.base + QMP_OUR_CHANNEL_ACK) == QMP_UP) {
+		printf("adsp: %u: the mailbox is open already (the Wi-Fi's start, or a kernel before this one, opened it)\n", step);
+		our_box = box;
+		return true;
+	}
+	put(&aoss, "their link, seen by us", QMP_THEIR_LINK_ACK, rd(aoss.base + QMP_THEIR_LINK));
+	put(&aoss, "our link", QMP_OUR_LINK, QMP_UP);
+	ring_aop();
+	if (!mailbox_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		printf("adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT ACKNOWLEDGE OUR LINK within a second; taken down again\n", step);
+		put(&aoss, "our link", QMP_OUR_LINK, QMP_DOWN);
+		ring_aop();
+		return false;
+	}
+	put(&aoss, "our channel", QMP_OUR_CHANNEL, QMP_UP);
+	ring_aop();
+	if (!mailbox_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		printf("adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT OPEN ITS CHANNEL within a second; ours is taken down again\n", step);
+		put(&aoss, "our channel", QMP_OUR_CHANNEL, QMP_DOWN);
+		put(&aoss, "our link", QMP_OUR_LINK, QMP_DOWN);
+		ring_aop();
+		return false;
+	}
+	put(&aoss, "their channel, seen by us", QMP_THEIR_CHANNEL_ACK, QMP_UP);
+	ring_aop();
+	if (!mailbox_wait(QMP_OUR_CHANNEL_ACK, QMP_UP, 1000)) {
+		printf("adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT ACKNOWLEDGE OUR CHANNEL within a second; taken down again\n", step);
+		put(&aoss, "our channel", QMP_OUR_CHANNEL, QMP_DOWN);
+		put(&aoss, "our link", QMP_OUR_LINK, QMP_DOWN);
+		ring_aop();
+		return false;
+	}
+	printf("adsp: %u: THE MAILBOX TO THE ALWAYS-ON PROCESSOR IS OPEN\n", step);
+	our_box = box;
+	return true;
+}
+
+/* A message to the always-on processor (Linux's qmp_send()), under the lock the Wi-Fi's start takes too. */
+static bool
+mailbox_send(const char *text)
+{
+	uint32_t words[QMP_MESSAGE / 4] = { 0 };
+	bool sent = false;
+
+	if (!leaving) {
+		lck_mtx_lock(&hakios_aop_mailbox_lock);
+	}
+	if (our_box == 0 && (leaving || !mailbox_open())) {
+		goto out;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	printf("adsp: %u: about to tell the always-on processor \"%s\"\n", step, text);
+	snprintf(last_write, sizeof(last_write), "step %u sent the always-on processor a message", step);
+	if (rd(aoss.base + our_box) != 0) {
+		printf("adsp: %u: our mailbox still holds a message of %u bytes: not sent\n", step, rd(aoss.base + our_box));
+		goto out;
+	}
+	for (unsigned i = 0; i < QMP_MESSAGE / 4; i++) {
+		wr(aoss.base + our_box + 4 + 4 * i, words[i]);
+	}
+	wr(aoss.base + our_box, QMP_MESSAGE);
+	(void)rd(aoss.base + our_box);
+	ring_aop();
+	if (!mailbox_wait(our_box, 0, 1000)) {
+		printf("adsp: %u: THE ALWAYS-ON PROCESSOR DOES NOT TAKE THE MESSAGE within a second; it is taken back\n", step);
+		wr(aoss.base + our_box, 0);
+		goto out;
+	}
+	printf("adsp: %u: the always-on processor has taken it\n", step);
+	sent = true;
+out:
+	if (!leaving) {
+		lck_mtx_unlock(&hakios_aop_mailbox_lock);
+	}
+	return sent;
+}
+
+/* ---- RPMh: the DSP's two rails, asked for while it boots ------------------------------------------------ */
+
+/*
+ * The audio DSP's logic and memories run from LPASS's own rails, LCX and LMX (dt: vdd_cx and
+ * vdd_mx of qcom,lpass@3700000 are PM7325 L5 and L4 "level" regulators, RPMh resources lcx.lvl and
+ * lmx.lvl), which the boot loader leaves at retention (16). Linux and Android ask for level 384
+ * while the DSP boots, until it says it has asked for its own (bit 2, "proxy-unvote"); without it
+ * the DSP rang once and left "SFR Init: wdog or kernel error suspected." in its last words.
+ *
+ * A request goes to RPMh through the application processor's sequencer (dt: rsc@18200000, DRV 2,
+ * qcom,tcs-offset 0xd00, qcom,tcs-config: TCSs 0 and 1 are for requests made at once), as Linux's
+ * rpmh-rsc.c writes one: the command's message id, address and value into a TCS that is idle, the
+ * command enabled and marked to be waited for, the TCS put in "active" mode and triggered, and its
+ * bit in the status of completions looked for. A rail asked for by level is asked by position in
+ * the list of its levels that the boot loader's command database keeps (cmd-db.c), the first
+ * position at or above the level wanted.
+ */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static const struct cmd_db_header *cmd_db;
+
+static struct block rsc = { "rsc", 0x18220000, 0x10000 };
+#define RSC_TCS_BASE            0xd00
+#define RSC_IRQ_STATUS          (RSC_TCS_BASE + 0x04)   /* a bit per TCS: done */
+#define RSC_IRQ_CLEAR           (RSC_TCS_BASE + 0x08)
+#define RSC_TCS(n)              (RSC_TCS_BASE + 672 * (n))
+#define TCS_WAIT_FOR_DONE       0x10
+#define TCS_CONTROL             0x14
+#define TCS_STATUS              0x18                    /* not zero: idle */
+#define TCS_ENABLED             0x1c
+#define TCS_COMMAND(c)          (0x30 + 20 * (c))       /* message id, address, value, status */
+#define TCS_ACTIVE_MODE         (1u << 16)
+#define TCS_TRIGGER             (1u << 24)
+#define MSGID_WRITE_WAITED      (8u | 1u << 8 | 1u << 16)       /* four bytes, an answer wanted, a write */
+#define RPMH_TCS                0                       /* the first of the two for requests made at once */
+
+/* The level position RPMh takes for that rail and level; -1: not found. */
+static int
+rail_position(const char *name, uint32_t level, uint32_t *address)
+{
+	char id[8] = { 0 };
+
+	if (cmd_db == NULL) {
+		cmd_db = (const struct cmd_db_header *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	}
+	if (!(cmd_db->magic[0] == 0xdb && cmd_db->magic[1] == 0x30 && cmd_db->magic[2] == 0x03 && cmd_db->magic[3] == 0x0c)) {
+		printf("adsp: %u: the boot loader's command database is not there\n", step);
+		return -1;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &cmd_db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(cmd_db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			const uint8_t *data;
+			char levels[160];
+			int at;
+
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((unsigned)slave->data_offset + entry[i].offset + entry[i].length > CMD_DB_SIZE - 0x1000) {
+				return -1;
+			}
+			data = cmd_db->data + slave->data_offset + entry[i].offset;
+			at = snprintf(levels, sizeof(levels), "%s at %#x, levels:", name, entry[i].address);
+			for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+				unsigned value = data[2 * l] | data[2 * l + 1] << 8;
+
+				if (l > 0 && value == 0) {
+					break;
+				}
+				at += snprintf(levels + at, sizeof(levels) - (size_t)at, " %u", value);
+			}
+			printf("adsp: %u: RPMh has %s\n", step, levels);
+			for (unsigned l = 0; l < entry[i].length / 2u && l < 16; l++) {
+				if ((uint32_t)(data[2 * l] | data[2 * l + 1] << 8) >= level) {
+					*address = entry[i].address;
+					return (int)l;
+				}
+			}
+			return -1;
+		}
+	}
+	printf("adsp: %u: RPMh has no \"%s\"\n", step, name);
+	return -1;
+}
+
+/* The two rails at that level (Linux's proxy request), or given back (level 0). True: RPMh has said done. */
+static bool
+rails(uint32_t level)
+{
+	static const char *const names[2] = { "lcx.lvl", "lmx.lvl" };
+	uint32_t addresses[2] = { 0, 0 }, values[2] = { 0, 0 }, done = 0;
+	uint64_t began;
+
+	for (unsigned r = 0; r < 2; r++) {
+		int position = level == 0 ? 0 : rail_position(names[r], level, &addresses[r]);
+
+		if (level == 0) {
+			rail_position(names[r], 0, &addresses[r]);
+		}
+		if (position < 0 || addresses[r] == 0) {
+			printf("adsp: %u: no position for %s at level %u: the rails are not asked\n", step, names[r], level);
+			return false;
+		}
+		values[r] = (uint32_t)position;
+	}
+	need(&rsc);
+	/* (on a panic's way back to the loader no lock is taken: the other processors are stopped, and one of them may hold this one for good) */
+	if (!leaving) {
+		lck_mtx_lock(&hakios_rsc_lock);
+	}
+	/* (the boot loader leaves the trigger set after its last request, done: idle is what the status says) */
+	if (rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS) == 0) {
+		printf("adsp: %u: TCS %u of the sequencer is busy (status %#x, control %#x): the rails are not asked\n", step, RPMH_TCS,
+		    rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS), rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL));
+		if (!leaving) {
+			lck_mtx_unlock(&hakios_rsc_lock);
+		}
+		return false;
+	}
+	printf("adsp: %u: about to ask RPMh, through TCS %u, for lcx.lvl (%#x) = %u and lmx.lvl (%#x) = %u (level %u%s)\n", step,
+	    RPMH_TCS, addresses[0], values[0], addresses[1], values[1], level, level == 0 ? ": given back" : "");
+	snprintf(last_write, sizeof(last_write), "step %u asked RPMh for the audio DSP's rails at level %u", step, level);
+	hold();
+	wr(rsc.base + RSC_IRQ_CLEAR, 1u << RPMH_TCS);
+	for (unsigned r = 0; r < 2; r++) {
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(r), MSGID_WRITE_WAITED);
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(r) + 4, addresses[r]);
+		wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(r) + 8, values[r]);
+	}
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_WAIT_FOR_DONE, 3);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_ENABLED, 3);
+	settle();
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) & ~TCS_TRIGGER);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) | TCS_ACTIVE_MODE);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) | TCS_TRIGGER);
+	began = now_us();
+	while (now_us() - began < 100000) {
+		done = rd(rsc.base + RSC_IRQ_STATUS) & (1u << RPMH_TCS);
+		if (done) {
+			break;
+		}
+		sleep_us(50);
+	}
+	printf("adsp: %u: RPMh %s after %llu us; the commands' status %#x %#x, the TCS's %#x\n", step, done ? "HAS DONE IT" :
+	    "HAS NOT SAID DONE", now_us() - began, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(0) + 12),
+	    rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_COMMAND(1) + 12), rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_STATUS));
+	wr(rsc.base + RSC_IRQ_CLEAR, 1u << RPMH_TCS);
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL, rd(rsc.base + RSC_TCS(RPMH_TCS) + TCS_CONTROL) & ~(TCS_TRIGGER | TCS_ACTIVE_MODE));
+	wr(rsc.base + RSC_TCS(RPMH_TCS) + TCS_ENABLED, 0);
+	if (!leaving) {
+		lck_mtx_unlock(&hakios_rsc_lock);
+	}
+	return done != 0;
+}
+
+/* ---- step 1: the shared memory --------------------------------------------------------------------- */
+
+static bool
+step_survey(void)
+{
+	struct smp2p words;
+	uint32_t size = 0;
+
+	announce("read our partition with the audio DSP in the shared memory (0x80900000), and its items");
+	show_partition();
+	if (dsp_words(&words)) {
+		show_words("the DSP's item (443) is there: it has run since the phone was started", &words);
+	} else {
+		printf("adsp: %u: the DSP's SMP2P item (443) is not there: it has not run since the phone was started\n", step);
+	}
+	printf("adsp: %u: our SMP2P item (429): %s; GLINK's descriptor (478): %s, our queue (479): %s, the DSP's (480): %s\n", step,
+	    smem_item(ITEM_SMP2P_OURS, &size) ? "there" : "not there", smem_item(478, &size) ? "there" : "NOT THERE",
+	    smem_item(479, &size) ? "there" : "NOT THERE", smem_item(480, &size) ? "there" : "not there (the DSP makes it)");
+	show_crash_reason();
+	need(&ipcc);
+	printf("adsp: %u: the doorbells say %#x\n", step, rd(ipcc.base + IPCC_RECEIVED));
+	return smem_partition(SMEM_US, SMEM_ADSP, &size, &size) != 0;
+}
+
+/* ---- step 2: the firmware -------------------------------------------------------------------------- */
+
+#define ADSP_MEMORY             0x86700000u     /* dt: reserved-memory adsp@86700000, memory-region of qcom,lpass@3700000 */
+#define ADSP_MEMORY_SIZE        0x04000000u
+#define PAS_ADSP                1               /* dt: qcom,pas-id */
+
+
+/*
+ * A file of /fw on the root file system, read whole into memory of ours: the system image, where
+ * userland/build.sh puts fw-audio/ when it makes that image. It is compressed there, which the file
+ * system undoes and the reading of the small image's memory below does not; and it is there only
+ * once the root is mounted, so only adsp=1, which waits for that on its own thread, finds it so.
+ */
+static const uint8_t *
+root_file(const char *name, uint64_t *size)
+{
+	char path[64];
+	vfs_context_t context = vfs_context_kernel();
+	vnode_t vnode = NULLVP;
+	struct vnode_attr attributes;
+	uint8_t *data;
+	int left = 0, error;
+
+	if (rootvnode == NULLVP) {
+		return NULL;
+	}
+	snprintf(path, sizeof(path), "/fw/%s", name);
+	if (vnode_lookup(path, 0, &vnode, context) != 0) {
+		return NULL;
+	}
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_data_size);
+	if (vnode_getattr(vnode, &attributes, context) != 0 || attributes.va_data_size == 0 ||
+	    attributes.va_data_size > ADSP_MEMORY_SIZE) {
+		vnode_put(vnode);
+		return NULL;
+	}
+	data = kalloc_data(attributes.va_data_size, Z_WAITOK);
+	if (data == NULL) {
+		vnode_put(vnode);
+		return NULL;
+	}
+	error = vn_rdwr(UIO_READ, vnode, (caddr_t)data, (int)attributes.va_data_size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(context), &left, vfs_context_proc(context));
+	vnode_put(vnode);
+	if (error != 0 || left != 0) {
+		printf("adsp: %u: %s: read error %d, %d bytes left\n", step, path, error, left);
+		kfree_data(data, attributes.va_data_size);
+		return NULL;
+	}
+	*size = attributes.va_data_size;
+	return data;
+}
+
+static bool from_root;                  /* the image is in memory of ours (root_file()), to be given back once written */
+
+/* For the sound (hakios.sound.c): a file of /fw on the root, read whole into memory of ours, and given back. */
+const uint8_t *
+hakios_adsp_fw_file(const char *name, uint64_t *size)
+{
+	return root_file(name, size);
+}
+
+void
+hakios_adsp_fw_free(const uint8_t *data, uint64_t size)
+{
+	uint8_t *ours = __DECONST(uint8_t *, data);
+
+	kfree_data(ours, size);
+}
+
+/* A file of fw/ in the small image (ADSP=1 userland/build.sh puts fw-audio/ there), else of /fw on the root (above). */
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+static const uint8_t *
+image_file(const char *name, uint64_t *size)
+{
+	{
+		const uint8_t *data = hakios_image_file("fw", name, size, NULL);  /* (hakios.image.c) */
+
+		if (data != NULL) {
+			return data;
+		}
+	}
+	{
+		const uint8_t *data = root_file(name, size);
+
+		if (data != NULL) {
+			from_root = true;
+			return data;
+		}
+	}
+	printf("adsp: %u: no fw/%s in the small image nor on the root: put the phone's /vendor/firmware_mnt/image/%s into "
+	    "fw-audio/ and run SYSTEM=1 userland/build.sh (or ADSP=1, for the small image)\n", step, name, name);
+	return NULL;
+}
+
+
+#define MDT_HASH(flags)         (((flags) >> 24 & 7) == 2)
+#define MAX_SEGMENTS            48
+
+struct elf_segment {
+	uint32_t type, offset, vaddr, paddr, file_size, memory_size, flags, align;
+};
+
+static struct {
+	const uint8_t *header;
+	uint64_t header_size;
+	struct {
+		uint32_t at;
+		uint32_t file_size, memory_size;
+		const uint8_t *file;
+	} segment[MAX_SEGMENTS];
+	unsigned segments;
+	uint32_t size;
+} image;
+
+/* The image's files given back, if they were read into memory of ours. */
+static void
+image_forget(void)
+{
+	if (!from_root) {
+		return;
+	}
+	if (image.header != NULL) {
+		void *data = (void *)(uintptr_t)image.header;
+
+		kfree_data(data, image.header_size);
+	}
+	for (unsigned s = 0; s < image.segments; s++) {
+		if (image.segment[s].file != NULL) {
+			void *data = (void *)(uintptr_t)image.segment[s].file;
+
+			kfree_data(data, image.segment[s].file_size);
+		}
+	}
+	bzero(&image, sizeof(image));
+	from_root = false;
+}
+
+static bool
+step_firmware(void)
+{
+	struct elf_segment segment;
+	const uint8_t *header;
+	uint64_t size = 0, files = 0;
+	uint32_t count, hashes = 0, lowest = ~0u, highest = 0;
+	uint8_t first[4] = { 0 };
+
+	announce("find the audio DSP's image in the small image or on the root, and check it against its own header");
+	image_forget();
+	image.segments = 0;
+	header = image_file("adsp.mdt", &size);
+	if (header == NULL) {
+		return false;
+	}
+	image.header = header;
+	image.header_size = size;
+	count = size >= 52 + 2 * 32 ? header[44] | header[45] << 8 : 0;
+	/* (a file of 1 to 4 bytes is shorter than what is compared and printed: both look only at what is there) */
+	memcpy(first, header, size < sizeof(first) ? size : sizeof(first));
+	if (size < 5 || memcmp(header, "\177ELF\1", 5) != 0 || count < 3 || count > MAX_SEGMENTS || 52 + 32 * count > size ||
+	    size > PAGE_SIZE) {
+		printf("adsp: %u: fw/adsp.mdt is not such a header (%02x %02x %02x %02x, %u segments, %llu bytes)\n", step, first[0],
+		    first[1], first[2], first[3], count, size);
+		goto fail;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		char name[16];
+
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		if (MDT_HASH(segment.flags)) {
+			hashes = segment.file_size;
+		}
+		if (segment.type != 1 || MDT_HASH(segment.flags) || segment.memory_size == 0) {
+			continue;
+		}
+		if (segment.paddr < ADSP_MEMORY || segment.file_size > segment.memory_size ||
+		    (uint64_t)segment.paddr + segment.memory_size > (uint64_t)ADSP_MEMORY + ADSP_MEMORY_SIZE) {
+			printf("adsp: %u: segment %u (%#x, %#x bytes) is not within the DSP's memory\n", step, i, segment.paddr,
+			    segment.memory_size);
+			goto fail;
+		}
+		image.segment[image.segments].at = segment.paddr - ADSP_MEMORY;
+		image.segment[image.segments].file_size = segment.file_size;
+		image.segment[image.segments].memory_size = segment.memory_size;
+		image.segment[image.segments].file = NULL;
+		if (segment.file_size != 0) {
+			uint64_t file_size = 0;
+
+			snprintf(name, sizeof(name), "adsp.b%02u", i);
+			image.segment[image.segments].file = image_file(name, &file_size);
+			if (image.segment[image.segments].file == NULL) {
+				goto fail;
+			}
+			if (file_size != segment.file_size) {
+				printf("adsp: %u: fw/%s has %llu bytes, the header says %u\n", step, name, file_size, segment.file_size);
+				/* (the file is given back with the size it was allocated with, not the header's: kfree_data() needs that) */
+				image.segment[image.segments].file_size = (uint32_t)file_size;
+				image.segments++;               /* (for its file to be given back) */
+				goto fail;
+			}
+			files += file_size;
+		}
+		lowest = segment.paddr < lowest ? segment.paddr : lowest;
+		highest = segment.paddr + segment.memory_size > highest ? segment.paddr + segment.memory_size : highest;
+		image.segments++;
+	}
+	if (image.segments == 0 || lowest != ADSP_MEMORY || 52 + 32 * count + (uint64_t)hashes != size) {
+		printf("adsp: %u: not what TrustZone takes: %u segments to load, the lowest at %#x; the header file has %llu bytes, "
+		    "the header %u and the hashes %u\n", step, image.segments, lowest, size, 52 + 32 * count, hashes);
+		goto fail;
+	}
+	image.header = header;
+	image.header_size = size;
+	image.size = ((highest + 0xfff) & ~0xfffu) - ADSP_MEMORY;
+	printf("adsp: %u: the image is whole (%s): a header of %llu bytes (%u of hashes), %u segments, %llu bytes of files, %#x "
+	    "bytes of the DSP's %#x from %#x\n", step, from_root ? "from /fw on the root" : "from the small image", size, hashes,
+	    image.segments, files, image.size, ADSP_MEMORY_SIZE, ADSP_MEMORY);
+	return true;
+fail:
+	image_forget();
+	image.segments = 0;
+	return false;
+}
+
+/* ---- step 3: the mailbox --------------------------------------------------------------------------- */
+
+static bool
+step_mailbox(void)
+{
+	bool open;
+
+	announce("open the mailbox to the always-on processor, unless it is open: words of its message memory, and its doorbell");
+	lck_mtx_lock(&hakios_aop_mailbox_lock);
+	open = mailbox_open();
+	lck_mtx_unlock(&hakios_aop_mailbox_lock);
+	return open;
+}
+
+/* ---- TrustZone, and stopping the DSP --------------------------------------------------------------- */
+
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+
+static LCK_MTX_DECLARE(dsp_lock, &adsp_lock_group);     /* the DSP being started or stopped */
+static bool rails_asked;                /* our request for its rails stands (until it asks for its own, or is shut down) */
+static bool dsp_started;
+static bool stopped_by_its_word;
+static uint32_t our_item;
+static bool smp2p_agreed, smp2p_restart_acks, smp2p_restart_acked;
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	function |= SCM_64 | SCM_SIP;
+	printf("adsp: %u: about to ask TrustZone %s: smc %#llx, arguments %#llx, %#llx, %#llx\n", step, what, function, first,
+	    second, third);
+	snprintf(last_write, sizeof(last_write), "step %u asked TrustZone %#llx(%#llx, %#llx)", step, function, first, second);
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			printf("adsp: %u: TrustZone returns %d, answer %#llx\n", step, (int32_t)x0, x1);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	printf("adsp: %u: TrustZone keeps saying the call was interrupted\n", step);
+	return -1;
+}
+
+static uint32_t
+our_item_find(void)
+{
+	uint32_t size = 0, at = smem_item(ITEM_SMP2P_OURS, &size);
+
+	/* (step_our_item() writes the whole struct there without a bounds check: it has to lie inside the SMEM window) */
+	return at != 0 && size >= sizeof(struct smp2p) && (uint64_t)at + sizeof(struct smp2p) <= SMEM_SIZE ? at : 0;
+}
+
+/* What Linux does when the DSP rings for SMP2P: agree on the features once, and answer a restart. */
+static void
+dsp_listen(const struct smp2p *theirs)
+{
+	struct smp2p ours;
+
+	if (our_item == 0 || !smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC) {
+		return;
+	}
+	if (!smp2p_agreed) {
+		uint32_t features = (ours.version >> 8) & (theirs->version >> 8);
+
+		if ((theirs->version & 0xff) != (ours.version & 0xff)) {
+			return;
+		}
+		if (features != ours.version >> 8) {
+			smem_poke(our_item + SMP2P_AT_VERSION, features << 8 | (ours.version & 0xff));
+		}
+		smp2p_restart_acks = features & SMP2P_RESTART_ACKS;
+		smp2p_agreed = true;
+		printf("adsp: %u: the DSP and we agree on SMP2P: version %u, features %#x\n", step, ours.version & 0xff, features);
+	}
+	if (smp2p_restart_acks && ((theirs->flags & SMP2P_RESTART_DONE) != 0) != smp2p_restart_acked) {
+		smp2p_restart_acked = !smp2p_restart_acked;
+		printf("adsp: %u: the DSP's flags say it has restarted (%#x): answered in our flags (bit 1 = %u), and its SMP2P doorbell\n",
+		    step, theirs->flags, smp2p_restart_acked);
+		smem_poke(our_item + SMP2P_AT_FLAGS, (ours.flags & ~SMP2P_RESTART_ACK) | (smp2p_restart_acked ? SMP2P_RESTART_ACK : 0));
+		settle();
+		wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	}
+}
+
+/* Linux's qcom_q6v5_request_stop(): our bit "stop", the DSP's "stop ack" waited for, our bit taken back. */
+static bool
+dsp_ask_to_stop(uint32_t bound_ms)
+{
+	struct smp2p ours, theirs;
+	uint32_t at = our_item_find(), state, value_at;
+	uint64_t asked, now;
+	int entry = -1;
+
+	if (at == 0 || !smem_peek(at, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || (ours.version & 0xff) != SMP2P_VERSION ||
+	    (entry = smp2p_entry(&ours, OUR_ENTRY_STOP)) < 0) {
+		printf("adsp: %u: the DSP is not asked to stop first: there is no SMP2P item of ours to ask it with\n", step);
+		return false;
+	}
+	if (!dsp_words(&theirs) || smp2p_entry(&theirs, "slave-kernel") < 0) {
+		printf("adsp: %u: the DSP is not asked to stop first: its item has no entry to answer in\n", step);
+		return false;
+	}
+	state = dsp_state(&theirs);
+	if (state & DSP_STOP_ACK) {
+		printf("adsp: %u: the DSP is not asked to stop: its entry says %#x, that it has stopped when asked before\n", step, state);
+		return true;
+	}
+	if (!(state & DSP_READY) || (state & DSP_FATAL)) {
+		printf("adsp: %u: the DSP is not asked to stop first: its entry says %#x, not \"up\"\n", step, state);
+		return false;
+	}
+	need(&ipcc);
+	value_at = at + SMP2P_AT_VALUE((uint32_t)entry);
+	printf("adsp: %u: about to ask the DSP to stop: bit 0 of our entry \"%s\" at %#lx, and its SMP2P doorbell\n", step,
+	    OUR_ENTRY_STOP, SMEM_PHYS + value_at);
+	snprintf(last_write, sizeof(last_write), "step %u asked the audio DSP to stop", step);
+	smem_poke(value_at, ours.entry[entry].value | DSP_STOP);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	asked = now = now_us();
+	while (now - asked < bound_ms * 1000ull) {
+		if (dsp_words(&theirs) && (dsp_state(&theirs) & (DSP_STOP_ACK | DSP_FATAL))) {
+			break;
+		}
+		sleep_us(200);
+		now = now_us();
+	}
+	state = dsp_words(&theirs) ? dsp_state(&theirs) : 0;
+	printf("adsp: %u: %s after %llu.%03llu ms; its entry says %#x\n", step, state & DSP_STOP_ACK ?
+	    "THE AUDIO DSP ACKNOWLEDGES THE STOP" : "THE AUDIO DSP DOES NOT ACKNOWLEDGE THE STOP", (now - asked) / 1000,
+	    (now - asked) % 1000, state);
+	smem_poke(value_at, ours.entry[entry].value & ~DSP_STOP);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	return (state & DSP_STOP_ACK) != 0;
+}
+
+static void link_stop(void);
+
+/* Asked to stop, then shut down by TrustZone, then the always-on processor told that the image is gone. */
+static bool
+dsp_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	printf("adsp: %u: %s: the audio DSP is asked to stop, then TrustZone to shut it down\n", step, why);
+	if (!leaving) {
+		link_stop();
+	}
+	stopped_by_its_word = dsp_ask_to_stop(leaving ? 2000 : 5000);
+	result = scm("to shut the audio DSP down", SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP, 0, 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT SHUT THE AUDIO DSP DOWN: the call returns %d, its answer is %#llx\n", step, result,
+		    answer);
+		return false;
+	}
+	printf("adsp: %u: THE AUDIO DSP IS SHUT DOWN\n", step);
+	need(&ipcc);
+	wr(ipcc.base + IPCC_DISABLE, IPCC_LPASS << 16 | IPCC_SMP2P);
+	doorbells();
+	dsp_started = false;
+	mailbox_send("{class: image, res: load_state, name: adsp, val: off}");
+	if (rails_asked) {
+		rails(0);
+		rails_asked = false;
+	}
+	return true;
+}
+
+/* ---- step 4: TrustZone takes the header ------------------------------------------------------------ */
+
+static bool
+step_header(void)
+{
+	struct smp2p words;
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	if (dsp_words(&words)) {
+		show_words("the DSP has left words in the shared memory", &words);
+		announce("ask TrustZone to shut down an audio DSP that a kernel before this one may have left running");
+		if (!dsp_shutdown("it may be running")) {
+			return false;
+		}
+		if (!stopped_by_its_word && !option("adsp_again")) {
+			printf("adsp: %u: THE AUDIO DSP IS NOT STARTED AGAIN: it was shut down without having acknowledged a stop, and "
+			    "with the Wi-Fi's DSP a start after that reset the phone (adsp_again=1 to try all the same)\n", step);
+			return false;
+		}
+	} else {
+		printf("adsp: %u: the DSP has left nothing in the shared memory: it has not run since the phone was started\n", step);
+	}
+
+	announce("hand the image's header to TrustZone to check its signature (image 1), in a page of ours");
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("adsp: %u: no memory\n", step);
+		return false;
+	}
+	memcpy((void *)page, image.header, image.header_size);
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+	result = scm("to take the audio DSP's header", SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_ADSP, kvtophys(page), 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT TAKE THE HEADER: the call returns %d, its answer is %#llx\n", step, result, answer);
+		return false;
+	}
+	printf("adsp: %u: TRUSTZONE ACCEPTS THE AUDIO DSP'S SIGNATURE FROM THIS KERNEL\n", step);
+
+	announce("tell TrustZone where the image will be");
+	result = scm("where the image will be", SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_ADSP, ADSP_MEMORY, image.size, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT TAKE THE PLACE: the call returns %d, its answer is %#llx\n", step, result, answer);
+		return false;
+	}
+	printf("adsp: %u: TrustZone takes the place: %#x bytes at %#x\n", step, image.size, ADSP_MEMORY);
+	return true;
+}
+
+/* ---- step 5: the image, in the DSP's memory --------------------------------------------------------- */
+
+static bool image_written;
+
+static uint64_t
+segment_word(unsigned s, uint32_t at)
+{
+	uint64_t word = 0;
+
+	for (unsigned b = 0; b < 8 && at + b < image.segment[s].file_size; b++) {
+		word |= (uint64_t)image.segment[s].file[at + b] << (8 * b);
+	}
+	return word;
+}
+
+static bool
+step_image(void)
+{
+	volatile uint64_t *dsp_memory;
+	uint64_t written = 0, cleared = 0, wrong = 0;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	announce("put the image's segments into the audio DSP's memory (0x86700000, 64 MB: memory of nobody's until TrustZone "
+	    "starts the DSP), with zeroes where a segment is longer than its file, and read them back");
+	dsp_memory = (volatile uint64_t *)ml_io_map_unmappable(ADSP_MEMORY, ADSP_MEMORY_SIZE, VM_WIMG_WCOMB);
+	snprintf(last_write, sizeof(last_write), "step %u wrote the image at %#x", step, ADSP_MEMORY);
+	for (unsigned s = 0; s < image.segments; s++) {
+		volatile uint64_t *to = dsp_memory + image.segment[s].at / 8;
+
+		if ((image.segment[s].at | image.segment[s].memory_size) & 7) {
+			printf("adsp: %u: a segment that does not begin and end at a multiple of eight bytes: not written\n", step);
+			ml_io_unmap((vm_offset_t)dsp_memory, ADSP_MEMORY_SIZE);
+			return false;
+		}
+		for (uint32_t i = 0; i < image.segment[s].memory_size; i += 8) {
+			to[i / 8] = segment_word(s, i);
+		}
+		written += image.segment[s].file_size;
+		cleared += image.segment[s].memory_size - image.segment[s].file_size;
+	}
+	settle();
+	for (unsigned s = 0; s < image.segments; s++) {
+		volatile uint64_t *from = dsp_memory + image.segment[s].at / 8;
+
+		for (uint32_t i = 0; i < image.segment[s].memory_size; i += 8) {
+			wrong += from[i / 8] != segment_word(s, i);
+		}
+	}
+	printf("adsp: %u: %u segments, %llu bytes written and %llu cleared; read back, %llu words of eight bytes differ\n", step,
+	    image.segments, written, cleared, wrong);
+	settle();
+	ml_io_unmap((vm_offset_t)dsp_memory, ADSP_MEMORY_SIZE);
+	image_written = wrong == 0;
+	image_forget();                         /* (it is in the DSP's memory now: what was read of the root, given back) */
+	return image_written;
+}
+
+/* ---- step 6: our SMP2P item ------------------------------------------------------------------------ */
+
+static struct block smem_lock = { "shared memory's lock", 0x01f43000, 0x1000 };
+#define LOCK_OWNER              0x000
+#define LOCK_US                 1u
+
+/* Our item made in the partition, as Linux's qcom_smem_alloc_private() makes one (hakios.wifi.c: our_item_make()). */
+static bool
+our_item_make(uint32_t partition)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	const uint32_t item_size = (sizeof(struct smp2p) + 7) & ~7u, need_bytes = sizeof(entry) + item_size;
+	uint32_t owner = ~0u, at;
+	bool made = false;
+
+	lck_mtx_lock(&hakios_smem_alloc_lock);         /* (the Wi-Fi's start allocates under the same hardware lock) */
+	need(&smem_lock);
+	printf("adsp: %u: about to take the lock (%#x), write an entry for item %u with %u bytes behind it at the partition's mark, "
+	    "move the mark by %u, and release the lock\n", step, smem_lock.phys + LOCK_OWNER, ITEM_SMP2P_OURS, item_size, need_bytes);
+	snprintf(last_write, sizeof(last_write), "step %u took the shared memory's lock", step);
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr(smem_lock.base + LOCK_OWNER, LOCK_US);
+		owner = rd(smem_lock.base + LOCK_OWNER);
+		if (owner == LOCK_US) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	if (owner != LOCK_US) {
+		printf("adsp: %u: THE LOCK IS HELD BY PROCESSOR %u AND STAYS SO FOR A SECOND: nothing is written\n", step, owner);
+		lck_mtx_unlock(&hakios_smem_alloc_lock);
+		return false;
+	}
+	if (!smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.free_cached ||
+	    header.free_cached > header.size) {
+		printf("adsp: %u: the partition's marks make no sense: nothing is written\n", step);
+		goto out;
+	}
+	for (at = sizeof(header); at < header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.item == ITEM_SMP2P_OURS ||
+		    entry.size > header.size) {
+			break;
+		}
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		printf("adsp: %u: the partition's entries do not end at its mark (+%#x, the mark is +%#x), or the item has appeared: "
+		    "nothing is written\n", step, at, header.free_uncached);
+		goto out;
+	}
+	if (at + need_bytes > header.free_cached) {
+		printf("adsp: %u: no room: %u bytes wanted, %u free: nothing is written\n", step, need_bytes, header.free_cached - at);
+		goto out;
+	}
+	smem_poke(partition + at, SMEM_CANARY | ITEM_SMP2P_OURS << 16);
+	smem_poke(partition + at + 4, item_size);
+	smem_poke(partition + at + 8, item_size - (uint32_t)sizeof(struct smp2p));
+	smem_poke(partition + at + 12, 0);
+	settle();
+	smem_poke(partition + __offsetof(struct smem_partition, free_uncached), at + need_bytes);
+	settle();
+	made = true;
+out:
+	wr(smem_lock.base + LOCK_OWNER, 0);
+	printf("adsp: %u: the lock is released (it reads %u)\n", step, rd(smem_lock.base + LOCK_OWNER));
+	lck_mtx_unlock(&hakios_smem_alloc_lock);
+	return made;
+}
+
+static void glink_reset(void);
+
+static bool
+step_our_item(void)
+{
+	struct smem_partition header;
+	struct smp2p ours;
+	uint32_t cacheline = 0, size = 0, partition, name[4] = { 0 };
+
+	announce("look for an SMP2P item of ours (429) in our partition with the audio DSP, make it if there is none, and fill it in");
+	partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("adsp: %u: there is no such partition\n", step);
+		return false;
+	}
+	our_item = our_item_find();
+	if (our_item != 0) {
+		printf("adsp: %u: item %u is there, at %#lx: a kernel before this one made it, and it is used again\n", step,
+		    ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	} else {
+		if (!our_item_make(partition)) {
+			return false;
+		}
+		our_item = our_item_find();
+		if (our_item == 0) {
+			printf("adsp: %u: THE ITEM IS NOT FOUND where it was just made\n", step);
+			return false;
+		}
+		printf("adsp: %u: item %u made, at %#lx\n", step, ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	}
+	/* zeroes; from processor 0 to 2, room for 16 entries, "master-kernel" at zero, feature bit 0; last the version */
+	snprintf(last_write, sizeof(last_write), "step %u filled in our SMP2P item", step);
+	for (uint32_t at = 0; at < sizeof(ours); at += 4) {
+		smem_poke(our_item + at, 0);
+	}
+	settle();
+	smem_poke(our_item, SMP2P_MAGIC);
+	smem_poke(our_item + SMP2P_AT_PROCESSORS, SMEM_US | SMEM_ADSP << 16);
+	strlcpy((char *)name, OUR_ENTRY_STOP, sizeof(name));
+	for (uint32_t word = 0; word < 4; word++) {
+		smem_poke(our_item + SMP2P_AT_NAME(0) + 4 * word, name[word]);
+	}
+	smem_poke(our_item + SMP2P_AT_COUNTS, 16 | 1u << 16);
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8);
+	settle();
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8 | SMP2P_VERSION);
+	settle();
+	smp2p_agreed = smp2p_restart_acks = smp2p_restart_acked = false;
+	need(&ipcc);
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	if (!smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || smp2p_entry(&ours, OUR_ENTRY_STOP) < 0) {
+		printf("adsp: %u: OUR ITEM DOES NOT READ BACK AS WRITTEN\n", step);
+		return false;
+	}
+	show_words("our item reads back", &ours);
+	glink_reset();
+	return true;
+}
+
+/* ---- step 7: the DSP, started ---------------------------------------------------------------------- */
+
+/*
+ * Android's kernel (this phone, dmesg): the image loaded at 8.92 s, "brought out of reset" at
+ * 9.10, "error ready" 40 ms later; the audio services' protection domain up at 9.39.
+ * Here (runs 085341 and later): the DSP's SMP2P item appears 17 ms after TrustZone returns, with
+ * a ring of its SMP2P and GLINK doorbells; at 41 ms "slave-kernel" says 6, up and asking for its
+ * own power, and our request for the rails is given back; at 2.2 s it adds "sleepstate_see".
+ * Asked to stop, it acknowledges within 25 ms (0x10e), and it starts again in the same session.
+ */
+static bool
+step_start(void)
+{
+	struct smp2p words, last;
+	uint64_t answer = ~0ull, started, now, ready_at = 0, limit;
+	uint32_t state = 0, rang, changes = 0, wait_seconds = 10;
+	int32_t result;
+	bool have, spoke = false, handed_over = false;
+
+	if (!image_written) {
+		printf("adsp: %u: the image is not in place\n", step);
+		return false;
+	}
+	PE_parse_boot_argn("adsp_wait", &wait_seconds, sizeof(wait_seconds));
+	bzero(&last, sizeof(last));
+	have = dsp_words(&last);
+	announce("listen for the audio DSP's doorbells, ask RPMh for its rails, tell the always-on processor that its image is "
+	    "loaded, and ask TrustZone to authenticate the image and let the DSP out of reset");
+	need(&ipcc);
+	for (unsigned i = 0; i < 8 && (rang = rd(ipcc.base + IPCC_RECEIVED)) != IPCC_NOBODY && rang >> 16 == IPCC_LPASS; i++) {
+		put(&ipcc, "heard", IPCC_CLEAR, rang);
+	}
+	put(&ipcc, "listened for", IPCC_ENABLE, IPCC_LPASS << 16 | IPCC_SMP2P);
+	put(&ipcc, "listened for", IPCC_ENABLE, IPCC_LPASS << 16 | IPCC_GLINK);
+	bzero(&doorbell, sizeof(doorbell));
+	lck_mtx_lock(&dsp_lock);
+	if (!rails(384)) {
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	rails_asked = true;
+	if (!mailbox_send("{class: image, res: load_state, name: adsp, val: on}")) {
+		rails(0);
+		rails_asked = false;
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	result = scm("to authenticate the audio DSP's image and start it", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_ADSP, 0, 0,
+	    &answer);
+	doorbell.since = started = now_us();
+	image_written = false;
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT START THE AUDIO DSP: the call returns %d, its answer is %#llx\n", step, result,
+		    answer);
+		mailbox_send("{class: image, res: load_state, name: adsp, val: off}");
+		rails(0);
+		rails_asked = false;
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	dsp_started = true;
+	lck_mtx_unlock(&dsp_lock);
+	printf("adsp: %u: TRUSTZONE HAS AUTHENTICATED THE IMAGE AND LET THE AUDIO DSP OUT OF RESET; watching for %u s\n", step,
+	    wait_seconds);
+	limit = started + wait_seconds * 1000000ull;
+	for (;;) {
+		now = now_us();
+		if (now >= limit || !dsp_started) {
+			break;
+		}
+		doorbells();
+		spoke = spoke || doorbell.glink + doorbell.smp2p != 0;
+		if (dsp_words(&words) && (!have || memcmp(&words, &last, sizeof(words)) != 0)) {
+			char when[64];
+
+			snprintf(when, sizeof(when), "+%llu.%03llu ms: the DSP's item %s", (now - started) / 1000, (now - started) % 1000,
+			    have ? "changes" : "APPEARS");
+			if (changes++ < 40) {
+				show_words(when, &words);
+			}
+			last = words;
+			have = spoke = true;
+			dsp_listen(&words);
+			state = dsp_state(&words);
+			if ((state & DSP_READY) && ready_at == 0) {
+				ready_at = now;
+				limit = now + 3000000ull;
+				printf("adsp: %u: THE AUDIO DSP SAYS IT IS UP: \"slave-kernel\" says %#x, %llu.%03llu ms after TrustZone started "
+				    "it\n", step, state, (now - started) / 1000, (now - started) % 1000);
+			}
+			if ((state & DSP_HANDOVER) && !handed_over) {
+				handed_over = true;
+				printf("adsp: %u: the DSP says it has asked for its own power (bit 2), %llu.%03llu ms after the start: ours is "
+				    "given back\n", step, (now - started) / 1000, (now - started) % 1000);
+				lck_mtx_lock(&dsp_lock);
+				if (rails_asked) {
+					rails(0);
+					rails_asked = false;
+				}
+				lck_mtx_unlock(&dsp_lock);
+			}
+			if (state & DSP_FATAL) {
+				printf("adsp: %u: THE AUDIO DSP SAYS IT HAS GIVEN UP\n", step);
+				show_crash_reason();
+				break;
+			}
+		}
+		sleep_us(200);
+	}
+	printf("adsp: %u: the watch is over after %llu ms; its doorbells heard: GLINK %u, SMP2P %u\n", step,
+	    (now_us() - started) / 1000, doorbell.glink, doorbell.smp2p);
+	show_partition();
+	if (our_item != 0 && smem_peek(our_item, &words, sizeof(words))) {
+		show_words("our item (429) now", &words);
+	}
+	{
+		/* (what is at the bottom of our partition, entry by entry, as it is now) */
+		uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+		struct smem_partition header;
+		struct smem_entry entry;
+
+		if (partition != 0 && smem_peek(partition, &header, sizeof(header))) {
+			printf("adsp: %u: the partition's header: hosts %u and %u, size %#x, free from the bottom at +%#x, from the top at "
+			    "+%#x; the table's line size %u\n", step, header.host0, header.host1, header.size, header.free_uncached,
+			    header.free_cached, cacheline);
+			for (uint32_t at = sizeof(header), n = 0; at + sizeof(entry) <= header.size && n < 8; n++) {
+				smem_peek(partition + at, &entry, sizeof(entry));
+				printf("adsp: %u:   +%#x: canary %#x item %u size %u padding %u/%u\n", step, at, entry.canary, entry.item,
+				    entry.size, entry.padding_data, entry.padding_header);
+				if (entry.canary != SMEM_CANARY) {
+					break;
+				}
+				at += sizeof(entry) + entry.padding_header + entry.size;
+			}
+		}
+	}
+	if (state & DSP_FATAL) {
+		return false;
+	}
+	if (ready_at == 0) {
+		printf("adsp: %u: %s\n", step, spoke ? "THE AUDIO DSP RUNS BUT HAS NOT SAID \"UP\"" : "NOT A WORD FROM THE AUDIO DSP");
+		show_crash_reason();
+	}
+	return ready_at != 0;
+}
+
+/* ---- GLINK (hakios.wifi.c; items 478 to 480 of our partition with the audio DSP) ------------------- */
+
+#define ITEM_GLINK_DESCRIPTOR   478
+#define ITEM_GLINK_OUR_QUEUE    479
+#define ITEM_GLINK_THEIR_QUEUE  480
+#define GLINK_OUR_TAIL          0
+#define GLINK_OUR_HEAD          4
+#define GLINK_THEIR_TAIL        8
+#define GLINK_THEIR_HEAD        12
+#define GLINK_RESERVE           16
+
+enum {
+	GLINK_VERSION = 0, GLINK_VERSION_ACK = 1, GLINK_OPEN = 2, GLINK_CLOSE = 3, GLINK_OPEN_ACK = 4, GLINK_INTENT = 5,
+	GLINK_DONE = 6, GLINK_INTENT_REQUEST = 7, GLINK_INTENT_REQUEST_ACK = 8, GLINK_DATA = 9, GLINK_CLOSE_ACK = 11,
+	GLINK_DATA_MORE = 12, GLINK_READ_NOTIFY = 13, GLINK_DONE_REUSE = 14, GLINK_SIGNALS = 15,
+};
+#define GLINK_VERSION_1         1
+#define GLINK_INTENT_REUSE      1u
+
+struct glink_message {
+	uint16_t command, param1;
+	uint32_t param2;
+};
+struct glink_packet {
+	struct glink_packet *next;
+	uint32_t length;
+	uint8_t data[];
+};
+
+/*
+ * The channels we answer when the DSP opens them, each with our number for it and the intents
+ * we give it when it is open both ways (how many buffers of which size the DSP may send into):
+ * IPCRTR, which carries QRTR (dt: qcom,intents of qcom,adsp_qrtr), and apr_audio_svc, which
+ * carries APR, the audio services' own protocol (below; Android's apr_tal_rpmsg.c asks for no
+ * particular intents: what the DSP sends there is a few hundred bytes, up to a few kilobytes).
+ */
+enum { CHANNEL_QRTR, CHANNEL_APR, CHANNEL_PMIC, CHANNELS };
+
+struct glink_channel {
+	const char *name;
+	uint32_t ours;                          /* our number for it */
+	struct {
+		uint32_t size, count;
+	} intents[3];
+	uint32_t theirs;                        /* the DSP's number for it; 0: it has not opened it */
+	bool asked, acknowledged, open;         /* our open sent; acknowledged; both ways done and our intents told */
+	bool request_answered, request_granted; /* our last request for an intent */
+	struct {
+		uint32_t id, size;
+		bool there, in_use;
+	} their_intents[64];                    /* what we may send into */
+	struct {
+		uint32_t size, fill;
+		uint8_t *data;
+	} our_intents[24];                      /* what the DSP may send into; an intent's number is its place here + 1 */
+	uint32_t our_intent_count;
+	struct glink_packet *first, *last;      /* received, in order */
+};
+
+static LCK_MTX_DECLARE(glink_lock, &adsp_lock_group);
+static struct {
+	uint32_t descriptor, ours, ours_size, theirs, theirs_size;
+	bool up, broken;
+	uint32_t features;
+	bool agreed;
+	struct glink_channel channel[CHANNELS];
+	uint32_t said, heard, trace;
+	char others[4][33];                     /* the channels the DSP opens that nobody here speaks (for the log) */
+} glink = {
+	.channel = {
+		[CHANNEL_QRTR] = { .name = "IPCRTR", .ours = 1, .intents = { { 0x800, 5 }, { 0x2000, 3 }, { 0x4400, 2 } } },
+		[CHANNEL_APR] = { .name = "apr_audio_svc", .ours = 2, .intents = { { 0x200, 8 }, { 0x1000, 4 }, { 0x2000, 2 } } },
+		/* the battery manager's (battmgr below): answers of a few dozen bytes, a name of 128 */
+		[CHANNEL_PMIC] = { .name = "PMIC_RTR_ADSP_APPS", .ours = 3, .intents = { { 0x200, 6 }, { 0x1000, 2 }, { 0, 0 } } },
+	},
+};
+
+static struct glink_channel *
+glink_theirs(uint32_t theirs)
+{
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		if (glink.channel[c].theirs != 0 && glink.channel[c].theirs == theirs) {
+			return &glink.channel[c];
+		}
+	}
+	return NULL;
+}
+
+static bool
+glink_find(void)
+{
+	uint32_t size = 0;
+
+	glink.descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+	/* (the descriptor and both queues are read and written without further checks: all three must lie inside the SMEM window) */
+	if (glink.descriptor == 0 || size != 32 || (uint64_t)glink.descriptor + size > SMEM_SIZE) {
+		return false;
+	}
+	glink.ours = smem_item(ITEM_GLINK_OUR_QUEUE, &glink.ours_size);
+	glink.theirs = smem_item(ITEM_GLINK_THEIR_QUEUE, &glink.theirs_size);
+	return glink.ours != 0 && glink.theirs != 0 && glink.ours_size >= 1024 && glink.theirs_size >= 1024 &&
+	       !(glink.ours_size & 7) && !(glink.theirs_size & 7) &&
+	       (uint64_t)glink.ours + glink.ours_size <= SMEM_SIZE && (uint64_t)glink.theirs + glink.theirs_size <= SMEM_SIZE;
+}
+
+static void
+glink_reset(void)
+{
+	uint32_t size = 0, descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+
+	/* (and inside the SMEM window: the words below are read and written without a bounds check) */
+	if (descriptor == 0 || size != 32 || (uint64_t)descriptor + size > SMEM_SIZE) {
+		printf("adsp: %u: GLINK's descriptor (item %u) is not there: nothing to reset\n", step, ITEM_GLINK_DESCRIPTOR);
+		return;
+	}
+	printf("adsp: %u: GLINK's descriptor at %#lx: our queue read to %#x and written to %#x, the DSP's read to %#x and written "
+	    "to %#x\n", step, SMEM_PHYS + descriptor, smem_word(descriptor + GLINK_OUR_TAIL), smem_word(descriptor + GLINK_OUR_HEAD),
+	    smem_word(descriptor + GLINK_THEIR_TAIL), smem_word(descriptor + GLINK_THEIR_HEAD));
+	if (smem_word(descriptor + GLINK_OUR_HEAD) != 0 || smem_word(descriptor + GLINK_THEIR_TAIL) != 0) {
+		printf("adsp: %u: about to write our two marks there (+4, +8): 0\n", step);
+		smem_poke(descriptor + GLINK_OUR_HEAD, 0);
+		smem_poke(descriptor + GLINK_THEIR_TAIL, 0);
+		settle();
+	}
+}
+
+static uint32_t
+glink_waiting(void)
+{
+	uint32_t head = smem_word(glink.descriptor + GLINK_THEIR_HEAD), tail = smem_word(glink.descriptor + GLINK_THEIR_TAIL);
+
+	if (head >= glink.theirs_size || tail >= glink.theirs_size) {
+		return 0;
+	}
+	return head >= tail ? head - tail : glink.theirs_size - tail + head;
+}
+
+static void
+glink_peek(void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (smem_word(glink.descriptor + GLINK_THEIR_TAIL) + offset) % glink.theirs_size;
+
+	for (uint32_t i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = smem[glink.theirs + (at + i) % glink.theirs_size];
+	}
+}
+
+static void
+glink_advance(uint32_t count)
+{
+	smem_poke(glink.descriptor + GLINK_THEIR_TAIL, (smem_word(glink.descriptor + GLINK_THEIR_TAIL) + count) % glink.theirs_size);
+}
+
+static uint32_t
+glink_room(void)
+{
+	uint32_t head = smem_word(glink.descriptor + GLINK_OUR_HEAD), tail = smem_word(glink.descriptor + GLINK_OUR_TAIL), room;
+
+	if (head >= glink.ours_size || tail >= glink.ours_size) {
+		return 0;
+	}
+	room = tail <= head ? glink.ours_size - head + tail : tail - head;
+	return room < GLINK_RESERVE ? 0 : room - GLINK_RESERVE;
+}
+
+static bool
+glink_put(const void *first, uint32_t first_length, const void *second, uint32_t second_length)
+{
+	volatile uint8_t *queue = (volatile uint8_t *)(uintptr_t)smem + glink.ours;
+	uint32_t head = smem_word(glink.descriptor + GLINK_OUR_HEAD), length = first_length + second_length;
+	uint32_t padded = (length + 7) & ~7u;
+
+	if (!glink.up || glink_room() < padded) {
+		return false;
+	}
+	for (uint32_t i = 0; i < padded; i++) {
+		queue[(head + i) % glink.ours_size] = i < first_length ? ((const uint8_t *)first)[i] :
+		    i < length ? ((const uint8_t *)second)[i - first_length] : 0;
+	}
+	settle();
+	smem_poke(glink.descriptor + GLINK_OUR_HEAD, (head + padded) % glink.ours_size);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_GLINK);
+	glink.said++;
+	return true;
+}
+
+static const char *
+glink_name(unsigned command)
+{
+	static const char *const names[] = {
+		"version", "version-ack", "open", "close", "open-ack", "intent", "done", "intent-request", "intent-request-ack",
+		"data", "10", "close-ack", "data-more", "read-notify", "done-reuse", "signals"
+	};
+
+	return command < sizeof(names) / sizeof(names[0]) ? names[command] : "?";
+}
+
+static void
+glink_say(unsigned command, uint32_t param1, uint32_t param2, const void *more, uint32_t more_length)
+{
+	struct glink_message message = { .command = (uint16_t)command, .param1 = (uint16_t)param1, .param2 = param2 };
+	bool sent = glink_put(&message, sizeof(message), more, more_length);
+
+	if (glink.trace > 0 || !sent) {
+		glink.trace -= glink.trace > 0;
+		printf("adsp: glink: > %s %u %#x%s\n", glink_name(command), param1, param2, sent ? "" : ": NO ROOM IN OUR QUEUE, not sent");
+	}
+}
+
+static bool
+glink_offer(struct glink_channel *channel, uint32_t size)
+{
+	uint32_t words[2] = { size, channel->our_intent_count + 1 }, i = channel->our_intent_count;
+
+	if (i >= sizeof(channel->our_intents) / sizeof(channel->our_intents[0]) || size == 0 || size > 0x10000) {
+		return false;
+	}
+	if (channel->our_intents[i].data == NULL || channel->our_intents[i].size != size) {
+		/* (a buffer of another size from an earlier run is given back first: replacing the pointer would leak it) */
+		if (channel->our_intents[i].data != NULL) {
+			kfree_data(channel->our_intents[i].data, channel->our_intents[i].size);
+			channel->our_intents[i].data = NULL;
+		}
+		channel->our_intents[i].data = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	}
+	if (channel->our_intents[i].data == NULL) {
+		return false;
+	}
+	channel->our_intents[i].size = size;
+	channel->our_intents[i].fill = 0;
+	channel->our_intent_count++;
+	glink_say(GLINK_INTENT, channel->ours, 1, words, sizeof(words));
+	return true;
+}
+
+/* Everything the DSP has put into its queue, taken out and acted on (Linux's qcom_glink_native_rx()). With glink_lock held. */
+static void
+glink_pump(void)
+{
+	struct glink_message message;
+	struct glink_channel *channel;
+	uint32_t words[4];
+	char name[33];
+
+	while (glink.up && !glink.broken) {
+		uint32_t waiting = glink_waiting(), length;
+		/*
+		 * The length is worked out in 64 bits: the DSP writes the fields it comes from, and in 32 bits a value such as
+		 * 0xfffffff8 wrapped it to 0, so that the message was never taken out and this loop never ended (with glink_lock held).
+		 */
+		uint64_t wide = sizeof(message);
+
+		if (waiting < sizeof(message)) {
+			return;
+		}
+		glink_peek(&message, 0, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			wide += message.param2;
+		} else if (message.command == GLINK_INTENT) {
+			wide += 8ull * message.param2;
+		} else if (message.command == GLINK_DATA || message.command == GLINK_DATA_MORE) {
+			if (waiting < 16) {
+				return;
+			}
+			glink_peek(words, 8, 8);
+			wide = 16ull + words[0];
+		}
+		wide = (wide + 7) & ~7ull;
+		if (wide > glink.theirs_size - 8) {
+			printf("adsp: glink: A MESSAGE OF %llu BYTES (%s %u %#x): not believed, and nothing more is read\n", wide,
+			    glink_name(message.command), message.param1, message.param2);
+			glink.broken = true;
+			return;
+		}
+		length = (uint32_t)wide;
+		if (waiting < length) {
+			return;
+		}
+		glink.heard++;
+		if (glink.trace > 0 && message.command != GLINK_DATA && message.command != GLINK_DATA_MORE &&
+		    message.command != GLINK_INTENT && message.command != GLINK_DONE_REUSE) {
+			glink.trace--;
+			printf("adsp: glink: < %s %u %#x\n", glink_name(message.command), message.param1, message.param2);
+		}
+		switch (message.command) {
+		case GLINK_VERSION:
+			if (message.param1 == GLINK_VERSION_1) {
+				glink.features &= message.param2;
+			}
+			glink_advance(length);
+			glink_say(GLINK_VERSION_ACK, GLINK_VERSION_1, glink.features, NULL, 0);
+			break;
+		case GLINK_VERSION_ACK:
+			glink_advance(length);
+			if (message.param1 == GLINK_VERSION_1 && message.param2 == glink.features) {
+				glink.agreed = true;
+			} else if (message.param1 != 0) {
+				glink.features &= message.param2;
+				glink_say(GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+			}
+			break;
+		case GLINK_OPEN:
+			bzero(name, sizeof(name));
+			glink_peek(name, sizeof(message), message.param2 < sizeof(name) - 1 ? message.param2 : sizeof(name) - 1);
+			glink_advance(length);
+			channel = NULL;
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (strcmp(name, glink.channel[c].name) == 0) {
+					channel = &glink.channel[c];
+				}
+			}
+			if (channel == NULL) {
+				printf("adsp: glink: the DSP opens \"%s\" as its channel %u: left unanswered, nobody here speaks it\n", name,
+				    message.param1);
+				for (unsigned i = 0; i < 4; i++) {
+					if (glink.others[i][0] == 0) {
+						strlcpy(glink.others[i], name, sizeof(glink.others[i]));
+						break;
+					}
+				}
+				break;
+			}
+			printf("adsp: glink: the DSP opens \"%s\" as its channel %u: acknowledged, and opened from our side as channel %u\n",
+			    name, message.param1, channel->ours);
+			channel->theirs = message.param1;
+			glink_say(GLINK_OPEN_ACK, channel->theirs, 0, NULL, 0);
+			if (!channel->asked) {
+				uint32_t size = (uint32_t)strlen(channel->name) + 1;
+
+				bzero(name, sizeof(name));
+				strlcpy(name, channel->name, sizeof(name));
+				glink_say(GLINK_OPEN, channel->ours, size, name, (size + 7) & ~7u);
+				channel->asked = true;
+			}
+			break;
+		case GLINK_OPEN_ACK:
+			glink_advance(length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == glink.channel[c].ours) {
+					glink.channel[c].acknowledged = true;
+				}
+			}
+			break;
+		case GLINK_INTENT:
+			channel = glink_theirs(message.param1);
+			for (uint32_t i = 0; channel != NULL && i < message.param2; i++) {
+				glink_peek(words, 8 + 8 * i, 8);
+				for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+					if (!channel->their_intents[n].there || channel->their_intents[n].id == words[1]) {
+						channel->their_intents[n].there = true;
+						channel->their_intents[n].in_use = false;
+						channel->their_intents[n].size = words[0];
+						channel->their_intents[n].id = words[1];
+						break;
+					}
+				}
+			}
+			glink_advance(length);
+			break;
+		case GLINK_DONE:
+		case GLINK_DONE_REUSE:
+			channel = glink_theirs(message.param1);
+			for (unsigned n = 0; channel != NULL && n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+				if (channel->their_intents[n].there && channel->their_intents[n].id == message.param2) {
+					channel->their_intents[n].in_use = false;
+					channel->their_intents[n].there = message.command == GLINK_DONE_REUSE;
+				}
+			}
+			glink_advance(length);
+			break;
+		case GLINK_INTENT_REQUEST:
+			glink_advance(length);
+			if ((channel = glink_theirs(message.param1)) != NULL) {
+				bool granted = glink_offer(channel, message.param2);
+
+				glink_say(GLINK_INTENT_REQUEST_ACK, channel->ours, granted, NULL, 0);
+			}
+			break;
+		case GLINK_INTENT_REQUEST_ACK:
+			glink_advance(length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == glink.channel[c].theirs || message.param1 == glink.channel[c].ours) {
+					glink.channel[c].request_answered = true;
+					glink.channel[c].request_granted = message.param2 != 0;
+				}
+			}
+			break;
+		case GLINK_DATA:
+		case GLINK_DATA_MORE: {
+			uint32_t intent = message.param2 - 1;
+
+			channel = glink_theirs(message.param1);
+			if (channel == NULL || intent >= channel->our_intent_count ||
+			    words[0] > channel->our_intents[intent].size - channel->our_intents[intent].fill) {
+				printf("adsp: glink: < data of %u bytes on channel %u for intent %u: NOT OURS OR TOO MUCH, dropped\n", words[0],
+				    message.param1, message.param2);
+				glink_advance(length);
+				break;
+			}
+			glink_peek(channel->our_intents[intent].data + channel->our_intents[intent].fill, 16, words[0]);
+			channel->our_intents[intent].fill += words[0];
+			glink_advance(length);
+			if (words[1] == 0) {
+				struct glink_packet *packet = kalloc_data(sizeof(*packet) + channel->our_intents[intent].fill, Z_WAITOK);
+
+				if (packet != NULL) {
+					packet->next = NULL;
+					packet->length = channel->our_intents[intent].fill;
+					memcpy(packet->data, channel->our_intents[intent].data, packet->length);
+					if (channel->last != NULL) {
+						channel->last->next = packet;
+					} else {
+						channel->first = packet;
+					}
+					channel->last = packet;
+				}
+				channel->our_intents[intent].fill = 0;
+				glink_say(GLINK_DONE_REUSE, channel->ours, message.param2, NULL, 0);
+			}
+			break;
+		}
+		case GLINK_READ_NOTIFY:
+			glink_advance(length);
+			wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_GLINK);
+			break;
+		case GLINK_CLOSE:
+			glink_advance(length);
+			glink_say(GLINK_CLOSE_ACK, message.param1, 0, NULL, 0);
+			if ((channel = glink_theirs(message.param1)) != NULL) {
+				printf("adsp: glink: THE DSP CLOSES \"%s\"\n", channel->name);
+				channel->open = false;
+				channel->theirs = 0;
+			}
+			break;
+		case GLINK_CLOSE_ACK:
+		case GLINK_SIGNALS:
+			glink_advance(length);
+			break;
+		default:
+			printf("adsp: glink: A MESSAGE THIS DOES NOT KNOW (%u, %u, %#x): nothing more is read\n", message.command,
+			    message.param1, message.param2);
+			glink.broken = true;
+			return;
+		}
+		for (unsigned c = 0; c < CHANNELS; c++) {
+			channel = &glink.channel[c];
+			if (channel->theirs != 0 && channel->acknowledged && !channel->open) {
+				channel->open = true;
+				printf("adsp: glink: THE CHANNEL \"%s\" IS OPEN both ways (ours %u, the DSP's %u); telling the DSP our intents\n",
+				    channel->name, channel->ours, channel->theirs);
+				for (unsigned i = 0; i < 3; i++) {
+					for (unsigned n = 0; n < channel->intents[i].count; n++) {
+						glink_offer(channel, channel->intents[i].size);
+					}
+				}
+			}
+		}
+	}
+}
+
+/* One whole message to the DSP on a channel; waits up to five seconds for an intent of the DSP's that it fits. */
+static int
+glink_send(struct glink_channel *channel, const void *data, uint32_t length)
+{
+	struct {
+		struct glink_message message;
+		uint32_t size, left;
+	} header = { { GLINK_DATA, (uint16_t)channel->ours, 0 }, length, 0 };
+	bool asked = false, fits;
+	int found = -1;
+
+	lck_mtx_lock(&glink_lock);
+	if (glink.up && length + sizeof(header) + 8 > glink.ours_size - GLINK_RESERVE) {
+		lck_mtx_unlock(&glink_lock);
+		return EMSGSIZE;
+	}
+	for (unsigned waited = 0;; waited++) {
+		glink_pump();
+		if (!glink.up || !channel->open || glink.broken) {
+			lck_mtx_unlock(&glink_lock);
+			return ENOTCONN;
+		}
+		found = -1;
+		fits = false;
+		for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+			if (!channel->their_intents[n].there || channel->their_intents[n].size < length) {
+				continue;
+			}
+			fits = true;
+			if (!channel->their_intents[n].in_use &&
+			    (found < 0 || channel->their_intents[n].size < channel->their_intents[found].size)) {
+				found = (int)n;
+			}
+		}
+		if (found >= 0 && glink_room() >= ((length + sizeof(header) + 7) & ~7u)) {
+			break;
+		}
+		if (!fits && !asked) {
+			channel->request_answered = false;
+			glink_say(GLINK_INTENT_REQUEST, channel->ours, length, NULL, 0);
+			asked = true;
+		}
+		if (waited >= 5000 || (!fits && asked && channel->request_answered && !channel->request_granted)) {
+			lck_mtx_unlock(&glink_lock);
+			return found < 0 ? ENOBUFS : EAGAIN;
+		}
+		lck_mtx_unlock(&glink_lock);
+		sleep_ms(1);
+		lck_mtx_lock(&glink_lock);
+	}
+	channel->their_intents[found].in_use = true;
+	header.message.param2 = channel->their_intents[found].id;
+	glink_put(&header, sizeof(header), data, length);
+	lck_mtx_unlock(&glink_lock);
+	return 0;
+}
+
+/* ---- QRTR: hello, and the services the DSP tells of (hakios.wifi.c, without ports of our own yet) ---- */
+
+#define QRTR_US                 1u
+#define QRTR_CONTROL            0xfffffffeu
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6, QRTR_RESUME_TX = 7,
+       QRTR_NEW_LOOKUP = 10, QRTR_DEL_LOOKUP = 11 };
+
+struct qrtr_header {
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct qrtr_control {
+	uint32_t command;
+	uint32_t words[4];
+};
+
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} qrtr_servers[64];
+static uint32_t qrtr_peer, qrtr_in, qrtr_out, qrtr_hellos, qrtr_lookups;
+
+static int
+qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct qrtr_header *packet;
+	int error;
+
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = glink_send(&glink.channel[CHANNEL_QRTR], packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	qrtr_out += error == 0;
+	return error;
+}
+
+static void
+qrtr_control(const struct qrtr_header *header, const struct qrtr_control *control)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	int found = -1, error;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		if (qrtr_hellos++ != 0) {
+			break;
+		}
+		error = qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, header->from_node, QRTR_CONTROL, &hello, sizeof(hello));
+		printf("adsp: qrtr: HELLO FROM NODE %u; ours to it: %s\n", header->from_node, error == 0 ? "SENT" : "NOT SENT");
+		break;
+	case QRTR_NEW_SERVER:
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!qrtr_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			qrtr_servers[found].there = true;
+			qrtr_servers[found].service = control->words[0];
+			qrtr_servers[found].instance = control->words[1];
+			qrtr_servers[found].node = control->words[2];
+			qrtr_servers[found].port = control->words[3];
+		}
+		printf("adsp: qrtr: a service: %u (%#x), version %u, instance %u, at node %u port %u\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3]);
+		break;
+	case QRTR_DEL_SERVER:
+		printf("adsp: qrtr: service %u at node %u port %u has gone\n", control->words[0], control->words[2], control->words[3]);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				qrtr_servers[i].there = false;
+			}
+		}
+		break;
+	case QRTR_NEW_LOOKUP:
+		/* the DSP looks for a service of ours (a protection domain's locator, say): there are none yet */
+		if (qrtr_lookups++ < 16) {
+			printf("adsp: qrtr: the DSP looks for service %u (%#x), instance %u: nobody here offers it\n", control->words[0],
+			    control->words[0], control->words[1]);
+		}
+		break;
+	case QRTR_BYE:
+		printf("adsp: qrtr: BYE from node %u\n", header->from_node);
+		bzero(qrtr_servers, sizeof(qrtr_servers));
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		printf("adsp: qrtr: %u bytes that are no datagram (they begin %#x)\n", length, length ? data[0] : 0);
+		return;
+	}
+	/* (the datagram's size is the DSP's word: "at + size" could wrap in 32 bits and pass, so it is compared as a difference) */
+	if (header.size == 0 || at > length || header.size > length - at) {
+		printf("adsp: qrtr: a datagram of %u bytes in a message of %u: dropped\n", header.size, length);
+		return;
+	}
+	qrtr_in++;
+	if (qrtr_peer == 0) {
+		qrtr_peer = header.from_node;
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;
+	}
+	if (header.confirm) {
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP) {
+		struct qrtr_control control = { 0 };
+
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		qrtr_control(&header, &control);
+		return;
+	}
+	printf("adsp: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n", header.size,
+	    header.from_node, header.from_port, header.to_port);
+}
+
+/* ---- APR: the audio services' protocol, on the channel apr_audio_svc ------------------------------------- */
+
+/*
+ * What Android's audio drivers say to the DSP's audio services (Linux: drivers/soc/qcom/apr.c,
+ * include/linux/soc/qcom/apr.h; Android's q6core.c): a packet of a header of eight words -- a
+ * word of kind, header length and version and the packet's length, who it is from and to (a
+ * service, a domain, a port each: we are domain 5, the DSP 4), a token the answer carries back,
+ * an opcode -- and what the opcode takes. The DSP's core service (3) answers whether the audio
+ * services are up (AVCS_CMD_ADSP_EVENT_GET_STATE, which Android asks again and again after the DSP
+ * has started, until the answer is 1) and which services it has and in which versions.
+ */
+#define APR_DOMAIN_ADSP                 4
+#define APR_DOMAIN_APPS                 5
+#define APR_SVC_ADSP_CORE               3
+#define APR_MSG_TYPE_SEQ_CMD            2
+#define APR_HDR_FIELD(type, bytes)      ((uint16_t)((type) << 8 | ((bytes) / 4) << 4))      /* version 0 */
+#define APR_BASIC_RSP_RESULT            0x000110e8u
+#define AVCS_GET_VERSIONS               0x00012905u
+#define AVCS_GET_VERSIONS_RSP           0x00012906u
+#define AVCS_CMD_ADSP_EVENT_GET_STATE   0x0001290cu
+#define AVCS_CMDRSP_ADSP_EVENT_GET_STATE 0x0001290du
+
+struct apr_header {
+	uint16_t field, size;
+	uint8_t from_service, from_domain;
+	uint16_t from_port;
+	uint8_t to_service, to_domain;
+	uint16_t to_port;
+	uint32_t token, opcode;
+};
+
+static struct {
+	uint32_t opcode, token, length;
+	uint32_t words[64];
+	volatile bool there;
+} apr_answer;
+static uint32_t apr_in, apr_out, apr_next_token = 1;
+static bool audio_up;                   /* the core service has said that the audio services are up (step 11) */
+static uint32_t apr_waited_for;         /* the token a question waits for the answer to; 0: none */
+static hakios_apr_events_t apr_events; /* the sound's (hakios.sound.c): what nobody waits for */
+static hakios_apr_events_t apr_events_second;  /* the microphones' (hakios.mic.c) */
+static LCK_MTX_DECLARE(apr_lock, &adsp_lock_group);     /* one question at a time */
+
+/* A packet from the DSP's audio services. From the link's thread. */
+static void
+apr_input(const uint8_t *data, uint32_t length)
+{
+	struct apr_header header;
+	uint32_t header_length, payload;
+
+	if (length < sizeof(header)) {
+		printf("adsp: apr: %u bytes, no APR packet\n", length);
+		return;
+	}
+	memcpy(&header, data, sizeof(header));
+	header_length = ((header.field >> 4) & 0xf) * 4;
+	if (header_length < sizeof(header) || header_length > length) {
+		printf("adsp: apr: a header of %u bytes in a packet of %u: dropped\n", header_length, length);
+		return;
+	}
+	/*
+	 * The packet's own size is the DSP's word: below the header it would make the payload wrap to about 4 GB, and the copies
+	 * below would then read 256 bytes from beyond this packet. Such a packet is dropped.
+	 */
+	if ((header.size < length ? header.size : length) < header_length) {
+		printf("adsp: apr: a packet of %u bytes with a header of %u: dropped\n", header.size < length ? header.size : length,
+		    header_length);
+		return;
+	}
+	payload = (header.size < length ? header.size : length) - header_length;
+	apr_in++;
+	if (header.token != apr_waited_for || apr_waited_for == 0) {
+		hakios_apr_events_t events = apr_events;
+		uint32_t words[64];
+
+		bzero(words, sizeof(words));
+		memcpy(words, data + header_length, payload < sizeof(words) ? payload : sizeof(words));
+		if (events != NULL && events(header.from_service, header.from_port, header.opcode, header.token, words,
+		    payload < sizeof(words) ? payload : sizeof(words))) {
+			return;
+		}
+		events = apr_events_second;
+		if (events != NULL && events(header.from_service, header.from_port, header.opcode, header.token, words,
+		    payload < sizeof(words) ? payload : sizeof(words))) {
+			return;
+		}
+	}
+	if (apr_in <= 40) {
+		uint32_t w[4] = { 0, 0, 0, 0 };
+
+		memcpy(w, data + header_length, payload < sizeof(w) ? payload : sizeof(w));
+		printf("adsp: apr: < from service %u of domain %u (port %u) to %u of %u (port %u): opcode %#x, token %u, %u bytes: %#x %#x "
+		    "%#x %#x\n", header.from_service, header.from_domain, header.from_port, header.to_service, header.to_domain,
+		    header.to_port, header.opcode, header.token, payload, w[0], w[1], w[2], w[3]);
+	}
+	bzero(apr_answer.words, sizeof(apr_answer.words));
+	memcpy(apr_answer.words, data + header_length, payload < sizeof(apr_answer.words) ? payload : sizeof(apr_answer.words));
+	apr_answer.length = payload;
+	apr_answer.opcode = header.opcode;
+	apr_answer.token = header.token;
+	/* (released: the thread that waits must not see "there" before the words and the token above, as with battmgr's answers) */
+	os_atomic_store(&apr_answer.there, true, release);
+}
+
+/*
+ * A command to one of the DSP's services (and its answer waited for, with ms): true when it was
+ * sent and, if waited for, answered; the answer is in apr_answer and, if asked for, in *answer.
+ * The port is the service's own numbering of what the command is for (ASM: session << 8 | stream).
+ */
+bool
+hakios_adsp_apr(uint8_t service, uint16_t port, uint32_t token, uint32_t opcode, const void *payload, uint32_t length,
+    uint32_t ms, struct hakios_apr_answer *answer)
+{
+	uint8_t packet[sizeof(struct apr_header) + 256];
+	struct apr_header *header = (struct apr_header *)packet;
+	bool answered = false;
+	int error;
+
+	if (length > sizeof(packet) - sizeof(*header) || !glink.channel[CHANNEL_APR].open) {
+		return false;
+	}
+	bzero(packet, sizeof(packet));
+	header->field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD, sizeof(*header));
+	header->size = (uint16_t)(sizeof(*header) + length);
+	header->from_service = service;
+	header->from_domain = APR_DOMAIN_APPS;
+	header->from_port = port;
+	header->to_service = service;
+	header->to_domain = APR_DOMAIN_ADSP;
+	header->to_port = port;
+	header->opcode = opcode;
+	if (length != 0) {
+		memcpy(packet + sizeof(*header), payload, length);
+	}
+	if (ms == 0) {
+		/* (sent and not waited for: what comes back is the events' handler's) */
+		header->token = token;
+		error = glink_send(&glink.channel[CHANNEL_APR], packet, (uint32_t)sizeof(*header) + length);
+		apr_out += error == 0;
+		return error == 0;
+	}
+	lck_mtx_lock(&apr_lock);
+	if (token == 0) {
+		token = apr_next_token++;
+		if (apr_next_token >= 0x01000000u) {
+			apr_next_token = 1;
+		}
+	}
+	header->token = token;
+	apr_answer.there = false;
+	apr_waited_for = token;
+	error = glink_send(&glink.channel[CHANNEL_APR], packet, (uint32_t)sizeof(*header) + length);
+	if (error != 0) {
+		printf("adsp: apr: > opcode %#x to service %u: NOT SENT (%d)\n", opcode, service, error);
+	} else {
+		apr_out++;
+		for (uint32_t waited = 0; waited < ms && !answered; waited++) {
+			if (os_atomic_load(&apr_answer.there, acquire) && apr_answer.token == token) {
+				answered = true;
+				if (answer != NULL) {
+					answer->opcode = apr_answer.opcode;
+					answer->token = apr_answer.token;
+					answer->length = apr_answer.length;
+					memcpy(answer->words, apr_answer.words, sizeof(answer->words));
+				}
+				break;
+			}
+			sleep_ms(1);
+		}
+	}
+	apr_waited_for = 0;
+	lck_mtx_unlock(&apr_lock);
+	return answered;
+}
+
+void
+hakios_adsp_apr_events(hakios_apr_events_t handler)
+{
+	apr_events = handler;
+}
+
+void
+hakios_adsp_apr_events_second(hakios_apr_events_t handler)
+{
+	apr_events_second = handler;
+}
+
+/* A command to one of the DSP's services, and its answer waited for: true, and the answer in apr_answer, if it came. */
+static bool
+apr_ask(uint8_t service, uint32_t opcode, const void *payload, uint32_t length, uint32_t ms)
+{
+	return hakios_adsp_apr(service, 0, 0, opcode, payload, length, ms, NULL);
+}
+
+/* ---- the battery manager, on the channel PMIC_RTR_ADSP_APPS ------------------------------------------ */
+
+/*
+ * On this SoC the audio DSP also runs the battery's and the charger's management -- the fuel gauge,
+ * the charging -- and the operating system only asks it how things are: Android's
+ * qti_battery_charger.c, Linux's qcom_battmgr.c over pmic_glink.c, on the channel PMIC_RTR_ADSP_APPS
+ * that the DSP opens. A message is a header (owner 32778, the battery manager; type 1, request and
+ * answer, or 2, a notice; an opcode) and its words; a property is asked for with opcode 0x30 (the
+ * battery's) or 0x32 (the USB port's), the battery's number (0), the property's number and a word
+ * that a get does not use, and is answered with the property's number, its value and a result (0:
+ * good). Only gets are sent from here: nothing is set, no limit, no current, no notice asked for.
+ * With adsp=1 (battmgr=0: not) it is asked every BATTMGR_SECONDS while the DSP runs, and what it says
+ * goes to drivers/power/hakios.battery.c (hakios_battery_report()), and from there to the power source
+ * that Darwin reads (drivers/power/hakios.battery.cpp). battmgr=2: every property once, for the log.
+ * Units: capacity in hundredths of a percent, voltage in uV, current in uA (more than 0 while the
+ * battery takes charge), the temperature in hundredths of a degree, charges in uAh.
+ * The properties' numbers are this phone's firmware's, read with battmgr=2 and checked against what
+ * Android shows at the same moment (dumpsys battery, /sys/class/power_supply/battery): up to 9 they
+ * are those of Linux's qcom_battmgr.c (sm8350), from there on one more property comes before the
+ * temperature, so the temperature is 13, not 12, and the charge counter, the cycles, the designed and
+ * the learnt full charge are 15 to 18.
+ */
+#define BATTMGR_OWNER           32778
+#define BATTMGR_REQUEST         1
+#define BATTMGR_NOTICE          2
+#define BATTMGR_BATTERY_GET     0x30
+#define BATTMGR_USB_GET         0x32
+#define BATT_STATUS             0               /* Linux's POWER_SUPPLY_STATUS_*: 1 charging, 2 discharging, 3 not charging, 4 full */
+#define BATT_HEALTH             1
+#define BATT_PRESENT            2
+#define BATT_CAPACITY           4
+#define BATT_VOLT_NOW           7
+#define BATT_CURR_NOW           9
+#define BATT_TEMP               13              /* hundredths of a degree: 3900 when Android says 39.0 */
+#define BATT_CHG_COUNTER        15              /* the charge in the battery now, uAh */
+#define BATT_CYCLE_COUNT        16
+#define BATT_CHG_FULL_DESIGN    17              /* 5000000 uAh */
+#define BATT_CHG_FULL           18              /* the full charge as the fuel gauge has learnt it, uAh */
+#define USB_VOLT_NOW            1               /* uV */
+#define USB_CURR_NOW            3               /* uA, what the port gives */
+#define USB_TYPE                6               /* Linux's POWER_SUPPLY_USB_TYPE_*: 1 here, a computer's port */
+#define USB_ONLINE              0
+#define BATTMGR_SECONDS         10
+
+struct battmgr_message {
+	uint32_t owner, type, opcode;
+	uint32_t words[3];                      /* asked: battery, property, value; answered: property, value, result */
+};
+
+static struct {
+	volatile uint32_t answers, notices;
+	uint32_t opcode, property, value, result, length;
+	bool wanted;
+	volatile bool runs;
+} battmgr;
+
+static void
+battmgr_input(const uint8_t *data, uint32_t length)
+{
+	struct battmgr_message m;
+
+	bzero(&m, sizeof(m));
+	memcpy(&m, data, length < sizeof(m) ? length : sizeof(m));
+	if (m.owner != BATTMGR_OWNER || length < 12) {
+		printf("adsp: battmgr: < %u bytes of owner %u, type %u, opcode %#x: not the battery manager's\n", length, m.owner,
+		    m.type, m.opcode);
+		return;
+	}
+	if (m.type == BATTMGR_NOTICE) {
+		if (battmgr.notices++ < 8) {
+			tell("adsp: battmgr: < a notice, opcode %#x, %u bytes (%#x %#x %#x)\n", m.opcode, length, m.words[0], m.words[1],
+			    m.words[2]);
+		}
+		return;
+	}
+	battmgr.opcode = m.opcode;
+	battmgr.property = m.words[0];
+	battmgr.value = m.words[1];
+	battmgr.result = m.words[2];
+	battmgr.length = length;
+	os_atomic_inc(&battmgr.answers, release);
+}
+
+/* One property asked for and its answer waited for (a second at most); one thread asks at a time (battmgr_thread). */
+static bool
+battmgr_get(uint32_t opcode, uint32_t property, uint32_t *value)
+{
+	struct battmgr_message q = { BATTMGR_OWNER, BATTMGR_REQUEST, opcode, { 0, property, 0 } };
+	uint32_t before = os_atomic_load(&battmgr.answers, acquire);
+
+	if (glink_send(&glink.channel[CHANNEL_PMIC], &q, sizeof(q)) != 0) {
+		return false;
+	}
+	for (unsigned ms = 0; ms < 1000; ms++) {
+		if (os_atomic_load(&battmgr.answers, acquire) != before) {
+			if (battmgr.opcode != opcode || battmgr.property != property || battmgr.length < sizeof(struct battmgr_message)) {
+				before = battmgr.answers;       /* (somebody else's answer: wait on) */
+				continue;
+			}
+			if (battmgr.result != 0) {
+				return false;
+			}
+			*value = battmgr.value;
+			return true;
+		}
+		sleep_ms(1);
+	}
+	return false;
+}
+
+static void
+battmgr_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	battmgr.runs = true;
+	for (unsigned ms = 0; ms < 15000 && battmgr.wanted && !glink.channel[CHANNEL_PMIC].open; ms += 10) {
+		sleep_ms(10);
+	}
+	if (!glink.channel[CHANNEL_PMIC].open) {
+		tell("adsp: battmgr: the DSP has not opened PMIC_RTR_ADSP_APPS: nothing is asked\n");
+		battmgr.runs = false;
+		thread_terminate(current_thread());
+	}
+	{
+		/* boot-arg battmgr=2: every property once, for the log (which number is which on this phone's firmware) */
+		uint32_t mode = 1;
+
+		PE_parse_boot_argn("battmgr", &mode, sizeof(mode));
+		for (uint32_t p = 0; mode == 2 && p < 32; p++) {
+			uint32_t v = 0;
+			bool ok = battmgr_get(BATTMGR_BATTERY_GET, p, &v);
+
+			tell("adsp: battmgr: battery property %u: %s %u (%d)\n", p, ok ? "" : "NO ANSWER", v, (int)v);
+		}
+		for (uint32_t p = 0; mode == 2 && p < 12; p++) {
+			uint32_t v = 0;
+			bool ok = battmgr_get(BATTMGR_USB_GET, p, &v);
+
+			tell("adsp: battmgr: USB property %u: %s %u (%d)\n", p, ok ? "" : "NO ANSWER", v, (int)v);
+		}
+	}
+	for (unsigned round = 0; battmgr.wanted && glink.up && glink.channel[CHANNEL_PMIC].open; round++) {
+		struct hakios_battery_state b = { .size = sizeof(b) };
+		uint32_t capacity = 0, status = 0, present = 0, volt = 0, curr = 0, temp = 0, usb = 0;
+		uint32_t usb_type = 0, usb_volt = 0, usb_curr = 0, charge = 0;
+		static uint32_t full, design, cycles;
+		bool good = battmgr_get(BATTMGR_BATTERY_GET, BATT_CAPACITY, &capacity) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_STATUS, &status) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_PRESENT, &present) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_VOLT_NOW, &volt) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_CURR_NOW, &curr) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_TEMP, &temp) &&
+		    battmgr_get(BATTMGR_USB_GET, USB_ONLINE, &usb);
+
+		if (good) {
+			/* (what may be missing without harm, and the capacities and the cycles only now and then: they hardly change) */
+			(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_COUNTER, &charge);
+			if (usb) {
+				(void)battmgr_get(BATTMGR_USB_GET, USB_TYPE, &usb_type);
+				(void)battmgr_get(BATTMGR_USB_GET, USB_VOLT_NOW, &usb_volt);
+				(void)battmgr_get(BATTMGR_USB_GET, USB_CURR_NOW, &usb_curr);
+			}
+			if (round % 30 == 0 || full == 0) {
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_FULL, &full);
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_FULL_DESIGN, &design);
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CYCLE_COUNT, &cycles);
+			}
+			b.percent_hundredths = (int32_t)capacity;
+			b.voltage_uv = (int32_t)volt;
+			b.current_ua = (int32_t)curr;
+			b.temperature_hundredths = (int32_t)temp;
+			b.present = present != 0;
+			b.external = usb != 0;
+			b.status = (int32_t)status;
+			b.charge_uah = (int32_t)charge;
+			b.full_uah = (int32_t)full;
+			b.design_uah = (int32_t)design;
+			b.cycles = (int32_t)cycles;
+			b.usb_type = (int32_t)usb_type;
+			b.usb_voltage_uv = (int32_t)usb_volt;
+			b.usb_current_ua = (int32_t)usb_curr;
+			hakios_battery_report(&b);
+		}
+		if (round < 3 || round % 6 == 0 || !good) {
+			tell("adsp: battmgr: %s capacity %u (hundredths of a percent), status %u, present %u, %d uV, %d uA, temperature %d "
+			    "(hundredths of a degree), charge %u uAh, USB online %u (type %u, %u uV, %u uA)\n",
+			    good ? "the DSP says:" : "NO ANSWER to all of", capacity, status, present, (int)volt, (int)curr, (int)temp,
+			    charge, usb, usb_type, usb_volt, usb_curr);
+			if (round % 30 == 0 && good) {
+				tell("adsp: battmgr: full charge %u uAh, as designed %u uAh, %u cycles\n", full, design, cycles);
+			}
+		}
+		for (unsigned ms = 0; ms < BATTMGR_SECONDS * 1000 && battmgr.wanted && glink.up; ms += 50) {
+			sleep_ms(50);
+		}
+	}
+	battmgr.runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+battmgr_start(void)
+{
+	thread_t thread;
+
+	uint32_t wanted = 1;            /* (on with adsp=1 unless battmgr=0) */
+
+	PE_parse_boot_argn("battmgr", &wanted, sizeof(wanted));
+	if (wanted == 0 || battmgr.runs) {
+		return;
+	}
+	if (option("battery")) {
+		/* (the loader's way, through Qualcomm's UEFI charger drivers: one way to the battery at a time) */
+		tell("adsp: battmgr: not with battery=1: the battery is asked about the loader's way\n");
+		return;
+	}
+	battmgr.wanted = true;
+	if (kernel_thread_start(battmgr_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static void
+battmgr_stop(void)
+{
+	battmgr.wanted = false;
+	for (unsigned ms = 0; ms < 2000 && battmgr.runs; ms++) {
+		sleep_ms(1);
+	}
+}
+
+/* ---- the link's thread ----------------------------------------------------------------------------- */
+
+static volatile bool link_wanted, link_runs;
+
+static void
+link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct smp2p words, last;
+	struct glink_packet *packet;
+	bool gave_up = false;
+
+	bzero(&last, sizeof(last));
+	dsp_words(&last);
+	while (link_wanted) {
+		sleep_us(1000);
+		doorbells();
+		if (dsp_words(&words) && memcmp(&words, &last, sizeof(words)) != 0) {
+			last = words;
+			dsp_listen(&words);
+			if ((dsp_state(&words) & DSP_FATAL) && !gave_up) {
+				gave_up = true;
+				printf("adsp: link: THE AUDIO DSP SAYS IT HAS GIVEN UP (\"slave-kernel\" = %#x)\n", dsp_state(&words));
+				show_crash_reason();
+			}
+		}
+		for (;;) {
+			unsigned from = CHANNELS;
+
+			lck_mtx_lock(&glink_lock);
+			glink_pump();
+			packet = NULL;
+			for (unsigned c = 0; c < CHANNELS && packet == NULL; c++) {
+				struct glink_channel *channel = &glink.channel[c];
+
+				if ((packet = channel->first) != NULL) {
+					channel->first = packet->next;
+					channel->last = channel->first == NULL ? NULL : channel->last;
+					from = c;
+				}
+			}
+			lck_mtx_unlock(&glink_lock);
+			if (packet == NULL) {
+				break;
+			}
+			if (from == CHANNEL_QRTR) {
+				qrtr_input(packet->data, packet->length);
+			} else if (from == CHANNEL_PMIC) {
+				battmgr_input(packet->data, packet->length);
+			} else {
+				apr_input(packet->data, packet->length);
+			}
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+	}
+	link_runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+link_stop(void)
+{
+	struct glink_packet *packet;
+
+	if (link_runs) {
+		link_wanted = false;
+		for (unsigned ms = 0; ms < 2000 && link_runs; ms++) {
+			sleep_ms(1);
+		}
+		printf("adsp: link: %s; GLINK said %u and heard %u messages, QRTR sent %u and received %u datagrams, APR %u and %u "
+		    "packets; its doorbells heard: GLINK %u, SMP2P %u\n", link_runs ? "THE THREAD DOES NOT END" : "down", glink.said,
+		    glink.heard, qrtr_out, qrtr_in, apr_out, apr_in, doorbell.glink, doorbell.smp2p);
+	}
+	lck_mtx_lock(&glink_lock);
+	glink.up = false;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->open = false;
+		while ((packet = channel->first) != NULL) {
+			channel->first = packet->next;
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+		channel->last = NULL;
+		/*
+		 * The buffers we offered the DSP are given back too, so that they do not stay allocated for good: only
+		 * glink_pump() uses them, under this lock, and it does nothing while glink.up is false.
+		 */
+		for (unsigned i = 0; i < sizeof(channel->our_intents) / sizeof(channel->our_intents[0]); i++) {
+			if (channel->our_intents[i].data != NULL) {
+				kfree_data(channel->our_intents[i].data, channel->our_intents[i].size);
+				channel->our_intents[i].data = NULL;
+			}
+			channel->our_intents[i].size = channel->our_intents[i].fill = 0;
+		}
+		channel->our_intent_count = 0;
+	}
+	lck_mtx_unlock(&glink_lock);
+	bzero(qrtr_servers, sizeof(qrtr_servers));
+	qrtr_peer = 0;
+}
+
+/* ---- step 8: GLINK's queues, looked at -------------------------------------------------------------- */
+
+static bool
+step_queues(void)
+{
+	struct glink_message message;
+	uint32_t head, tail;
+
+	announce("find GLINK's descriptor and the two queues, and read what the audio DSP has put into its own");
+	if (!glink_find()) {
+		printf("adsp: %u: GLINK's items are not all there, or not of a shape this knows (descriptor %#x, ours %#x of %u bytes, "
+		    "the DSP's %#x of %u)\n", step, glink.descriptor, glink.ours, glink.ours_size, glink.theirs, glink.theirs_size);
+		return false;
+	}
+	head = smem_word(glink.descriptor + GLINK_THEIR_HEAD);
+	tail = smem_word(glink.descriptor + GLINK_THEIR_TAIL);
+	printf("adsp: %u: our queue: %u bytes at %#lx, written to %#x, read by the DSP to %#x; the DSP's: %u bytes at %#lx, written "
+	    "to %#x, read by us to %#x\n", step, glink.ours_size, SMEM_PHYS + glink.ours, smem_word(glink.descriptor + GLINK_OUR_HEAD),
+	    smem_word(glink.descriptor + GLINK_OUR_TAIL), glink.theirs_size, SMEM_PHYS + glink.theirs, head, tail);
+	for (uint32_t at = 0, shown = 0; at + sizeof(message) <= head && head < glink.theirs_size && tail == 0 && shown < 8; shown++) {
+		char name[33] = "";
+		uint32_t length = sizeof(message);
+
+		glink_peek(&message, at, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			glink_peek(name, at + 8, message.param2 < 32 ? message.param2 : 32);
+			length += message.param2;
+		}
+		printf("adsp: %u:   in the DSP's queue at %#x: %s %u %#x %s\n", step, at, glink_name(message.command), message.param1,
+		    message.param2, name);
+		if (message.command != GLINK_VERSION && message.command != GLINK_OPEN) {
+			break;
+		}
+		at += (length + 7) & ~7u;
+	}
+	return true;
+}
+
+/* ---- step 9: GLINK, spoken -------------------------------------------------------------------------- */
+
+static bool
+step_link(void)
+{
+	thread_t thread;
+	uint64_t began;
+
+	if (!dsp_started || glink.descriptor == 0) {
+		return false;
+	}
+	announce("take up GLINK with the audio DSP: our version, then whatever its messages call for; a thread of ours listens "
+	    "from here on, every millisecond");
+	snprintf(last_write, sizeof(last_write), "step %u took up GLINK", step);
+	lck_mtx_lock(&glink_lock);
+	glink.features = GLINK_INTENT_REUSE;
+	glink.agreed = glink.broken = false;
+	glink.said = glink.heard = 0;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->asked = channel->acknowledged = channel->open = false;
+		channel->theirs = channel->our_intent_count = 0;
+		bzero(channel->their_intents, sizeof(channel->their_intents));
+	}
+	apr_in = apr_out = 0;
+	audio_up = false;
+	bzero(glink.others, sizeof(glink.others));
+	glink.trace = 60;
+	glink.up = true;
+	qrtr_hellos = qrtr_in = qrtr_out = qrtr_lookups = 0;
+	doorbell.since = began = now_us();
+	glink_say(GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+	lck_mtx_unlock(&glink_lock);
+	link_wanted = link_runs = true;
+	if (kernel_thread_start(link_thread, NULL, &thread) != KERN_SUCCESS) {
+		link_wanted = link_runs = false;
+		printf("adsp: %u: no thread\n", step);
+		return false;
+	}
+	thread_deallocate(thread);
+	for (unsigned ms = 0; ms < 5000 && !glink.channel[CHANNEL_QRTR].open && !glink.broken; ms++) {
+		sleep_ms(1);
+	}
+	sleep_ms(50);
+	printf("adsp: %u: %llu ms after our version: versions %s (features %#x); the channel \"IPCRTR\" is %s, \"apr_audio_svc\" %s; "
+	    "the DSP also opened \"%s\" \"%s\" \"%s\" \"%s\"\n", step, (now_us() - began) / 1000, glink.agreed ? "agreed" :
+	    "NOT AGREED", glink.features, glink.channel[CHANNEL_QRTR].open ? "OPEN" : "NOT OPEN",
+	    glink.channel[CHANNEL_APR].open ? "OPEN" : "NOT OPEN", glink.others[0], glink.others[1], glink.others[2], glink.others[3]);
+	return glink.channel[CHANNEL_QRTR].open;
+}
+
+/* ---- step 10: QRTR ---------------------------------------------------------------------------------- */
+
+static bool
+step_qrtr(void)
+{
+	unsigned services = 0;
+
+	if (!glink.channel[CHANNEL_QRTR].open) {
+		return false;
+	}
+	PE_parse_boot_argn("adsp_listen", &listen_seconds, sizeof(listen_seconds));
+	announce("listen to QRTR on the channel: the DSP's hello (answered from the link's thread), and the services it tells of");
+	for (unsigned ms = 0; ms < listen_seconds * 1000; ms++) {
+		sleep_ms(1);
+	}
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+	}
+	printf("adsp: %u: after %u s: %s; the DSP is node %u and has told of %u services; it looked for %u of ours; QRTR received %u "
+	    "and sent %u datagrams\n", step, listen_seconds, qrtr_hellos ? "HELLO BOTH WAYS" : "NO HELLO FROM THE DSP", qrtr_peer,
+	    services, qrtr_lookups, qrtr_in, qrtr_out);
+	return qrtr_hellos != 0;
+}
+
+/* ---- step 11: APR ---------------------------------------------------------------------------------- */
+
+static bool
+step_apr(void)
+{
+	uint32_t wait_seconds = 10, asked = 0, state = 0;
+	uint64_t began = now_us();
+
+	PE_parse_boot_argn("adsp_apr_wait", &wait_seconds, sizeof(wait_seconds));
+	announce("ask the audio DSP's core service over APR whether the audio services are up (again and again, as Android "
+	    "does), then which services it has");
+	for (unsigned ms = 0; ms < 3000 && !glink.channel[CHANNEL_APR].open; ms++) {
+		sleep_ms(1);
+	}
+	if (!glink.channel[CHANNEL_APR].open) {
+		printf("adsp: %u: the channel \"apr_audio_svc\" is not open: the DSP has not opened it\n", step);
+		return false;
+	}
+	while (now_us() - began < wait_seconds * 1000000ull) {
+		asked++;
+		if (apr_ask(APR_SVC_ADSP_CORE, AVCS_CMD_ADSP_EVENT_GET_STATE, NULL, 0, 500) &&
+		    apr_answer.opcode == AVCS_CMDRSP_ADSP_EVENT_GET_STATE) {
+			state = apr_answer.words[0];
+			if (state == 1) {
+				break;
+			}
+		}
+		sleep_ms(200);
+	}
+	audio_up = state == 1;
+	printf("adsp: %u: %s after %llu ms and %u questions (the last answer: opcode %#x, %u bytes, %#x)\n", step, state == 1 ?
+	    "THE AUDIO SERVICES ARE UP" : "THE AUDIO SERVICES DO NOT SAY THEY ARE UP", (now_us() - began) / 1000, asked,
+	    apr_answer.opcode, apr_answer.length, apr_answer.words[0]);
+	if (apr_ask(APR_SVC_ADSP_CORE, AVCS_GET_VERSIONS, NULL, 0, 1000)) {
+		char line[400];
+		int at = 0;
+
+		for (uint32_t i = 0; i < apr_answer.length / 4 && i < 64 && at < (int)sizeof(line) - 12; i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %#x", apr_answer.words[i]);
+		}
+		printf("adsp: %u: the services and their versions (opcode %#x, %u bytes):%s\n", step, apr_answer.opcode,
+		    apr_answer.length, line);
+	} else {
+		printf("adsp: %u: no answer to the question of the services' versions\n", step);
+	}
+	return state == 1;
+}
+
+/* ---- the steps, and their end ----------------------------------------------------------------------- */
+
+static bool (*const steps[STEPS])(void) = {
+	step_survey, step_firmware, step_mailbox, step_header, step_image, step_our_item, step_start, step_queues, step_link,
+	step_qrtr, step_apr,
+};
+
+static bool keep;                       /* the DSP and the link stay up while the system runs (adsp_keep, adsp=1) */
+
+static void
+steps_over(uint32_t done)
+{
+	lck_mtx_lock(&dsp_lock);
+	if (dsp_started && done == last_step && keep) {
+		printf("adsp: THE AUDIO DSP STAYS ON while the system runs%s\n", link_runs ? ", and the link with it" : "");
+	} else if (dsp_started) {
+		dsp_shutdown("the steps are over");
+	}
+	lck_mtx_unlock(&dsp_lock);
+}
+
+/* When the run ends in order: a DSP that runs is shut down, for the next kernel to start again. */
+void
+hakios_adsp_stop(void)
+{
+	battmgr_stop();
+	hakios_sound_dsp_down();               /* the amplifiers, the stream and the port first, while the DSP still listens */
+	hakios_mic_dsp_down();                 /* and what the microphones' path has asked for */
+	lck_mtx_lock(&dsp_lock);
+	if (dsp_started) {
+		unsigned services = 0;
+		uint32_t node = qrtr_peer;
+		bool down;
+
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			services += qrtr_servers[i].there;
+		}
+		down = dsp_shutdown("the run is about to end");
+		/* (said again at the end: a long run's log keeps its beginning and its end, and the middle may be gone) */
+		tell("adsp: the audio DSP is off: it had been up%s (node %u, %u services; audio services %s), it %s, and TrustZone %s\n",
+		    node ? " and linked" : ", NOT LINKED", node, services, audio_up ? "up" : "NOT UP", stopped_by_its_word ?
+		    "stopped when asked" : "DID NOT SAY IT HAD STOPPED", down ? "has shut it down" : "DID NOT SHUT IT DOWN");
+	}
+	lck_mtx_unlock(&dsp_lock);
+}
+
+/* The same on a panic's way back to the loader: one processor, interrupts off, no lock, no sleep. */
+void
+hakios_adsp_quiesce(void)
+{
+	hakios_sound_quiesce();                /* the amplifiers off, whatever the DSP's state */
+	if (!dsp_started) {
+		return;
+	}
+	leaving = true;
+	new_from = ~0u;
+	dsp_shutdown("the kernel is on its way back to the loader");
+}
+
+static void
+run_steps(void)
+{
+	uint32_t done = 0;
+
+	for (step = 1; step <= last_step; step++) {
+		if (!steps[step - 1]()) {
+			printf("adsp: step %u: FAILED; the steps after it are not attempted\n", step);
+			break;
+		}
+		printf("adsp: step %u: done\n", step);
+		done = step;
+	}
+	step = done;
+	new_from = STEPS + 1;
+	steps_over(done);
+	printf("adsp: over after step %u; %s\n", done, last_write);
+}
+
+static void
+whole_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t began = now_us();
+	unsigned services = 0;
+
+	/* (the firmware may be on the root file system, which is not mounted yet when this begins: a minute at most) */
+	for (unsigned waited = 0; waited < 300 && rootvnode == NULLVP; waited++) {
+		sleep_ms(200);
+	}
+	run_steps();
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+	}
+	if (step == STEPS && dsp_started) {
+		tell("adsp: THE AUDIO DSP IS UP AND LINKED, its audio services up (APR), %llu ms after the kernel began on it (the "
+		    "root's waited for included): node %u, %u services; it stays on\n", (now_us() - began) / 1000, qrtr_peer, services);
+		hakios_sound_dsp_up();         /* (boot-arg sound=N: the speakers' path, hakios.sound.c) */
+		hakios_mic_dsp_up();           /* (boot-arg mic=N: the microphones' path, hakios.mic.c) */
+		battmgr_start();                /* (how the battery is, from the DSP; battmgr=0: not asked) */
+	} else {
+		tell("adsp: THE AUDIO DSP DID NOT COME UP: step %u failed (%s); see the kernel's own log for the steps\n", step + 1,
+		    last_write);
+	}
+	thread_terminate(current_thread());
+}
+
+/* Called while the system starts (drivers/input/hakios.input.c), after the Wi-Fi's start has been set going. */
+void
+hakios_adsp_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("adsp_step", &last_step, sizeof(last_step));
+	if (last_step == 0 && (!PE_parse_boot_argn("adsp", &on, sizeof(on)) || on != 1)) {
+		return;
+	}
+	if (pe_arm_get_soc_base_phys() != HAKIOS_SOC_BASE) {
+		printf("adsp: adsp=1 and adsp_step=N are for the phone's audio DSP, and this is not the phone\n");
+		return;
+	}
+	if (last_step == 0) {
+		/* all of it, on a thread of its own, and left up */
+		last_step = STEPS;
+		keep = true;
+		quiet = true;
+		pause_ms = 0;
+		listen_seconds = 1;
+		new_from = STEPS + 1;
+		if (kernel_thread_start(whole_thread, NULL, &thread) != KERN_SUCCESS) {
+			printf("adsp: no thread: the audio DSP is not brought up\n");
+			return;
+		}
+		thread_deallocate(thread);
+		tell("adsp: the audio DSP is being brought up beside the system's start (adsp=1)\n");
+		return;
+	}
+	if (last_step > STEPS) {
+		last_step = STEPS;
+	}
+	keep = option("adsp_keep");
+	new_from = last_step;
+	PE_parse_boot_argn("adsp_new", &new_from, sizeof(new_from));
+	PE_parse_boot_argn("adsp_pause", &pause_ms, sizeof(pause_ms));
+	printf("adsp: steps up to %u; those from %u on are new and wait %u ms after each announcement\n", last_step, new_from,
+	    pause_ms);
+	run_steps();
+	if (option("adsp_return")) {
+		printf("adsp: back to the loader (adsp_return)\n");
+		loader_return();
+	}
+	printf("adsp: the system goes on starting\n");
+}
diff --git a/bsd/dev/hakios.apfs_check.c b/bsd/dev/hakios.apfs_check.c
new file mode 100644
index 0000000..3cfa631
--- /dev/null
+++ b/bsd/dev/hakios.apfs_check.c
@@ -0,0 +1,1872 @@
+/*
+ * Mount the APFS volume on /dev/rvblk0 and walk it through VFS, so that what the driver
+ * does can be compared with what tools/apfs/apfs.py reads from the same image on the
+ * build machine.  Only with boot-arg apfs_check.
+ *
+ *   apfs_check=1              walk the whole volume and print only the totals
+ *   apfs_check=2              also print a line per entry
+ *   apfs_check=3              mount it and stop, leaving it for user space to read
+ *                             (userland/src/apfs_mmap_test.c, which is the only way the
+ *                             driver's vnop_pagein ever runs)
+ *   apfs_check=4              mount nothing: walk the root filesystem, which is what the
+ *                             root already is when the volume was handed to the kernel as
+ *                             its root device.  This is how the phone is reached: it has
+ *                             no driver for its own storage and no virtio, so the only
+ *                             block device there is a RAM disk, and a RAM disk given to
+ *                             the kernel as the root is mounted by vfs_mountroot.
+ *   apfs_check=5              several threads walk the root filesystem at once, each over
+ *                             the whole of it, to see what the one lock round apfs_lib
+ *                             costs when there is more than one reader
+ *   apfs_threads=N            how many, for mode 5 (default 4)
+ *   apfs_check=6              mount apfs_dev on apfs_mnt, walk it on this thread and go
+ *                             back to the loader.  For a volume that is not the root and
+ *                             where there is no user space to make a mount point: the
+ *                             point is a directory of the root image itself.
+ *   apfs_dev=md1              the device to mount for modes 1 to 3 and 6 (default rvblk0)
+ *   apfs_mnt=/lib             where to mount it for mode 6 (default /private/var/apfs-check)
+ *   apfs_depth=N              go no deeper than N levels below where the walk starts
+ *                             (1 = only the entries of that directory; 0 = no limit).
+ *                             For splitting a volume too big to hold into parts: one part
+ *                             takes the root's own entries, the others take a subtree
+ *                             each, and the per-line hashes add up to the whole.
+ *   apfs_max=N                stop after N entries (and say how memory stood on the way):
+ *                             for finding out what a walk that never comes back runs into
+ *   apfs_skip=/a,/b           directories not to go into, as paths inside the volume,
+ *                             comma separated.  Their own line is still counted, only
+ *                             their contents are left out -- which is how a volume too
+ *                             big to hold is cut into parts that between them cover it
+ *                             exactly once.
+ *   apfs_subtree=/usr         walk only that part of the volume
+ *   apfs_check=7              the one mode that writes: replace bytes inside a file of the
+ *                             container on apfs_dev where they lie, with the kernel's own
+ *                             bsd/miscfs/apfs/apfs_write.c, and read them back out of a
+ *                             container opened again from nothing (apfs_write_check below)
+ *   apfs_check=8              the store of fixed-length slot files on apfs_dev: save a payload
+ *                             into it and read it back out of a container opened again from
+ *                             nothing (apfs_store_check below)
+ *
+ * A line is the same one tools/apfs/apfs-tool's census and `verify.py clines` print:
+ *
+ *   path <TAB> d_type <TAB> mode <TAB> uid <TAB> gid <TAB> size <TAB> hash-of-contents
+ *
+ * The whole volume is 318098 entries, and printing them all through the kernel log would
+ * be 47 MB down a serial line, so by default each line is folded into a sum instead: the
+ * lines are hashed one at a time and the hashes added together.  Addition does not care
+ * what order the entries came in, which matters because this walk and the one on the host
+ * need not visit a directory's entries in the same order.  The host adds up the same
+ * hashes over its own lines; if the two sums and counts agree, every path, kind, mode,
+ * owner, group, size and byte of content agreed.  When they do not, apfs_check=2 over a
+ * subtree gives lines to diff.
+ *
+ * Everything here goes through VFS -- vnode_lookup, vnode_getattr, VNOP_READDIR,
+ * VNOP_READLINK, vn_rdwr -- so it exercises the vnode operations and not just the format
+ * reading underneath them.
+ */
+
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/dirent.h>
+#include <sys/errno.h>
+#include <sys/kauth.h>
+#include <sys/param.h>
+#include <sys/mount.h>
+#include <sys/mount_internal.h>
+#include <sys/namei.h>
+#include <sys/proc.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/uio_internal.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/vnode_internal.h>
+#include <sys/hakios.input.h>
+#include <sys/sysctl.h>
+#include <pexpert/pexpert.h>
+#include <libkern/OSAtomic.h>
+#include <sys/hakios.apfs_check.h>
+#include <miscfs/apfs/apfs_lib.h>
+#include <miscfs/apfs/apfs_write.h>
+#include <miscfs/apfs/apfs_store.h>
+#include <sys/disk.h>
+#include <sys/buf.h>
+#include <sys/fcntl.h>
+
+extern void loader_return(void);        /* osfmk/arm64/loader_return.c */
+extern void apfs_stats_print(void);     /* bsd/miscfs/apfs/apfs_vfsops.c */
+extern void hakios_sparse_report(void);
+
+/* how memory stands, for the progress line (osfmk/vm, bsd/vfs) */
+extern unsigned int vm_page_free_count, vm_page_wire_count, memorystatus_available_pages;
+extern long numvnodes;
+extern int desiredvnodes;
+#define CHECK_MB(pages) ((unsigned int)(((uint64_t)(pages) * PAGE_SIZE) >> 20))
+
+/* which operation the walk is in, for the stuck detector further down */
+static const char *volatile watch_phase = "";
+#define PHASE(name) (watch_phase = (name))
+
+#define CHECK_MNT    "/private/var/apfs-check"
+#define CHECK_PARENT "/private/var"
+#define CHECK_LEAF   "apfs-check"
+#define CHECK_DEV    "/dev/rvblk0"
+
+#define FNV_INIT  0xcbf29ce484222325ULL
+#define FNV_PRIME 0x100000001b3ULL
+
+/*
+ * How much each read asks for: 64 KB, one compressed piece, unless boot-arg apfs_chunk says
+ * otherwise (up to 4 MB) -- a bigger read is one request whose pieces the driver can
+ * decompress on several processors at once.
+ */
+static uint32_t
+read_chunk(void)
+{
+	static uint32_t chunk;
+
+	if (chunk == 0) {
+		uint32_t want = 64 * 1024;
+
+		PE_parse_boot_argn("apfs_chunk", &want, sizeof(want));
+		if (want < 4096 || want > 4 * 1024 * 1024) {
+			want = 64 * 1024;
+		}
+		chunk = want;
+	}
+	return chunk;
+}
+#define READ_CHUNK read_chunk()
+#define DIR_CHUNK  4096
+#define MAX_DEPTH  48
+#define PATH_CAP   2048
+
+static uint64_t
+fnv1a(const uint8_t *p, size_t n, uint64_t h)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		h ^= p[i];
+		h *= FNV_PRIME;
+	}
+	return h;
+}
+
+struct census {
+	vfs_context_t ctx;
+	char     *path;                 /* the whole path, starting with CHECK_MNT */
+	size_t    rel;                  /* where the part inside the volume starts */
+	size_t    len;
+	uint8_t  *buf;                  /* for reading file contents */
+	uint64_t  sum;                  /* the per-line hashes, added up */
+	uint64_t  entries, dirs, files, links, others, bytes;
+	uint32_t  errors;
+	bool      print_lines;
+	int       depth;
+	/*
+	 * The volume being walked.  Walking the root means walking over the mount points of
+	 * other filesystems -- devfs on /dev above all -- and their contents are not this
+	 * volume's, so anything that turns out to live on another mount is passed over.
+	 */
+	mount_t   mp;
+	/*
+	 * NOCROSSMOUNT when the volume being walked is the root: a lookup then gives the
+	 * directory this volume has under a mount point rather than the root of whatever is
+	 * mounted on it, so /dev is counted as the (empty) directory it is here instead of
+	 * being either skipped or walked as devfs.  Not set when the volume is reached
+	 * through a path that itself crosses into it.
+	 */
+	int       lookup_flags;
+	uint32_t  max_depth;            /* 0: no limit */
+	char     *skip;                 /* comma separated paths not to descend into */
+	uint64_t  max_entries;          /* 0: no limit */
+	bool      stop;
+	uint64_t  t0;                   /* when the walk started, for the progress line */
+	/*
+	 * FNV-1a goes a byte at a time, each step waiting on the one before: about three
+	 * cycles a byte, more than a second over the restore ramdisk -- the checker's own
+	 * time, not the filesystem's.  Boot-arg apfs_hash=0 reads every byte all the same and
+	 * does not hash it (the sums are then not the ones to compare); hash_ticks is how
+	 * long the hashing took otherwise.
+	 */
+	bool      no_hash;
+	uint64_t  hash_ticks;
+	/*
+	 * Boot-arg apfs_contents=0: no file is read at all, only looked up and stat'ed --
+	 * how long the walk itself takes, the directories and the inodes.
+	 */
+	bool      no_contents;
+	/* apfs_walkers=N: one of N walkers; a subdirectory is left on the shared stack (par_push) */
+	bool      par;
+	/* where a walker's time goes (mach ticks): lookups, getattr, reading files and links
+	 * (hashing included), readdir, waiting for a directory to walk (par); on a processor */
+	uint64_t  t_lookup, t_attr, t_read, t_readdir, t_idle, t_cpu, t_wall;
+};
+
+/* The boot-args both kinds of walk take the same way. */
+static void
+census_options(struct census *cs)
+{
+	uint32_t hash = 1, contents = 1;
+
+	PE_parse_boot_argn("apfs_hash", &hash, sizeof(hash));
+	PE_parse_boot_argn("apfs_contents", &contents, sizeof(contents));
+	cs->no_hash = (hash == 0);
+	cs->no_contents = (contents == 0);
+}
+
+/* The format bits of a mode, which vnode_getattr does not report in va_mode. */
+static uint16_t
+ifmt_of(enum vtype t)
+{
+	switch (t) {
+	case VREG:  return S_IFREG;
+	case VDIR:  return S_IFDIR;
+	case VLNK:  return S_IFLNK;
+	case VCHR:  return S_IFCHR;
+	case VBLK:  return S_IFBLK;
+	case VFIFO: return S_IFIFO;
+	case VSOCK: return S_IFSOCK;
+	default:    return 0;
+	}
+}
+
+/* FNV-1a over a regular file's contents, read through VNOP_READ. */
+static int
+hash_file(struct census *cs, vnode_t vp, uint64_t size, uint64_t *out)
+{
+	uint64_t h = FNV_INIT, off = 0;
+
+	while (off < size) {
+		int want = (int)((size - off > READ_CHUNK) ? READ_CHUNK : (size - off));
+		int resid = 0;
+		int error = vn_rdwr(UIO_READ, vp, (caddr_t)cs->buf, want, (off_t)off,
+		    UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(cs->ctx), &resid,
+		    vfs_context_proc(cs->ctx));
+
+		if (error) {
+			return error;
+		}
+		if (resid == want) {
+			break;                  /* nothing more to be had */
+		}
+		if (!cs->no_hash) {
+			uint64_t t0 = mach_absolute_time();
+
+			h = fnv1a(cs->buf, (size_t)(want - resid), h);
+			cs->hash_ticks += mach_absolute_time() - t0;
+		}
+		cs->bytes += (uint64_t)(want - resid);
+		off += (uint64_t)(want - resid);
+	}
+	*out = h;
+	return 0;
+}
+
+/* FNV-1a over a symbolic link's target, read through VNOP_READLINK. */
+static int
+hash_link(struct census *cs, vnode_t vp, uint64_t *out)
+{
+	uio_t uio;
+	char uio_buf[UIO_SIZEOF(1)];
+	int error;
+	size_t n;
+
+	uio = uio_createwithbuffer(1, 0, UIO_SYSSPACE, UIO_READ, uio_buf, sizeof(uio_buf));
+	if (uio == NULL) {
+		return ENOMEM;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(cs->buf), MAXPATHLEN);
+	error = VNOP_READLINK(vp, uio, cs->ctx);
+	if (error) {
+		return error;
+	}
+	n = MAXPATHLEN - (size_t)uio_resid(uio);
+	cs->bytes += n;
+	*out = fnv1a(cs->buf, n, FNV_INIT);
+	return 0;
+}
+
+static bool
+census_entry(struct census *cs, uint8_t d_type)
+{
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+	uint64_t h = 0, size = 0;
+	uint16_t mode = 0;
+	char line[PATH_CAP + 128];
+	int error;
+	int n;
+
+	/*
+	 * Do not follow a symbolic link: the point is to look at the link itself, as the host
+	 * reader does.  Following them would report the target's kind, size and contents
+	 * instead, and a link whose target is missing -- of which this volume has several --
+	 * would look like a lookup failure.  Crossing mount points has to stay allowed: the
+	 * path leads from the ramfs that holds the mount point into the volume itself.
+	 */
+	PHASE("lookup");
+	{
+		uint64_t t0 = mach_absolute_time();
+
+		error = vnode_lookup(cs->path, cs->lookup_flags, &vp, cs->ctx);
+		cs->t_lookup += mach_absolute_time() - t0;
+	}
+	if (error) {
+		printf("apfs-check: %s: lookup failed: %d\n", cs->path + cs->rel, error);
+		cs->errors++;
+		return false;
+	}
+	if (cs->mp != NULL && vnode_mount(vp) != cs->mp) {
+		vnode_put(vp);          /* another filesystem is mounted here */
+		return false;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	VATTR_WANTED(&va, va_data_size);
+	PHASE("getattr");
+	{
+		uint64_t t0 = mach_absolute_time();
+
+		error = vnode_getattr(vp, &va, cs->ctx);
+		cs->t_attr += mach_absolute_time() - t0;
+	}
+	if (error) {
+		printf("apfs-check: %s: getattr failed: %d\n", cs->path + cs->rel, error);
+		cs->errors++;
+		goto out;
+	}
+	mode = (uint16_t)(ifmt_of(vnode_vtype(vp)) | (VATTR_IS_SUPPORTED(&va, va_mode)
+	    ? (va.va_mode & 07777) : 0));
+	size = VATTR_IS_SUPPORTED(&va, va_data_size) ? va.va_data_size : 0;
+
+	if (vnode_vtype(vp) == VREG) {
+		cs->files++;
+		PHASE("read");
+		if (!cs->no_contents) {
+			uint64_t t0 = mach_absolute_time();
+
+			error = hash_file(cs, vp, size, &h);
+			cs->t_read += mach_absolute_time() - t0;
+		}
+	} else if (vnode_vtype(vp) == VLNK) {
+		cs->links++;
+		PHASE("readlink");
+		if (!cs->no_contents) {
+			uint64_t t0 = mach_absolute_time();
+
+			error = hash_link(cs, vp, &h);
+			cs->t_read += mach_absolute_time() - t0;
+		}
+	} else if (vnode_vtype(vp) == VDIR) {
+		cs->dirs++;
+	} else {
+		cs->others++;
+	}
+	if (error) {
+		printf("apfs-check: %s: reading it failed: %d\n", cs->path + cs->rel, error);
+		cs->errors++;
+		goto out;
+	}
+
+	n = scnprintf(line, sizeof(line), "%s\t%u\t%06o\t%u\t%u\t%llu\t%016llx\n",
+	    cs->path + cs->rel, d_type, mode,
+	    VATTR_IS_SUPPORTED(&va, va_uid) ? va.va_uid : 0,
+	    VATTR_IS_SUPPORTED(&va, va_gid) ? va.va_gid : 0,
+	    (unsigned long long)size, (unsigned long long)h);
+	cs->sum += fnv1a((const uint8_t *)line, (size_t)n, FNV_INIT);
+	cs->entries++;
+	if (cs->print_lines) {
+		printf("apfs-line: %s", line);
+	}
+	if ((cs->entries % 10000) == 0) {
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - cs->t0, &ns);
+		printf("apfs-check: %llu entries so far at %llu ms  free %u MB  wired %u MB  "
+		    "available %u MB  vnodes %ld of %d\n", cs->entries, ns / 1000000,
+		    CHECK_MB(vm_page_free_count),
+		    CHECK_MB(vm_page_wire_count), CHECK_MB(memorystatus_available_pages),
+		    numvnodes, desiredvnodes);
+	}
+	if (cs->max_entries != 0 && cs->entries >= cs->max_entries) {
+		cs->stop = true;
+	}
+out:
+	PHASE("vnode_put");
+	vnode_put(vp);
+	PHASE("");
+	return error == 0;
+}
+
+static void census_dir(struct census *cs);
+static void par_push(const char *path, size_t len, int depth);
+
+/* the walkers of a parallel walk, for the watch's count of progress */
+#define PAR_MAX 16
+static struct census *volatile par_cs[PAR_MAX];
+static volatile uint32_t par_n;
+
+/*
+ * A walk that stops making progress, rather than one that fails.  On the phone a walk of
+ * the real volume can stop dead past some tens of thousands of entries, and then nothing
+ * is left to say why: the watchdog resets the phone and the log goes with it.  So a timer
+ * looks every few seconds; if the count of entries has not moved, it says which entry and
+ * which operation the walk is in, and goes back to the loader -- with the log -- before
+ * the watchdog does.
+ */
+#define WATCH_SECONDS 6
+
+static struct census *volatile watch_cs;
+static uint64_t watch_last = ~0ULL;
+static thread_call_t watch_call;
+
+static void
+watch_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	struct census *cs = watch_cs;
+	uint64_t deadline, progress;
+
+	if (cs == NULL) {
+		return;                 /* the walk is over */
+	}
+	/* entries and bytes both count as progress: one big file can take a while */
+	progress = cs->entries + cs->bytes;
+	for (uint32_t i = 0; i < par_n; i++) {
+		if (par_cs[i] != NULL) {
+			progress += par_cs[i]->entries + par_cs[i]->bytes;
+		}
+	}
+	if (progress == watch_last) {
+		printf("apfs-check: STUCK: no progress for %d s after entry %llu, at %s, in %s\n",
+		    WATCH_SECONDS, cs->entries, cs->path + cs->rel, watch_phase);
+		apfs_stats_print();
+		hakios_sparse_report();
+		printf("apfs-check: going back to the loader with that\n");
+		loader_return();
+		return;
+	}
+	/* a sign the timer got to run at all: a walk can starve every thread call */
+	printf("apfs-check: tick, %llu entries\n", cs->entries);
+	watch_last = progress;
+	clock_interval_to_deadline(WATCH_SECONDS, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(watch_call, deadline);
+}
+
+static void
+watch_start(struct census *cs)
+{
+	uint64_t deadline;
+
+	if (watch_call == NULL) {
+		watch_call = thread_call_allocate(watch_tick, NULL);
+	}
+	watch_last = ~0ULL;
+	watch_cs = cs;
+	clock_interval_to_deadline(WATCH_SECONDS, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(watch_call, deadline);
+}
+
+static void
+watch_stop(void)
+{
+	watch_cs = NULL;
+	if (watch_call != NULL) {
+		thread_call_cancel(watch_call);
+	}
+}
+
+/* Is this directory one of the ones to stay out of?  Compares the path inside the volume. */
+static bool
+census_skipped(struct census *cs)
+{
+	const char *want = cs->path + cs->rel;
+	size_t want_len = strlen(want);
+	const char *at = cs->skip;
+
+	if (at == NULL) {
+		return false;
+	}
+	while (*at != '\0') {
+		const char *end = strchr(at, ',');
+		size_t n = (end != NULL) ? (size_t)(end - at) : strlen(at);
+
+		if (n == want_len && memcmp(at, want, n) == 0) {
+			return true;
+		}
+		if (end == NULL) {
+			break;
+		}
+		at = end + 1;
+	}
+	return false;
+}
+
+/* Add "/name" to the path, do the entry, and put the path back as it was. */
+static void
+census_child(struct census *cs, const char *name, size_t name_len, uint8_t d_type)
+{
+	size_t saved = cs->len;
+
+	if (cs->stop) {
+		return;
+	}
+	if (cs->len + name_len + 2 > PATH_CAP) {
+		printf("apfs-check: path below %s is too long\n", cs->path + cs->rel);
+		cs->errors++;
+		return;
+	}
+	cs->path[cs->len++] = '/';
+	memcpy(cs->path + cs->len, name, name_len);
+	cs->len += name_len;
+	cs->path[cs->len] = '\0';
+
+	if (census_entry(cs, d_type) && d_type == DT_DIR && cs->depth < MAX_DEPTH &&
+	    (cs->max_depth == 0 || (uint32_t)cs->depth + 1 < cs->max_depth) &&
+	    !census_skipped(cs)) {
+		if (cs->par) {
+			par_push(cs->path, cs->len, cs->depth + 1);
+		} else {
+			cs->depth++;
+			census_dir(cs);
+			cs->depth--;
+		}
+	}
+	cs->len = saved;
+	cs->path[cs->len] = '\0';
+}
+
+/* Every entry of the directory the path currently names. */
+static void
+census_dir(struct census *cs)
+{
+	vnode_t dvp = NULLVP;
+	char *dbuf;
+	off_t offset = 0;
+	int error;
+
+	{
+		uint64_t t0 = mach_absolute_time();
+
+		error = vnode_lookup(cs->len != 0 ? cs->path : "/", cs->lookup_flags, &dvp,
+		    cs->ctx);
+		cs->t_lookup += mach_absolute_time() - t0;
+	}
+	if (error == 0 && cs->mp == NULL) {
+		cs->mp = vnode_mount(dvp);
+	}
+	if (error) {
+		printf("apfs-check: %s: lookup failed: %d\n",
+		    cs->len != 0 ? cs->path + cs->rel : "/", error);
+		cs->errors++;
+		return;
+	}
+	dbuf = kalloc_data(DIR_CHUNK, Z_WAITOK);
+	if (dbuf == NULL) {
+		vnode_put(dvp);
+		cs->errors++;
+		return;
+	}
+	for (;;) {
+		uio_t uio;
+		char uio_buf[UIO_SIZEOF(1)];
+		int eof = 0, items = 0;
+		size_t got;
+		char *p;
+
+		uio = uio_createwithbuffer(1, offset, UIO_SYSSPACE, UIO_READ, uio_buf,
+		    sizeof(uio_buf));
+		if (uio == NULL) {
+			cs->errors++;
+			break;
+		}
+		uio_addiov(uio, CAST_USER_ADDR_T(dbuf), DIR_CHUNK);
+		PHASE("readdir");
+		{
+			uint64_t t0 = mach_absolute_time();
+
+			error = VNOP_READDIR(dvp, uio, 0, &eof, &items, cs->ctx);
+			cs->t_readdir += mach_absolute_time() - t0;
+		}
+		if (error) {
+			printf("apfs-check: %s: readdir failed: %d\n", cs->path + cs->rel, error);
+			cs->errors++;
+			break;
+		}
+		got = DIR_CHUNK - (size_t)uio_resid(uio);
+		if (got == 0) {
+			break;
+		}
+		offset = uio_offset(uio);
+
+		for (p = dbuf; p < dbuf + got;) {
+			struct dirent *de = (struct dirent *)p;
+
+			if (de->d_reclen == 0 || p + de->d_reclen > dbuf + got) {
+				printf("apfs-check: %s: a directory entry of %u bytes\n",
+				    cs->path + cs->rel, de->d_reclen);
+				cs->errors++;
+				break;
+			}
+			p += de->d_reclen;
+			if (de->d_namlen == 0 ||
+			    (de->d_namlen == 1 && de->d_name[0] == '.') ||
+			    (de->d_namlen == 2 && de->d_name[0] == '.' && de->d_name[1] == '.')) {
+				continue;
+			}
+			census_child(cs, de->d_name, de->d_namlen, de->d_type);
+			if (cs->stop) {
+				break;
+			}
+		}
+		if (eof || cs->stop) {
+			break;
+		}
+	}
+	kfree_data(dbuf, DIR_CHUNK);
+	vnode_put(dvp);
+}
+
+/*
+ * apfs_walkers=N (mode 6): N threads walk the volume at once. They take directories off one
+ * shared stack -- a directory's own entries are done by the walker that took it, its
+ * subdirectories pushed for any of them -- so that as many files are read at once as there are
+ * walkers, and the storage has that many requests to work on. The per-line hashes add up the
+ * same whatever the order: the sum and the counts are those of the walk on one thread.
+ */
+struct par_dir {
+	char  *path;
+	size_t len;
+	int    depth;
+};
+
+static LCK_GRP_DECLARE(par_lck_grp, "apfs-check-walkers");
+static LCK_MTX_DECLARE(par_lock, &par_lck_grp);
+static struct par_dir *par_stack;
+static uint32_t par_count, par_cap, par_busy, par_finished, par_most;
+static bool par_failed;
+
+static void
+par_push(const char *path, size_t len, int depth)
+{
+	char *copy = kalloc_data(len + 1, Z_WAITOK);
+
+	lck_mtx_lock(&par_lock);
+	if (par_count == par_cap) {
+		uint32_t cap = par_cap ? par_cap * 2 : 1024;
+		struct par_dir *grown = kalloc_data(cap * sizeof(*grown), Z_WAITOK);
+
+		if (grown == NULL) {
+			par_failed = true;
+			lck_mtx_unlock(&par_lock);
+			kfree_data(copy, len + 1);
+			return;
+		}
+		if (par_stack != NULL) {
+			memcpy(grown, par_stack, par_count * sizeof(*grown));
+			kfree_data(par_stack, par_cap * sizeof(*grown));
+		}
+		par_stack = grown;
+		par_cap = cap;
+	}
+	if (copy == NULL) {
+		par_failed = true;
+	} else {
+		memcpy(copy, path, len + 1);
+		par_stack[par_count++] = (struct par_dir){ copy, len, depth };
+		if (par_count > par_most) {
+			par_most = par_count;
+		}
+		wakeup(&par_stack);
+	}
+	lck_mtx_unlock(&par_lock);
+}
+
+static void
+par_walker(void *arg, __unused wait_result_t wr)
+{
+	struct census *cs = arg;
+	uint64_t cpu0 = thread_get_runtime_self(), wall0 = mach_absolute_time();
+
+	for (;;) {
+		struct par_dir d;
+		uint64_t t0 = mach_absolute_time();
+
+		lck_mtx_lock(&par_lock);
+		while (par_count == 0 && par_busy > 0) {
+			msleep(&par_stack, &par_lock, PRIBIO, "apfs-walkers", NULL);
+		}
+		cs->t_idle += mach_absolute_time() - t0;
+		if (par_count == 0) {
+			/* nothing left, and no walker that could leave more */
+			cs->t_cpu = thread_get_runtime_self() - cpu0;
+			cs->t_wall = mach_absolute_time() - wall0;
+			par_finished++;
+			wakeup(&par_stack);
+			lck_mtx_unlock(&par_lock);
+			return;
+		}
+		d = par_stack[--par_count];
+		par_busy++;
+		lck_mtx_unlock(&par_lock);
+
+		memcpy(cs->path, d.path, d.len + 1);
+		cs->len = d.len;
+		cs->depth = d.depth;
+		kfree_data(d.path, d.len + 1);
+		if (!cs->stop) {
+			census_dir(cs);
+		}
+
+		lck_mtx_lock(&par_lock);
+		par_busy--;
+		wakeup(&par_stack);
+		lck_mtx_unlock(&par_lock);
+	}
+}
+
+/* where a walker's (or, summed, all walkers') time went */
+static void
+census_times(const struct census *cs, int who)
+{
+	uint64_t v[8] = { cs->t_wall, cs->t_cpu, cs->t_lookup, cs->t_attr, cs->t_read, cs->hash_ticks, cs->t_readdir,
+		              cs->t_idle };
+
+	for (int i = 0; i < 8; i++) {
+		absolutetime_to_nanoseconds(v[i], &v[i]);
+		v[i] /= 1000000;
+	}
+	char name[24];
+
+	if (who < 0) {
+		strlcpy(name, "all walkers", sizeof(name));
+	} else {
+		snprintf(name, sizeof(name), "walker %d", who);
+	}
+	printf("apfs-check: %s: %llu entries, %llu bytes: %llu ms, on a processor %llu; lookups %llu, getattr %llu, "
+	    "reading %llu (of it hashing %llu), readdir %llu, waiting for a directory %llu\n",
+	    name, cs->entries, cs->bytes, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+}
+
+/* The whole walk on n threads, its totals into cs */
+static void
+par_walk(struct census *cs, uint32_t n)
+{
+	struct census *w[PAR_MAX];
+	uint32_t started = 0;
+
+	par_count = par_busy = par_finished = par_most = 0;
+	par_failed = false;
+	par_push(cs->path, cs->len, cs->depth);
+	for (uint32_t i = 0; i < n; i++) {
+		w[i] = kalloc_type(struct census, Z_WAITOK | Z_ZERO);
+		if (w[i] == NULL) {
+			break;
+		}
+		*w[i] = *cs;
+		w[i]->par = true;
+		w[i]->sum = w[i]->entries = w[i]->dirs = w[i]->files = w[i]->links = w[i]->others = w[i]->bytes = 0;
+		w[i]->errors = 0;
+		w[i]->hash_ticks = 0;
+		w[i]->path = kalloc_data(PATH_CAP, Z_WAITOK | Z_ZERO);
+		w[i]->buf = kalloc_data(READ_CHUNK, Z_WAITOK);
+		if (w[i]->path == NULL || w[i]->buf == NULL) {
+			break;
+		}
+		par_cs[i] = w[i];
+		started = i + 1;
+	}
+	par_n = started;
+	printf("apfs-check: %u walkers at once\n", started);
+	for (uint32_t i = 0; i < started; i++) {
+		thread_t th;
+
+		if (kernel_thread_start(par_walker, w[i], &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			lck_mtx_lock(&par_lock);
+			par_finished++;
+			lck_mtx_unlock(&par_lock);
+		}
+	}
+	lck_mtx_lock(&par_lock);
+	while (par_finished < started) {
+		msleep(&par_stack, &par_lock, PRIBIO, "apfs-walk", NULL);
+	}
+	lck_mtx_unlock(&par_lock);
+	par_n = 0;
+	for (uint32_t i = 0; i < started; i++) {
+		par_cs[i] = NULL;
+		cs->sum += w[i]->sum;
+		cs->entries += w[i]->entries;
+		cs->dirs += w[i]->dirs;
+		cs->files += w[i]->files;
+		cs->links += w[i]->links;
+		cs->others += w[i]->others;
+		cs->bytes += w[i]->bytes;
+		cs->errors += w[i]->errors;
+		cs->hash_ticks += w[i]->hash_ticks;
+		census_times(w[i], i);
+		cs->t_lookup += w[i]->t_lookup;
+		cs->t_attr += w[i]->t_attr;
+		cs->t_read += w[i]->t_read;
+		cs->t_readdir += w[i]->t_readdir;
+		cs->t_idle += w[i]->t_idle;
+		cs->t_cpu += w[i]->t_cpu;
+		cs->t_wall += w[i]->t_wall;
+		kfree_data(w[i]->path, PATH_CAP);
+		kfree_data(w[i]->buf, READ_CHUNK);
+		kfree_type(struct census, w[i]);
+	}
+	if (par_failed) {
+		printf("apfs-check: the walkers ran out of memory for their stack: the walk is NOT whole\n");
+		cs->errors++;
+	}
+	census_times(cs, -1);
+	printf("apfs-check: at most %u directories waited on the walkers' stack\n", par_most);
+	if (par_stack != NULL) {
+		kfree_data(par_stack, par_cap * sizeof(*par_stack));
+		par_stack = NULL;
+		par_cap = 0;
+	}
+}
+
+/* ---- getting there ---- */
+
+static int
+make_mount_point(vfs_context_t ctx)
+{
+	struct componentname cn;
+	struct vnode_attr va;
+	vnode_t dvp = NULLVP, vp = NULLVP;
+	char leaf[] = CHECK_LEAF;
+	int error;
+
+	error = vnode_lookup(CHECK_PARENT, 0, &dvp, ctx);
+	if (error) {
+		return error;
+	}
+	bzero(&cn, sizeof(cn));
+	cn.cn_nameiop = CREATE;
+	cn.cn_flags = ISLASTCN;
+	cn.cn_context = ctx;
+	cn.cn_pnbuf = leaf;
+	cn.cn_pnlen = (int)sizeof(leaf);
+	cn.cn_nameptr = leaf;
+	cn.cn_namelen = (int)(sizeof(leaf) - 1);
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_type, VDIR);
+	VATTR_SET(&va, va_mode, 0755);
+
+	error = VNOP_MKDIR(dvp, &vp, &cn, &va, ctx);
+	if (error == 0 && vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	if (error == EEXIST) {
+		error = 0;
+	}
+	return error;
+}
+
+#define MAX_THREADS 8
+
+static volatile int apfs_check_running;
+
+struct walk_job {
+	int      index;
+	uint64_t ms;
+	uint64_t entries;
+	uint64_t bytes;
+	uint64_t sum;
+	uint32_t errors;
+};
+
+static struct walk_job apfs_jobs[MAX_THREADS];
+
+/* One reader: the whole root filesystem, with everything of its own. */
+static void
+apfs_walk_one(void *arg, __unused wait_result_t wr)
+{
+	struct walk_job *job = arg;
+	struct census cs;
+	uint64_t start, end, ns = 0, hash_ns = 0;
+
+	bzero(&cs, sizeof(cs));
+	cs.ctx = vfs_context_kernel();
+	census_options(&cs);
+	PE_parse_boot_argn("apfs_depth", &cs.max_depth, sizeof(cs.max_depth));
+	PE_parse_boot_argn("apfs_max", &cs.max_entries, sizeof(cs.max_entries));
+	{
+		static char skip[256];
+
+		if (PE_parse_boot_arg_str("apfs_skip", skip, sizeof(skip)) && skip[0] != '\0') {
+			cs.skip = skip;
+			printf("apfs-check: staying out of %s\n", skip);
+		}
+	}
+	cs.lookup_flags = VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT;
+	cs.path = kalloc_data(PATH_CAP, Z_WAITOK | Z_ZERO);
+	cs.buf = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (cs.path == NULL || cs.buf == NULL) {
+		printf("apfs-check: reader %d: out of memory\n", job->index);
+		OSDecrementAtomic(&apfs_check_running);
+		return;
+	}
+	start = mach_absolute_time();
+	census_dir(&cs);
+	end = mach_absolute_time();
+	absolutetime_to_nanoseconds(end - start, &ns);
+	absolutetime_to_nanoseconds(cs.hash_ticks, &hash_ns);
+
+	job->ms = ns / 1000000;
+	job->entries = cs.entries;
+	job->bytes = cs.bytes;
+	job->sum = cs.sum;
+	job->errors = cs.errors;
+	printf("apfs-check: reader %d: %llu entries  %llu bytes  sum %016llx  errors %u  "
+	    "%llu ms  hash %s%llu ms\n", job->index, cs.entries, cs.bytes,
+	    (unsigned long long)cs.sum, cs.errors, job->ms, cs.no_hash ? "off " : "",
+	    hash_ns / 1000000);
+
+	kfree_data(cs.path, PATH_CAP);
+	kfree_data(cs.buf, READ_CHUNK);
+	OSDecrementAtomic(&apfs_check_running);
+}
+
+/*
+ * Several readers at once over the same volume.  What is wanted is not only that nothing
+ * breaks but what the lock costs: all of apfs_lib runs under one mutex, so the part of the
+ * work that is held time cannot go faster however many processors there are.
+ */
+static void
+apfs_check_concurrent(void)
+{
+	uint32_t want = 4;
+	uint64_t start, end, ns = 0;
+	uint64_t total_bytes = 0, total_entries = 0;
+	int i, n, bad = 0;
+
+	if (PE_parse_boot_argn("apfs_threads", &want, sizeof(want)) == 0 || want == 0) {
+		want = 4;
+	}
+	if (want > MAX_THREADS) {
+		want = MAX_THREADS;
+	}
+	n = (int)want;
+	printf("apfs-check: %d readers over the root filesystem at once\n", n);
+
+	bzero(apfs_jobs, sizeof(apfs_jobs));
+	apfs_check_running = n;
+	start = mach_absolute_time();
+	for (i = 0; i < n; i++) {
+		thread_t th;
+
+		apfs_jobs[i].index = i;
+		if (kernel_thread_start(apfs_walk_one, &apfs_jobs[i], &th) != KERN_SUCCESS) {
+			printf("apfs-check: cannot start reader %d\n", i);
+			OSDecrementAtomic(&apfs_check_running);
+			continue;
+		}
+		thread_deallocate(th);
+	}
+	while (apfs_check_running > 0) {
+		delay_for_interval(50, NSEC_PER_MSEC);
+	}
+	end = mach_absolute_time();
+	absolutetime_to_nanoseconds(end - start, &ns);
+
+	for (i = 0; i < n; i++) {
+		total_bytes += apfs_jobs[i].bytes;
+		total_entries += apfs_jobs[i].entries;
+		if (apfs_jobs[i].sum != apfs_jobs[0].sum ||
+		    apfs_jobs[i].entries != apfs_jobs[0].entries || apfs_jobs[i].errors != 0) {
+			bad++;
+		}
+	}
+	printf("apfs-check: %d readers done in %llu ms\n", n, ns / 1000000);
+	printf("apfs-check: together %llu entries  %llu bytes  %llu KB/s\n", total_entries,
+	    total_bytes, ns ? (total_bytes * 1000000ull) / ns : 0);
+	printf("apfs-check: readers that disagreed or failed: %d\n", bad);
+	apfs_stats_print();
+}
+
+/* ------------------------------------------- apfs_check=7: the kernel's own write, on a device */
+
+/*
+ * The one place bsd/miscfs/apfs/apfs_write.c is run inside the kernel.  It is not VFS: there is
+ * no vnop_write and this milestone does not call for one.  It is apfs_lib and apfs_write on a
+ * real block device, which is the step between the tests on the build machine
+ * (tools/apfs/write-tests.sh) and anything on the phone's flash.
+ *
+ *   apfs_check=7
+ *   apfs_dev=md0              the container to write in (default rvblk0)
+ *   apfs_write_path=/redwood/x   the file in it, by path from the volume's root
+ *   apfs_write_at=N           where in the file (default 0)
+ *   apfs_write_len=N          how many bytes (default 4096, at most APFS_WRITE_MAX)
+ *   apfs_write_byte=N         what to fill them with (default 0xa5)
+ *
+ * The container is opened, written and closed; then opened again from nothing and the file read
+ * back, so what is reported came off the device and not out of apfs_lib's block cache.  The
+ * device is opened for writing here and nowhere else: every mount of this driver leaves
+ * dev.write NULL, and without it apfs_write_in_place refuses everything.
+ *
+ * Where this can reach, which is the point: a block device.  The phone's flash is not one under
+ * this kernel -- it is read through the loader's mailbox and, on the branch that writes to it at
+ * all, through a character device of its own with its own bounds (drivers/storage/hakios.ufs.c) -- so
+ * nothing here can touch it.  In QEMU and on the phone alike the only block devices are RAM
+ * disks.  And it happens at all only when asked for twice over: apfs_check=7 and a path.
+ */
+#define APFS_WRITE_MAX (1u << 20)
+
+struct wdev {
+	vnode_t  vp;
+	uint32_t devblock;
+};
+
+static int
+wdev_io(struct wdev *w, uint64_t off, void *buf, size_t len, int flag)
+{
+	char *p = buf;
+
+	if ((off % w->devblock) != 0 || (len % w->devblock) != 0) {
+		return EINVAL;
+	}
+	while (len > 0) {
+		size_t n = len < (128u << 10) ? len : (128u << 10);
+		buf_t bp = buf_alloc(w->vp);
+		int error;
+
+		if (bp == NULL) {
+			return ENOMEM;
+		}
+		buf_reset(bp, flag);
+		buf_setblkno(bp, (daddr64_t)(off / w->devblock));
+		buf_setlblkno(bp, (daddr64_t)(off / w->devblock));
+		buf_setcount(bp, (uint32_t)n);
+		buf_setdataptr(bp, (uintptr_t)p);
+		/*
+		 * A write buffer of our own has to be counted against the device's vnode before
+		 * it is issued: buf_biodone() undoes that count, and without it the kernel
+		 * panics on the way back (vnode_writedone: numoutput < 0).  This is what
+		 * cluster_io() does for the same kind of raw buffer.
+		 */
+		if (flag != B_READ) {
+			vnode_startwrite(w->vp);
+		}
+		error = VNOP_STRATEGY(bp);
+		if (error == 0) {
+			error = (int)buf_biowait(bp);
+		}
+		if (error == 0 && (buf_resid(bp) != 0 || buf_count(bp) != n)) {
+			error = EIO;
+		}
+		buf_free(bp);
+		if (error) {
+			return error;
+		}
+		p += n;
+		off += n;
+		len -= n;
+	}
+	return 0;
+}
+
+static int
+wdev_read(void *ctx, uint64_t off, void *buf, size_t len)
+{
+	return wdev_io(ctx, off, buf, len, B_READ);
+}
+
+static int
+wdev_write(void *ctx, uint64_t off, const void *buf, size_t len)
+{
+	return wdev_io(ctx, off, (void *)(uintptr_t)buf, len, B_WRITE);
+}
+
+/* The volume a path names, and the inode in it; the first volume with a root directory. */
+static int
+wdev_open_volume(struct apfs_nx *nx, struct apfs_vol *vol)
+{
+	uint32_t i;
+
+	for (i = 0; i < APFS_NX_MAX_FILE_SYSTEMS; i++) {
+		struct apfs_inode ino;
+
+		if (nx->fs_oid[i] == 0 || apfs_vol_open(nx, i, vol) != 0) {
+			continue;
+		}
+		if (apfs_inode_get(vol, APFS_ROOT_DIR_INO_NUM, &ino) == 0) {
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+/* The FNV-1a of a file's contents as the census lines use it, read through apfs_lib. */
+static int
+wdev_hash(struct apfs_vol *vol, const struct apfs_inode *ino, uint8_t *buf, size_t buflen,
+    uint64_t *out)
+{
+	struct apfs_cfile cf;
+	uint64_t h = FNV_INIT, off = 0;
+
+	bzero(&cf, sizeof(cf));
+	while (off < ino->size) {
+		size_t want = (size_t)(ino->size - off), got = 0, i;
+
+		if (want > buflen) {
+			want = buflen;
+		}
+		if (apfs_read_file(vol, ino, &cf, off, buf, want, &got) != 0 || got == 0) {
+			apfs_cfile_fini(&cf);
+			return EIO;
+		}
+		for (i = 0; i < got; i++) {
+			h ^= buf[i];
+			h *= FNV_PRIME;
+		}
+		off += got;
+	}
+	apfs_cfile_fini(&cf);
+	*out = h;
+	return 0;
+}
+
+static void
+apfs_write_check(const char *devname)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct apfs_nx nx;
+	struct apfs_vol vol;
+	struct apfs_inode ino;
+	struct apfs_write_report rep;
+	struct apfs_dev dev;
+	struct wdev w = { NULLVP, 0 };
+	char path[256] = "";
+	uint8_t *data = NULL, *scratch = NULL, *was = NULL;
+	uint64_t at = 0, before = 0, after = 0, want = 0, file_id = 0, was_len = 0;
+	uint32_t len = 4096, byte = 0xa5;
+	const char *why = NULL;
+	bool opened = false, nx_open = false;
+	int error, tries;
+
+	if (!PE_parse_boot_arg_str("apfs_write_path", path, sizeof(path)) || path[0] != '/') {
+		printf("apfs-write: apfs_write_path=/some/file says which file to write\n");
+		return;
+	}
+	PE_parse_boot_argn("apfs_write_at", &at, sizeof(at));
+	PE_parse_boot_argn("apfs_write_len", &len, sizeof(len));
+	PE_parse_boot_argn("apfs_write_byte", &byte, sizeof(byte));
+	if (len == 0 || len > APFS_WRITE_MAX) {
+		printf("apfs-write: apfs_write_len=%u is not between 1 and %u\n", len, APFS_WRITE_MAX);
+		return;
+	}
+
+	for (tries = 0; tries < 100; tries++) {
+		if (vnode_lookup(devname, 0, &w.vp, ctx) == 0) {
+			break;
+		}
+		delay_for_interval(20, NSEC_PER_MSEC);
+	}
+	if (w.vp == NULLVP) {
+		printf("apfs-write: %s never showed up in /dev\n", devname);
+		return;
+	}
+	/* for writing, which is what no mount of this driver ever asks for */
+	error = VNOP_OPEN(w.vp, FREAD | FWRITE, ctx);
+	if (error) {
+		printf("apfs-write: %s will not open for writing: %d\n", devname, error);
+		goto out;
+	}
+	opened = true;
+	if (VNOP_IOCTL(w.vp, DKIOCGETBLOCKSIZE, (caddr_t)&w.devblock, 0, ctx) != 0 ||
+	    w.devblock == 0 || (4096 % w.devblock) != 0) {
+		printf("apfs-write: %s has no usable block size\n", devname);
+		goto out;
+	}
+	data = kalloc_data(len, Z_WAITOK);
+	scratch = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (data == NULL || scratch == NULL) {
+		printf("apfs-write: out of memory\n");
+		goto out;
+	}
+	memset(data, (int)(byte & 0xff), len);
+
+	memset(&dev, 0, sizeof(dev));
+	dev.ctx = &w;
+	dev.read = wdev_read;
+	dev.read_data = wdev_read;
+	dev.write = wdev_write;
+	error = apfs_nx_open(&nx, &dev);
+	if (error) {
+		printf("apfs-write: %s is not a container we can read: %d\n", devname, error);
+		goto out;
+	}
+	nx_open = true;
+	error = wdev_open_volume(&nx, &vol);
+	if (error) {
+		printf("apfs-write: %s has no volume with a root directory\n", devname);
+		goto out;
+	}
+	if (apfs_write_volume_ok(&vol, &why) != 0) {
+		printf("apfs-write: volume %s will not be written: %s\n", vol.name, why);
+		goto out;
+	}
+	error = apfs_path_lookup(&vol, path, &file_id, NULL);
+	if (error) {
+		printf("apfs-write: %s: no such path in %s: %d\n", path, vol.name, error);
+		goto out;
+	}
+	error = apfs_inode_get(&vol, file_id, &ino);
+	if (error == 0) {
+		error = wdev_hash(&vol, &ino, scratch, READ_CHUNK, &before);
+	}
+	if (error) {
+		printf("apfs-write: %s cannot be read before the write: %d\n", path, error);
+		goto out;
+	}
+	printf("apfs-write: %s on %s, inode %llu, %llu bytes, hash %016llx\n", path, vol.name,
+	    file_id, ino.size, before);
+	/*
+	 * The file as it is now, kept so that what it should hold afterwards can be worked out
+	 * from it rather than from the result -- which would prove nothing.
+	 */
+	if (ino.size <= APFS_WRITE_MAX) {
+		struct apfs_cfile cf;
+		size_t got = 0;
+
+		bzero(&cf, sizeof(cf));
+		was_len = ino.size;
+		was = kalloc_data((vm_size_t)was_len, Z_WAITOK);
+		if (was != NULL &&
+		    (apfs_read_file(&vol, &ino, &cf, 0, was, (size_t)was_len, &got) != 0 ||
+		    got != was_len)) {
+			kfree_data(was, (vm_size_t)was_len);
+			was = NULL;
+		}
+		apfs_cfile_fini(&cf);
+	}
+	if (was == NULL) {
+		printf("apfs-write: %s is too big to keep a copy of: only the hashes are reported\n",
+		    path);
+	}
+
+	error = apfs_write_in_place(&vol, file_id, at, data, len, &rep);
+	printf("apfs-write: %u bytes of 0x%02x at %llu: %s; %llu blocks from %llu, %llu of them "
+	    "patched whole, %llu writes\n", len, byte & 0xff, at,
+	    error == 0 ? "written" : (rep.why != NULL ? rep.why : "failed"), rep.blocks,
+	    rep.first_block, rep.partial, rep.calls);
+	apfs_nx_close(&nx);
+	nx_open = false;
+	if (error) {
+		goto out;
+	}
+
+	/*
+	 * Again from nothing: a container opened a second time shares no cache with the first,
+	 * so what comes back now is what is on the device.
+	 */
+	error = apfs_nx_open(&nx, &dev);
+	if (error == 0) {
+		nx_open = true;
+		error = wdev_open_volume(&nx, &vol);
+	}
+	if (error == 0) {
+		error = apfs_path_lookup(&vol, path, &file_id, NULL);
+	}
+	if (error == 0) {
+		error = apfs_inode_get(&vol, file_id, &ino);
+	}
+	if (error == 0) {
+		error = wdev_hash(&vol, &ino, scratch, READ_CHUNK, &after);
+	}
+	if (error) {
+		printf("apfs-write: the volume will not read back after the write: %d\n", error);
+		goto out;
+	}
+	if (was != NULL) {
+		uint64_t off;
+
+		want = FNV_INIT;
+		for (off = 0; off < was_len; off++) {
+			uint8_t b = (off >= at && off < at + len) ? (uint8_t)(byte & 0xff) : was[off];
+
+			want ^= b;
+			want *= FNV_PRIME;
+		}
+	}
+	printf("apfs-write: read back from a container opened again: %llu bytes, hash %016llx "
+	    "(was %016llx); the bytes written are %s\n", ino.size, after, before,
+	    was == NULL ? "not checked here" :
+	    (want == after ? "all there and nothing else changed" : "NOT what was asked for"));
+out:
+	if (nx_open) {
+		apfs_nx_close(&nx);
+	}
+	if (data != NULL) {
+		kfree_data(data, len);
+	}
+	if (scratch != NULL) {
+		kfree_data(scratch, READ_CHUNK);
+	}
+	if (was != NULL) {
+		kfree_data(was, (vm_size_t)was_len);
+	}
+	if (opened) {
+		(void)VNOP_CLOSE(w.vp, FREAD | FWRITE, ctx);
+	}
+	if (w.vp != NULLVP) {
+		vnode_put(w.vp);
+	}
+}
+
+/* -------------------------------------- apfs_check=8: the store, in the kernel, on a device */
+
+/*
+ * The store of fixed-length slot files (bsd/miscfs/apfs/apfs_store.c) run where it will live: in
+ * the kernel, on a block device, under the kernel's own allocator.  A payload of apfs_store_len
+ * bytes of a pattern this works out twice -- once to save, once to compare -- goes into the
+ * store on apfs_dev; then the container is opened again from nothing and the newest good slot is
+ * read back, so what is reported came off the device.
+ *
+ *   apfs_check=8
+ *   apfs_dev=md1              the store volume (default rvblk0); its name must be HakiosStore
+ *   apfs_store_len=N          how many bytes of payload (default 40000)
+ *   apfs_store_seed=N         which pattern (default 1); a different seed is a different payload
+ *   apfs_store_note=N         the writer's own number, kept in the header (default 0)
+ */
+#define APFS_STORE_TEST_MAX (4u << 20)
+
+static void
+store_pattern(uint8_t *buf, uint32_t len, uint32_t seed)
+{
+	uint32_t i;
+
+	for (i = 0; i < len; i++) {
+		buf[i] = (uint8_t)(i * (7 + seed) + 5 + seed);
+	}
+}
+
+static void
+apfs_store_check(const char *devname)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct apfs_nx nx;
+	struct apfs_vol vol;
+	struct apfs_store st;
+	struct apfs_store_head head;
+	struct apfs_store_write w;
+	struct apfs_dev dev;
+	struct wdev wd = { NULLVP, 0 };
+	uint8_t *data = NULL, *scratch = NULL;
+	uint32_t len = 40000, seed = 1;
+	uint64_t note = 0, want = FNV_INIT;
+	const char *why = NULL;
+	bool opened = false, nx_open = false;
+	int best, error, tries;
+	uint32_t i;
+
+	PE_parse_boot_argn("apfs_store_len", &len, sizeof(len));
+	PE_parse_boot_argn("apfs_store_seed", &seed, sizeof(seed));
+	PE_parse_boot_argn("apfs_store_note", &note, sizeof(note));
+	if (len == 0 || len > APFS_STORE_TEST_MAX) {
+		printf("apfs-store: apfs_store_len=%u is not between 1 and %u\n", len,
+		    APFS_STORE_TEST_MAX);
+		return;
+	}
+	for (tries = 0; tries < 100; tries++) {
+		if (vnode_lookup(devname, 0, &wd.vp, ctx) == 0) {
+			break;
+		}
+		delay_for_interval(20, NSEC_PER_MSEC);
+	}
+	if (wd.vp == NULLVP) {
+		printf("apfs-store: %s never showed up in /dev\n", devname);
+		return;
+	}
+	error = VNOP_OPEN(wd.vp, FREAD | FWRITE, ctx);
+	if (error) {
+		printf("apfs-store: %s will not open for writing: %d\n", devname, error);
+		goto out;
+	}
+	opened = true;
+	if (VNOP_IOCTL(wd.vp, DKIOCGETBLOCKSIZE, (caddr_t)&wd.devblock, 0, ctx) != 0 ||
+	    wd.devblock == 0 || (4096 % wd.devblock) != 0) {
+		printf("apfs-store: %s has no usable block size\n", devname);
+		goto out;
+	}
+	data = kalloc_data(len, Z_WAITOK);
+	scratch = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (data == NULL || scratch == NULL) {
+		printf("apfs-store: out of memory\n");
+		goto out;
+	}
+	store_pattern(data, len, seed);
+	for (i = 0; i < len; i++) {
+		want ^= data[i];
+		want *= FNV_PRIME;
+	}
+
+	memset(&dev, 0, sizeof(dev));
+	dev.ctx = &wd;
+	dev.read = wdev_read;
+	dev.read_data = wdev_read;
+	dev.write = wdev_write;
+	error = apfs_nx_open(&nx, &dev);
+	if (error) {
+		printf("apfs-store: %s is not a container we can read: %d\n", devname, error);
+		goto out;
+	}
+	nx_open = true;
+	error = wdev_open_volume(&nx, &vol);
+	if (error == 0) {
+		error = apfs_store_open(&vol, &st, &why);
+	}
+	if (error) {
+		printf("apfs-store: %s holds no store: %s\n", devname,
+		    why != NULL ? why : "cannot be opened");
+		goto out;
+	}
+	best = apfs_store_newest(&st, scratch, READ_CHUNK, &head);
+	printf("apfs-store: %s: %d slots of %llu bytes, %llu of payload; the newest good slot is "
+	    "%d%s\n", vol.name, (int)APFS_STORE_SLOTS, st.slot_bytes, st.payload_max, best,
+	    best < 0 ? " (none)" : "");
+
+	error = apfs_store_save(&st, data, len, 0, note, scratch, READ_CHUNK, &w);
+	printf("apfs-store: %u bytes into slot %d as generation %llu: %s; %llu blocks\n", len,
+	    w.slot, w.generation, error == 0 ? "saved" : "failed", w.blocks);
+	apfs_nx_close(&nx);
+	nx_open = false;
+	if (error) {
+		printf("apfs-store: the save failed: %d\n", error);
+		goto out;
+	}
+
+	/* again from nothing: no cache of the first opening survives into the second */
+	error = apfs_nx_open(&nx, &dev);
+	if (error == 0) {
+		nx_open = true;
+		error = wdev_open_volume(&nx, &vol);
+	}
+	if (error == 0) {
+		error = apfs_store_open(&vol, &st, &why);
+	}
+	if (error) {
+		printf("apfs-store: the store will not open again: %d\n", error);
+		goto out;
+	}
+	best = apfs_store_newest(&st, scratch, READ_CHUNK, &head);
+	if (best < 0) {
+		printf("apfs-store: after the save no slot holds anything good\n");
+		goto out;
+	}
+	printf("apfs-store: read back from a container opened again: slot %d, generation %llu, "
+	    "%llu bytes, note %llu, sum %016llx; the payload is %s\n", best, head.generation,
+	    head.bytes, head.note, head.sum,
+	    (head.bytes == len && head.sum == want) ? "the one that was saved" :
+	    "NOT what was saved");
+out:
+	if (nx_open) {
+		apfs_nx_close(&nx);
+	}
+	if (data != NULL) {
+		kfree_data(data, len);
+	}
+	if (scratch != NULL) {
+		kfree_data(scratch, READ_CHUNK);
+	}
+	if (opened) {
+		(void)VNOP_CLOSE(wd.vp, FREAD | FWRITE, ctx);
+	}
+	if (wd.vp != NULLVP) {
+		vnode_put(wd.vp);
+	}
+}
+
+static void
+apfs_check_thread(void *arg, __unused wait_result_t wr)
+{
+	uint32_t mode = (uint32_t)(uintptr_t)arg;
+	vfs_context_t ctx = vfs_context_kernel();
+	struct census cs;
+	char devname[64] = CHECK_DEV;
+	char subtree[256] = "";
+	uint64_t start, end;
+	int error, tries;
+
+	bzero(&cs, sizeof(cs));
+	cs.ctx = ctx;
+	census_options(&cs);
+	cs.print_lines = (mode == 2);
+	/*
+	 * NOCROSSMOUNT only where the volume is the root (modes 4 and 5).  In mode 6 the
+	 * path leads from the root image into the mount, so crossing has to be allowed; the
+	 * walk is kept on the volume by the check against the mount it started on.
+	 */
+	PE_parse_boot_argn("apfs_depth", &cs.max_depth, sizeof(cs.max_depth));
+	PE_parse_boot_argn("apfs_max", &cs.max_entries, sizeof(cs.max_entries));
+	{
+		static char skip[256];
+
+		if (PE_parse_boot_arg_str("apfs_skip", skip, sizeof(skip)) && skip[0] != '\0') {
+			cs.skip = skip;
+			printf("apfs-check: staying out of %s\n", skip);
+		}
+	}
+	cs.lookup_flags = VNODE_LOOKUP_NOFOLLOW |
+	    ((mode == 4 || mode == 5) ? VNODE_LOOKUP_NOCROSSMOUNT : 0);
+	if (PE_parse_boot_arg_str("apfs_dev", subtree, sizeof(subtree)) && subtree[0] != '\0') {
+		snprintf(devname, sizeof(devname), "/dev/%s", subtree);
+	}
+	subtree[0] = '\0';
+
+	/* the modes that write: no walk, no mount, no census */
+	if (mode == 7) {
+		apfs_write_check(devname);
+		return;
+	}
+	if (mode == 8) {
+		apfs_store_check(devname);
+		return;
+	}
+
+	cs.path = kalloc_data(PATH_CAP, Z_WAITOK | Z_ZERO);
+	cs.buf = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (cs.path == NULL || cs.buf == NULL) {
+		printf("apfs-check: out of memory\n");
+		return;
+	}
+
+	if (mode == 6) {
+		char mnt[128] = CHECK_MNT;
+
+		if (PE_parse_boot_arg_str("apfs_mnt", subtree, sizeof(subtree)) &&
+		    subtree[0] == '/') {
+			strlcpy(mnt, subtree, sizeof(mnt));
+		}
+		subtree[0] = '\0';
+		/*
+		 * A node just made with devfs_make_node() is not in /dev the instant it is
+		 * made -- this runs straight after the device registered itself, and the first
+		 * lookup comes back ENOENT -- so wait for it rather than guess how long devfs
+		 * takes to show it.
+		 */
+		{
+			vnode_t t = NULLVP;
+			int tries;
+
+			for (tries = 0; tries < 100; tries++) {
+				if (vnode_lookup(devname, 0, &t, ctx) == 0) {
+					vnode_put(t);
+					break;
+				}
+				delay_for_interval(20, NSEC_PER_MSEC);
+			}
+			if (tries >= 100) {
+				printf("apfs-check: %s never showed up in /dev\n", devname);
+			} else if (tries > 0) {
+				printf("apfs-check: %s showed up in /dev after %d ms\n", devname,
+				    tries * 20);
+			}
+		}
+		error = kernel_mount("apfs", NULLVP, NULLVP, mnt, devname, 0,
+		    MNT_RDONLY | MNT_DONTBROWSE, KERNEL_MOUNT_NOAUTH, ctx);
+		if (error) {
+			printf("apfs-check: mounting %s on %s failed: %d\n", devname, mnt,
+			    error);
+			kfree_data(cs.path, PATH_CAP);
+			kfree_data(cs.buf, READ_CHUNK);
+			return;
+		}
+		printf("apfs-check: %s mounted on %s\n", devname, mnt);
+		cs.rel = strlen(mnt);
+		strlcpy(cs.path, mnt, PATH_CAP);
+		cs.len = cs.rel;
+		if (PE_parse_boot_arg_str("apfs_subtree", subtree, sizeof(subtree)) &&
+		    subtree[0] == '/') {
+			strlcat(cs.path, subtree, PATH_CAP);
+			cs.len = strlen(cs.path);
+			printf("apfs-check: walking %s\n", cs.path + cs.rel);
+		} else {
+			printf("apfs-check: walking the whole volume\n");
+		}
+		goto walk;
+	}
+	if (mode >= 5) {
+		kfree_data(cs.path, PATH_CAP);
+		kfree_data(cs.buf, READ_CHUNK);
+		apfs_check_concurrent();
+		return;
+	}
+	if (mode >= 4 && mode != 6) {
+		/*
+		 * The volume is already the root: nothing to mount, and no mount point to
+		 * make, so none of what follows about /private/var applies.
+		 */
+		cs.rel = 0;
+		cs.len = 0;
+		cs.path[0] = '\0';
+		printf("apfs-check: walking the root filesystem\n");
+		goto walk;
+	}
+
+	/*
+	 * /private/var is a ramfs that userland's init mounts, so the mount point cannot be
+	 * made until that has happened.  Wait for it rather than guess how long it takes.
+	 */
+	for (tries = 0; tries < 180; tries++) {
+		error = make_mount_point(ctx);
+		if (error == 0) {
+			break;
+		}
+		delay_for_interval(500, NSEC_PER_MSEC);
+	}
+	if (error) {
+		printf("apfs-check: cannot make %s: %d\n", CHECK_MNT, error);
+		return;
+	}
+
+	/*
+	 * The mount data is the device's path itself, not a pointer to it: the extra
+	 * indirection imageboot_pivot_image() uses is unpacked only on the BaseSystem path,
+	 * which this build does not have, so apfs_mount() reads the string straight off
+	 * this pointer.
+	 */
+	error = kernel_mount("apfs", NULLVP, NULLVP, CHECK_MNT, devname, 0,
+	    MNT_RDONLY | MNT_DONTBROWSE, KERNEL_MOUNT_NOAUTH, ctx);
+	if (error) {
+		printf("apfs-check: mounting %s on %s failed: %d\n", devname, CHECK_MNT,
+		    error);
+		return;
+	}
+	printf("apfs-check: %s mounted on %s\n", devname, CHECK_MNT);
+	if (mode >= 3) {
+		/* someone in user space is going to read it; leave it alone */
+		printf("apfs-check: left mounted, not walking it here\n");
+		return;
+	}
+
+	cs.rel = sizeof(CHECK_MNT) - 1;
+	strlcpy(cs.path, CHECK_MNT, PATH_CAP);
+	cs.len = cs.rel;
+	if (PE_parse_boot_arg_str("apfs_subtree", subtree, sizeof(subtree)) &&
+	    subtree[0] == '/') {
+		strlcat(cs.path, subtree, PATH_CAP);
+		cs.len = strlen(cs.path);
+		while (cs.len > cs.rel && cs.path[cs.len - 1] == '/') {
+			cs.path[--cs.len] = '\0';
+		}
+		printf("apfs-check: walking %s\n", cs.path + cs.rel);
+	} else {
+		printf("apfs-check: walking the whole volume\n");
+	}
+
+walk:
+	hakios_ufs_report("before the walk");
+	start = mach_absolute_time();
+	cs.t0 = start;
+	watch_start(&cs);
+	{
+		uint32_t walkers = 1;
+
+		PE_parse_boot_argn("apfs_walkers", &walkers, sizeof(walkers));
+		if (mode == 6 && walkers > 1) {
+			par_walk(&cs, walkers > PAR_MAX ? PAR_MAX : walkers);
+		} else {
+			uint64_t cpu0 = thread_get_runtime_self(), wall0 = mach_absolute_time();
+
+			census_dir(&cs);
+			cs.t_cpu = thread_get_runtime_self() - cpu0;
+			cs.t_wall = mach_absolute_time() - wall0;
+			census_times(&cs, 0);
+		}
+	}
+	watch_stop();
+	end = mach_absolute_time();
+
+	{
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(end - start, &ns);
+		printf("apfs-check: done in %llu ms\n", ns / 1000000);
+	}
+	printf("apfs-check: entries %llu  dirs %llu  files %llu  symlinks %llu  other %llu\n",
+	    cs.entries, cs.dirs, cs.files, cs.links, cs.others);
+	printf("apfs-check: content bytes %llu\n", cs.bytes);
+	printf("apfs-check: line-hash sum %016llx\n", (unsigned long long)cs.sum);
+	printf("apfs-check: errors %u\n", cs.errors);
+	{
+		uint64_t hash_ns = 0;
+
+		absolutetime_to_nanoseconds(cs.hash_ticks, &hash_ns);
+		printf("apfs-check: of it the checker's own hashing %llu ms%s\n", hash_ns / 1000000,
+		    cs.no_hash ? " (apfs_hash=0)" : "");
+	}
+	apfs_stats_print();
+	hakios_sparse_report();
+	hakios_ufs_report("after the walk");
+	printf("apfs-check: compare with tools/apfs/verify.py sum\n");
+
+	kfree_data(cs.path, PATH_CAP);
+	kfree_data(cs.buf, READ_CHUNK);
+}
+
+static volatile int apfs_check_finished;
+
+static void
+apfs_check_runner(void *arg, wait_result_t wr)
+{
+	apfs_check_thread(arg, wr);
+	apfs_check_finished = 1;
+}
+
+/*
+ * sysctl kern.hakios_switch_root="INCOMING OUTGOING": the volume mounted on INCOMING
+ * becomes the root, and what was the root until now is mounted on OUTGOING inside it (a
+ * path without a leading slash, which must be a directory there -- on the Darwin volume, a
+ * synthetic one).  devfs stays on /dev (vfs_switch_root() keeps it there).  This is how
+ * the Darwin root volume on the phone's flash becomes the root: the kernel starts from the
+ * small image, whose init mounts the volume, puts in place what the system needs on it
+ * and then asks for this (userland/src/init.c, boot-arg root_apfs=).  Process 1 only, once.
+ */
+static int hakios_root_switched;
+
+static int
+hakios_sysctl_switch_root SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[512], *outgoing;
+	int error;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, hakios_root_switched ? "1" : "0", 2);
+	}
+	if (proc_getpid(current_proc()) != 1 || suser(kauth_cred_get(), NULL) != 0) {
+		return EPERM;
+	}
+	if (hakios_root_switched) {
+		return EBUSY;
+	}
+	if (req->newlen == 0 || req->newlen >= sizeof(buf)) {
+		return EINVAL;
+	}
+	error = SYSCTL_IN(req, buf, req->newlen);
+	if (error) {
+		return error;
+	}
+	buf[req->newlen] = '\0';
+	outgoing = strchr(buf, ' ');
+	if (outgoing == NULL || buf[0] != '/') {
+		return EINVAL;
+	}
+	*outgoing++ = '\0';
+	error = vfs_switch_root(buf, outgoing, 0);
+	printf("hakios: %s is the root now, the one before it on /%s: %d\n", buf, outgoing, error);
+	if (error == 0) {
+		hakios_root_switched = 1;
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, hakios_switch_root, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, hakios_sysctl_switch_root, "A",
+    "write \"INCOMING OUTGOING\": the volume on INCOMING becomes the root (process 1, once)");
+
+/*
+ * apfs_volume=DEV: a volume for user space in an ordinary boot.  Mounted read only (and
+ * nosuid, nodev) on apfs_volume_at -- by default /System/Volumes/Darwin, which the system image
+ * has for it (userland/build.sh) -- right here, after the root and devfs and before launchd,
+ * so that all of user space sees it from the start.  apfs_volume=ufs_darwin is the Darwin root
+ * container on the phone's flash (ufs=2 for the loader, bootcpu=7).
+ */
+static void
+apfs_volume_mount(void)
+{
+	char dev[48], at[256] = "/System/Volumes/Darwin", path[64];
+	vfs_context_t ctx = vfs_context_kernel();
+	uint64_t t0, ns = 0;
+	vnode_t vp = NULLVP;
+	int error, tries;
+
+	if (!PE_parse_boot_arg_str("apfs_volume", dev, sizeof(dev)) || dev[0] == '\0') {
+		return;
+	}
+	(void)PE_parse_boot_arg_str("apfs_volume_at", at, sizeof(at));
+	snprintf(path, sizeof(path), "/dev/%s", dev);
+	/* a node devfs_make_node() has just made is not in /dev at once (see apfs_check_thread) */
+	for (tries = 0; tries < 100; tries++) {
+		if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+			vnode_put(vp);
+			break;
+		}
+		delay_for_interval(50, NSEC_PER_MSEC);
+	}
+	t0 = mach_absolute_time();
+	error = kernel_mount("apfs", NULLVP, NULLVP, at, path, 0,
+	    MNT_RDONLY | MNT_NOSUID | MNT_NODEV, KERNEL_MOUNT_NOAUTH, ctx);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (error) {
+		printf("apfs: mounting %s on %s failed: %d\n", path, at, error);
+	} else {
+		printf("apfs: %s mounted on %s, read only, in %llu ms\n", path, at, ns / 1000000);
+	}
+}
+
+void
+hakios_apfs_check_init(void)
+{
+	uint32_t mode = 0;
+	thread_t th;
+
+	apfs_volume_mount();
+
+	if (!PE_parse_boot_argn("apfs_check", &mode, sizeof(mode)) || mode == 0) {
+		return;
+	}
+	if (mode >= 4) {
+		/*
+		 * The volume is the root (or mode 6, which mounts it here), and bsd_init is
+		 * about to exec /sbin/launchd off it, which on anything but an image of ours
+		 * (stage0 as /sbin/launchd) ends in a panic.  So the walk has to be over before this returns.
+		 *
+		 * It does not run on this thread, though.  This is the boot thread: it runs
+		 * above the threads that service thread calls, and a walk off a RAM disk never
+		 * blocks, so for as long as it lasts no thread call runs at all -- not even
+		 * the one that feeds the phone's watchdog every ten seconds.  On the phone a
+		 * walk past half a minute was reset with no log to say why; in QEMU, which
+		 * has no such watchdog, the same walk let not one 6-second timer fire in 72 s.
+		 * So the walk gets a thread of ordinary priority, and this one sleeps until
+		 * it is done.
+		 */
+		thread_t th;
+
+		apfs_check_finished = 0;
+		if (kernel_thread_start(apfs_check_runner, (void *)(uintptr_t)mode, &th) !=
+		    KERN_SUCCESS) {
+			printf("apfs-check: cannot start the thread\n");
+			return;
+		}
+		thread_deallocate(th);
+		while (!apfs_check_finished) {
+			delay_for_interval(100, NSEC_PER_MSEC);     /* sleeps */
+		}
+		printf("apfs-check: going back to the loader\n");
+		loader_return();
+		return;
+	}
+	if (kernel_thread_start(apfs_check_thread, (void *)(uintptr_t)mode, &th) !=
+	    KERN_SUCCESS) {
+		printf("apfs-check: cannot start the thread\n");
+		return;
+	}
+	thread_deallocate(th);
+}
diff --git a/bsd/dev/hakios.apple80211.c b/bsd/dev/hakios.apple80211.c
new file mode 100644
index 0000000..62662f7
--- /dev/null
+++ b/bsd/dev/hakios.apple80211.c
@@ -0,0 +1,739 @@
+/*
+ * Darwin-on-hakios: Apple80211, answered in the kernel.
+ *
+ * Darwin's Wi-Fi side -- wifid, and through it Settings and the status bar -- talks to a Wi-Fi
+ * driver in requests that were once ioctls and are, where the driver offers no user client,
+ * ioctls still: SIOCGA80211 and SIOCSA80211 on any socket, with a struct apple80211req that
+ * names the interface, a request type, a value, and a buffer in the caller's memory
+ * (IO80211.framework: Apple80211Get/Set and their kin all end there). XNU hands an interface
+ * ioctl it does not know to the interface, so they arrive in drivers/net/hakios.net.c, which
+ * passes them here when its link is a radio.
+ *
+ * What is asked is answered from the station boundary (sys/hakios.sta.h): the radio's power,
+ * its channels, a scan and what it heard, the network joined. What happens there by itself is
+ * told to Darwin the way a driver tells it: kernel events of class 6 (IEEE 802.11), subclass 1,
+ * whose code is Apple80211's own event number and whose data begins with the interface's name
+ * in 16 bytes (IO80211.framework reads them from a PF_SYSTEM socket and compares the name).
+ *
+ * Every request is still written to the log -- who asks, get or set, the type, the value, the
+ * length -- because which of them wifid needs is found that way. Never what a request carries:
+ * a network's name or its key may be in there.
+ *
+ * The request types and the layouts are Apple's. The old ones are as the headers of its open
+ * IO80211 sources once described them (apple80211_ioctl.h, apple80211_var.h); where Darwin userland 16.5
+ * differs the layout was read out of IO80211.framework of 16.5, which fills and reads the same
+ * structures on the other side (Apple80211GetWithIOCTL, _getScanData, _addScanResultToList,
+ * _performAssociation, _dispatchAsyncAssocEvent, _dispatchLinkChangedEvent).
+ *
+ * A join: ASSOCIATE (20) carries the network's name, perhaps its access point, and the
+ * passphrase as typed (the framework does not make the key of it), and is answered at once;
+ * when the station has joined or failed, event 9 says so, and ASSOCIATE_RESULT (21) gives the
+ * outcome as one of Apple80211's result numbers, which the framework turns into its errors:
+ * 1 success, 21 "invalid PMK" (a wrong passphrase), 9 a timeout, 2 anything else.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.net.h>
+#include <sys/hakios.sta.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+/* (as far as they have come by: the names help reading the log) */
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts ------------------------------------------------------------------------------------------ */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27) and HW_SUPPORTED_CHANNELS (254): 4824 bytes */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): 10016 bytes; of each channel a byte in each of several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10): 5456 bytes */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;                     /* 1: asking, 2: listening only */
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;                    /* networks asked for by name, each in 56 bytes */
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11) and CURRENT_NETWORK (103): 1164 bytes */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20): 592 bytes; of what follows the key (the RSN element wifid built, flags) nothing is used */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* cipher 10: a passphrase as typed; 6: the key (from 64 hex digits) */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+
+/* the link event's data (at least 32 bytes, or the framework drops the event) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as Darwin userland 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as Darwin userland 16.5 has it");
+
+/* Apple80211's events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = "en0";   /* (drivers/net/hakios.net.c makes one interface, and that is its name) */
+
+static LCK_GRP_DECLARE(apple80211_lock_group, "hakios-apple80211");
+static LCK_MTX_DECLARE(apple80211_lock, &apple80211_lock_group);
+static unsigned result_next;                    /* which of what the last scan heard a SCAN_RESULT request gets next */
+static uint32_t join_result;                    /* of the last join asked for: 0 while it runs, then Apple80211's number */
+
+/* ---- channels ---------------------------------------------------------------------------------------- */
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static unsigned
+channel_frequency(const struct apple80211_channel *channel)
+{
+	bool low = channel->flags & CHANNEL_2GHZ ? true : channel->flags & CHANNEL_5GHZ ? false : channel->channel <= 14;
+
+	if (channel->channel == 0 || channel->channel > 196 || (channel->flags & 0x2000)) {     /* (0x2000: 6 GHz) */
+		return 0;
+	}
+	return low ? (channel->channel == 14 ? 2484 : 2407 + 5 * channel->channel) : 5000 + 5 * channel->channel;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency, unsigned flags)
+{
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (flags & HAKIOS_STA_CHANNEL_PASSIVE ?
+	    0 : CHANNEL_ACTIVE) | (flags & HAKIOS_STA_CHANNEL_RADAR ? CHANNEL_DFS : 0);
+}
+
+/* ---- what the caller is given back ------------------------------------------------------------------- */
+
+/* At most as many bytes as it has room for. */
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+/* An access point in the form a scan's result has; the caller has said how much room for elements there is. */
+static int
+give_network(const struct apple80211req *request, const struct hakios_sta_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->frequency, 0);
+	result->rssi = bss->rssi;
+	result->beacon_interval = bss->beacon_interval;
+	result->capability = bss->capability;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = bss->ssid_length;
+	memcpy(result->ssid, bss->ssid, bss->ssid_length);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->elements_length <= room ? bss->elements_length : 0);
+	memcpy(result->elements, bss->elements, result->elements_length);
+	/* the rates it says it has (elements 1 and 50: units of 500 kbit/s, the top bit marks the ones everybody must have) */
+	for (unsigned at = 0; at + 2 <= bss->elements_length && at + 2 + bss->elements[at + 1] <= bss->elements_length;
+	    at += 2 + bss->elements[at + 1]) {
+		for (unsigned i = 0; (bss->elements[at] == 1 || bss->elements[at] == 50) && i < bss->elements[at + 1]; i++) {
+			unsigned rate = (bss->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* ---- get ---------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct hakios_sta_state *state;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
+		static const char name[256] = "hakios: ath11k for the WCN6750";
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * What the card can do, a bit each (apple80211_var.h: APPLE80211_CAP_*): the 13 bytes are the
+		 * bits alone, from the first (the framework hands in a buffer that begins after the old
+		 * header's version word). AES, AES-CCM, power management, short slot and preamble, WPA2, WME,
+		 * short guard interval at 20 MHz. Read wrong, the framework sees no WPA2 and builds no join
+		 * for a WPA2 network ("Unable to join").
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* the radio's power: one radio. Until the driver is up it counts as on: it */
+		struct {                        /* is being brought up, and Darwin asks this once, early */
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !hakios_sta_present() || hakios_sta_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* the mode: a station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 27:
+	case 254: {                             /* the channels the radio may tune to */
+		struct apple80211_channels *answer;
+		struct hakios_sta_channel channels[96];
+		unsigned count = hakios_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = count;
+		for (unsigned i = 0; i < count; i++) {
+			channel_fill(&answer->channels[i], channels[i].frequency, channels[i].flags);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {                             /* ... and more of each */
+		struct apple80211_channels_info *answer;
+		struct hakios_sta_channel channels[96];
+		unsigned count = hakios_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->count = (uint16_t)count;
+		for (unsigned i = 0; i < count; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channels[i].frequency, channels[i].flags);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = (channels[i].flags & HAKIOS_STA_CHANNEL_RADAR) != 0;
+			answer->passive[i] = (channels[i].flags & HAKIOS_STA_CHANNEL_PASSIVE) != 0;
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 21:                                /* how the last join went (0: not over yet) */
+		lck_mtx_lock(&apple80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&apple80211_lock);
+		return 0;
+	case 11: {                              /* what the last scan heard, one access point a request; EIO: that was all */
+		struct hakios_sta_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+		bool there;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&apple80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&apple80211_lock);
+		there = hakios_sta_heard(index, bss);
+		error = there ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined, and there is none unless the station says so */
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return ENOMEM;
+	}
+	hakios_sta_state(state);
+	switch (request->req_type) {
+	case 13:                                /* the state: APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = state->phase == HAKIOS_STA_JOINED ? 4 : state->phase == HAKIOS_STA_JOINING ? 2 :
+		    state->phase == HAKIOS_STA_SCANNING ? 1 : 0;
+		break;
+	case 1:                                 /* its name; the length goes back in the request */
+		if (state->phase != HAKIOS_STA_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, state->bss.ssid, state->bss.ssid_length)) == 0) {
+			request->req_len = state->bss.ssid_length;
+		}
+		break;
+	case 9:                                 /* its access point's address */
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, state->bss.bssid, 6);
+		break;
+	case 4: {                               /* its channel */
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (state->phase != HAKIOS_STA_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, state->bss.frequency, 0);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {                              /* how strongly it is heard: dBm, per radio and all together, twice over */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { state->bss.rssi }, .all = state->bss.rssi,
+			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
+
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:                               /* all of it, as a scan's result */
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give_network(request, &state->bss);
+		break;
+	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase */
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(state, sizeof(*state));
+	return error;
+}
+
+/* ---- set ---------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	struct hakios_sta_scan *what;
+	unsigned unknown = 0;
+	int error;
+
+	if (request->req_len != sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!hakios_sta_present()) {
+		return EBUSY;                   /* (the radio is still being brought up: the framework tries again) */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, sizeof(*asked))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	if (asked->ssid_length <= sizeof(what->ssid)) {
+		what->ssid_length = (uint8_t)asked->ssid_length;
+		memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	}
+	what->passive = asked->scan_type == 2;
+	what->dwell_ms = asked->dwell_ms;
+	/* (more channels than there is room to name: every channel) */
+	for (unsigned i = 0; i < asked->channel_count && i < 400 && asked->channel_count <= 64; i++) {
+		unsigned frequency = channel_frequency(&asked->channels[i]);
+
+		if (frequency != 0) {
+			what->frequencies[what->frequency_count++] = (uint16_t)frequency;
+		} else {
+			unknown++;
+		}
+	}
+	snprintf(said, said_size, " (a scan: type %u, %u channels of which %u are not the radio's, %u ms on each, a name of %u bytes, "
+	    "%u more names, flags %#llx)", asked->scan_type, asked->channel_count, unknown, asked->dwell_ms, asked->ssid_length,
+	    asked->name_count, asked->flags);
+	if (asked->channel_count != 0 && asked->channel_count <= 64 && what->frequency_count == 0) {
+		error = EINVAL;                 /* (nothing of what is asked for is a channel of this radio's) */
+	} else {
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		error = hakios_sta_ask_scan(what);
+	}
+out:
+	if (asked != NULL) {
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_assoc *asked;
+	struct hakios_sta_join *what;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	/* (lengths and kinds only: the name, the access point and the key stay out of the log) */
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5] ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > sizeof(what->ssid)) {
+		error = EINVAL;
+		goto out;
+	}
+	what->ssid_length = (uint8_t)asked->ssid_length;
+	memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	memcpy(what->bssid, asked->bssid, sizeof(what->bssid));
+	if (asked->key_length == 0) {
+		what->security = HAKIOS_STA_OPEN;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= 8 && asked->key_length <= 63) {
+		what->security = HAKIOS_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)asked->key_length;
+		memcpy(what->passphrase, asked->key, asked->key_length);
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == sizeof(what->pmk)) {
+		what->security = HAKIOS_STA_WPA2_PSK;
+		memcpy(what->pmk, asked->key, sizeof(what->pmk));
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&apple80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = hakios_sta_ask_join(what);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		memset_s(what, sizeof(*what), 0, sizeof(*what));
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:                                /* leave the network */
+		return hakios_sta_ask_leave();
+	case 19: {                              /* the radio's power */
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return hakios_sta_ask_power(asked.state[0] != 0);
+	}
+	case 10:
+		return set_scan(request, said, said_size);
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events -------------------------------------------------------------------------------------------- */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+/* What the station side says has happened (drivers/wifi/hakios.sta.c calls this, on its thread or the station's). */
+void
+hakios_apple80211_event(enum hakios_sta_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("apple80211: the station says: %s, %d\n", event == HAKIOS_STA_POWER ? "power" : event == HAKIOS_STA_SCAN_DONE ?
+		    "a scan is over" : event == HAKIOS_STA_JOIN_DONE ? "a join is over" : "the link", status);
+	}
+	switch (event) {
+	case HAKIOS_STA_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case HAKIOS_STA_SCAN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case HAKIOS_STA_JOIN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case HAKIOS_STA_LINK: {
+		struct apple80211_link_changed link = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };      /* (4: gone, not asked) */
+		struct hakios_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+
+		if (state != NULL) {
+			hakios_sta_state(state);
+			link.rssi = status == 1 ? state->bss.rssi : 0;
+			kfree_data(state, sizeof(*state));
+		}
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		break;
+	}
+	}
+}
+
+/* ---- the requests as they arrive --------------------------------------------------------------------- */
+
+/*
+ * How often each kind of request came and how it fared: said when the run ends, because the
+ * lines said along the way can be lost with the middle of a long log.
+ */
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+} kinds[96];
+static unsigned kind_count;
+
+static void
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	unsigned i;
+
+	lck_mtx_lock(&apple80211_lock);
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count++] = (typeof(kinds[0])) { .type = request->req_type, .set = is_set };
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+	}
+	lck_mtx_unlock(&apple80211_lock);
+}
+
+void
+hakios_apple80211_summary(void)
+{
+	static bool said;
+
+	if (said) {
+		return;
+	}
+	said = true;
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
+		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
+		if (kinds[i].last_error != 0) {
+			printf("; the last refusal: %d%s\n", kinds[i].last_error, kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+		}
+	}
+}
+
+/* An Apple80211 request for the radio's interface, from the process that is running now. */
+errno_t
+hakios_apple80211_ioctl(u_long command, void *data)
+{
+	static unsigned said;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211;
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	error = is_set ? set(request, what, sizeof(what)) : get(request);
+	note(request, is_set, error);
+	/* (a request that is repeated for ever is said a few hundred times) */
+	if (said < 800) {
+		said++;
+		printf("apple80211: %s %s %d (%s), value %d, %u bytes%s: %s", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered\n" : error ==
+		    EOPNOTSUPP ? "REFUSED\n" : "");
+		if (error != 0 && error != EOPNOTSUPP) {
+			printf("error %d\n", error);
+		}
+	}
+	return error;
+}
diff --git a/bsd/dev/hakios.audio.c b/bsd/dev/hakios.audio.c
new file mode 100644
index 0000000..91f784c
--- /dev/null
+++ b/bsd/dev/hakios.audio.c
@@ -0,0 +1,362 @@
+/*
+ * /dev/hakios-audio: the sound that Darwin plays (see sys/hakios.audio.h).
+ *
+ * What is written goes two ways:
+ *
+ *   to a sink   a driver that plays it: the virtio sound device under QEMU
+ *               (hakios.virtio_sound.c). On the phone there is none yet (hakios.speaker.c
+ *               is where it begins).
+ *
+ *   into a recording, with boot-arg rec_sound=N: the first N seconds of sound are also kept
+ *               in one piece of memory that is left in place when the kernel returns to the
+ *               loader, which hands it to the host ("xl sound"; under QEMU, the monitor's
+ *               pmemsave), where tools/sound.py makes a WAV file of it. Only what is played
+ *               takes room, the silence in between does not: every write is stored with the
+ *               time it was made.
+ *
+ *                 struct rec_header, then per write: struct rec_block, frames * 4 bytes
+ *
+ *               With rec_sound_fed=1 as well, the recording has instead what the speakers' guard
+ *               let through (hakios.guard.c, on the phone): what reaches the amplifiers. With
+ *               rec_sound_mic=1, what the main microphone hears (hakios.mic.c, mic=3), in both
+ *               channels.
+ *
+ * When the writer has stopped, a line in the log says how long it wrote, at what rate, how much
+ * of it was not silence and how loud: the only way to "hear" a machine one cannot listen to.
+ * (The audio server writes for as long as its device runs, a second or two beyond the sound.)
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/hakios.audio.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <vm/vm_kern.h>
+
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+
+#define CHUNK_FRAMES    1024            /* what one pass of write() moves */
+#define QUIET_MS        500             /* no write for this long: the writer has stopped */
+#define SILENCE         8               /* samples no larger than this are silence */
+#define REC_MAX_SECONDS 1200            /* 220 MB */
+
+struct rec_header {
+	char     magic[8];              /* "RWSND001" */
+	uint32_t rate, channels;        /* HAKIOS_AUDIO_RATE, HAKIOS_AUDIO_CHANNELS; the samples are 16-bit */
+	uint32_t blocks;
+	uint32_t reserved;
+};
+struct rec_block {
+	uint64_t nanoseconds;           /* when it was written, since the kernel started */
+	uint32_t frames;
+	uint32_t reserved;
+};
+
+/* { physical address, bytes, kernel address } of the recording, for the loader: osfmk/arm64/loader_return.c */
+extern uint64_t loader_sound[3];
+
+static LCK_GRP_DECLARE(audio_lck_grp, "hakios-audio");
+static LCK_MTX_DECLARE(audio_lock, &audio_lck_grp);
+
+static hakios_audio_sink_t audio_sink;
+
+static uint8_t *rec_base;
+static bool rec_fed;                    /* boot-arg rec_sound_fed=1: what the guard let through is recorded, not what was written */
+static bool rec_mic;                    /* boot-arg rec_sound_mic=1: what the microphone hears (hakios.mic.c) */
+static uint64_t rec_size, rec_used;
+static uint64_t rec_frames, rec_frames_max;
+
+/* the stretch of writing in progress */
+static uint64_t stretch_first, stretch_last;    /* mach_absolute_time() of its first and its latest write */
+static uint64_t stretch_frames, stretch_latest; /* frames written, and how many of them by the latest write */
+static uint64_t stretch_sound, stretch_lost;    /* frames in writes that were not silence; frames the sink did not take */
+static uint32_t stretch_peak;                   /* the largest sample, as an absolute value */
+static thread_call_t report_call;
+static bool report_armed;
+
+static void
+audio_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t frames, latest, sound, lost, deadline, since = 0, lasted = 0;
+	uint32_t loudest;
+
+	lck_mtx_lock(&audio_lock);
+	absolutetime_to_nanoseconds(mach_absolute_time() - stretch_last, &since);
+	if (since < QUIET_MS * NSEC_PER_MSEC) {
+		/* still writing: look again later */
+		clock_interval_to_deadline(2 * QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(report_call, deadline);
+		lck_mtx_unlock(&audio_lock);
+		return;
+	}
+	absolutetime_to_nanoseconds(stretch_last - stretch_first, &lasted);
+	frames = stretch_frames;
+	latest = stretch_latest;
+	sound = stretch_sound;
+	lost = stretch_lost;
+	loudest = stretch_peak;
+	stretch_frames = stretch_sound = stretch_lost = 0;
+	stretch_peak = 0;
+	report_armed = false;
+	lck_mtx_unlock(&audio_lock);
+
+	printf("hakios-audio: %llu.%02llu s written", frames / HAKIOS_AUDIO_RATE,
+	    frames % HAKIOS_AUDIO_RATE * 100 / HAKIOS_AUDIO_RATE);
+	if (lasted >= NSEC_PER_SEC) {
+		/* what was written before the latest write took the time between the first and the latest */
+		printf(" at %llu frames a second", (frames - latest) * NSEC_PER_SEC / lasted);
+	}
+	printf(", %llu.%02llu s of it sound, peak %u%% of full scale", sound / HAKIOS_AUDIO_RATE,
+	    sound % HAKIOS_AUDIO_RATE * 100 / HAKIOS_AUDIO_RATE, loudest * 100 / 32768);
+	if (lost) {
+		printf(", %llu ms lost (the sink was full)", lost * 1000 / HAKIOS_AUDIO_RATE);
+	}
+	printf("\n");
+}
+
+/* With audio_lock held. */
+static void
+audio_record(const int16_t *frames, uint32_t count)
+{
+	struct rec_header *header = (struct rec_header *)rec_base;
+	struct rec_block *block;
+	uint64_t bytes = (uint64_t)count * HAKIOS_AUDIO_FRAME;
+
+	if (rec_base == NULL || rec_frames >= rec_frames_max || rec_used + sizeof(*block) + bytes > rec_size) {
+		return;
+	}
+	block = (struct rec_block *)(rec_base + rec_used);
+	absolutetime_to_nanoseconds(mach_absolute_time(), &block->nanoseconds);
+	block->frames = count;
+	block->reserved = 0;
+	memcpy(block + 1, frames, bytes);
+	rec_used += sizeof(*block) + bytes;
+	rec_frames += count;
+	header->blocks++;
+	loader_sound[1] = rec_used;
+	if (rec_frames >= rec_frames_max) {
+		printf("hakios-audio: recording finished: %llu s in %u writes\n", rec_frames / HAKIOS_AUDIO_RATE, header->blocks);
+	}
+}
+
+bool
+hakios_audio_recording_fed(void)
+{
+	return rec_fed && rec_base != NULL && rec_frames < rec_frames_max;
+}
+
+bool
+hakios_audio_recording_mic(void)
+{
+	return rec_mic && rec_base != NULL && rec_frames < rec_frames_max;
+}
+
+/* From the speakers' feeder: what the guard let through, into the recording (rec_sound_fed=1). */
+void
+hakios_audio_record_fed(const int16_t *frames, uint32_t count)
+{
+	lck_mtx_lock(&audio_lock);
+	audio_record(frames, count);
+	lck_mtx_unlock(&audio_lock);
+}
+
+static void
+audio_play(const int16_t *frames, uint32_t count)
+{
+	uint32_t loudest = 0, taken = 0;
+	uint64_t deadline;
+
+	for (uint32_t i = 0; i < count * HAKIOS_AUDIO_CHANNELS; i++) {
+		uint32_t level = frames[i] < 0 ? -(int32_t)frames[i] : frames[i];
+
+		if (level > loudest) {
+			loudest = level;
+		}
+	}
+	lck_mtx_lock(&audio_lock);
+	if (!rec_fed && !rec_mic) {
+		audio_record(frames, count);
+	}
+	if (audio_sink != NULL) {
+		taken = audio_sink(frames, count);
+		stretch_lost += count - taken;
+	}
+	stretch_last = mach_absolute_time();
+	if (stretch_frames == 0) {
+		stretch_first = stretch_last;
+	}
+	stretch_frames += count;
+	stretch_latest = count;
+	if (loudest > SILENCE) {
+		stretch_sound += count;
+	}
+	if (loudest > stretch_peak) {
+		stretch_peak = loudest;
+	}
+	if (!report_armed && report_call != NULL) {
+		report_armed = true;
+		clock_interval_to_deadline(2 * QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(report_call, deadline);
+	}
+	lck_mtx_unlock(&audio_lock);
+}
+
+void
+hakios_audio_set_sink(const char *name, hakios_audio_sink_t sink)
+{
+	lck_mtx_lock(&audio_lock);
+	audio_sink = sink;
+	lck_mtx_unlock(&audio_lock);
+	printf("hakios-audio: sound goes to %s\n", name);
+}
+
+static int
+audio_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+audio_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+audio_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t frames[CHUNK_FRAMES * HAKIOS_AUDIO_CHANNELS];
+	int error = 0;
+
+	while (uio_resid(uio) >= HAKIOS_AUDIO_FRAME) {
+		user_ssize_t bytes = uio_resid(uio);
+
+		if (bytes > (user_ssize_t)sizeof(frames)) {
+			bytes = sizeof(frames);
+		}
+		bytes -= bytes % HAKIOS_AUDIO_FRAME;
+		error = uiomove((caddr_t)frames, (int)bytes, uio);
+		if (error) {
+			break;
+		}
+		audio_play(frames, (uint32_t)(bytes / HAKIOS_AUDIO_FRAME));
+	}
+	return error;
+}
+
+/* the speakers' volume, as Darwin sets it (sys/hakios.audio.h): kept for the sink's driver to look at */
+#define HAKIOS_AUDIO_BELOW_MAX  (90 * 8)        /* eighths of a dB: the amplifiers' own lowest volume (speaker.c VOLUME_LOWEST) */
+static uint32_t volume_below, volume_generation;
+static bool volume_muted;
+
+static int
+audio_ioctl(__unused dev_t dev, u_long command, caddr_t data, __unused int flags, __unused struct proc *p)
+{
+	const struct hakios_audio_volume *volume = (const struct hakios_audio_volume *)data;
+	uint32_t below;
+
+	if (command != HAKIOS_AUDIO_SET_VOLUME) {
+		return ENOTTY;
+	}
+	/*
+	 * The amplifiers go no lower than -90 dB (hakios.speaker.c's VOLUME_LOWEST, the "mute volume"): a larger `below'
+	 * means nothing there, and from user space (the node is open to all) it would make the sums made with it
+	 * (sound_below + below) wrap round to a level far louder than the one asked for.
+	 */
+	below = volume->below > HAKIOS_AUDIO_BELOW_MAX ? HAKIOS_AUDIO_BELOW_MAX : volume->below;
+	lck_mtx_lock(&audio_lock);
+	volume_below = below;
+	volume_muted = volume->muted != 0;
+	volume_generation++;
+	lck_mtx_unlock(&audio_lock);
+	printf("hakios-audio: the volume: %s%u.%03u dB under the loudest\n", volume->muted ? "muted; " : "", below / 8,
+	    below % 8 * 125);
+	return 0;
+}
+
+bool
+hakios_audio_volume(uint32_t *below, bool *muted, uint32_t *generation)
+{
+	lck_mtx_lock(&audio_lock);
+	*below = volume_below;
+	*muted = volume_muted;
+	*generation = volume_generation;
+	lck_mtx_unlock(&audio_lock);
+	return *generation != 0;
+}
+
+static const struct cdevsw audio_cdevsw = {
+	.d_open = audio_open, .d_close = audio_close, .d_read = eno_rdwrt, .d_write = audio_write,
+	.d_ioctl = audio_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+audio_recording_init(void)
+{
+	struct rec_header *header;
+	uint32_t seconds = 0, fed = 0;
+	vm_offset_t memory = 0;
+	uint64_t size;
+
+	if (!PE_parse_boot_argn("rec_sound", &seconds, sizeof(seconds)) || seconds == 0) {
+		return;
+	}
+	if (seconds > REC_MAX_SECONDS) {
+		seconds = REC_MAX_SECONDS;
+	}
+	/* the samples, and a block header for every write of ten milliseconds or more */
+	size = sizeof(*header) + (uint64_t)seconds * (HAKIOS_AUDIO_RATE * HAKIOS_AUDIO_FRAME + 100 * sizeof(struct rec_block));
+	size = round_page(size);
+	/* one piece of physical memory: the loader will send it over USB as it lies */
+	if (kmem_alloc_contig(kernel_map, &memory, size, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("hakios-audio: no memory for a recording of %u s (%llu MB)\n", seconds, size >> 20);
+		return;
+	}
+	header = (struct rec_header *)memory;
+	memcpy(header->magic, "RWSND001", 8);
+	header->rate = HAKIOS_AUDIO_RATE;
+	header->channels = HAKIOS_AUDIO_CHANNELS;
+	rec_size = size;
+	rec_used = sizeof(*header);
+	rec_frames_max = (uint64_t)seconds * HAKIOS_AUDIO_RATE;
+	rec_base = (uint8_t *)memory;
+	loader_sound[0] = kvtophys(memory);
+	loader_sound[1] = rec_used;
+	loader_sound[2] = (uint64_t)memory;
+	PE_parse_boot_argn("rec_sound_fed", &fed, sizeof(fed));
+	rec_fed = fed != 0;
+	fed = 0;
+	PE_parse_boot_argn("rec_sound_mic", &fed, sizeof(fed));
+	rec_mic = fed != 0;
+	printf("hakios-audio: recording the first %u s of sound%s, into %llu MB at %#llx\n", seconds,
+	    rec_fed ? " as the speakers' guard lets it through" : rec_mic ? " the microphone hears (in both channels)" : "", size >> 20,
+	    loader_sound[0]);
+}
+
+void
+hakios_audio_init(void)
+{
+	int major = cdevsw_add(-1, &audio_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-audio") == NULL) {
+		printf("hakios-audio: cannot create the device\n");
+		return;
+	}
+	report_call = thread_call_allocate(audio_report, NULL);
+	audio_recording_init();
+	hakios_virtio_sound_init();
+	hakios_speaker_init();
+	hakios_haptic_init();
+	hakios_torch_init();
+	hakios_camera_init();
+}
diff --git a/bsd/dev/hakios.battery.c b/bsd/dev/hakios.battery.c
new file mode 100644
index 0000000..54acd33
--- /dev/null
+++ b/bsd/dev/hakios.battery.c
@@ -0,0 +1,205 @@
+/*
+ * Battery monitor for Xiaomi redwood (POCO X5 Pro).
+ *
+ * The phone selects PM7325B and qcom,battery-charger over PMIC GLINK/ADSP, not
+ * the local PM7250B/QG layout.  The resident UEFI contains the matching
+ * Qualcomm charger drivers.  xnuloader owns that firmware context on core 0,
+ * polls it, and publishes a read-only cache; XNU only consumes that cache.
+ * Charger limits and JEITA protection therefore remain firmware-owned.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.input.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define LOADER_BATTERY_MAGIC            0x2154544142574452ULL
+#define LOADER_BATTERY_VERSION          1
+#define LOADER_BATTERY_VALID            (1u << 0)
+#define LOADER_BATTERY_PRESENT          (1u << 1)
+#define LOADER_BATTERY_CHARGER_PRESENT  (1u << 2)
+#define LOADER_BATTERY_VOLTAGE_VALID    (1u << 3)
+#define LOADER_BATTERY_CHARGING         (1u << 4)
+#define LOADER_BATTERY_SOC_ESTIMATED    (1u << 5)
+#define LOADER_PAGE_SIZE                0x4000UL
+
+struct loader_battery {
+	uint64_t magic;
+	uint32_t version, size;
+	volatile uint32_t sequence;
+	uint32_t flags;
+	int32_t soc_percent, voltage_mv, current_ma, temperature_c;
+	uint32_t charger_action, polls, failures, reserved;
+};
+
+static volatile struct loader_battery *shared_battery;
+static int battery_soc_percent = -1, battery_voltage_mv = -1, battery_current_ma;
+static int battery_temperature_c = -273, battery_present, battery_charger_present;
+static int battery_charging, battery_soc_estimated, battery_charger_action = -1;
+static uint64_t battery_updates, battery_failures;
+
+/* for others in the kernel (the flashlight's thermal guard): -273 while it is not known */
+int
+hakios_battery_temperature(void)
+{
+	return battery_temperature_c;
+}
+
+SYSCTL_DECL(_kern_hakios);              /* the node is drivers/core/hakios.platform.c's: every driver hangs its sysctls there */
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_soc, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_soc_percent, 0, "battery state of charge, 0..100 percent, or -1 if unknown");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_voltage_mv, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_voltage_mv, 0, "battery voltage in millivolts, or -1 if unknown");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_current_ma, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_current_ma, 0, "battery current reported by Qualcomm firmware, in milliamps");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_temperature_c, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_temperature_c, 0, "battery temperature reported by Qualcomm firmware, in Celsius");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_present, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_present, 0, "1 if Qualcomm firmware reports a battery");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_charger_present, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charger_present, 0, "1 if Qualcomm firmware reports an attached charger");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_charging, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charging, 0, "1 while an attached charger is charging a non-full battery");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_soc_estimated, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_soc_estimated, 0, "1 only when SOC had to be estimated from voltage");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_charger_action, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charger_action, 0, "last Qualcomm charger action, for diagnostics");
+
+static bool
+battery_snapshot(struct loader_battery *out)
+{
+	uint32_t before, after;
+
+	for (unsigned retry = 0; retry < 4; retry++) {
+		before = shared_battery->sequence;
+		if (before & 1) continue;
+		__asm__ volatile ("dmb ishld" ::: "memory");
+		memcpy(out, (const void *)(uintptr_t)shared_battery, sizeof(*out));
+		__asm__ volatile ("dmb ishld" ::: "memory");
+		after = shared_battery->sequence;
+		if (before == after && !(after & 1)) return true;
+	}
+	return false;
+}
+
+static void
+battery_poll(void)
+{
+	struct loader_battery sample;
+
+	if (!battery_snapshot(&sample) || sample.magic != LOADER_BATTERY_MAGIC ||
+	    sample.version != LOADER_BATTERY_VERSION || sample.size < sizeof(sample) ||
+	    !(sample.flags & LOADER_BATTERY_VALID) || sample.soc_percent < 0 || sample.soc_percent > 100) {
+		battery_failures++;
+		return;
+	}
+	battery_soc_percent = sample.soc_percent;
+	battery_voltage_mv = (sample.flags & LOADER_BATTERY_VOLTAGE_VALID) ? sample.voltage_mv : -1;
+	battery_current_ma = sample.current_ma;
+	battery_temperature_c = sample.temperature_c;
+	battery_present = (sample.flags & LOADER_BATTERY_PRESENT) != 0;
+	battery_charger_present = (sample.flags & LOADER_BATTERY_CHARGER_PRESENT) != 0;
+	battery_charging = (sample.flags & LOADER_BATTERY_CHARGING) != 0;
+	battery_soc_estimated = (sample.flags & LOADER_BATTERY_SOC_ESTIMATED) != 0;
+	battery_charger_action = (int)sample.charger_action;
+	battery_updates++;
+}
+
+/*
+ * What the audio DSP's battery manager says (drivers/audio/hakios.adsp.c, with adsp=1 unless battmgr=0):
+ * the values that Android shows, from where Android takes them. They are kept here for the sysctls
+ * and passed on to the power source that Darwin reads (drivers/power/hakios.battery.cpp).
+ */
+static int battery_full_uah, battery_design_uah, battery_cycles, battery_source_dsp;
+
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_full_uah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_full_uah, 0, "the battery's full charge as the fuel gauge has learnt it, in uAh (0 if unknown)");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_design_uah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_design_uah, 0, "the battery's charge as designed, in uAh (0 if unknown)");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_cycles, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_cycles, 0, "the battery's charge cycles (0 if unknown)");
+SYSCTL_INT(_kern_hakios, OID_AUTO, battery_from_dsp, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_source_dsp, 0, "1 when the values come from the audio DSP's battery manager");
+
+extern void HakiosBatteryReport(const void *state, unsigned size);     /* drivers/power/hakios.battery.cpp */
+
+void
+hakios_battery_report(const struct hakios_battery_state *b)
+{
+	/* (rounded in 64 bits: the DSP's value near INT32_MAX plus 50 would overflow an int, and a full battery would read 0%) */
+	int percent = (int)(((int64_t)b->percent_hundredths + 50) / 100);
+
+	battery_soc_percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	battery_voltage_mv = b->voltage_uv / 1000;
+	battery_current_ma = b->current_ua / 1000;
+	/* (in 64 bits for the same reason: an overflow here would make a hot battery read as cold) */
+	battery_temperature_c = (int)(((int64_t)b->temperature_hundredths + 50) / 100);
+	battery_present = b->present != 0;
+	battery_charger_present = b->external != 0;
+	battery_charging = b->status == 1;      /* POWER_SUPPLY_STATUS_CHARGING */
+	battery_soc_estimated = 0;
+	battery_charger_action = b->status;
+	if (b->full_uah > 0) {
+		battery_full_uah = b->full_uah;
+	}
+	if (b->design_uah > 0) {
+		battery_design_uah = b->design_uah;
+	}
+	if (b->cycles > 0) {
+		battery_cycles = b->cycles;
+	}
+	battery_source_dsp = 1;
+	battery_updates++;
+	HakiosBatteryReport(b, sizeof(*b));
+}
+
+static void
+battery_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (unsigned tick = 0;; tick++) {
+		battery_poll();
+		if (tick % 12 == 0) {
+			printf("battery: SOC=%d%%%s, V=%d mV, I=%d mA, T=%d C, battery=%d charger=%d charging=%d "
+			    "action=%d (%llu reads, %llu failed)\n", battery_soc_percent,
+			    battery_soc_estimated ? " (voltage estimate)" : "", battery_voltage_mv,
+			    battery_current_ma, battery_temperature_c, battery_present, battery_charger_present,
+			    battery_charging, battery_charger_action, battery_updates, battery_failures);
+		}
+		delay_for_interval(5000, NSEC_PER_MSEC);
+	}
+}
+
+void
+hakios_battery_init(void)
+{
+	uint32_t enabled = 0;
+	uint64_t shared_pa = 0;
+	vm_offset_t page;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("battery", &enabled, sizeof(enabled)) || !enabled) return;
+	if (!PE_parse_boot_argn("battery_shared_pa", &shared_pa, sizeof(shared_pa)) || shared_pa == 0) {
+		printf("battery: xnuloader did not provide battery_shared_pa\n");
+		return;
+	}
+	/* The cache must lie inside the one page that is mapped: an address near its end would be read past the mapping. */
+	if ((shared_pa & (LOADER_PAGE_SIZE - 1)) + sizeof(struct loader_battery) > LOADER_PAGE_SIZE) {
+		printf("battery: battery_shared_pa %#llx: the cache would cross the end of its page\n", shared_pa);
+		return;
+	}
+	page = ml_io_map((vm_offset_t)(shared_pa & ~(LOADER_PAGE_SIZE - 1)), LOADER_PAGE_SIZE);
+	shared_battery = (volatile struct loader_battery *)(page + (shared_pa & (LOADER_PAGE_SIZE - 1)));
+	if (shared_battery->magic != LOADER_BATTERY_MAGIC || shared_battery->version != LOADER_BATTERY_VERSION ||
+	    shared_battery->size < sizeof(struct loader_battery)) {
+		printf("battery: bad xnuloader cache at %#llx (magic %#llx version %u size %u)\n", shared_pa,
+		    shared_battery->magic, shared_battery->version, shared_battery->size);
+		return;
+	}
+	printf("battery: Qualcomm UEFI cache at pa %#llx; polling every 5 seconds\n", shared_pa);
+	if (kernel_thread_start(battery_thread, NULL, &thread) == KERN_SUCCESS) thread_deallocate(thread);
+}
diff --git a/bsd/dev/hakios.battguard.c b/bsd/dev/hakios.battguard.c
new file mode 100644
index 0000000..bc8a438
--- /dev/null
+++ b/bsd/dev/hakios.battguard.c
@@ -0,0 +1,119 @@
+/*
+ * A run nobody watches must not empty the battery: with boot-arg battery_stop=<percent>, hand control back to the boot loader
+ * when the charge is at or below that for three looks in a row, the way drivers/power/hakios.thermal.c does for heat.
+ *
+ * Why. The phone is not charged while HakiOS runs (the kernel has no charging path yet: docs/install-safe.md), and a session
+ * left going overnight ends with a flat battery, which is a phone that has gone off USB until somebody plugs it in. This is the
+ * protection that costs nothing: at 15 percent the run ends, the loader has the log, and (xl with XL_REBOOT_AFTER=1) the phone
+ * goes back to Android, which charges it.
+ *
+ * What it believes. It asks the battery driver's own numbers (sysctl kern.hakios.battery_soc, ..._present, ..._charger_present;
+ * they come from the loader's charger page or, with adsp=1, from the audio DSP's battery service) and acts only on a reading that is
+ * between 0 and 100 with a battery present and NO charger attached. An unknown charge (-1), no battery, or a charger on the cable
+ * is never a reason to stop. It does not read any hardware itself.
+ *
+ * Status (what has and has not been seen): COMPILED ONLY. It was written while the phone was off USB, so it has not run on one;
+ * whether the numbers it reads are filled in when a kernel runs without adsp=1 is not known (the battery driver's header says
+ * where they come from; the first run that sets battery_stop will print its "battguard:" line and say). Not run in QEMU.
+ *
+ * Boot-args:
+ *   battery_stop=<percent>   stop at this charge or below (0: never, the default; 1 to 99)
+ *   battery_stop_poll=<s>    how often to look (5 to 600; 20)
+ */
+#include <kern/clock.h>
+#include <kern/startup.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+extern void loader_log_putc(char c);
+extern void loader_return(void);
+extern void hakios_var_save_on_return(void);
+extern void hakios_adreno_stop(void);
+extern void hakios_wifi_stop(void);
+extern void hakios_adsp_stop(void);
+extern int kernel_sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t newlen);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+static thread_call_t call;
+static uint32_t stop_percent, poll_seconds = 20, looks, strikes, last_said_minute = ~0u;
+static bool stopping;
+
+static bool
+read_int(const char *name, int *value)
+{
+	size_t size = sizeof(*value);
+
+	return kernel_sysctlbyname(name, value, &size, NULL, 0) == 0 && size == sizeof(*value);
+}
+
+static void
+tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	int soc = -1, present = 0, charger = 0;
+	uint64_t deadline;
+	bool known = read_int("kern.hakios.battery_soc", &soc) && read_int("kern.hakios.battery_present", &present) &&
+	    read_int("kern.hakios.battery_charger_present", &charger) && soc >= 0 && soc <= 100 && present && !charger;
+	uint32_t minute = (uint32_t)(++looks * poll_seconds / 300);       /* a line every five minutes, and the first */
+
+	if (minute != last_said_minute || looks == 1) {
+		last_said_minute = minute;
+		say("battguard: charge %d%% (battery %s, charger %s); stop at or below %u%%%s\n", soc, present ? "present" : "not reported",
+		    charger ? "attached: the guard waits" : "not attached", stop_percent, known ? "" : " -- not a reading it acts on");
+	}
+	strikes = (known && (uint32_t)soc <= stop_percent) ? strikes + 1 : 0;
+	if (strikes >= 3 && !stopping) {
+		stopping = true;
+		say("\n--- battguard: the charge is %d%%, at or below battery_stop=%u three looks in a row: back to the loader ---\n", soc,
+		    stop_percent);
+		hakios_var_save_on_return();
+		hakios_adreno_stop();
+		hakios_wifi_stop();
+		hakios_adsp_stop();
+		loader_return();
+	}
+	clock_interval_to_deadline(poll_seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+}
+
+__startup_func
+static void
+battguard_init(void)
+{
+	uint32_t value;
+
+	if (!PE_parse_boot_argn("battery_stop", &stop_percent, sizeof(stop_percent)) || stop_percent == 0 || stop_percent > 99) {
+		return;
+	}
+	if (PE_parse_boot_argn("battery_stop_poll", &value, sizeof(value)) && value >= 5 && value <= 600) {
+		poll_seconds = value;
+	}
+	say("battguard: on, looking every %u s; the run ends at %u%% or less (and only with a battery, a known charge and no charger)\n",
+	    poll_seconds, stop_percent);
+	uint64_t deadline;
+
+	call = thread_call_allocate(tick, NULL);
+
+	clock_interval_to_deadline(poll_seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, battguard_init);
diff --git a/bsd/dev/hakios.bt.c b/bsd/dev/hakios.bt.c
new file mode 100644
index 0000000..555dd6f
--- /dev/null
+++ b/bsd/dev/hakios.bt.c
@@ -0,0 +1,143 @@
+/*
+ * Bluetooth of the POCO X5 Pro (redwood): STEP ONE, a look. Only with boot-arg bt=1, and it only READS.
+ *
+ * The phone's radio chip is a Qualcomm WCN6750, one chip for Wi-Fi and Bluetooth (the phone's device tree: the node
+ * bt_wcn6750, compatible qcom,wcn6750-bt; the Wi-Fi half is drivers/wifi/hakios.wifi.c). What the device tree says
+ * about the Bluetooth half, and what this file takes from it (numbers, not text):
+ *
+ *   qcom,bt-reset-gpio     GPIO 85    the Bluetooth half's reset / enable line
+ *   qcom,bt-sw-ctrl-gpio   GPIO 86    the line that tells the radio's switch which half has the antenna
+ *   qcom,wl-reset-gpio     GPIO 84    the Wi-Fi half's reset line, listed here too: the chip comes up as a whole
+ *   the supplies (qcom,bt-vdd-*-supply, each with a -config of minimum and maximum microvolts; read out of the
+ *   device tree by script, not by eye), the same for both halves:
+ *       io 1800000..2000000    aon, dig, rfacmn, rfa-0p8 824000..1120000    rfa1 1872000..2040000
+ *       rfa2 1256000..1500000  ipa-2p2 2200000..2210000                     asd 2800000..3544000
+ *     (which regulator each supply is, is a phandle in the tree; nothing here writes any of them)
+ *
+ * What this does. At boot-arg bt=1 it reads the three pins' configuration and level out of the TLMM (the same
+ * registers the haptic driver reads for its pins) and prints them, once at the start and once bt_again seconds later
+ * (default 30), to see whether the Wi-Fi bring-up (wifi=1) moved the reset lines in between. It writes NOTHING: no
+ * pin, no supply, no clock, no serial engine. Reading a pin's configuration is a plain load from the TLMM, which the
+ * haptic and thermal drivers do on this phone without trouble.
+ *
+ * What is NOT here, and what it needs. Bluetooth on this chip, as Android and Linux (hci_qca, btqca) do it:
+ *   1. the supplies on (they are shared with Wi-Fi: wifi=1 already raises what the Wi-Fi half needs),
+ *   2. the reset line high, and the chip given a moment,
+ *   3. the UART of the Bluetooth half opened at 115200 baud (a Qualcomm serial engine, "hsuart0" in the device tree:
+ *      its clocks and its pins have to be set up first, and an access to an engine whose clock is off hangs the bus),
+ *   4. the chip's own firmware loaded over that UART with Qualcomm's vendor commands (a rampatch and an NVM file out of
+ *      /vendor/firmware on the phone: NOT in the repository, and not pulled by devices/redwood/pull-firmware.sh yet; Linux
+ *      names them qca/msbtfw*.mbn and qca/msnv*.bin for the WCN6750, as I remember it, which is NOT verified here),
+ *   5. the baud rate raised, then H4 packets (HCI) in both directions.
+ * None of 1 to 5 is written, because none of it could be checked: the phone was not on the desk when this was written, and
+ * the register numbers and command bytes for a chip are not the kind of thing to write from memory and ship. Each step comes
+ * with a boot-arg level the way haptic=N and wifi_step=N did: the next one is bt=2 (supplies and reset line, seen on the
+ * pins), after this one has been run and its output compared with a phone that is running Android.
+ *
+ * Status: COMPILED ONLY. Not run in QEMU (it has no such TLMM, and bt=1 must not be given there: a load from an address it
+ * does not map faults) and not run on the phone.
+ *
+ * Boot-args:
+ *   bt=1           the look
+ *   bt_again=<s>   the second look this many seconds later (0: no second look; 30)
+ */
+#include <stdint.h>
+#include <kern/clock.h>
+#include <kern/startup.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[200];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x100000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_OUTPUT              (1u << 9)
+
+static vm_offset_t tlmm;
+static uint32_t again_seconds = 30;
+static thread_call_t again_call;
+
+/* The three pins of the device tree's bt_wcn6750 node. */
+static const struct {
+	unsigned pin;
+	const char *what;
+} pins[] = {
+	{ 84, "qcom,wl-reset-gpio: the Wi-Fi half's reset" },
+	{ 85, "qcom,bt-reset-gpio: the Bluetooth half's reset" },
+	{ 86, "qcom,bt-sw-ctrl-gpio: the antenna switch" },
+};
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+/* One look at the pins: what the TLMM says each is set to, and the level it reads. Nothing is written. */
+static void
+look(const char *when)
+{
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		uint32_t cfg = rd(GPIO_CFG(pins[i].pin)), io = rd(GPIO_IO(pins[i].pin));
+
+		say("bt: %s: gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", when, pins[i].pin, pins[i].what, (cfg >> 2) & 15,
+		    cfg & 3, (((cfg >> 6) & 7) + 1) * 2, (cfg & CFG_OUTPUT) ? (io & 2 ? "drives high" : "drives low") : "input", io & 1);
+	}
+}
+
+static void
+look_again(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	look("again");
+}
+
+__startup_func
+static void
+bt_init(void)
+{
+	uint32_t enabled = 0, value;
+	uint64_t deadline;
+
+	if (!PE_parse_boot_argn("bt", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	if (PE_parse_boot_argn("bt_again", &value, sizeof(value)) && value <= 3600) {
+		again_seconds = value;
+	}
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	if (tlmm == 0) {
+		say("bt: could not map the TLMM; off\n");
+		return;
+	}
+	say("bt: level 1: a look, reading only (WCN6750; nothing is written)\n");
+	look("at start");
+	if (again_seconds != 0) {
+		again_call = thread_call_allocate(look_again, NULL);
+		clock_interval_to_deadline(again_seconds, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(again_call, deadline);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, bt_init);
diff --git a/bsd/dev/hakios.buttons.c b/bsd/dev/hakios.buttons.c
new file mode 100644
index 0000000..27203ee
--- /dev/null
+++ b/bsd/dev/hakios.buttons.c
@@ -0,0 +1,615 @@
+/*
+ * The buttons of the POCO X5 Pro (redwood) -- power, volume up, volume down -- as a source of
+ * button records for /dev/hakios-touch (sys/hakios.input.h). Only with boot-arg buttons=1:
+ * every address below belongs to this phone.
+ *
+ * None of the three is a pin of the SoC. They are inputs of two of the power management chips:
+ *   power        KPDPWR_N of the power-on block ("PON") of the PMK8350
+ *   volume down  RESIN_N of the same block
+ *   volume up    GPIO6 of the PM7325, pulled up; the key pulls it low
+ * Both chips sit on the SPMI bus (slaves 0 and 1), and the way to that bus is the SoC's "PMIC
+ * arbiter": it owns the bus and gives each of the systems on the chip (this one, the modem, the
+ * always-on processor, TrustZone...) a set of registers per PMIC peripheral -- a "channel" -- to
+ * ask for a transfer with. Reads go through the "observer" channels, which every system has for
+ * every peripheral, whoever owns it.
+ *
+ * THIS DRIVER ONLY READS. Nothing is written to either chip, neither a register of a PMIC nor
+ * the configuration of the pin: the PMICs make the phone's supplies, and a wrong write there
+ * can switch one off. The firmware reads the same keys itself (volume down and volume up choose
+ * between fastboot and recovery) and has left both inputs as they are needed; the driver checks
+ * that before it believes them, and where it finds something else it says so and leaves that
+ * key alone. The only thing written is the command word that asks the arbiter for a read.
+ *
+ * What a press is: the PON's "real time status" has a bit per key, set while the key is held
+ * (after the block's own debouncing); the GPIO's has the level of the pin. A thread reads the
+ * two registers 60 times a second, and a key has changed when two looks in a row say so. A key
+ * that reads as held before it has ever been seen released is not believed (a pin that is not
+ * what it was taken for must not become a volume key held down for the whole session).
+ * No interrupt is used; what one would take is said at the end of this file.
+ *
+ * The mapping: the phone has what the iPhone X has, whose user space runs here -- a side button
+ * and two volume keys, no home button. Power is the side button (HAKIOS_BUTTON_LOCK).
+ *
+ * The bring-up is made in steps, each said in the log before it is made. Boot-arg
+ * buttons_steps=N stops after the first N:
+ *   1  map the arbiter and read its version             (the first access to that block)
+ *   2  find the channels of the two peripherals         (reads of the arbiter's tables)
+ *   3  ask each peripheral what it is                   (the first transfers on the bus)
+ *   4  read how the keys' inputs are set up, and what they say now
+ *   5  watch them                                       (the default)
+ *
+ * Register layouts: Linux drivers/spmi/spmi-pmic-arb.c (arbiter version 5),
+ * drivers/input/misc/pm8941-pwrkey.c (the "pmk8350" kind), drivers/pinctrl/qcom/pinctrl-spmi-gpio.c,
+ * and the phone's own device tree (qcom,spmi@c440000, pon_hlos@1300, gpio_keys).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+/*
+ * Every line goes to the loader's log directly as well: without -v the kernel's own messages
+ * reach that log only at the end of a run (with the kernel's message buffer), and "xl log"
+ * during a run is to show a press when it happens.
+ */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+#define printf say
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the PMIC arbiter ---------------------------------------------------------------------------- */
+
+#define ARB_CORE_PHYS           0x0c440000UL    /* "core": the version, and which peripheral each channel is */
+#define ARB_CORE_SIZE           0x1100UL
+#define ARB_CNFG_PHYS           0x0c40a000UL    /* "cnfg": which system owns each channel */
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_OBSERVER_PHYS       0x0e600000UL    /* "obsrvr": 0x10000 per system, 0x80 per channel in it */
+#define ARB_OBSERVER_SIZE       0x10000UL       /* ours is the first */
+#define ARB_SYSTEM              0               /* who we are to the arbiter: the device tree's "qcom,ee" */
+
+#define ARB_VERSION             0x000
+#define ARB_VERSION_5           0x50000000u     /* what follows is version 5's; 7 moved things again */
+#define ARB_VERSION_7           0x70000000u
+#define ARB_FEATURES            0x004           /* [10:0] the number of channels */
+#define ARB_CHANNEL(n)          (0x900 + 4 * (n))       /* core: [19:8] slave and peripheral, [24] interrupts go to the owner */
+#define ARB_CHANNEL_INTERRUPTS  (1u << 24)
+#define ARB_OWNER(n)            (0x700 + 4 * (n))       /* cnfg: [2:0] the system that may write through channel n */
+#define ARB_MAX_CHANNELS        512
+
+#define OBSERVER_COMMAND        0x00
+#define OBSERVER_STATUS         0x08
+#define OBSERVER_DATA0          0x18            /* the bytes read, the first in the lowest byte */
+#define OBSERVER_DATA1          0x1c
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define COMMAND_READ            (1u << 27)      /* "extended register read long"; [11:4] register, [2:0] bytes - 1 */
+#define READ_TIMEOUT_US         2000            /* a read takes some tens of microseconds */
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer;
+
+/* one transfer at a time through the arbiter: hakios_spmi_lock() (drivers/core/hakios.platform.c) */
+
+struct peripheral {
+	const char *    name;
+	uint16_t        id;             /* slave << 8 | peripheral: the high byte of its register addresses */
+	uint16_t        channel;
+	bool            found;
+};
+static struct peripheral pon = { .name = "the PMK8350's power-on block", .id = 0x013 };          /* registers 0x1300 of slave 0 */
+static struct peripheral pin = { .name = "GPIO6 of the PM7325", .id = 0x18d };                   /* registers 0x8d00 of slave 1 */
+
+/* How the reads have gone: said once a minute. */
+static struct {
+	uint64_t reads, failed, total_ns, longest_ns, last_ns;
+} bus;
+
+/*
+ * Read `count` (1 to 8) registers of a peripheral, from register `reg` on. Returns NULL, or what
+ * went wrong.
+ */
+static const char *
+spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	uint64_t start = mach_absolute_time(), now, interval, taken;
+	uint32_t status, data[2];
+	const char *problem = NULL;
+
+	nanoseconds_to_absolutetime(READ_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	hakios_spmi_lock();
+	wr(channel + OBSERVER_COMMAND, COMMAND_READ | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(channel + OBSERVER_STATUS);
+		now = mach_absolute_time();
+	} while (!(status & STATUS_DONE) && now - start < interval);
+	data[0] = rd(channel + OBSERVER_DATA0);
+	data[1] = count > 4 ? rd(channel + OBSERVER_DATA1) : 0;
+	hakios_spmi_unlock();
+
+	if (!(status & STATUS_DONE)) {
+		problem = "no answer from the arbiter";
+	} else if (status & STATUS_DENIED) {
+		problem = "the arbiter refuses";
+	} else if (status & STATUS_FAILURE) {
+		problem = "the transfer failed (nobody at that address?)";
+	} else if (status & STATUS_DROPPED) {
+		problem = "the transfer was dropped";
+	} else {
+		for (uint32_t i = 0; i < count; i++) {
+			bytes[i] = (uint8_t)(data[i / 4] >> (8 * (i % 4)));
+		}
+	}
+	absolutetime_to_nanoseconds(now - start, &taken);
+	bus.reads++;
+	bus.total_ns += taken;
+	bus.last_ns = taken;
+	if (taken > bus.longest_ns) {
+		bus.longest_ns = taken;
+	}
+	if (problem != NULL) {
+		bus.failed++;
+	}
+	return problem;
+}
+
+/*
+ * Which channel is that peripheral's. Several can be: one per system that may write to it. As
+ * Linux chooses: the first, unless a later one is ours to write through.
+ */
+static void
+find_channel(struct peripheral *p, uint32_t channels)
+{
+	for (uint32_t n = 0; n < channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n)), owner;
+
+		if (map == 0 || ((map >> 8) & 0xfff) != p->id) {
+			continue;
+		}
+		owner = rd(arb_cnfg + ARB_OWNER(n)) & 7;
+		printf("buttons: channel %u is %s (%#x); written by system %u%s\n", n, p->name, map, owner,
+		    (map & ARB_CHANNEL_INTERRUPTS) ? ", which also gets its interrupts" : "");
+		if (!p->found || owner == ARB_SYSTEM) {
+			p->found = true;
+			p->channel = (uint16_t)n;
+		}
+	}
+	if (!p->found) {
+		printf("buttons: no channel of the arbiter is %s (slave %u, peripheral %#x)\n", p->name, p->id >> 8, p->id & 0xff);
+	}
+}
+
+/* ---- the two peripherals ------------------------------------------------------------------------- */
+
+/* every peripheral of these PMICs */
+#define REG_TYPE                0x04
+#define REG_SUBTYPE             0x05
+#define REG_RT_STATUS           0x10            /* the inputs as they are now */
+#define REG_INT_SET_TYPE        0x11            /* interrupts: a bit per input in each of these */
+#define REG_INT_POLARITY_HIGH   0x12
+#define REG_INT_POLARITY_LOW    0x13
+#define REG_INT_ENABLED         0x15
+#define REG_INT_LATCHED         0x18
+#define REG_INT_PENDING         0x19
+
+/* the power-on block, of the kind that is split in two ("generation 3"): this is its half for the operating system */
+#define PON_TYPE                0x01
+#define PON_SUBTYPE_HLOS        0x09
+#define PON_KPDPWR              0x80            /* in the status and in the interrupt registers */
+#define PON_RESIN               0x40
+
+/* a GPIO of the low or medium voltage kind */
+#define GPIO_TYPE               0x10
+#define GPIO_SUBTYPE_LV         0x10
+#define GPIO_SUBTYPE_MV_VIN3    0x13            /* 0x10 to 0x13: one layout */
+#define GPIO_LEVEL              0x01            /* in the status */
+#define GPIO_REG_MODE           0x40            /* [1:0]: 0 input, 1 output, 2 both, 3 analog */
+#define GPIO_REG_SUPPLY         0x41
+#define GPIO_REG_PULL           0x42            /* [2:0]: 0 to 3 up (30, 1.5, 31.5 uA, 1.5 with a boost), 4 down, 5 none */
+#define GPIO_REG_ENABLE         0x46            /* [7] */
+
+#define POLL_MS                 16
+#define MINUTE_TICKS            (60 * 1000 / POLL_MS)
+
+static struct button {
+	const char *    name;
+	uint32_t        record;         /* HAKIOS_BUTTON_* */
+	bool            usable;         /* its input is what it was taken for */
+	bool            live;           /* it has been seen released */
+	bool            last;           /* the look before this one */
+	bool            down;           /* as reported */
+	uint64_t        since;          /* when it went down */
+	uint32_t        presses;
+} power = { .name = "power", .record = HAKIOS_BUTTON_LOCK },
+    volume_up = { .name = "volume up", .record = HAKIOS_BUTTON_VOLUME_UP },
+    volume_down = { .name = "volume down", .record = HAKIOS_BUTTON_VOLUME_DOWN };
+
+/* "12.345 s (08:13:05.918 UTC)": since boot as in the log's own stamps, and as the daemons' lines have it */
+static void
+now_text(char *text, size_t size, uint64_t now)
+{
+	clock_sec_t seconds;
+	clock_usec_t micro;
+	uint64_t up;
+
+	absolutetime_to_nanoseconds(now, &up);
+	clock_get_calendar_microtime(&seconds, &micro);
+	snprintf(text, size, "%llu.%03llu s (%02u:%02u:%02u.%03u UTC)", up / NSEC_PER_SEC, up / NSEC_PER_MSEC % 1000,
+	    (unsigned)(seconds / 3600 % 24), (unsigned)(seconds / 60 % 60), (unsigned)(seconds % 60), (unsigned)(micro / 1000));
+}
+
+static void
+button_look(struct button *b, bool pressed)
+{
+	uint64_t now = mach_absolute_time(), held;
+	bool steady = pressed == b->last;
+	char when[64];
+
+	b->last = pressed;
+	if (!b->usable || !steady) {
+		return;
+	}
+	if (!b->live) {
+		if (!pressed) {
+			b->live = true;
+			printf("buttons: %s is released now: believed from here on\n", b->name);
+		}
+		return;
+	}
+	if (pressed == b->down) {
+		return;
+	}
+	b->down = pressed;
+	now_text(when, sizeof(when), now);
+	if (pressed) {
+		b->since = now;
+		b->presses++;
+		printf("buttons: %s PRESSED at %s\n", b->name, when);
+	} else {
+		absolutetime_to_nanoseconds(now - b->since, &held);
+		printf("buttons: %s released at %s, after %llu ms\n", b->name, when, held / NSEC_PER_MSEC);
+	}
+	hakios_touch_post(pressed ? HAKIOS_BUTTON_DOWN : HAKIOS_BUTTON_UP, b->record, 0, 0);
+}
+
+/* One look at both peripherals. */
+static void
+buttons_poll(void)
+{
+	static unsigned said;
+	const char *problem;
+	uint8_t status;
+
+	if (power.usable || volume_down.usable) {
+		problem = spmi_read(&pon, REG_RT_STATUS, &status, 1);
+		if (problem == NULL) {
+			button_look(&power, status & PON_KPDPWR);
+			button_look(&volume_down, status & PON_RESIN);
+		} else if (said < 8) {
+			said++;
+			printf("buttons: reading %s: %s\n", pon.name, problem);
+		}
+	}
+	if (volume_up.usable) {
+		problem = spmi_read(&pin, REG_RT_STATUS, &status, 1);
+		if (problem == NULL) {
+			button_look(&volume_up, !(status & GPIO_LEVEL));
+		} else if (said < 8) {
+			said++;
+			printf("buttons: reading %s: %s\n", pin.name, problem);
+		}
+	}
+}
+
+/* Step 3: is each peripheral what the registers above are those of? */
+static bool
+identify(const struct peripheral *p, uint8_t type, uint8_t subtype_from, uint8_t subtype_to)
+{
+	const char *problem;
+	uint8_t is[2];
+
+	if (!p->found) {
+		return false;
+	}
+	printf("buttons: next: read the type of %s through channel %u (2 registers, 0x%02x04)\n", p->name, p->channel, p->id & 0xff);
+	problem = spmi_read(p, REG_TYPE, is, 2);
+	if (problem != NULL) {
+		printf("buttons: %s: %s\n", p->name, problem);
+		return false;
+	}
+	printf("buttons: %s says type %#x, subtype %#x (the read took %llu us)\n", p->name, is[0], is[1], bus.last_ns / 1000);
+	if (is[0] != type || is[1] < subtype_from || is[1] > subtype_to) {
+		printf("buttons: ... which is not what this driver knows (type %#x, subtype %#x to %#x): left alone\n", type,
+		    subtype_from, subtype_to);
+		return false;
+	}
+	return true;
+}
+
+/* Step 4 for the power-on block: nothing to check but what it says now; its interrupt setup goes to the log. */
+static void
+pon_inputs(void)
+{
+	const char *problem;
+	uint8_t r[8], more[2];
+
+	printf("buttons: next: read the status and the interrupt setup of %s (registers 0x1310 to 0x1319)\n", pon.name);
+	problem = spmi_read(&pon, REG_RT_STATUS, r, 8);
+	if (problem == NULL) {
+		problem = spmi_read(&pon, REG_INT_LATCHED, more, 2);
+	}
+	if (problem != NULL) {
+		printf("buttons: %s: %s\n", pon.name, problem);
+		return;
+	}
+	printf("buttons: power-on block: status %#x (power %s, volume down %s); interrupts: edge %#x, high %#x, low %#x, "
+	    "enabled %#x, latched %#x, pending %#x\n", r[0], (r[0] & PON_KPDPWR) ? "HELD" : "released",
+	    (r[0] & PON_RESIN) ? "HELD" : "released", r[REG_INT_SET_TYPE - REG_RT_STATUS], r[REG_INT_POLARITY_HIGH - REG_RT_STATUS],
+	    r[REG_INT_POLARITY_LOW - REG_RT_STATUS], r[REG_INT_ENABLED - REG_RT_STATUS], more[0], more[1]);
+	power.usable = volume_down.usable = true;
+	power.last = r[0] & PON_KPDPWR;
+	volume_down.last = r[0] & PON_RESIN;
+}
+
+/* Step 4 for the pin: it is volume up only if it is an input with a pull-up, and switched on. */
+static void
+pin_input(void)
+{
+	const char *problem;
+	uint8_t c[8], status = 0;
+	unsigned mode, pull;
+
+	printf("buttons: next: read the setup and the level of %s (registers 0x8d40 to 0x8d47, 0x8d10)\n", pin.name);
+	problem = spmi_read(&pin, GPIO_REG_MODE, c, 8);
+	if (problem == NULL) {
+		problem = spmi_read(&pin, REG_RT_STATUS, &status, 1);
+	}
+	if (problem != NULL) {
+		printf("buttons: %s: %s\n", pin.name, problem);
+		return;
+	}
+	mode = c[0] & 3;
+	pull = c[GPIO_REG_PULL - GPIO_REG_MODE] & 7;
+	printf("buttons: volume up's pin: mode %u (%s), supply %u, pull %u (%s), %s; registers 0x40.. = %02x %02x %02x %02x %02x %02x "
+	    "%02x %02x; level %s\n", mode, mode == 0 ? "input" : mode == 1 ? "output" : mode == 2 ? "input and output" : "analog",
+	    c[GPIO_REG_SUPPLY - GPIO_REG_MODE] & 7, pull, pull < 4 ? "up" : pull == 4 ? "down" : "none",
+	    (c[GPIO_REG_ENABLE - GPIO_REG_MODE] & 0x80) ? "enabled" : "DISABLED", c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7],
+	    (status & GPIO_LEVEL) ? "high (released)" : "LOW (held)");
+	if (mode != 0 || pull >= 4 || !(c[GPIO_REG_ENABLE - GPIO_REG_MODE] & 0x80)) {
+		printf("buttons: volume up's pin is not an enabled input with a pull-up. Making it one is a write to the PMIC, "
+		    "which this driver does not do: volume up is left alone\n");
+		return;
+	}
+	volume_up.usable = true;
+	volume_up.last = !(status & GPIO_LEVEL);
+}
+
+static void
+say_summary(void)
+{
+	printf("buttons: so far %u presses of power, %u of volume up, %u of volume down; now%s%s%s%s; %llu reads of the bus, "
+	    "%llu us each (the longest %llu), %llu failed\n", power.presses, volume_up.presses, volume_down.presses,
+	    power.down ? " power" : "", volume_up.down ? " volume-up" : "", volume_down.down ? " volume-down" : "",
+	    (power.down || volume_up.down || volume_down.down) ? " held" : " none held", bus.reads,
+	    bus.reads ? bus.total_ns / bus.reads / 1000 : 0, bus.longest_ns / 1000, bus.failed);
+}
+
+static void
+buttons_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t steps = (uint32_t)(uintptr_t)parameter, version, channels;
+	bool pon_known, pin_known;
+
+	printf("buttons: step 1: map the PMIC arbiter (%#lx, %#lx, %#lx) and read its version\n", ARB_CORE_PHYS, ARB_CNFG_PHYS,
+	    ARB_OBSERVER_PHYS);
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_OBSERVER_SIZE);
+	version = rd(arb_core + ARB_VERSION);
+	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
+	printf("buttons: PMIC arbiter version %#x, %u channels\n", version, channels);
+	if (version < ARB_VERSION_5 || version >= ARB_VERSION_7) {
+		printf("buttons: this driver knows version 5 of the arbiter only: no buttons\n");
+		goto out;
+	}
+	if (channels == 0 || channels > ARB_MAX_CHANNELS) {
+		channels = ARB_MAX_CHANNELS;
+	}
+	if (steps < 2) {
+		goto out;
+	}
+
+	printf("buttons: step 2: look through the arbiter's table for the channels of the two peripherals\n");
+	find_channel(&pon, channels);
+	find_channel(&pin, channels);
+	if (steps < 3) {
+		goto out;
+	}
+
+	printf("buttons: step 3: the first transfers on the SPMI bus\n");
+	pon_known = identify(&pon, PON_TYPE, PON_SUBTYPE_HLOS, PON_SUBTYPE_HLOS);
+	pin_known = identify(&pin, GPIO_TYPE, GPIO_SUBTYPE_LV, GPIO_SUBTYPE_MV_VIN3);
+	if (steps < 4) {
+		goto out;
+	}
+
+	printf("buttons: step 4: how the keys' inputs are set up\n");
+	if (pon_known) {
+		pon_inputs();
+	}
+	if (pin_known) {
+		pin_input();
+	}
+	if (!power.usable && !volume_up.usable) {
+		printf("buttons: nothing that can be read: no buttons\n");
+		goto out;
+	}
+	if (power.last || volume_down.last || volume_up.last) {
+		printf("buttons: a key reads as held before anything was watched:%s%s%s. It is not reported until it has been "
+		    "seen released\n", power.last ? " power" : "", volume_up.last ? " volume-up" : "",
+		    volume_down.last ? " volume-down" : "");
+	}
+	/* (a key that is released now is believed at once) */
+	power.live = power.usable && !power.last;
+	volume_down.live = volume_down.usable && !volume_down.last;
+	volume_up.live = volume_up.usable && !volume_up.last;
+	if (steps < 5) {
+		goto out;
+	}
+
+	printf("buttons: step 5: watching%s%s%s, every %u ms: power is the side button\n", power.usable ? " power" : "",
+	    volume_up.usable ? " volume-up" : "", volume_down.usable ? " volume-down" : "", POLL_MS);
+	for (unsigned tick = 1;; tick++) {
+		buttons_poll();
+		/* once early on as well: a short run is to say what the reads cost too */
+		if (tick % MINUTE_TICKS == 0 || tick == 10 * 1000 / POLL_MS) {
+			say_summary();
+		}
+		if (bus.failed >= 1000 && bus.failed * 2 > bus.reads) {
+			printf("buttons: more than half of %llu reads have failed: giving up\n", bus.reads);
+			break;
+		}
+		delay_for_interval(POLL_MS, NSEC_PER_MSEC);
+	}
+out:
+	if (steps < 5) {
+		printf("buttons: stopping here (buttons_steps=%u)\n", steps);
+	}
+	thread_terminate(current_thread());
+}
+
+/*
+ * boot-arg press_power=<seconds>: a short press of the power key that many seconds after boot, and another ten
+ * seconds later, given to Darwin as the key's own are (hakios_touch_post): the lock, and the wake, tried with nobody
+ * at the phone. press_power_ms=<ms> is how long each is held (default 150: a tap; 3000 and up is a long press).
+ */
+static uint32_t press_ms = 150, press_left;
+static thread_call_t press_call;
+
+static void
+press_step(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	static bool down;
+	uint64_t deadline;
+	char when[64];
+
+	down = !down;
+	now_text(when, sizeof(when), mach_absolute_time());
+	printf("buttons: press_power: power %s at %s\n", down ? "PRESSED (by the test)" : "released (by the test)", when);
+	hakios_touch_post(down ? HAKIOS_BUTTON_DOWN : HAKIOS_BUTTON_UP, HAKIOS_BUTTON_LOCK, 0, 0);
+	if (down) {
+		clock_interval_to_deadline(press_ms, NSEC_PER_MSEC, &deadline);
+	} else if (--press_left > 0) {
+		clock_interval_to_deadline(10, NSEC_PER_SEC, &deadline);
+	} else {
+		return;
+	}
+	thread_call_enter_delayed(press_call, deadline);
+}
+
+static void
+press_power_init(void)
+{
+	uint32_t seconds = 0;
+	uint64_t deadline;
+
+	if (!PE_parse_boot_argn("press_power", &seconds, sizeof(seconds)) || seconds == 0) {
+		return;
+	}
+	PE_parse_boot_argn("press_power_ms", &press_ms, sizeof(press_ms));
+	press_left = 2;
+	press_call = thread_call_allocate(press_step, NULL);
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(press_call, deadline);
+	printf("buttons: press_power: the power key will be pressed for %u ms at %u s and at %u s\n", press_ms, seconds,
+	    seconds + 10);
+}
+
+void
+hakios_buttons_init(void)
+{
+	uint32_t enabled = 0, steps = 5;
+	thread_t thread;
+
+	press_power_init();
+
+	/*
+	 * On with the touch screen (the phone, somebody at it) unless buttons=0 says otherwise: a hand
+	 * has pressed all three keys and each press and release was read as it was made.
+	 */
+	if (!PE_parse_boot_argn("buttons", &enabled, sizeof(enabled))) {
+		uint32_t touch_screen = 0;
+
+		enabled = PE_parse_boot_argn("touchscreen", &touch_screen, sizeof(touch_screen)) && touch_screen != 0;
+	}
+	if (!enabled) {
+		return;
+	}
+	PE_parse_boot_argn("buttons_steps", &steps, sizeof(steps));
+	if (steps == 0) {
+		return;
+	}
+	if (kernel_thread_start(buttons_thread, (void *)(uintptr_t)steps, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * What interrupts would take, instead of looking 60 times a second:
+ *
+ *   - The arbiter has one interrupt line for all the PMICs' peripherals ("periph_irq": through the
+ *     power domain controller's pin 1 to the interrupt controller's SPI 481). This kernel has no
+ *     driver that takes a hardware interrupt other than the timer's so far; that is the first
+ *     thing to add (a handler registered for one more interrupt of the GICv3 the kernel already
+ *     drives, and that line unmasked and set to level, high).
+ *   - Per channel, the arbiter has an enable bit ("ACC_ENABLE"), a status and a clear register
+ *     (in the "chnls" region: 0x100, 0x104, 0x108 of 0x10000 per channel), and per system a
+ *     summary of which channels have something. Those are writes to the arbiter, not to a PMIC.
+ *   - But the peripheral must be told to raise them as well: for each key a bit in "interrupt
+ *     type" (edge), "polarity high" and "polarity low" (both edges), and "enable set". Those are
+ *     WRITES TO THE PMIC -- to the power-on block for power and volume down, to the GPIO for
+ *     volume up -- unless the firmware has left them set; step 4 prints what it finds there.
+ *     After an interrupt the peripheral's latched status is cleared by another write to it.
+ *   - Only the system that owns a peripheral's channel gets its interrupts (step 2 prints the
+ *     owners).
+ * Looking costs two reads of some tens of microseconds each, 60 times a second (the minute's
+ * summary line says what they really take), so the reason to want interrupts would not be
+ * processor time; it would be a system that sleeps and is to be woken by a key, and this one
+ * does not sleep.
+ */
diff --git a/bsd/dev/hakios.camera.c b/bsd/dev/hakios.camera.c
new file mode 100644
index 0000000..eca227b
--- /dev/null
+++ b/bsd/dev/hakios.camera.c
@@ -0,0 +1,4309 @@
+/*
+ * The cameras of the POCO X5 Pro (redwood): the macro one, an OmniVision OV02B10 (2 MP, Android's
+ * camera 2, "hakios_aac_ov02b10_macro"), the wide one, a Samsung S5KHM2SD (108 MP, Android's
+ * camera 0, "hakios_sunny_s5khm2sd_wide"), the front one and the ultra-wide one. Every address and
+ * number below belongs to this phone, from Android's own device tree (cam-sensor0 to cam-sensor3 and
+ * what they point to), the sensors' module files of Android's camera stack (/vendor/lib64/camera/com.qti.sensormodule.hakios_*.bin: the
+ * slave address, the chip ID and where it is read, the power sequence, the tables) and the drivers
+ * of the phone's kernel (MiCode hakios-s-oss: cam_sensor_util.c, qcom_pm8008-regulator.c,
+ * camcc-yupik.c, gdsc-regulator.c, pinctrl-yupik.c, pinctrl-spmi-gpio.c, cam_csiphy_*), read as
+ * data. The macro one (the others' differences are in sensors[] below and capture_sensor()):
+ *
+ *   the sensor     on CCI 1, master 0 (GPIO 73 data, 74 clock, function cci_i2c, internal pull-ups),
+ *                  slave address 0x3c; done by hand here, as the other drivers do their I2C (the
+ *                  two pins taken for each transaction and given back as they were found)
+ *   chip ID        Android reads it as a 16-bit register at the 16-bit address 0x0203 and wants
+ *                  0x002b (mask 0xffff); done the same way here
+ *   reset          GPIO 77, high = running
+ *   MCLK           camcc's mclk2 (RCG 0xe038, branch 0xe050) at 19.2 MHz on GPIO 66 (function
+ *                  cam_mclk, 4 mA); Android takes the 19.2 MHz from camcc's PLL2 (M/N 1/75), here
+ *                  it is the crystal's own 19.2 MHz (the RCG's source 0), with no PLL to start.
+ *                  Before it Android switches on the camera's top power domain ("cam_clk":
+ *                  titan_top_gdsc, camcc 0xc194), and so does this.
+ *   VDIG (DOVDD)   PM8008i's LDO6 at 1.8 V; VANA (AVDD) its LDO7 at 2.8 V (the device tree's
+ *                  voltages, normal power mode for the load Android asks). The PM8008i is on the
+ *                  serial engine 1's I2C (GPIO 4 data, 5 clock; addresses 0x08 for the chip, 0x09
+ *                  for the regulators, 16-bit registers), done by hand too; its reset pin is
+ *                  PM8350C GPIO 3 (output high, as Android's pinctrl "pm8008i_active" has it)
+ *   power-up       (the module file's): reset low, 1 ms; VDIG on; VANA on, 2 ms; MCLK on, 4 ms;
+ *                  reset high, 9 ms. Power-down: MCLK off; reset low, 1 ms; VANA off, 7 ms; VDIG off.
+ *                  (Both are read from the sensor's table at run time, as the wide one's are.)
+ *
+ * The wide one: CCI 0 master 1 (GPIO 71/72), slave address 0x20, chip ID 0xfad2 at 0x0000, reset
+ * GPIO 21, MCLK1 (RCG 0xe01c, branch 0xe034, GPIO 65); VDIG the PM8008i's LDO1 at 1.0 V, VIO its
+ * LDO5 at 1.8 V, VANA a fixed 2.8 V regulator that GPIO 106 switches; three C-PHY trios into
+ * CSIPHY 1.
+ *
+ * The front one, an OmniVision OV16A1Q (16 MP, cam-sensor1): CCI 0 master 0 (GPIO 69/70), slave
+ * 0x10, chip ID 0x1641 at 0x300b, reset GPIO 20, MCLK0 (GPIO 64); VANA LDO3 at 2.8 V, VDIG LDO2 at
+ * 1.2 V, VIO LDO5 at 1.8 V; four D-PHY lanes into CSIPHY 0.
+ *
+ * The ultra-wide one, a Samsung S5K4H7 (8 MP, cam-sensor3): CCI 1 master 1 (GPIO 75/76), slave
+ * 0x2d, chip ID 0x487b at 0x0000, reset GPIO 78, MCLK3 (GPIO 67) at the 24 MHz its module file
+ * asks for, from camcc's PLL2 (Android's 1440 MHz Zonda configuration); VANA LDO4 at 2.8 V, VIO
+ * LDO5 at 1.8 V, VDIG a fixed 1.2 V regulator that GPIO 108 switches; four D-PHY lanes into CSIPHY 3.
+ *
+ * Nothing here is done unless a boot-arg asks for it:
+ *
+ *   cam=1   a look, reading only: the camera's clocks and power domain as they are, the pins, the
+ *           PM8008i's reset pin, and if it is out of reset the PM8008i itself (its chip enable and
+ *           the two LDOs)
+ *   cam=2   ... and the sensor powered up as Android powers it, its chip ID read, and powered
+ *           down again (every write read back)
+ *   cam=3   the CSID's test pattern through RDI 0 and IFE-lite 0 into memory, which the loader hands
+ *           to the host after the run (xl camera): the camera subsystem's rails, PLL, clocks, SMMU
+ *           and blocks without the sensor (capture_tpg() below)
+ *   cam=4   the sensor's own frames that way, through its CSIPHY (capture_sensor() below)
+ *
+ * Boot-arg cam_sensor=wide picks the wide sensor; without it, the macro one.
+ *
+ * Limits, whatever asks: Android's voltages only (the device tree's: 1.8 and 2.8 V for the macro
+ * one, 1.0 and 1.8 V for the wide one, 1.2, 1.8 and 2.8 V for the front one, 1.8 and 2.8 V for the
+ * ultra-wide one; nothing else is ever written to the LDOs' set points); only the registers named above are written (a list each, checked at every
+ * write) and each is read back; any write that does not read back, a regulator that is not ready
+ * in time or reports over-current, a byte nobody acknowledges, and everything is switched off again
+ * in the power-down's order and nothing more is done. At the run's end (and on a panic's way out)
+ * whatever was switched on is switched off. Everything that was found switched on is left on.
+ * The camera subsystem's own registers (camcc's PLL0 and the clocks named there, the sensor's CSIPHY,
+ * CSID-lite 0, IFE-lite 0, one match register and context of the SMMU) are written the same way, read back
+ * where they keep what they are given, and taken back in the reverse order.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <vm/vm_kern.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/memory_types.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/hakios.audio.h>
+#include <sys/hakios.camera.h>
+#include <sys/hakios.input.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static uint32_t level;
+static bool broken, leaving;
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+/* every line to the loader's log as well (and to the console when that may be written) */
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != '\0'; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	}
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+static void
+give_up(const char *why)
+{
+	if (!broken) {
+		broken = true;
+		say("camera: %s: nothing more is written in this run\n", why);
+	}
+}
+
+/* ---- pins ------------------------------------------------------------------------------------------ */
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x100000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_PULL_UP             3
+#define CFG_OUTPUT              (1u << 9)
+#define CFG_FUNCTION(f)         ((uint32_t)(f) << 2)
+#define CFG_DRIVE_MA(ma)        ((uint32_t)((ma) / 2 - 1) << 6)
+
+#define PIN_PMIC_SDA            4       /* the serial engine 1's I2C: the PM8008i */
+#define PIN_PMIC_SCL            5
+
+static vm_offset_t tlmm;
+
+/*
+ * The four sensors, as Android's device tree has them (cam-sensor2 the macro, cam-sensor0 the wide,
+ * cam-sensor1 the front, cam-sensor3 the ultra-wide): the pins of their CCI master (taken by hand),
+ * the reset, MCLK (camcc RCG and branch, the pin and its function 1, cam_mclk, at 4 mA), the supplies
+ * the module file's power sequence switches (a PM8008i LDO at the device tree's voltage, or a GPIO
+ * that switches a fixed regulator), the CSIPHY with its clocks, and how the sensor's exposure
+ * registers are laid out. Boot-arg cam_sensor=macro|wide|front|ultra picks one (default: the macro,
+ * and for cam=5 the wide).
+ */
+enum { SUPPLY_NONE, SUPPLY_LDO, SUPPLY_GPIO };
+struct supply {
+	uint8_t         kind, ldo;      /* SUPPLY_LDO: PM8008i LDO n ... */
+	uint16_t        mv;             /* ... at this set point (the device tree's) */
+	uint16_t        gpio, ramp_us;  /* SUPPLY_GPIO: the pin, active high, and the regulator's ramp */
+};
+struct sensor_hw {
+	const char *    name;
+	const char *    tab;            /* in fw/ of the small image (tools/camsensor.py) */
+	const char *    bus_name;
+	unsigned        sda, scl, reset;
+	uint32_t        mclk_cmd, mclk_cbcr;
+	unsigned        mclk_pin;
+	struct supply   vana, vdig, vio;
+	unsigned        csiphy;
+	uint32_t        phy_cbcr, timer_cmd, timer_cbcr;
+	uint8_t         regs;           /* the exposure registers: REGS_OV_PAGED, REGS_SMIA or REGS_OV16 */
+	uint8_t         bayer;          /* the picture's order as it comes here (camraw.py's codes: 1 GRBG, 3 BGGR) */
+	uint8_t         pattern_bayer;  /* ... and its own colour bars' (its module file's "tpgon") */
+	const char *    chip;           /* for the frames' header */
+	uint16_t        gain_unity, gain_max;   /* the analog gain register's 1x, and the most it is given */
+};
+enum {
+	REGS_OV_PAGED,                  /* OmniVision, 8-bit registers in pages (0xfd): exposure 0x0e/0x0f, gain 0x22, VTS 0x14/0x15 */
+	REGS_SMIA,                      /* SMIA: frame length 0x0340, coarse integration 0x0202, analog gain 0x0204, hold 0x0104 */
+	REGS_OV16,                      /* OmniVision, 16-bit addresses: exposure 0x3500.., gain 0x3508, VTS 0x380e, hold 0x3208 */
+};
+static const struct sensor_hw sensors[] = {
+	{       /* cam-sensor2: OV02B10, CCI 1 master 0 (GPIO 73/74), reset GPIO 77, MCLK2 (GPIO 66), csiphy 2 */
+		.name = "macro (OV02B10)", .tab = "camera-ov02b10.tab", .bus_name = "CCI 1 master 0", .sda = 73, .scl = 74, .reset = 77,
+		.mclk_cmd = 0xe038, .mclk_cbcr = 0xe050, .mclk_pin = 66,
+		.vana = { SUPPLY_LDO, 7, 2800, 0, 0 }, .vdig = { SUPPLY_LDO, 6, 1800, 0, 0 }, .vio = { SUPPLY_NONE, 0, 0, 0, 0 },
+		.csiphy = 2, .phy_cbcr = 0xe110, .timer_cmd = 0xe0f4, .timer_cbcr = 0xe10c, .regs = REGS_OV_PAGED, .bayer = 3,
+		.pattern_bayer = 2, .chip = "OV02B10", .gain_unity = 16, .gain_max = 0xf8,
+	},
+	{       /* cam-sensor0: S5KHM2SD, CCI 0 master 1 (GPIO 71/72), reset GPIO 21, MCLK1 (GPIO 65), csiphy 1;
+		 * VANA: camera_wide_vana_ldo, a fixed 2.8 V regulator from BOB switched by GPIO 106 (ramp 135 us) */
+		.name = "wide (S5KHM2SD)", .tab = "camera-s5khm2sd.tab", .bus_name = "CCI 0 master 1", .sda = 71, .scl = 72, .reset = 21,
+		.mclk_cmd = 0xe01c, .mclk_cbcr = 0xe034, .mclk_pin = 65,
+		.vana = { SUPPLY_GPIO, 0, 2800, 106, 135 }, .vdig = { SUPPLY_LDO, 1, 1000, 0, 0 }, .vio = { SUPPLY_LDO, 5, 1800, 0, 0 },
+		.csiphy = 1, .phy_cbcr = 0xe0ec, .timer_cmd = 0xe0d0, .timer_cbcr = 0xe0e8, .regs = REGS_SMIA, .bayer = 1,
+		.pattern_bayer = 2, .chip = "S5KHM2SD", .gain_unity = 32, .gain_max = 0x800,
+	},
+	{       /* cam-sensor1: OV16A1Q, CCI 0 master 0 (GPIO 69/70), reset GPIO 20, MCLK0 (GPIO 64), csiphy 0 */
+		.name = "front (OV16A1Q)", .tab = "camera-ov16a1q.tab", .bus_name = "CCI 0 master 0", .sda = 69, .scl = 70, .reset = 20,
+		.mclk_cmd = 0xe000, .mclk_cbcr = 0xe018, .mclk_pin = 64,
+		.vana = { SUPPLY_LDO, 3, 2800, 0, 0 }, .vdig = { SUPPLY_LDO, 2, 1200, 0, 0 }, .vio = { SUPPLY_LDO, 5, 1800, 0, 0 },
+		.csiphy = 0, .phy_cbcr = 0xe0c8, .timer_cmd = 0xe0ac, .timer_cbcr = 0xe0c4, .regs = REGS_OV16, .bayer = 3,
+		.pattern_bayer = 0, .chip = "OV16A1Q", .gain_unity = 0x100, .gain_max = 0xf80,
+	},
+	{       /* cam-sensor3: S5K4H7, CCI 1 master 1 (GPIO 75/76), reset GPIO 78, MCLK3 (GPIO 67, 24 MHz: camcc's PLL2), csiphy 3;
+		 * VDIG: camera_ultra_dvdd_ldo, a fixed 1.2 V regulator from PM7325 S8 switched by GPIO 108 (ramp 135 us) */
+		.name = "ultra-wide (S5K4H7)", .tab = "camera-s5k4h7.tab", .bus_name = "CCI 1 master 1", .sda = 75, .scl = 76, .reset = 78,
+		.mclk_cmd = 0xe054, .mclk_cbcr = 0xe06c, .mclk_pin = 67,
+		.vana = { SUPPLY_LDO, 4, 2800, 0, 0 }, .vdig = { SUPPLY_GPIO, 0, 1200, 108, 135 }, .vio = { SUPPLY_LDO, 5, 1800, 0, 0 },
+		.csiphy = 3, .phy_cbcr = 0xe138, .timer_cmd = 0xe11c, .timer_cbcr = 0xe134, .regs = REGS_SMIA, .bayer = 1,
+		.pattern_bayer = 2, .chip = "S5K4H7", .gain_unity = 32, .gain_max = 0x200,
+	},
+};
+static const struct sensor_hw *hw = &sensors[0];
+static unsigned hw_index;
+
+static void
+show_pin(unsigned pin, const char *what)
+{
+	uint32_t cfg = rd(GPIO_CFG(pin)), io = rd(GPIO_IO(pin));
+
+	say("camera: gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", pin, what, (cfg >> 2) & 15, cfg & 3,
+	    (((cfg >> 6) & 7) + 1) * 2, (cfg & CFG_OUTPUT) ? (io & 2 ? "drives high" : "drives low") : "input", io & 1);
+}
+
+/* The pins written while powered up, as they were found, to be put back: the reset pin, MCLK's, a supply's. */
+static uint32_t found_reset_cfg, found_reset_io, found_mclk_cfg, found_vana_cfg, found_vana_io;
+static bool pins_found;
+
+/* the sensor's reset and MCLK pins as they are now (to be put back when it is powered down) */
+static void
+find_pins(void)
+{
+	found_reset_cfg = rd(GPIO_CFG(hw->reset));
+	found_reset_io = rd(GPIO_IO(hw->reset));
+	found_mclk_cfg = rd(GPIO_CFG(hw->mclk_pin));
+	pins_found = true;
+}
+
+static void
+reset_pin(bool high)
+{
+	wr(GPIO_IO(hw->reset), high ? 2 : 0);
+	wr(GPIO_CFG(hw->reset), CFG_OUTPUT | CFG_DRIVE_MA(2));         /* GPIO, no pull, 2 mA: Android's cam_sensor_active_* */
+}
+
+/* ---- I2C by hand (as in hakios.haptic.c) ---------------------------------------------------------- */
+
+struct bus {
+	const char *    name;
+	unsigned        sda, scl;
+	uint32_t        cfg[2], io[2];  /* the pins as they were found, while taken */
+};
+static struct bus pmic_bus = { .name = "the PM8008i's I2C", .sda = PIN_PMIC_SDA, .scl = PIN_PMIC_SCL };
+static struct bus cci_bus;              /* the sensor's (from hw) */
+
+static void
+half_bit(void)
+{
+	spin_us(5);                     /* 100 kHz at most */
+}
+
+static void
+line(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), 0);
+	wr(GPIO_CFG(pin), CFG_PULL_UP | (high ? 0 : CFG_OUTPUT));
+}
+
+static bool
+level_of(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+i2c_start(struct bus *b)
+{
+	line(b->sda, true);
+	line(b->scl, true);
+	half_bit();
+	line(b->sda, false);
+	half_bit();
+	line(b->scl, false);
+	half_bit();
+}
+
+static void
+i2c_stop(struct bus *b)
+{
+	line(b->sda, false);
+	half_bit();
+	line(b->scl, true);
+	half_bit();
+	line(b->sda, true);
+	half_bit();
+}
+
+static bool
+i2c_bit(struct bus *b, bool out)
+{
+	bool in;
+
+	line(b->sda, out);
+	half_bit();
+	line(b->scl, true);
+	for (unsigned stretched = 0; !level_of(b->scl) && stretched < 100; stretched++) {
+		half_bit();
+	}
+	half_bit();
+	in = level_of(b->sda);
+	line(b->scl, false);
+	return in;
+}
+
+static bool
+i2c_write(struct bus *b, uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_bit(b, (byte >> bit) & 1);
+	}
+	return !i2c_bit(b, true);
+}
+
+static uint8_t
+i2c_read(struct bus *b, bool more)
+{
+	uint8_t byte = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		byte = (uint8_t)(byte << 1 | i2c_bit(b, true));
+	}
+	i2c_bit(b, !more);
+	return byte;
+}
+
+static void
+bus_give_back(struct bus *b)
+{
+	wr(GPIO_IO(b->sda), b->io[0] & 2);
+	wr(GPIO_IO(b->scl), b->io[1] & 2);
+	wr(GPIO_CFG(b->sda), b->cfg[0]);
+	wr(GPIO_CFG(b->scl), b->cfg[1]);
+}
+
+/*
+ * A sensor stopped in the middle of a byte -- the camera switched away from it between frames, its
+ * digital rail left on because the driver found it on -- goes on holding the data line down, and the
+ * bus never comes to rest again however long one waits for it. The way out is the one Linux's
+ * bit-banged master takes (i2c_generic_scl_recovery): clock the line that is free until the sensor has
+ * finished that byte and lets the data line go, then a stop. Nine clocks are a byte and the
+ * acknowledgement after it. This is what kept the wide camera's bus (CCI 0 master 1) for the rest of a
+ * session once Camera.app had switched to the front camera and back.
+ */
+static bool
+bus_unwedge(struct bus *b)
+{
+	for (unsigned clocks = 1; clocks <= 9; clocks++) {
+		line(b->scl, false);
+		half_bit();
+		line(b->scl, true);
+		half_bit();
+		if (level_of(b->sda)) {
+			i2c_stop(b);
+			say("camera: %s: the data line was held down and came back after %u clock(s)\n", b->name, clocks);
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+bus_take(struct bus *b)
+{
+	b->cfg[0] = rd(GPIO_CFG(b->sda));
+	b->cfg[1] = rd(GPIO_CFG(b->scl));
+	b->io[0] = rd(GPIO_IO(b->sda));
+	b->io[1] = rd(GPIO_IO(b->scl));
+	line(b->sda, true);
+	line(b->scl, true);
+	half_bit();
+	if (level_of(b->sda) && level_of(b->scl)) {
+		return true;
+	}
+	/* the data line alone held down is a sensor that did not finish a byte: clock it out (see above) */
+	if (level_of(b->scl) && !level_of(b->sda) && bus_unwedge(b) && level_of(b->scl)) {
+		return true;
+	}
+	{
+		bool sda = level_of(b->sda), scl = level_of(b->scl);
+
+		bus_give_back(b);
+		say("camera: %s is not at rest (gpio%u reads %u, gpio%u reads %u): not touched\n", b->name, b->sda, sda, b->scl, scl);
+	}
+	return false;
+}
+
+/*
+ * A transaction: `out' (the register's address, and for a write the data) written, then for a read
+ * `in_count' bytes read after a repeated start. False if anybody did not acknowledge.
+ */
+static bool
+i2c_transfer(struct bus *b, uint8_t address, const uint8_t *out, unsigned out_count, uint8_t *in, unsigned in_count)
+{
+	bool answered;
+
+	if (!bus_take(b)) {
+		return false;
+	}
+	i2c_start(b);
+	answered = i2c_write(b, (uint8_t)(address << 1));
+	for (unsigned i = 0; answered && i < out_count; i++) {
+		answered = i2c_write(b, out[i]);
+	}
+	if (answered && in_count != 0) {
+		i2c_start(b);
+		answered = i2c_write(b, (uint8_t)(address << 1 | 1));
+		for (unsigned i = 0; answered && i < in_count; i++) {
+			in[i] = i2c_read(b, i + 1 < in_count);
+		}
+	}
+	i2c_stop(b);
+	bus_give_back(b);
+	return answered;
+}
+
+/* ---- the PMIC arbiter (version 5), for the PM8350C's GPIO 3: as in hakios.torch.c ------------------ */
+
+#define ARB_CORE_PHYS           0x0c440000UL
+#define ARB_CORE_SIZE           0x1100UL
+#define ARB_CNFG_PHYS           0x0c40a000UL
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_OBSERVER_PHYS       0x0e600000UL
+#define ARB_OBSERVER_SIZE       0x10000UL
+#define ARB_CHNLS_PHYS          0x0c600000UL
+#define ARB_SYSTEM              0
+
+#define ARB_VERSION             0x000
+#define ARB_CHANNEL(n)          (0x900 + 4 * (n))
+#define ARB_OWNER(n)            (0x700 + 4 * (n))
+#define ARB_MAX_CHANNELS        512
+
+#define CHANNEL_COMMAND         0x00
+#define CHANNEL_STATUS          0x08
+#define CHANNEL_WDATA0          0x10
+#define OBSERVER_DATA0          0x18
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define COMMAND_WRITE           (0u << 27)
+#define COMMAND_READ            (1u << 27)
+#define TRANSFER_TIMEOUT_US     2000
+#define DROPPED                 "the transfer was dropped"
+
+#define PGPIO_ID                0x28a   /* the PM8350C (slave 2), GPIO 3's peripheral (0x8800 + 0x100 x 2) */
+#define PGPIO_TYPE              0x04    /* 0x10: a GPIO */
+#define PGPIO_SUBTYPE           0x05
+#define PGPIO_RT_STS            0x10    /* [0] what the pin is at */
+#define PGPIO_MODE_CTL          0x40    /* LV/MV: [1:0] direction (1 output) */
+#define PGPIO_DIG_VIN_CTL       0x41    /* [2:0] which supply: 0 = VIN0 ("power-source 0") */
+#define PGPIO_DIG_PULL_CTL      0x42    /* [2:0] 5 = no pull */
+#define PGPIO_OUT_SOURCE_CTL    0x44    /* LV/MV: [7] the level (inverted "normal"), [3:0] the function: 0 normal */
+#define PGPIO_EN_CTL            0x46    /* [7] enabled */
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer, pgpio_write;
+static uint16_t pgpio_channel;
+static bool pgpio_found, pgpio_writable;
+
+static const char *
+wait_done(vm_offset_t channel)
+{
+	uint64_t start = mach_absolute_time(), interval;
+	uint32_t status;
+
+	nanoseconds_to_absolutetime(TRANSFER_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	do {
+		status = rd(channel + CHANNEL_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	return !(status & STATUS_DONE) ? "no answer from the arbiter" : (status & STATUS_DENIED) ? "the arbiter refuses" :
+	       (status & STATUS_FAILURE) ? "the transfer failed" : (status & STATUS_DROPPED) ? DROPPED : NULL;
+}
+
+static void
+lock(void)
+{
+	if (!leaving) {
+		hakios_spmi_lock();
+	}
+}
+
+static void
+unlock(void)
+{
+	if (!leaving) {
+		hakios_spmi_unlock();
+	}
+}
+
+static const char *
+pgpio_read(uint8_t reg, uint8_t *value)
+{
+	vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * pgpio_channel;
+	const char *problem = "no channel";
+
+	for (int tries = 0; pgpio_found && tries < 3; tries++) {
+		lock();
+		wr(channel + CHANNEL_COMMAND, COMMAND_READ | (uint32_t)reg << 4);
+		problem = wait_done(channel);
+		*value = (uint8_t)rd(channel + OBSERVER_DATA0);
+		unlock();
+		if (problem == NULL || strcmp(problem, DROPPED) != 0) {
+			break;
+		}
+	}
+	return problem;
+}
+
+/* One of GPIO 3's five registers above written and read back (when `force', also after something went wrong). */
+static bool
+pgpio_put(uint8_t reg, uint8_t value, bool force)
+{
+	const char *problem = NULL;
+	uint8_t back = 0xff;
+
+	if ((broken && !force) || !pgpio_writable || pgpio_write == 0 || (reg != PGPIO_MODE_CTL && reg != PGPIO_DIG_VIN_CTL &&
+	    reg != PGPIO_DIG_PULL_CTL && reg != PGPIO_OUT_SOURCE_CTL && reg != PGPIO_EN_CTL)) {
+		give_up("a write to the PM8350C that may not be made");
+		return false;
+	}
+	if (((rd(arb_core + ARB_CHANNEL(pgpio_channel)) >> 8) & 0xfff) != PGPIO_ID) {
+		give_up("the arbiter's channel is no longer the PM8350C's GPIO 3");
+		return false;
+	}
+	for (int tries = 0; tries < 3; tries++) {
+		lock();
+		wr(pgpio_write + CHANNEL_WDATA0, value);
+		wr(pgpio_write + CHANNEL_COMMAND, COMMAND_WRITE | (uint32_t)reg << 4);
+		problem = wait_done(pgpio_write);
+		unlock();
+		if (problem == NULL || strcmp(problem, DROPPED) != 0) {
+			break;
+		}
+	}
+	if (problem != NULL || (problem = pgpio_read(reg, &back)) != NULL || back != value) {
+		say("camera: PM8350C GPIO 3 %#04x <- %#04x: %s (reads %#04x)\n", reg, value, problem ? problem : "does not read back", back);
+		give_up("a write to the PM8350C that failed");
+		return false;
+	}
+	return true;
+}
+
+static void
+pgpio_find(void)
+{
+	for (uint32_t n = 0; n < ARB_MAX_CHANNELS; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n)), owner;
+
+		if (map == 0 || ((map >> 8) & 0xfff) != PGPIO_ID) {
+			continue;
+		}
+		owner = rd(arb_cnfg + ARB_OWNER(n)) & 7;
+		say("camera: channel %u is the PM8350C's GPIO 3 (%#x); written by system %u%s\n", n, map, owner,
+		    owner == ARB_SYSTEM ? ", which is us" : "");
+		if (!pgpio_found || owner == ARB_SYSTEM) {
+			pgpio_found = true;
+			pgpio_channel = (uint16_t)n;
+			pgpio_writable = owner == ARB_SYSTEM;
+		}
+	}
+	if (pgpio_found && pgpio_writable) {
+		pgpio_write = ml_io_map(ARB_CHNLS_PHYS + 0x10000UL * pgpio_channel, 0x1000);
+	}
+}
+
+/* GPIO 3 as Android's "pm8008i_active" has it: enabled, an output of the normal function, high, VIN0, no pull. */
+static uint8_t pgpio_found_regs[5];             /* DIG_VIN_CTL, DIG_PULL_CTL, MODE_CTL, OUT_SOURCE_CTL, EN_CTL as found */
+static bool pgpio_changed;
+
+static bool
+pgpio_active(uint8_t *regs)
+{
+	return (regs[0] & 7) == 0 && (regs[1] & 7) == 5 && (regs[2] & 3) == 1 && regs[3] == 0x80 && (regs[4] & 0x80);
+}
+
+static const uint8_t pgpio_which[5] = { PGPIO_DIG_VIN_CTL, PGPIO_DIG_PULL_CTL, PGPIO_MODE_CTL, PGPIO_OUT_SOURCE_CTL, PGPIO_EN_CTL };
+
+static bool
+pgpio_read_all(uint8_t *regs)
+{
+	for (int i = 0; i < 5; i++) {
+		if (pgpio_read(pgpio_which[i], &regs[i]) != NULL) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---- the PM8008i ----------------------------------------------------------------------------------- */
+
+#define PM8008_CHIP             0x08    /* its I2C addresses: the chip ... */
+#define PM8008_REGULATORS       0x09    /* ... and its regulators */
+#define REVID_BASE              0x0100
+#define MISC_CHIP_ENABLE        0x0950  /* [0] */
+#define LDO_BASE(n)             (0x4000 + 0x100 * ((n) - 1))
+#define LDO_STATUS1             0x08    /* [7] ready, [5] over-current, [1:0] mode: 3 normal, 2 low power */
+#define LDO_VSET_LB             0x40    /* the set point in mV, low byte ... */
+#define LDO_VSET_UB             0x41    /* ... high byte */
+#define LDO_MODE_CTL1           0x45    /* [2:0] 7 normal, 4 low power */
+#define LDO_ENABLE              0x46    /* [7] */
+
+/* LDO n is one of the sensor's supplies, at that set point. */
+static bool
+sensor_ldo(unsigned n, unsigned mv)
+{
+	const struct supply *all[3] = { &hw->vana, &hw->vdig, &hw->vio };
+
+	for (int i = 0; i < 3; i++) {
+		if (all[i]->kind == SUPPLY_LDO && all[i]->ldo == n && (mv == 0 || all[i]->mv == mv)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * The PM8008i's I2C is bit-banged, on a bus whose lines the phone's own firmware holds as well, and
+ * a transfer now and then goes unanswered -- more often the longer the run, and most often right
+ * after the camera has been switched off and on again. Taken for a fault the first time, the camera
+ * was gone for the rest of the run (give_up: nothing more is written); asked again, the chip
+ * answers. The number of goes that were needed is said at the end of the run.
+ */
+#define PM8008_GOES             4
+
+static uint64_t pm8008_retries;
+
+static bool
+pm8008_get(uint8_t address, uint16_t reg, uint8_t *values, unsigned count)
+{
+	uint8_t where[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+
+	for (unsigned go = 0; go < PM8008_GOES; go++) {
+		if (i2c_transfer(&pmic_bus, address, where, 2, values, count)) {
+			pm8008_retries += go;
+			return true;
+		}
+		wait_ms(1);
+	}
+	pm8008_retries += PM8008_GOES;
+	return false;
+}
+
+/* The registers the PM8008i may be written in: the chip enable, and the set point, mode and enable of the sensor's LDOs. */
+static bool
+pm8008_put(uint8_t address, uint16_t reg, uint8_t value, bool force)
+{
+	uint8_t out[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, value }, back = 0xff;
+	uint16_t base = reg & 0xff00, offset = reg & 0xff;
+	bool allowed = (address == PM8008_CHIP && reg == MISC_CHIP_ENABLE) ||
+	    (address == PM8008_REGULATORS && base >= LDO_BASE(1) && base <= LDO_BASE(7) && sensor_ldo((base - LDO_BASE(1)) / 0x100 + 1, 0) &&
+	    (offset == LDO_MODE_CTL1 || offset == LDO_ENABLE || offset == LDO_VSET_LB || offset == LDO_VSET_UB));
+
+	if ((broken && !force) || !allowed) {
+		give_up(allowed ? "a write to the PM8008i after a fault" : "a PM8008i register that is not to be written");
+		return false;
+	}
+	for (unsigned go = 0; go < PM8008_GOES; go++) {
+		if (i2c_transfer(&pmic_bus, address, out, 3, NULL, 0) && pm8008_get(address, reg, &back, 1) && back == value) {
+			pm8008_retries += go;
+			return true;
+		}
+		wait_ms(1);
+	}
+	say("camera: PM8008i %#04x:%#06x <- %#04x: %s (reads %#04x), %u goes\n", address, reg, value, back == 0xff ? "no answer" :
+	    "does not read back", back, PM8008_GOES);
+	give_up("a write to the PM8008i that failed");
+	return false;
+}
+
+static void
+show_ldo(unsigned n)
+{
+	uint8_t status = 0, vset[2] = { 0, 0 }, mode = 0, enable = 0;
+
+	if (pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_STATUS1), &status, 1) &&
+	    pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_VSET_LB), vset, 2) &&
+	    pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_MODE_CTL1), &mode, 1) &&
+	    pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_ENABLE), &enable, 1)) {
+		say("camera: PM8008i LDO%u: status %#04x (%sready%s, mode %u), set to %u mV, mode control %#04x, enable %#04x\n", n,
+		    status, status & 0x80 ? "" : "not ", status & 0x20 ? ", OVER-CURRENT" : "", status & 3, vset[1] << 8 | vset[0], mode,
+		    enable);
+	} else {
+		say("camera: PM8008i LDO%u: no answer\n", n);
+	}
+}
+
+/*
+ * An LDO on as Android's regulator framework puts it on (set point, load -> normal mode, enable),
+ * then ready within 10 tries of the driver's wait, and not over its current.
+ */
+static bool ldo_was_on[8], ldo_switched[8];
+
+static bool
+ldo_on(unsigned n, unsigned mv)
+{
+	uint16_t base = (uint16_t)LDO_BASE(n);
+	uint8_t enable = 0, mode = 0, status = 0;
+
+	if (!sensor_ldo(n, mv)) {
+		give_up("a voltage that is not Android's");
+		return false;
+	}
+	if (!pm8008_get(PM8008_REGULATORS, (uint16_t)(base + LDO_ENABLE), &enable, 1) ||
+	    !pm8008_get(PM8008_REGULATORS, (uint16_t)(base + LDO_MODE_CTL1), &mode, 1)) {
+		give_up("a PM8008i that does not answer");
+		return false;
+	}
+	ldo_was_on[n] = enable & 0x80;
+	if (ldo_was_on[n]) {
+		say("camera: PM8008i LDO%u was on already: left as it is\n", n);
+		return true;
+	}
+	if (!pm8008_put(PM8008_REGULATORS, (uint16_t)(base + LDO_VSET_LB), (uint8_t)mv, false) ||
+	    !pm8008_put(PM8008_REGULATORS, (uint16_t)(base + LDO_VSET_UB), (uint8_t)(mv >> 8), false) ||
+	    !pm8008_put(PM8008_REGULATORS, (uint16_t)(base + LDO_MODE_CTL1), (uint8_t)((mode & ~7) | 7), false)) {
+		return false;
+	}
+	ldo_switched[n] = true;
+	if (!pm8008_put(PM8008_REGULATORS, (uint16_t)(base + LDO_ENABLE), (uint8_t)(enable | 0x80), false)) {
+		return false;
+	}
+	for (int tries = 0, allones = 0; tries < 10; tries++) {
+		spin_us(20 + mv * 1000 / 38400 + 1);   /* the driver's wait: 20 us and the set point at the stepper's 38.4 mV/us */
+		if (!pm8008_get(PM8008_REGULATORS, (uint16_t)(base + LDO_STATUS1), &status, 1)) {
+			give_up("a PM8008i that does not answer");
+			return false;
+		}
+		/*
+		 * A byte with every bit set is not a status: a good one reads 0x87, and the bits between
+		 * "ready" and the mode are not used. It is what this bus reads when the PM8008i has not
+		 * answered properly, as it does for a few goes right after the front camera's rails have
+		 * gone down -- and it was read as an over-current, which switched the camera off for the
+		 * rest of the run just as Camera.app went back to the wide camera. Ask again.
+		 */
+		if (status == 0xff) {
+			if (allones++ == 0) {
+				say("camera: PM8008i LDO%u: a status of all ones, which is no answer: asking again\n", n);
+			}
+			continue;
+		}
+		if (status & 0x20) {
+			uint8_t again = 0;
+
+			/* as healthy() does while it runs: an over-current counts when it is still there */
+			wait_ms(2);
+			if (pm8008_get(PM8008_REGULATORS, (uint16_t)(base + LDO_STATUS1), &again, 1) && !(again & 0x20)) {
+				say("camera: PM8008i LDO%u: status %#04x, and %#04x when asked again\n", n, status, again);
+				status = again;
+			} else {
+				say("camera: PM8008i LDO%u reports over-current (status %#04x)\n", n, status);
+				give_up("an LDO over its current");
+				return false;
+			}
+		}
+		if (status & 0x80) {
+			say("camera: PM8008i LDO%u on at %u mV (status %#04x)\n", n, mv, status);
+			return true;
+		}
+	}
+	say("camera: PM8008i LDO%u not ready (status %#04x)\n", n, status);
+	give_up(status == 0xff ? "a PM8008i whose status is all ones" : "an LDO that is not ready");
+	return false;
+}
+
+static void
+ldo_off(unsigned n)
+{
+	uint8_t enable = 0;
+
+	if (!ldo_switched[n]) {
+		return;
+	}
+	if (pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_ENABLE), &enable, 1) &&
+	    pm8008_put(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_ENABLE), (uint8_t)(enable & ~0x80), true)) {
+		ldo_switched[n] = false;
+		say("camera: PM8008i LDO%u off\n", n);
+	} else {
+		say("camera: PM8008i LDO%u COULD NOT BE SWITCHED OFF\n", n);
+	}
+}
+
+/* ---- the camera's clocks: camcc --------------------------------------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_CAMERA_AHB_CBCR     0x26004         /* always on (gcc-yupik.c keeps it so) */
+#define GCC_CAMERA_XO_CBCR      0x26028
+#define CAMCC_PHYS              0x0ad00000UL
+#define CAMCC_SIZE              0x20000UL
+#define MCLK_CMD_RCGR           (hw->mclk_cmd)          /* [0] update, [31] the root is off */
+#define MCLK_CFG_RCGR           (hw->mclk_cmd + 4)      /* [4:0] divider (2n - 1), [10:8] source (0: the crystal), [13:12] M/N mode */
+#define MCLK_M                  (hw->mclk_cmd + 8)
+#define MCLK_N                  (hw->mclk_cmd + 12)
+#define MCLK_D                  (hw->mclk_cmd + 16)
+#define MCLK_CBCR               (hw->mclk_cbcr)         /* [0] enable, [31] the clock is off */
+#define TITAN_TOP_GDSCR         0xc194          /* [0] collapse, [11] keep the registers, [31] on */
+#define CBCR_OFF                (1u << 31)
+#define CMD_UPDATE              1u
+#define GDSC_COLLAPSE           1u
+#define GDSC_ON                 (1u << 31)
+
+static vm_offset_t gcc, camcc;
+static uint32_t found_mclk_cfg_rcgr, found_mclk_cbcr, found_gdscr, found_mclk_mnd[3];
+static bool gdsc_switched, mclk_switched, pll2_switched;
+
+/*
+ * camcc's PLL2 (Zonda), for the 24 MHz MCLK the ultra-wide sensor's module file asks for:
+ * camcc-yupik.c's cam_cc_pll2_config ("1440MHz Configuration"), set as clk_zonda_pll_configure()
+ * and started as clk_zonda_pll_enable() do it; the MCLK RCG takes its early output (source 5)
+ * divided by 10 and by M/N 1/6 (ftbl_cam_cc_mclk0_clk_src's 24 MHz). Taken down as
+ * clk_zonda_pll_disable() does, with the MCLK.
+ */
+#define PLL2_BASE               0x2000
+#define PLL2_MODE               0x00            /* [0] outputs, [1] out of bypass, [2] out of reset, [20] voted, [29] frequency locked, [31] locked */
+#define PLL2_L_VAL              0x04
+#define PLL2_USER_CTL           0x0c            /* [3:0] the outputs */
+#define PLL2_CONFIG_CTL         0x10
+#define PLL2_CONFIG_CTL_U       0x14
+#define PLL2_CONFIG_CTL_U1      0x18
+#define PLL2_TEST_CTL           0x1c            /* [16] stays in CFA (then the frequency lock is what to wait for) */
+#define PLL2_OPMODE             0x28            /* 0 standby, 1 run */
+#define PLL2_STATUS             0x38
+
+static void
+show_clocks(void)
+{
+	say("camera: GCC: camera AHB %#x, camera XO %#x\n", rd(gcc + GCC_CAMERA_AHB_CBCR), rd(gcc + GCC_CAMERA_XO_CBCR));
+	say("camera: camcc: titan top GDSC %#x; the sensor's MCLK RCG cmd %#x cfg %#x m %#x n %#x d %#x, branch %#x\n", rd(camcc + TITAN_TOP_GDSCR),
+	    rd(camcc + MCLK_CMD_RCGR), rd(camcc + MCLK_CFG_RCGR), rd(camcc + MCLK_M), rd(camcc + MCLK_N), rd(camcc + MCLK_D),
+	    rd(camcc + MCLK_CBCR));
+}
+
+/* camcc's registers: only these, each read back (an RCG's update bit and a GDSC's status by waiting for them) */
+static bool
+camcc_put(uint32_t offset, uint32_t value, uint32_t check_mask)
+{
+	if (offset != TITAN_TOP_GDSCR && offset != MCLK_CFG_RCGR && offset != MCLK_CMD_RCGR && offset != MCLK_CBCR && offset != MCLK_M &&
+	    offset != MCLK_N && offset != MCLK_D && !(offset >= PLL2_BASE && offset <= PLL2_BASE + PLL2_STATUS)) {
+		give_up("a camcc register that is not to be written");
+		return false;
+	}
+	wr(camcc + offset, value);
+	if ((rd(camcc + offset) & check_mask) != (value & check_mask)) {
+		say("camera: camcc %#x <- %#x, but it reads %#x\n", offset, value, rd(camcc + offset));
+		give_up("a camcc register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+wait_bits(uint32_t offset, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t waited = 0; waited <= us; waited += 10) {
+		if ((rd(camcc + offset) & mask) == want) {
+			return true;
+		}
+		spin_us(10);
+	}
+	return false;
+}
+
+static bool
+gdsc_on(void)
+{
+	found_gdscr = rd(camcc + TITAN_TOP_GDSCR);
+	if (!(found_gdscr & GDSC_COLLAPSE) && (found_gdscr & GDSC_ON)) {
+		say("camera: the titan top power domain was on already\n");
+		return true;
+	}
+	if (!camcc_put(TITAN_TOP_GDSCR, found_gdscr & ~GDSC_COLLAPSE, GDSC_COLLAPSE)) {
+		return false;
+	}
+	gdsc_switched = true;
+	spin_us(1);
+	if (!wait_bits(TITAN_TOP_GDSCR, GDSC_ON, GDSC_ON, 100)) {
+		say("camera: the titan top power domain does not come on (%#x)\n", rd(camcc + TITAN_TOP_GDSCR));
+		give_up("a power domain that does not come on");
+		return false;
+	}
+	say("camera: the titan top power domain on (%#x)\n", rd(camcc + TITAN_TOP_GDSCR));
+	return true;
+}
+
+static void
+gdsc_off(void)
+{
+	if (!gdsc_switched) {
+		return;
+	}
+	wr(camcc + TITAN_TOP_GDSCR, rd(camcc + TITAN_TOP_GDSCR) | GDSC_COLLAPSE);
+	gdsc_switched = false;
+	say("camera: the titan top power domain %s (%#x)\n", wait_bits(TITAN_TOP_GDSCR, GDSC_ON, 0, 100) ? "off" : "NOT OFF",
+	    rd(camcc + TITAN_TOP_GDSCR));
+}
+
+/* MCLK at 19.2 MHz: the RCG from the crystal, divider 1, no M/N; then the branch; then the pin. */
+static bool
+pll2_up(void)
+{
+	uint32_t mode = rd(camcc + PLL2_BASE + PLL2_MODE);
+
+	if (mode & (1u | 1u << 20)) {
+		give_up("camcc's PLL2 is running or voted for already (somebody else's)");
+		return false;
+	}
+	pll2_switched = true;
+	/* clk_zonda_pll_configure() */
+	if (!camcc_put(PLL2_BASE + PLL2_L_VAL, 0x4b, ~0u) || !camcc_put(PLL2_BASE + PLL2_CONFIG_CTL, 0x08200800, ~0u) ||
+	    !camcc_put(PLL2_BASE + PLL2_CONFIG_CTL_U, 0x05022011, ~0u) || !camcc_put(PLL2_BASE + PLL2_CONFIG_CTL_U1, 0x08000000, ~0u) ||
+	    !camcc_put(PLL2_BASE + PLL2_USER_CTL, 0x00000301, ~0u) ||
+	    !camcc_put(PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) & ~2u, 2) ||
+	    !camcc_put(PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) & ~1u, 1) ||
+	    !camcc_put(PLL2_BASE + PLL2_OPMODE, 0, 1) ||
+	    !camcc_put(PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) | 4u, 4)) {
+		return false;
+	}
+	/* clk_zonda_pll_enable(): out of bypass, 1 us, out of reset, run, locked, the outputs on */
+	if (!camcc_put(PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) | 2u, 2)) {
+		return false;
+	}
+	spin_us(1);
+	if (!camcc_put(PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) | 4u, 4) || !camcc_put(PLL2_BASE + PLL2_OPMODE, 1, 1)) {
+		return false;
+	}
+	uint32_t lock = rd(camcc + PLL2_BASE + PLL2_TEST_CTL) & (1u << 16) ? 1u << 29 : 1u << 31;
+
+	if (!wait_bits(PLL2_BASE + PLL2_MODE, lock, lock, 1000)) {
+		say("camera: camcc's PLL2 does not lock (mode %#x)\n", rd(camcc + PLL2_BASE + PLL2_MODE));
+		give_up("a PLL that does not lock");
+		return false;
+	}
+	if (!camcc_put(PLL2_BASE + PLL2_USER_CTL, rd(camcc + PLL2_BASE + PLL2_USER_CTL) | 0xf, 0xf) ||
+	    !camcc_put(PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) | 1u, 1)) {
+		return false;
+	}
+	say("camera: camcc's PLL2 locked at 1440 MHz (mode %#x, user_ctl %#x)\n", rd(camcc + PLL2_BASE + PLL2_MODE),
+	    rd(camcc + PLL2_BASE + PLL2_USER_CTL));
+	return true;
+}
+
+static void
+pll2_down(void)
+{
+	if (!pll2_switched) {
+		return;
+	}
+	wr(camcc + PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) & ~1u);
+	wr(camcc + PLL2_BASE + PLL2_USER_CTL, rd(camcc + PLL2_BASE + PLL2_USER_CTL) & ~0xfu);
+	wr(camcc + PLL2_BASE + PLL2_MODE, rd(camcc + PLL2_BASE + PLL2_MODE) & ~6u);
+	wr(camcc + PLL2_BASE + PLL2_OPMODE, 0);
+	pll2_switched = false;
+	say("camera: camcc's PLL2 off (mode %#x)\n", rd(camcc + PLL2_BASE + PLL2_MODE));
+}
+
+/* MCLK at 19.2 MHz from the crystal itself, or at 24 MHz from PLL2 (khz: the module file's rate) */
+static bool
+mclk_on(uint32_t khz)
+{
+	bool pll = khz == 24000;
+
+	found_mclk_cfg_rcgr = rd(camcc + MCLK_CFG_RCGR);
+	found_mclk_cbcr = rd(camcc + MCLK_CBCR);
+	found_mclk_mnd[0] = rd(camcc + MCLK_M);
+	found_mclk_mnd[1] = rd(camcc + MCLK_N);
+	found_mclk_mnd[2] = rd(camcc + MCLK_D);
+	if (found_mclk_cbcr & 1) {
+		give_up("MCLK is on already (somebody else's)");
+		return false;
+	}
+	if (pll) {
+		/* __clk_rcg2_configure(): M 1, N as ~(n - m), D as ~2d (2d = n), then source 5, divider 2 * 10 - 1, dual-edge M/N */
+		if (!pll2_up() || !camcc_put(MCLK_M, (found_mclk_mnd[0] & ~0xffu) | 1, 0xff) ||
+		    !camcc_put(MCLK_N, (found_mclk_mnd[1] & ~0xffu) | (~(6u - 1) & 0xff), 0xff) ||
+		    !camcc_put(MCLK_D, (found_mclk_mnd[2] & ~0xffu) | (~6u & 0xff), 0xff)) {
+			mclk_switched = true;
+			return false;
+		}
+	}
+	mclk_switched = true;
+	if (!camcc_put(MCLK_CFG_RCGR, (found_mclk_cfg_rcgr & ~0x371fu) | (pll ? 5u << 8 | 2u << 12 | 19u : 0u << 8 | 1u), 0x371f) ||
+	    !camcc_put(MCLK_CMD_RCGR, rd(camcc + MCLK_CMD_RCGR) | CMD_UPDATE, 0)) {
+		return false;
+	}
+	if (!wait_bits(MCLK_CMD_RCGR, CMD_UPDATE, 0, 500)) {
+		say("camera: MCLK's RCG does not take its configuration (cmd %#x)\n", rd(camcc + MCLK_CMD_RCGR));
+		give_up("an RCG that does not update");
+		return false;
+	}
+	if (!camcc_put(MCLK_CBCR, found_mclk_cbcr | 1, 1)) {
+		return false;
+	}
+	if (!wait_bits(MCLK_CBCR, CBCR_OFF, 0, 500)) {
+		say("camera: MCLK's branch does not come on (%#x)\n", rd(camcc + MCLK_CBCR));
+		give_up("a clock that does not come on");
+		return false;
+	}
+	wr(GPIO_CFG(hw->mclk_pin), CFG_FUNCTION(1) | CFG_DRIVE_MA(4));    /* cam_mclk, no pull, 4 mA: cam_macro_mclk_active, cam_wide_mclk_active */
+	say("camera: MCLK on at %u.%u MHz (RCG cfg %#x, branch %#x)\n", khz / 1000, khz % 1000 / 100, rd(camcc + MCLK_CFG_RCGR),
+	    rd(camcc + MCLK_CBCR));
+	return true;
+}
+
+static void
+mclk_off(void)
+{
+	if (!mclk_switched) {
+		return;
+	}
+	if (pins_found) {
+		wr(GPIO_CFG(hw->mclk_pin), found_mclk_cfg);
+	}
+	wr(camcc + MCLK_CBCR, rd(camcc + MCLK_CBCR) & ~1u);
+	(void)wait_bits(MCLK_CBCR, CBCR_OFF, CBCR_OFF, 500);
+	wr(camcc + MCLK_CFG_RCGR, found_mclk_cfg_rcgr);
+	wr(camcc + MCLK_CMD_RCGR, rd(camcc + MCLK_CMD_RCGR) | CMD_UPDATE);
+	(void)wait_bits(MCLK_CMD_RCGR, CMD_UPDATE, 0, 500);
+	if (pll2_switched) {
+		wr(camcc + MCLK_M, found_mclk_mnd[0]);
+		wr(camcc + MCLK_N, found_mclk_mnd[1]);
+		wr(camcc + MCLK_D, found_mclk_mnd[2]);
+		pll2_down();
+	}
+	mclk_switched = false;
+	say("camera: MCLK off (branch %#x, RCG cfg %#x as found)\n", rd(camcc + MCLK_CBCR), rd(camcc + MCLK_CFG_RCGR));
+}
+
+/* ---- the sensor's tables, its power and its ID ---------------------------------------------------------- */
+
+/*
+ * The sensor's tables are Android's, read at run time from fw/ of the small image, where
+ * userland/build.sh puts what tools/camsensor.py makes of the sensor's module file ("RWCTAB02"):
+ * the slave address and the chip ID's read, the lane assignment, the modes, the power sequences
+ * (Android's cam_sensor kinds: 0 MCLK, 1 VANA, 2 VDIG, 3 VIO, 8 RESET, with their delays) and the
+ * register tables (init, res0.., on, off, ...).
+ */
+struct ctab_head {
+	char            magic[8];       /* "RWCTAB02" */
+	uint32_t        slave, address_bytes, data_bytes, id_address, id, id_mask, lane_assign, modes;
+};
+struct ctab_mode {
+	uint32_t        width, height, x, y, lanes, cphy, settle, pixel_clock, line_length, frame_length, fps_milli, data_type;
+};
+struct ctab_entry {
+	uint16_t        address, data;  /* (a power sequence's: kind, value -- MCLK in kHz) */
+	uint8_t         address_bytes, data_bytes, operation, zero;
+	uint32_t        delay_us;
+};
+
+static const struct ctab_head *ctab;
+static const struct ctab_mode *ctab_modes;
+
+/* the sensor the rest works on: its descriptor, its CCI master's pins (its tables are loaded afresh: ctab_load()) */
+static void
+select_sensor(unsigned i)
+{
+	hw_index = i;
+	hw = &sensors[i];
+	cci_bus.name = hw->bus_name;
+	cci_bus.sda = hw->sda;
+	cci_bus.scl = hw->scl;
+	ctab = NULL;
+}
+static const uint8_t *ctab_power, *ctab_tables;
+static uint64_t ctab_size;
+
+static bool
+ctab_load(void)
+{
+	const uint8_t *at, *end;
+
+	ctab = (const struct ctab_head *)hakios_image_file("fw", hw->tab, &ctab_size, NULL);
+	if (ctab == NULL || ctab_size < sizeof(*ctab) || memcmp(ctab->magic, "RWCTAB02", 8) != 0 || ctab->modes == 0 ||
+	    ctab->modes > 16) {
+		say("camera: no %s (RWCTAB02) in fw/ of the small image (made from fw-camera/ when it is built)\n", hw->tab);
+		ctab = NULL;
+		return false;
+	}
+	end = (const uint8_t *)ctab + ctab_size;
+	ctab_modes = (const struct ctab_mode *)(ctab + 1);
+	ctab_power = (const uint8_t *)(ctab_modes + ctab->modes);
+	at = ctab_power;
+	for (int p = 0; p < 2; p++) {
+		if (at + 12 > end) {
+			ctab = NULL;
+			return false;
+		}
+		at += 12 + *(const uint32_t *)(at + 8) * sizeof(struct ctab_entry);
+	}
+	ctab_tables = at;
+	if (ctab_tables + 4 > end) {
+		ctab = NULL;
+		return false;
+	}
+	say("camera: the %s sensor's tables: slave %#x, chip ID %#x at %#x, lanes %#x, %u modes, %u tables\n", hw->name, ctab->slave,
+	    ctab->id, ctab->id_address, ctab->lane_assign, ctab->modes, *(const uint32_t *)ctab_tables);
+	for (uint32_t m = 0; m < ctab->modes; m++) {
+		const struct ctab_mode *o = &ctab_modes[m];
+
+		say("camera:   mode %u: %ux%u at %u,%u, %u %s, settle %u, pixel clock %u, line %u, frame %u, %u.%03u frames/s\n", m, o->width,
+		    o->height, o->x, o->y, o->lanes, o->cphy ? "trio(s), C-PHY" : "lane(s), D-PHY", o->settle, o->pixel_clock,
+		    o->line_length, o->frame_length, o->fps_milli / 1000, o->fps_milli % 1000);
+	}
+	return true;
+}
+
+static const struct ctab_entry *
+ctab_block(const uint8_t *at, uint32_t blocks, const char *name, uint32_t *count)
+{
+	const uint8_t *end = (const uint8_t *)ctab + ctab_size;
+
+	for (uint32_t t = 0; t < blocks && at + 12 <= end; t++) {
+		uint32_t n = *(const uint32_t *)(at + 8);
+
+		if (strncmp((const char *)at, name, 8) == 0 && at + 12 + n * sizeof(struct ctab_entry) <= end) {
+			*count = n;
+			return (const struct ctab_entry *)(at + 12);
+		}
+		at += 12 + n * sizeof(struct ctab_entry);
+	}
+	*count = 0;
+	return NULL;
+}
+
+static const struct ctab_entry *
+ctab_find(const char *name, uint32_t *count)
+{
+	return ctab == NULL ? NULL : ctab_block(ctab_tables + 4, *(const uint32_t *)ctab_tables, name, count);
+}
+
+static uint8_t
+sensor_address(void)
+{
+	return (uint8_t)(ctab->slave >> 1);    /* (the module file's is the 8-bit one) */
+}
+
+static bool chip_enable_switched, powered, reset_driven, vana_gpio_switched;
+
+/* A GPIO-switched supply (the wide sensor's VANA, the ultra-wide's VDIG): the pin a high output (GPIO, no pull, 2 mA: cam_sensor_active_*). */
+static bool
+supply_on(const struct supply *s)
+{
+	if (s->kind == SUPPLY_LDO) {
+		return ldo_on(s->ldo, s->mv);
+	}
+	if (s->kind == SUPPLY_GPIO) {
+		found_vana_cfg = rd(GPIO_CFG(s->gpio));
+		found_vana_io = rd(GPIO_IO(s->gpio));
+		vana_gpio_switched = true;
+		wr(GPIO_IO(s->gpio), 2);
+		wr(GPIO_CFG(s->gpio), CFG_OUTPUT | CFG_DRIVE_MA(2));
+		if ((rd(GPIO_CFG(s->gpio)) & 0x3ff) != (CFG_OUTPUT | CFG_DRIVE_MA(2)) || !(rd(GPIO_IO(s->gpio)) & 2)) {
+			give_up("a supply's pin that does not read back");
+			return false;
+		}
+		spin_us(s->ramp_us);
+		say("camera: gpio%u high: the fixed %u.%u V regulator on\n", s->gpio, s->mv / 1000, s->mv % 1000 / 100);
+		return true;
+	}
+	give_up("a supply this sensor does not have");
+	return false;
+}
+
+static void
+supply_off(const struct supply *s)
+{
+	if (s->kind == SUPPLY_LDO) {
+		ldo_off(s->ldo);
+	} else if (s->kind == SUPPLY_GPIO && vana_gpio_switched) {
+		wr(GPIO_IO(s->gpio), 0);
+		spin_us(10);
+		wr(GPIO_IO(s->gpio), found_vana_io & 2);
+		wr(GPIO_CFG(s->gpio), found_vana_cfg);
+		vana_gpio_switched = false;
+		say("camera: gpio%u back as it was found: the fixed regulator off\n", s->gpio);
+	}
+}
+
+static void
+sensor_delay(uint32_t us)
+{
+	if (us >= 1000) {
+		wait_ms(us / 1000);
+		us %= 1000;
+	}
+	spin_us(us);
+}
+
+/* One step of the module file's power sequence (`up': part of the power-up, where a fault stops it). */
+static bool
+power_step(const struct ctab_entry *e, bool up)
+{
+	const struct supply *s = e->address == 1 ? &hw->vana : e->address == 2 ? &hw->vdig : e->address == 3 ? &hw->vio : NULL;
+
+	switch (e->address) {
+	case 8:
+		reset_driven = true;
+		reset_pin(e->data != 0);
+		break;
+	case 0:
+		if (e->data != 0 && e->data != 19200 && e->data != 24000) {
+			give_up("an MCLK rate not known here");
+			return false;
+		}
+		if (e->data != 0) {
+			if (!up || !gdsc_on() || !mclk_on(e->data)) {
+				return false;
+			}
+		} else {
+			mclk_off();
+		}
+		break;
+	case 1: case 2: case 3:
+		if (s->kind == SUPPLY_NONE) {
+			give_up("a supply the device tree does not give this sensor");
+			return false;
+		}
+		if (e->data != 0) {
+			if (!up || !supply_on(s)) {
+				return false;
+			}
+		} else {
+			supply_off(s);
+		}
+		break;
+	default:
+		say("camera: a power step of kind %u, which this does not know\n", e->address);
+		give_up("a power sequence not understood");
+		return false;
+	}
+	/* (capped at 100 ms, as the sensor tables' delays are: a corrupt table must not keep the rails up or spin for minutes) */
+	sensor_delay(e->delay_us > 100000 ? 100000 : e->delay_us);
+	return true;
+}
+
+/* Everything that was switched on, off again: the module file's power-down, then the rest as it was found. */
+static void
+power_down(void)
+{
+	bool was = powered || mclk_switched || gdsc_switched || reset_driven || chip_enable_switched || pgpio_changed ||
+	    vana_gpio_switched;
+	uint32_t count = 0;
+	const struct ctab_entry *e = ctab != NULL ? ctab_block(ctab_power, 2, "pwrdn", &count) : NULL;
+
+	for (unsigned n = 1; n <= 7; n++) {
+		was |= ldo_switched[n];
+	}
+	if (!was) {
+		return;
+	}
+	say("camera: powering down\n");
+	for (uint32_t i = 0; e != NULL && i < count; i++) {
+		(void)power_step(&e[i], false);
+	}
+	/* (whatever the sequence did not reach) */
+	mclk_off();
+	if (reset_driven) {
+		reset_pin(false);
+	}
+	supply_off(&hw->vio);
+	supply_off(&hw->vana);
+	supply_off(&hw->vdig);
+	gdsc_off();
+	/*
+	 * The PM8008i itself stays as it is between one use of the camera and the next: out of reset and
+	 * enabled, with its LDOs off (they are switched above). Put back into reset it does come out
+	 * again -- it answers for its revision at 0x08 -- but its regulators are deaf from then on (a
+	 * write to 0x09 reads back 0xff), and the camera is gone for the rest of the run. It is put back
+	 * as it was found when the kernel leaves (hakios_camera_quiesce), which is where Android gets
+	 * the phone back.
+	 */
+	if (leaving && chip_enable_switched) {
+		uint8_t enable = 0;
+
+		if (pm8008_get(PM8008_CHIP, MISC_CHIP_ENABLE, &enable, 1) &&
+		    pm8008_put(PM8008_CHIP, MISC_CHIP_ENABLE, (uint8_t)(enable & ~1), true)) {
+			say("camera: the PM8008i's chip enable back off\n");
+		} else {
+			say("camera: the PM8008i's chip enable COULD NOT BE PUT BACK\n");
+		}
+		chip_enable_switched = false;
+	}
+	if (leaving && pgpio_changed) {
+		uint8_t now[5];
+		bool all = pgpio_read_all(now);
+
+		for (int i = 4; all && i >= 0; i--) {
+			if (now[i] != pgpio_found_regs[i]) {
+				all &= pgpio_put(pgpio_which[i], pgpio_found_regs[i], true);
+			}
+		}
+		say("camera: the PM8350C's GPIO 3 %s\n", all ? "back as it was found" : "COULD NOT BE PUT BACK");
+		pgpio_changed = false;
+	}
+	if (reset_driven && pins_found) {
+		wr(GPIO_IO(hw->reset), found_reset_io & 2);
+		wr(GPIO_CFG(hw->reset), found_reset_cfg);
+		reset_driven = false;
+	}
+	powered = false;
+	if (pm8008_retries != 0) {
+		say("camera: powered down (the PM8008i needed %llu more goes on its I2C)\n", pm8008_retries);
+	} else {
+		say("camera: powered down\n");
+	}
+}
+
+/* The PM8008i out of reset (its reset pin as Android drives it) and enabled. */
+static bool
+pm8008_up(void)
+{
+	uint8_t regs[5], revid[4] = { 0 }, enable = 0;
+
+	if (!pgpio_read_all(regs)) {
+		give_up("the PM8350C's GPIO 3 cannot be read");
+		return false;
+	}
+	if (!pgpio_changed) {           /* (as Android left it, which is what the run's end puts back) */
+		memcpy(pgpio_found_regs, regs, sizeof(regs));
+	}
+	if (!pgpio_active(regs)) {
+		uint8_t want[5] = { (uint8_t)(regs[0] & ~7), (uint8_t)((regs[1] & ~7) | 5), (uint8_t)((regs[2] & ~3) | 1), 0x80,
+			            (uint8_t)(regs[4] | 0x80) };
+
+		say("camera: the PM8008i is held in reset (GPIO 3 vin, pull, mode, source, enable: %02x %02x %02x %02x %02x): let out as "
+		    "Android lets it out\n", regs[0], regs[1], regs[2], regs[3], regs[4]);
+		pgpio_changed = true;
+		for (int i = 0; i < 5; i++) {
+			/* (only what differs, in the order Android's pinctrl driver writes them: the enable last) */
+			if (want[i] != regs[i] && !pgpio_put(pgpio_which[i], want[i], false)) {
+				return false;
+			}
+		}
+		wait_ms(5);
+	}
+	if (!pm8008_get(PM8008_CHIP, REVID_BASE, revid, 4)) {
+		give_up("the PM8008i does not answer");
+		return false;
+	}
+	say("camera: the PM8008i answers: revision %02x %02x %02x %02x\n", revid[0], revid[1], revid[2], revid[3]);
+	if (!pm8008_get(PM8008_CHIP, MISC_CHIP_ENABLE, &enable, 1)) {
+		give_up("the PM8008i does not answer");
+		return false;
+	}
+	if (!(enable & 1)) {
+		if (!pm8008_put(PM8008_CHIP, MISC_CHIP_ENABLE, (uint8_t)(enable | 1), false)) {
+			return false;
+		}
+		chip_enable_switched = true;
+		say("camera: the PM8008i's chip enabled\n");
+	}
+	return true;
+}
+
+/* The module file's power-up, step by step. */
+static bool
+power_up(void)
+{
+	uint32_t count = 0;
+	const struct ctab_entry *e = ctab != NULL ? ctab_block(ctab_power, 2, "pwrup", &count) : NULL;
+
+	if (e == NULL) {
+		give_up("no power sequence");
+		return false;
+	}
+	powered = true;
+	if (!pm8008_up()) {
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		if (!power_step(&e[i], true)) {
+			return false;
+		}
+	}
+	say("camera: the %s sensor powered up (%u steps)\n", hw->name, count);
+	return true;
+}
+
+static bool
+read_chip_id(void)
+{
+	uint8_t where[2] = { (uint8_t)(ctab->id_address >> 8), (uint8_t)ctab->id_address }, id[4] = { 0, 0, 0, 0 };
+	unsigned out = ctab->address_bytes == 2 ? 2 : 1, in = ctab->data_bytes >= 1 && ctab->data_bytes <= 4 ? ctab->data_bytes : 2;
+	uint32_t chip = 0;
+
+	/*
+	 * The first word asked of the sensor after its supplies have come up. Powered up again within a
+	 * run -- the capture graph stops and starts the stream as the application reconfigures its
+	 * session -- it is not always ready by the time the power sequence's own waits are over, and one
+	 * unanswered transfer used to end the camera for the rest of the run. It is asked again, for as
+	 * long as the sensor's own data sheet would have it waiting.
+	 */
+	unsigned go;
+
+	for (go = 0; go < 20; go++) {
+		if (i2c_transfer(&cci_bus, sensor_address(), out == 2 ? where : where + 1, out, id, in)) {
+			break;
+		}
+		wait_ms(2);
+	}
+	if (go == 20) {
+		say("camera: the %s sensor does not answer at %#04x\n", hw->name, sensor_address());
+		return false;
+	}
+	if (go != 0) {
+		say("camera: the %s sensor answered at %#04x after %u more goes (%u ms)\n", hw->name, sensor_address(), go, go * 2);
+	}
+	for (unsigned i = 0; i < in; i++) {
+		chip = chip << 8 | id[i];
+	}
+	say("camera: the %s sensor's chip ID: %#06x (%s)\n", hw->name, chip, (chip & ctab->id_mask) == (ctab->id & ctab->id_mask) ?
+	    "as Android expects" : "NOT what Android expects");
+	return (chip & ctab->id_mask) == (ctab->id & ctab->id_mask);
+}
+
+/*
+ * While powered up: the LDOs switched on still ready and not over their current. An over-current is
+ * asked again 2 ms on before it counts: the lens motor's moves show one on LDO5 for an instant (at a
+ * move of a few hundred steps, now and then), and the camera went on as before every time it was not
+ * looked at then.
+ */
+static bool
+healthy(void)
+{
+	for (unsigned n = 1; n <= 7; n++) {
+		uint8_t status = 0;
+
+		if (!ldo_switched[n]) {
+			continue;
+		}
+		for (int look = 0; look < 2; look++) {
+			if (!pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_STATUS1), &status, 1) || !(status & 0x80)) {
+				break;
+			}
+			if (!(status & 0x20)) {
+				break;
+			}
+			if (look == 0) {
+				say("camera: PM8008i LDO%u: status %#04x, asked again\n", n, status);
+				wait_ms(2);
+			}
+		}
+		if (!(status & 0x80) || (status & 0x20)) {
+			say("camera: PM8008i LDO%u: status %#04x\n", n, status);
+			give_up("an LDO that is no longer well");
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---- the camera subsystem's surroundings, read only: rails, the SMMU, camcc's PLLs ------------------- */
+
+/*
+ * What the camera's blocks need beyond the sensor (a look first, nothing written): the CX and MX
+ * rails' levels (camcc's clocks at Android's rates want CX at SVS and, for PLL0's 1.2 GHz, MX at
+ * SVS_L1), asked of RPMh by level positions from the boot loader's command database; what the
+ * application processors' RPMh sequencer (DRV 2) holds for them; the two rails' set points in their
+ * regulators (PM8350C S2 and S10); what the SMMU has for the IFEs' streams (dt: 0x800 and 0xc00 with
+ * the mask 0x4e0); camcc's PLL0 and PLL6.
+ */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x18220000UL    /* DRV 2's (dt: rsc@18200000, drv-id 2) */
+#define RSC_TCS_BASE            0xd00
+#define RSC_TCS(n)              (RSC_TCS_BASE + 672 * (n))
+#define TCS_CONTROL             0x14
+#define TCS_STATUS              0x18
+#define TCS_ENABLED             0x1c
+#define TCS_COMMAND(c)          (0x30 + 20 * (c))       /* message id, address, value, status */
+#define RSC_TCS_COUNT           8               /* dt qcom,tcs-config: 2 active, 3 sleep, 3 wake */
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+static const struct cmd_db_header *cmd_db;
+static vm_offset_t rsc;
+
+/* RPMh's address for a resource, and its levels (as many as `max'); 0: not there. */
+static uint32_t
+rpmh_resource(const char *name, uint16_t *levels, unsigned max, unsigned *count)
+{
+	char id[8] = { 0 };
+
+	*count = 0;
+	if (cmd_db == NULL) {
+		cmd_db = (const struct cmd_db_header *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	}
+	if (!(cmd_db->magic[0] == 0xdb && cmd_db->magic[1] == 0x30 && cmd_db->magic[2] == 0x03 && cmd_db->magic[3] == 0x0c)) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &cmd_db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(cmd_db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			const uint8_t *data;
+
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((unsigned)slave->data_offset + entry[i].offset + entry[i].length > CMD_DB_SIZE - 0x1000) {
+				return entry[i].address;
+			}
+			data = cmd_db->data + slave->data_offset + entry[i].offset;
+			for (unsigned l = 0; l < entry[i].length / 2u && l < max; l++) {
+				levels[l] = (uint16_t)(data[2 * l] | data[2 * l + 1] << 8);
+				if (l > 0 && levels[l] == 0) {
+					break;
+				}
+				*count = l + 1;
+			}
+			return entry[i].address;
+		}
+	}
+	return 0;
+}
+
+static void
+show_rail(const char *name, uint32_t *address)
+{
+	uint16_t levels[16];
+	unsigned count;
+	char line[200];
+	int at;
+
+	*address = rpmh_resource(name, levels, 16, &count);
+	at = snprintf(line, sizeof(line), "camera: RPMh's %s at %#x, levels:", name, *address);
+	for (unsigned l = 0; l < count && at < (int)sizeof(line) - 8; l++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %u", levels[l]);
+	}
+	say("%s\n", line);
+	/* what DRV 2's sequencer holds for it, in any of its TCSs */
+	for (unsigned t = 0; *address != 0 && t < RSC_TCS_COUNT; t++) {
+		uint32_t enabled = rd(rsc + RSC_TCS(t) + TCS_ENABLED);
+
+		for (unsigned c = 0; c < 16; c++) {
+			uint32_t where = rd(rsc + RSC_TCS(t) + TCS_COMMAND(c) + 4);
+
+			if (where == *address) {
+				say("camera:   TCS %u command %u: value %u (position), %senabled, message id %#x, status %#x\n", t, c,
+				    rd(rsc + RSC_TCS(t) + TCS_COMMAND(c) + 8), (enabled >> c) & 1 ? "" : "not ",
+				    rd(rsc + RSC_TCS(t) + TCS_COMMAND(c)), rd(rsc + RSC_TCS(t) + TCS_COMMAND(c) + 12));
+			}
+		}
+	}
+}
+
+/* A PMIC peripheral's registers, read through the arbiter's observer (any channel that is that peripheral's). */
+static bool
+pmic_peek(uint16_t id, uint8_t reg, uint8_t *values, unsigned count)
+{
+	for (uint32_t n = 0; n < ARB_MAX_CHANNELS; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n));
+
+		if (map == 0 || ((map >> 8) & 0xfff) != id) {
+			continue;
+		}
+		for (unsigned i = 0; i < count; i++) {
+			vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * n;
+
+			lock();
+			wr(channel + CHANNEL_COMMAND, COMMAND_READ | (uint32_t)(reg + i) << 4);
+			const char *problem = wait_done(channel);
+			values[i] = (uint8_t)rd(channel + OBSERVER_DATA0);
+			unlock();
+			if (problem != NULL) {
+				return false;
+			}
+		}
+		return true;
+	}
+	return false;
+}
+
+static void
+show_smps(const char *what, uint16_t id)
+{
+	uint8_t head[2] = { 0, 0 }, set[4] = { 0, 0, 0, 0 }, status[2] = { 0, 0 };
+
+	if (!pmic_peek(id, 0x04, head, 2) || !pmic_peek(id, 0x40, set, 4) || !pmic_peek(id, 0x08, status, 2)) {
+		say("camera: %s (peripheral %#x): cannot be read\n", what, id);
+		return;
+	}
+	say("camera: %s (peripheral %#x): type %#04x subtype %#04x, status %02x %02x, 0x40-0x43: %02x %02x %02x %02x (%u mV?)\n",
+	    what, id, head[0], head[1], status[0], status[1], set[0], set[1], set[2], set[3], set[1] << 8 | set[0]);
+}
+
+#define SMMU_PHYS               0x15000000UL
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SMR(n)             (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream */
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))       /* [17:16] 0 translate 1 bypass 2 fault, [7:0] context */
+#define IFE_STREAM              0x800                   /* dt: msm_cam_smmu_ife, iommus 0x800.. 0xce0, mask 0x4e0 */
+#define IFE_STREAM_MASK         0x4e0
+
+static vm_offset_t smmu;
+
+static void
+show_smmu(void)
+{
+	uint32_t scr0 = rd(smmu + SMMU_SCR0), idr0 = rd(smmu + SMMU_IDR0), idr1 = rd(smmu + SMMU_IDR1), free_matches = 0;
+	bool used[256] = { false };
+	unsigned contexts = idr1 & 0xff, free_contexts = 0;
+
+	for (uint32_t n = 0; n < (idr0 & 0xff) && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr = rd(smmu + SMMU_S2CR(n));
+		uint32_t stream = smr & 0x7fff, mask = smr >> 16 & 0x7fff;
+
+		if (!(smr >> 31)) {
+			free_matches++;
+			continue;
+		}
+		used[s2cr & 0xff] = true;
+		for (uint32_t ife = 0; ife < 0x10; ife++) {
+			uint32_t sid = (ife < 8 ? 0x800 : 0xc00) + 0x20 * (ife & 7);
+
+			if (((stream ^ sid) & ~mask) == 0) {
+				say("camera: SMMU match register %u (stream %#x mask %#x, s2cr %#x) covers the IFEs' stream %#x\n", n, stream,
+				    mask, s2cr, sid);
+				break;
+			}
+		}
+	}
+	for (unsigned c = 0; c < contexts; c++) {
+		free_contexts += !used[c];
+	}
+	say("camera: the SMMU: scr0 %#x (a stream nobody matches %s), %u match registers free, %u of %u contexts unused by them\n", scr0,
+	    scr0 & (1u << 10) ? "faults" : "passes", free_matches, free_contexts, contexts);
+}
+
+static void
+show_plls(void)
+{
+	for (unsigned p = 0; p <= 6; p += 6) {
+		vm_offset_t pll = camcc + 0x1000UL * p;
+
+		say("camera: camcc PLL%u: mode %#x, l %#x, cal_l %#x, user_ctl %#x %#x, config_ctl %#x %#x %#x, opmode %#x, status %#x, "
+		    "alpha %#x\n", p, rd(pll + 0x00), rd(pll + 0x04), rd(pll + 0x08), rd(pll + 0x0c), rd(pll + 0x10), rd(pll + 0x18),
+		    rd(pll + 0x1c), rd(pll + 0x20), rd(pll + 0x38), rd(pll + 0x30), rd(pll + 0x40));
+	}
+}
+
+static void
+look_around(void)
+{
+	uint32_t cx = 0, mx = 0;
+
+	if (rsc == 0) {
+		rsc = ml_io_map(RSC_PHYS, 0x10000);
+		smmu = ml_io_map(SMMU_PHYS, 0x1000);
+	}
+	show_rail("cx.lvl", &cx);
+	show_rail("mx.lvl", &mx);
+	show_smps("PM8350C S2 (VDD_CX)", 0x217);
+	show_smps("PM8350C S10 (VDD_MX)", 0x22f);
+	show_smmu();
+	show_plls();
+}
+
+/* ---- the camera subsystem (Titan 165): rails, PLL0, clocks ------------------------------------------- */
+
+/*
+ * cam=3: the path a picture takes, tried first with the CSID's own test pattern generator, so that
+ * nothing outside the SoC is involved: CSID-lite 0 (0xacc8000, "csid-lite165": the register layout
+ * of Android's cam_ife_csid_lite17x.h) makes RAW10 frames of a colour bar and sends them down its
+ * RDI 0 path to IFE-lite 0 (0xacc4000, "vfe-lite165": cam_vfe_lite16x.h, the bus of
+ * cam_vfe_bus_ver2.c), whose write master 0 writes each frame as it comes (Android's RDI frame mode)
+ * to memory through the SMMU, as stream 0x800 with the mask 0x4e0 (dt: msm_cam_smmu_ife), into a
+ * context of ours. The memory is one physically contiguous piece that the loader hands to the host
+ * after the run ("xl camera"; tools/camraw.py makes pictures of it).
+ *
+ * What it takes, in Android's order and with Android's numbers (camcc-yupik.c, gcc-yupik.c, the
+ * device tree's clock rates at the "svs" level of csid-lite 0, the sensor's csiphy and cpas):
+ *   RPMh   CX at SVS (128) for camcc's clocks at 400 MHz, MX at SVS_L1 (192) for PLL0's 1.2 GHz --
+ *          asked through DRV 2's second TCS for requests made at once, as camcc's vdd_cx and vdd_mx
+ *          votes are, and given back (position 0) at the end: DRV 2 holds no other vote on them
+ *          (cam=1 looks: none of its TCSs has a command for either)
+ *   GCC    camera_hf_axi (0x26010), camera_sf_axi (0x2601c)
+ *   camcc  PLL0 (Lucid, 1200 MHz: L 0x3e, alpha 0x8000, its config and user values), then the RCGs
+ *          slow_ahb 80 MHz, camnoc_axi 150, cphy_rx 400, csiNphytimer 300, ife_lite_0_csid 400,
+ *          ife_lite_0 400 (all from PLL0's even (600) or odd (400) output) and the branches
+ *          cpas_ahb, camnoc_axi, csiphyN, csiNphytimer, ife_lite_0_csid, ife_lite_0_cphy_rx,
+ *          ife_lite_0 (the clocks the device tree gives cpas, the csiphy and csid-lite 0; N is the
+ *          sensor's CSIPHY: 2 for the macro one and for the test pattern, 1 for the wide one)
+ * Everything is taken back in the reverse order at the end, and on any fault.
+ */
+#define RSC_IRQ_STATUS          (RSC_TCS_BASE + 0x04)
+#define RSC_IRQ_CLEAR           (RSC_TCS_BASE + 0x08)
+#define TCS_WAIT_FOR_DONE       0x10
+#define TCS_ACTIVE_MODE         (1u << 16)
+#define TCS_TRIGGER             (1u << 24)
+#define MSGID_WRITE_WAITED      (8u | 1u << 8 | 1u << 16)
+#define CAMERA_TCS              1                       /* the second TCS for requests made at once (the audio DSP's driver takes the first) */
+#define CX_LEVEL                128                     /* SVS */
+#define MX_LEVEL                192                     /* SVS_L1 */
+
+static bool rails_voted;
+
+/* The position of the first level at or above `level' in RPMh's list for that rail; -1: not there. */
+static int
+rail_position(const char *name, uint32_t level, uint32_t *address)
+{
+	uint16_t levels[16];
+	unsigned count;
+
+	*address = rpmh_resource(name, levels, 16, &count);
+	for (unsigned l = 0; *address != 0 && l < count; l++) {
+		if (levels[l] >= level) {
+			return (int)l;
+		}
+	}
+	return -1;
+}
+
+/* Up to three writes to RPMh's resources through the camera's TCS, waited for. True: RPMh has said done. */
+static bool
+rpmh_write(unsigned n, const uint32_t *addresses, const uint32_t *values)
+{
+	vm_offset_t tcs = rsc + RSC_TCS(CAMERA_TCS);
+	uint32_t done = 0, all = (1u << n) - 1;
+
+	if (rd(tcs + TCS_STATUS) == 0) {
+		say("camera: TCS %u of the sequencer is busy (control %#x)\n", CAMERA_TCS, rd(tcs + TCS_CONTROL));
+		return false;
+	}
+	wr(rsc + RSC_IRQ_CLEAR, 1u << CAMERA_TCS);
+	for (unsigned r = 0; r < n; r++) {
+		wr(tcs + TCS_COMMAND(r), MSGID_WRITE_WAITED);
+		wr(tcs + TCS_COMMAND(r) + 4, addresses[r]);
+		wr(tcs + TCS_COMMAND(r) + 8, values[r]);
+	}
+	wr(tcs + TCS_WAIT_FOR_DONE, all);
+	wr(tcs + TCS_ENABLED, all);
+	wr(tcs + TCS_CONTROL, rd(tcs + TCS_CONTROL) & ~TCS_TRIGGER);
+	wr(tcs + TCS_CONTROL, rd(tcs + TCS_CONTROL) | TCS_ACTIVE_MODE);
+	wr(tcs + TCS_CONTROL, rd(tcs + TCS_CONTROL) | TCS_TRIGGER);
+	/* (each command's status: [8] issued, [16] completed -- the TCS's interrupt may not be enabled for this one) */
+	for (unsigned waited = 0; waited < 100000 && !done; waited += 50) {
+		unsigned completed = 0;
+
+		for (unsigned r = 0; r < n; r++) {
+			completed += (rd(tcs + TCS_COMMAND(r) + 12) >> 16) & 1;
+		}
+		done = (rd(rsc + RSC_IRQ_STATUS) & (1u << CAMERA_TCS)) || completed == n;
+		if (!done) {
+			spin_us(50);
+		}
+	}
+	say("camera: RPMh's TCS %u: interrupt status %#x (enabled %#x), the commands' status %#x %#x %#x\n", CAMERA_TCS,
+	    rd(rsc + RSC_IRQ_STATUS), rd(rsc + RSC_TCS_BASE), rd(tcs + TCS_COMMAND(0) + 12), n > 1 ? rd(tcs + TCS_COMMAND(1) + 12) : 0,
+	    n > 2 ? rd(tcs + TCS_COMMAND(2) + 12) : 0);
+	wr(rsc + RSC_IRQ_CLEAR, 1u << CAMERA_TCS);
+	wr(tcs + TCS_CONTROL, rd(tcs + TCS_CONTROL) & ~(TCS_TRIGGER | TCS_ACTIVE_MODE));
+	wr(tcs + TCS_ENABLED, 0);
+	return done != 0;
+}
+
+/* CX and MX at the camera's levels, or given back (`on' false). True: RPMh has said done. */
+static bool
+rails(bool on)
+{
+	uint32_t addresses[2], values[2];
+	int cx = rail_position("cx.lvl", CX_LEVEL, &addresses[0]), mx = rail_position("mx.lvl", MX_LEVEL, &addresses[1]);
+	bool done;
+
+	if (cx < 0 || mx < 0) {
+		say("camera: RPMh has no position for CX %u or MX %u\n", CX_LEVEL, MX_LEVEL);
+		return false;
+	}
+	values[0] = on ? (uint32_t)cx : 0;
+	values[1] = on ? (uint32_t)mx : 0;
+	rails_voted |= on;
+	done = rpmh_write(2, addresses, values);
+	say("camera: RPMh %s CX (%#x) position %u and MX (%#x) position %u%s\n", done ? "took" : "DID NOT SAY IT TOOK", addresses[0],
+	    values[0], addresses[1], values[1], on ? "" : " (given back)");
+	return done;
+}
+
+/* camcc's PLL0 (Lucid): the registers of clk-alpha-pll.c's Lucid layout */
+#define PLL_MODE                0x00            /* [0] outputs, [2] out of reset, [23] update bypass, [31] locked */
+#define PLL_L_VAL               0x04
+#define PLL_CAL_L_VAL           0x08
+#define PLL_USER_CTL            0x0c            /* [2:0] the outputs: main, even, odd */
+#define PLL_USER_CTL_U          0x10
+#define PLL_USER_CTL_U1         0x14
+#define PLL_CONFIG_CTL          0x18
+#define PLL_CONFIG_CTL_U        0x1c
+#define PLL_CONFIG_CTL_U1       0x20
+#define PLL_OPMODE              0x38            /* 0 standby, 1 run */
+#define PLL_ALPHA_VAL           0x40
+
+static bool pll_on;
+
+static bool
+camcc_any(uint32_t offset, uint32_t value, uint32_t check)
+{
+	wr(camcc + offset, value);
+	if ((rd(camcc + offset) & check) != (value & check)) {
+		say("camera: camcc %#x <- %#x, but it reads %#x\n", offset, value, rd(camcc + offset));
+		give_up("a camcc register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+pll0_up(void)
+{
+	static const struct {
+		uint32_t offset, value;
+	} config[] = {                  /* camcc-yupik.c: cam_cc_pll0_config ("1200MHz Configuration"); CAL_L as clk-alpha-pll.c's default */
+		{ PLL_L_VAL, 0x3e }, { PLL_CAL_L_VAL, 0x44 }, { PLL_ALPHA_VAL, 0x8000 }, { PLL_CONFIG_CTL, 0x20485699 },
+		{ PLL_CONFIG_CTL_U, 0x00002261 }, { PLL_CONFIG_CTL_U1, 0x329a299c }, { PLL_USER_CTL, 0x00003101 },
+		{ PLL_USER_CTL_U, 0x00000805 }, { PLL_USER_CTL_U1, 0x00000000 },
+	};
+
+	if (rd(camcc + PLL_MODE) & 1) {
+		give_up("camcc's PLL0 is running already (somebody else's)");
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(config) / sizeof(config[0]); i++) {
+		if (!camcc_any(config[i].offset, config[i].value, ~0u)) {
+			return false;
+		}
+	}
+	pll_on = true;
+	/* clk_lucid_pll_configure(): update bypass, outputs off, standby, out of reset */
+	if (!camcc_any(PLL_MODE, rd(camcc + PLL_MODE) | 1u << 23, 1u << 23) || !camcc_any(PLL_MODE, rd(camcc + PLL_MODE) & ~1u, 1) ||
+	    !camcc_any(PLL_OPMODE, 0, 1) || !camcc_any(PLL_MODE, rd(camcc + PLL_MODE) | 1u << 2, 1u << 2)) {
+		return false;
+	}
+	/* alpha_pll_lucid_enable(): run, locked, the outputs on */
+	if (!camcc_any(PLL_OPMODE, 1, 1)) {
+		return false;
+	}
+	if (!wait_bits(PLL_MODE, 1u << 31, 1u << 31, 1000)) {
+		say("camera: camcc's PLL0 does not lock (mode %#x)\n", rd(camcc + PLL_MODE));
+		give_up("a PLL that does not lock");
+		return false;
+	}
+	if (!camcc_any(PLL_USER_CTL, rd(camcc + PLL_USER_CTL) | 7, 7) || !camcc_any(PLL_MODE, rd(camcc + PLL_MODE) | 1, 1)) {
+		return false;
+	}
+	say("camera: camcc's PLL0 locked at 1200 MHz (mode %#x, user_ctl %#x)\n", rd(camcc + PLL_MODE), rd(camcc + PLL_USER_CTL));
+	return true;
+}
+
+static void
+pll0_down(void)
+{
+	if (!pll_on) {
+		return;
+	}
+	/* alpha_pll_lucid_disable(), then back into reset as it was found */
+	wr(camcc + PLL_MODE, rd(camcc + PLL_MODE) & ~1u);
+	wr(camcc + PLL_USER_CTL, rd(camcc + PLL_USER_CTL) & ~7u);
+	wr(camcc + PLL_OPMODE, 0);
+	wr(camcc + PLL_MODE, rd(camcc + PLL_MODE) & ~(1u << 2));
+	pll_on = false;
+	say("camera: camcc's PLL0 off (mode %#x)\n", rd(camcc + PLL_MODE));
+}
+
+/* An RCG set (source, divider field 2n - 1, no M/N) and updated; then branches on. */
+struct rcg {
+	const char *    name;
+	uint32_t        cmd, source, divider;
+	uint32_t        found_cfg;
+	bool            set;
+};
+static struct rcg rcgs[] = {
+	{ "slow_ahb 80 MHz", 0x7058, 2, 14 },           /* PLL0 even (600) / 7.5 */
+	{ "camnoc_axi 150 MHz", 0xc124, 2, 7 },         /* / 4 */
+	{ "cphy_rx 400 MHz", 0xa064, 2, 2 },            /* / 1.5 */
+	{ "csiNphytimer 300 MHz", 0, 2, 3 },            /* / 2 (the sensor's CSIPHY's: hw->timer_cmd) */
+	{ "ife_lite_0_csid 400 MHz", 0xc020, 2, 2 },    /* / 1.5 */
+	{ "ife_lite_0 400 MHz", 0xc004, 3, 1 },         /* PLL0 odd (400) / 1 */
+};
+struct branch {
+	const char *    name;
+	bool            gcc;
+	uint32_t        cbcr;
+	bool            set;
+};
+static struct branch branches[] = {
+	{ "gcc camera_hf_axi", true, 0x26010 }, { "gcc camera_sf_axi", true, 0x2601c },
+	{ "cpas_ahb", false, 0xc11c }, { "camnoc_axi", false, 0xc140 }, { "csiphyN", false, 0 },
+	{ "csiNphytimer", false, 0 },
+	{ "ife_lite_0_csid", false, 0xc038 }, { "ife_lite_0_cphy_rx", false, 0xc040 }, { "ife_lite_0", false, 0xc01c },
+};
+
+static bool
+clocks_up(void)
+{
+	/* (the sensor's CSIPHY: its own branch and timer) */
+	rcgs[3].cmd = hw->timer_cmd;
+	branches[4].cbcr = hw->phy_cbcr;
+	branches[5].cbcr = hw->timer_cbcr;
+	for (unsigned i = 0; i < sizeof(rcgs) / sizeof(rcgs[0]); i++) {
+		struct rcg *r = &rcgs[i];
+		uint32_t cfg = r->cmd + 4;
+
+		r->found_cfg = rd(camcc + cfg);
+		if (!camcc_any(cfg, (r->found_cfg & ~0x371fu) | r->source << 8 | r->divider, 0x371f)) {
+			return false;
+		}
+		r->set = true;
+		wr(camcc + r->cmd, rd(camcc + r->cmd) | CMD_UPDATE);
+		if (!wait_bits(r->cmd, CMD_UPDATE, 0, 500)) {
+			say("camera: the RCG %s does not take its configuration (cmd %#x)\n", r->name, rd(camcc + r->cmd));
+			give_up("an RCG that does not update");
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); i++) {
+		struct branch *b = &branches[i];
+		vm_offset_t base = b->gcc ? gcc : camcc;
+
+		if (rd(base + b->cbcr) & 1) {
+			continue;               /* (on already: left on at the end too) */
+		}
+		wr(base + b->cbcr, rd(base + b->cbcr) | 1);
+		if (!(rd(base + b->cbcr) & 1)) {
+			say("camera: the branch %s does not take its enable (%#x)\n", b->name, rd(base + b->cbcr));
+			give_up("a clock that does not read back");
+			return false;
+		}
+		b->set = true;
+		for (unsigned waited = 0; rd(base + b->cbcr) & CBCR_OFF; waited += 10) {
+			if (waited > 500) {
+				say("camera: the branch %s does not come on (%#x)\n", b->name, rd(base + b->cbcr));
+				give_up("a clock that does not come on");
+				return false;
+			}
+			spin_us(10);
+		}
+	}
+	say("camera: the camera's clocks on (%u RCGs, %u branches)\n", (unsigned)(sizeof(rcgs) / sizeof(rcgs[0])),
+	    (unsigned)(sizeof(branches) / sizeof(branches[0])));
+	return true;
+}
+
+static void
+clocks_down(void)
+{
+	for (int i = (int)(sizeof(branches) / sizeof(branches[0])) - 1; i >= 0; i--) {
+		struct branch *b = &branches[i];
+		vm_offset_t base = b->gcc ? gcc : camcc;
+
+		if (b->set) {
+			wr(base + b->cbcr, rd(base + b->cbcr) & ~1u);
+			b->set = false;
+		}
+	}
+	for (int i = (int)(sizeof(rcgs) / sizeof(rcgs[0])) - 1; i >= 0; i--) {
+		struct rcg *r = &rcgs[i];
+
+		if (r->set) {
+			wr(camcc + r->cmd + 4, r->found_cfg);
+			wr(camcc + r->cmd, rd(camcc + r->cmd) | CMD_UPDATE);
+			(void)wait_bits(r->cmd, CMD_UPDATE, 0, 500);
+			r->set = false;
+		}
+	}
+	say("camera: the camera's clocks off\n");
+}
+
+/* ---- the frames' memory, and the SMMU ---------------------------------------------------------------- */
+
+#define FRAME_ADDRESSES         0x40000000ull           /* the IFE's addresses for it (in dt's iova pool 0x100000-0xfff00000) */
+#define CAM_HEADER_BYTES        4096
+#define CAM_FRAMES              2
+#define SMMU_CBAR(n)            (4 * (n))
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)
+#define SMMU_MAIR0              0xf404ff44
+#define SMMU_FSR_ALL            0xc00001fe
+#define CAM_PTE                 (3ull | 1ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)       /* as hakios.sound.c's */
+
+/* What the loader hands to the host (tools/camraw.py reads it). */
+struct cam_header {
+	char            magic[8];       /* "RWCAM001" */
+	uint32_t        width, height;  /* pixels */
+	uint32_t        stride;         /* bytes from one line to the next */
+	uint32_t        format;         /* 1: MIPI RAW10, packed (four pixels in five bytes) */
+	uint32_t        bayer;          /* 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR */
+	uint32_t        frames;         /* how many were written whole */
+	uint32_t        frame_bytes;    /* each, from CAM_HEADER_BYTES on */
+	uint32_t        source;         /* 0: the CSID's test pattern, 1: the sensor */
+	char            sensor[16];
+	uint32_t        last;           /* which of the frames' places holds the last one written */
+};
+
+extern uint64_t loader_recording[3];
+extern uint64_t kvtophys(vm_offset_t va);
+extern lck_mtx_t hakios_smmu_lock;
+
+static vm_offset_t frames, smmu_second, smmu_context, page_tables;
+static vm_offset_t keep;                /* memory in one piece, taken at boot (hakios_camera_init()) */
+static uint64_t keep_bytes;
+static uint64_t frames_bytes;
+static uint32_t smmu_match = ~0u, smmu_context_n, smmu_old_smr, smmu_old_s2cr, smmu_pages_size, smmu_pages;
+static bool smmu_on;
+
+static bool
+frames_alloc(uint32_t width, uint32_t height, uint32_t stride, uint32_t source)
+{
+	struct cam_header *h;
+	uint32_t frame_bytes = stride * height;
+
+	frames_bytes = round_page(CAM_HEADER_BYTES + (uint64_t)CAM_FRAMES * frame_bytes);
+	if (keep != 0 && keep_bytes >= frames_bytes) {
+		frames = keep;                  /* (the piece taken at boot: hakios_camera_init()) */
+		bzero((void *)frames, CAM_HEADER_BYTES);
+	} else if (kmem_alloc_contig(kernel_map, &frames, frames_bytes, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("camera: no memory for %u frames (%llu KB)\n", CAM_FRAMES, frames_bytes >> 10);
+		return false;
+	}
+	h = (struct cam_header *)frames;
+	memcpy(h->magic, "RWCAM001", 8);
+	h->width = width;
+	h->height = height;
+	h->stride = stride;
+	h->format = 1;
+	h->bayer = 0;                   /* (RGGB: the CSID's test pattern; a sensor's picture: capture_sensor()) */
+	h->frame_bytes = frame_bytes;
+	h->source = source;
+	strlcpy(h->sensor, !source ? "CSID TPG" : hw->chip, sizeof(h->sensor));
+	/* (what the processor wrote out of its caches; the IFE writes past them) */
+	for (vm_offset_t line = frames; line < frames + frames_bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	loader_recording[0] = kvtophys(frames);
+	loader_recording[1] = frames_bytes;
+	loader_recording[2] = (uint64_t)frames;
+	say("camera: %llu KB of memory for %u frames at %#llx, handed to the loader for the host\n", frames_bytes >> 10, CAM_FRAMES,
+	    loader_recording[0]);
+	return true;
+}
+
+static bool
+smmu_find(void)
+{
+	bool used[256] = { false };
+	uint32_t idr0 = rd(smmu + SMMU_IDR0), idr1 = rd(smmu + SMMU_IDR1);
+
+	smmu_pages_size = idr1 >> 31 ? 0x10000 : 0x1000;
+	smmu_pages = 2u << (idr1 >> 28 & 7);
+	if (2 * smmu_pages * smmu_pages_size != 0x100000) {
+		say("camera: the SMMU's layout is not the one known here\n");
+		return false;
+	}
+	for (uint32_t n = 0; n < (idr0 & 0xff) && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr = rd(smmu + SMMU_S2CR(n));
+
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+			if ((((smr & 0x7fff) ^ IFE_STREAM) & ~((smr >> 16 & 0x7fff) | IFE_STREAM_MASK)) == 0) {
+				say("camera: SMMU match register %u (%#x) is somebody's for the IFEs' streams: left alone\n", n, smr);
+				return false;
+			}
+		} else if (smmu_match == ~0u) {
+			smmu_match = n;
+			smmu_old_smr = smr;
+			smmu_old_s2cr = s2cr;
+		}
+	}
+	for (smmu_context_n = 0; smmu_context_n < (idr1 & 0xff) && used[smmu_context_n]; smmu_context_n++) {
+	}
+	if (smmu_match == ~0u || smmu_context_n >= (idr1 & 0xff)) {
+		say("camera: the SMMU has no match register or context left\n");
+		return false;
+	}
+	smmu_second = ml_io_map(SMMU_PHYS + smmu_pages_size, 0x1000);
+	smmu_context = ml_io_map(SMMU_PHYS + (uint64_t)(smmu_pages + smmu_context_n) * smmu_pages_size, 0x1000);
+	if (rd(smmu_context + SMMU_CB_SCTLR) & 1) {
+		say("camera: SMMU context %u is switched on although no stream uses it: somebody's\n", smmu_context_n);
+		return false;
+	}
+	return true;
+}
+
+static bool
+smmu_put(vm_offset_t base, uint32_t offset, uint32_t value, uint32_t check)
+{
+	wr(base + offset, value);
+	if ((rd(base + offset) & check) != (value & check)) {
+		say("camera: SMMU %#x <- %#x, but it reads %#x\n", offset, value, rd(base + offset));
+		give_up("an SMMU register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+/* The frames' memory behind FRAME_ADDRESSES for the IFEs' streams, through a free context with tables of ours. */
+static bool
+smmu_up(void)
+{
+	uint64_t *root, *second, table_root;
+	uint32_t thirds = (uint32_t)((frames_bytes + 0x1fffff) >> 21), pages = (uint32_t)(frames_bytes >> 12);
+
+	lck_mtx_lock(&hakios_smmu_lock);
+	if (!smmu_find()) {
+		lck_mtx_unlock(&hakios_smmu_lock);
+		give_up("no place in the SMMU");
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &page_tables, (2 + thirds) * 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		lck_mtx_unlock(&hakios_smmu_lock);
+		give_up("no memory for page tables");
+		return false;
+	}
+	root = (uint64_t *)page_tables;
+	second = (uint64_t *)(page_tables + 4096);
+	root[FRAME_ADDRESSES >> 30 & 0x1ff] = kvtophys((vm_offset_t)second) | 3;
+	for (uint32_t t = 0; t < thirds; t++) {
+		uint64_t *third = (uint64_t *)(page_tables + (2 + t) * 4096);
+
+		second[(FRAME_ADDRESSES >> 21 & 0x1ff) + t] = kvtophys((vm_offset_t)third) | 3;
+		for (uint32_t p = 0; p < 512 && t * 512 + p < pages; p++) {
+			third[p] = kvtophys(frames + 4096ull * (t * 512 + p)) | CAM_PTE;
+		}
+	}
+	for (vm_offset_t line = page_tables; line < page_tables + (2 + thirds) * 4096; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	table_root = kvtophys(page_tables) | (uint64_t)smmu_context_n << 48;
+	say("camera: SMMU: context %u gets our tables for %llu KB at %#llx; match register %u sends streams %#x/%#x through it\n",
+	    smmu_context_n, frames_bytes >> 10, FRAME_ADDRESSES, smmu_match, IFE_STREAM, IFE_STREAM_MASK);
+	if (!smmu_put(smmu_context, SMMU_CB_SCTLR, 0, ~0u) || !smmu_put(smmu_second, SMMU_CBA2R(smmu_context_n), 1, 1) ||
+	    !smmu_put(smmu_second, SMMU_CBAR(smmu_context_n), SMMU_CBAR_STAGE_1, 0x30000) ||
+	    !smmu_put(smmu_context, SMMU_CB_TCR2, SMMU_TCR2, 0) || !smmu_put(smmu_context, SMMU_CB_TCR, SMMU_TCR_39_BITS, ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_TTBR0, (uint32_t)table_root, ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_TTBR0 + 4, (uint32_t)(table_root >> 32), ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_TTBR1, 0, ~0u) || !smmu_put(smmu_context, SMMU_CB_TTBR1 + 4, 0, ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_MAIR0, SMMU_MAIR0, ~0u) || !smmu_put(smmu_context, SMMU_CB_MAIR1, 0, ~0u)) {
+		lck_mtx_unlock(&hakios_smmu_lock);
+		return false;
+	}
+	wr(smmu_context + SMMU_CB_FSR, SMMU_FSR_ALL);
+	wr(smmu_context + SMMU_CB_TLBIASID, smmu_context_n);
+	wr(smmu_context + SMMU_CB_TLBSYNC, 1);
+	for (unsigned waited = 0; rd(smmu_context + SMMU_CB_TLBSTATUS) & 1; waited++) {
+		if (waited > 1000) {
+			lck_mtx_unlock(&hakios_smmu_lock);
+			give_up("the SMMU does not finish forgetting");
+			return false;
+		}
+		spin_us(10);
+	}
+	if (!smmu_put(smmu_context, SMMU_CB_SCTLR, SMMU_SCTLR_ON, 1)) {
+		lck_mtx_unlock(&hakios_smmu_lock);
+		return false;
+	}
+	smmu_on = true;
+	if (!smmu_put(smmu, SMMU_S2CR(smmu_match), smmu_context_n, 0x300ff) ||
+	    !smmu_put(smmu, SMMU_SMR(smmu_match), 1u << 31 | (uint32_t)IFE_STREAM_MASK << 16 | IFE_STREAM, ~0u)) {
+		lck_mtx_unlock(&hakios_smmu_lock);
+		return false;
+	}
+	lck_mtx_unlock(&hakios_smmu_lock);
+	return true;
+}
+
+static void
+smmu_faults(void)
+{
+	uint32_t status, global;
+
+	if (!smmu_on) {
+		return;
+	}
+	status = rd(smmu_context + SMMU_CB_FSR);
+	global = rd(smmu + SMMU_SGFSR);
+	if ((status & SMMU_FSR_ALL) == 0 && global == 0) {
+		say("camera: the SMMU has refused the IFE nothing (context %u)\n", smmu_context_n);
+		return;
+	}
+	say("camera: THE SMMU HAS REFUSED A REQUEST: context %u status %#x, address %#llx, syndrome %#x; global status %#x, stream %#x\n",
+	    smmu_context_n, status, (uint64_t)rd(smmu_context + SMMU_CB_FAR + 4) << 32 | rd(smmu_context + SMMU_CB_FAR),
+	    rd(smmu_context + SMMU_CB_FSYNR0), global, rd(smmu + SMMU_SGFSYNR1));
+}
+
+static void
+smmu_down(void)
+{
+	if (!smmu_on && smmu_match == ~0u) {
+		return;
+	}
+	smmu_faults();
+	if (!leaving) {
+		lck_mtx_lock(&hakios_smmu_lock);
+	}
+	if (smmu_match != ~0u) {
+		wr(smmu + SMMU_SMR(smmu_match), smmu_old_smr);
+		wr(smmu + SMMU_S2CR(smmu_match), smmu_old_s2cr);
+	}
+	if (smmu_on) {
+		wr(smmu_context + SMMU_CB_SCTLR, 0);
+		wr(smmu_context + SMMU_CB_TLBIASID, smmu_context_n);
+		wr(smmu_context + SMMU_CB_TLBSYNC, 1);
+	}
+	if (!leaving) {
+		lck_mtx_unlock(&hakios_smmu_lock);
+	}
+	smmu_on = false;
+	smmu_match = ~0u;
+	say("camera: the SMMU's match register and context put back as they were found\n");
+}
+
+/* ---- CSID-lite 0 and IFE-lite 0 ----------------------------------------------------------------------- */
+
+#define CSID_PHYS               0x0acc8000UL
+#define IFE_PHYS                0x0acc4000UL
+#define CSIPHY_PHYS(n)          (0x0ace0000UL + 0x2000UL * (n))
+
+#define CSID_HW_VERSION         0x000
+#define CSID_RST_STROBES        0x010
+#define CSID_CSI2_RX_IRQ_STATUS 0x020
+#define CSID_CSI2_RX_IRQ_MASK   0x024
+#define CSID_CSI2_RX_IRQ_CLEAR  0x028
+#define CSID_RDI0_IRQ_STATUS    0x030
+#define CSID_RDI0_IRQ_MASK      0x034
+#define CSID_RDI0_IRQ_CLEAR     0x038
+#define CSID_TOP_IRQ_STATUS     0x070
+#define CSID_TOP_IRQ_MASK       0x074
+#define CSID_TOP_IRQ_CLEAR      0x078
+#define CSID_IRQ_CMD            0x080
+#define CSID_CSI2_RX_CFG0       0x100
+#define CSID_CSI2_RX_CFG1       0x104
+#define CSID_CSI2_RX_PKTS       0x160
+#define CSID_CSI2_RX_ECC        0x164
+#define CSID_CSI2_RX_CRC        0x168
+#define CSID_RDI0_CFG0          0x200
+#define CSID_RDI0_CFG1          0x204
+#define CSID_RDI0_CTRL          0x208
+#define CSID_RDI0_FRM_DROP_PATTERN 0x20c
+#define CSID_RDI0_FRM_DROP_PERIOD  0x210
+#define CSID_RDI0_IRQ_SUB_PATTERN  0x214
+#define CSID_RDI0_IRQ_SUB_PERIOD   0x218
+#define CSID_RDI0_PIX_DROP_PATTERN 0x224
+#define CSID_RDI0_PIX_DROP_PERIOD  0x228
+#define CSID_RDI0_LINE_DROP_PATTERN 0x22c
+#define CSID_RDI0_LINE_DROP_PERIOD  0x230
+#define CSID_RDI0_STATUS        0x250
+#define CSID_RDI0_BYTES_PING    0x2e0
+#define CSID_RDI0_BYTES_PONG    0x2e4
+#define CSID_TPG_CTRL           0x600
+#define CSID_TPG_VC_CFG0        0x604
+#define CSID_TPG_VC_CFG1        0x608
+#define CSID_TPG_LFSR_SEED      0x60c
+#define CSID_TPG_DT0_CFG0       0x610
+#define CSID_TPG_DT0_CFG1       0x614
+#define CSID_TPG_DT0_CFG2       0x618
+#define CSID_TPG_COLOR_BARS_CFG 0x640
+#define CSID_TPG_COMMON_GEN_CFG 0x648
+#define TPG_VC                  0xa
+#define RAW10_DT                0x2b
+/*
+ * A line's bytes as the write master lays them out: RAW10 (four pixels in five bytes), the line
+ * rounded up to 16 bytes, the bus's width (a 4000-pixel line takes 5008, not 5000).
+ */
+#define RAW10_STRIDE(width)     (((width) * 10 / 8 + 15) & ~15u)
+
+#define IFE_HW_VERSION          0x0000
+#define IFE_GLOBAL_RESET        0x0018
+#define IFE_IRQ_MASK0           0x005c
+#define IFE_IRQ_MASK1           0x0060
+#define IFE_IRQ_CLEAR0          0x0064
+#define IFE_IRQ_CLEAR1          0x0068
+#define IFE_IRQ_STATUS0         0x006c
+#define IFE_IRQ_STATUS1         0x0070
+#define IFE_IRQ_GLOBAL_CLEAR    0x0058
+#define IFE_VIOLATION_STATUS    0x007c
+#define IFE_REG_UPDATE          0x04ac
+#define BUS_HW_VERSION          0x2000
+#define BUS_CGC_OVD             0x200c
+#define BUS_IRQ_MASK1           0x2048
+#define BUS_IRQ_CLEAR0          0x2050
+#define BUS_IRQ_CLEAR1          0x2054
+#define BUS_IRQ_CLEAR2          0x2058
+#define BUS_IRQ_STATUS0         0x205c
+#define BUS_IRQ_STATUS1         0x2060
+#define BUS_IRQ_STATUS2         0x2064
+#define BUS_IRQ_GLOBAL_CLEAR    0x2068
+#define BUS_COMP_ERROR          0x206c
+#define BUS_ADDR_SYNC_FRAME_HDR 0x2080
+#define BUS_ADDR_SYNC_NO_SYNC   0x2084
+#define BUS_TEST_CTRL           0x211c
+#define WM0_STATUS0             0x2200
+#define WM0_STATUS1             0x2204
+#define WM0_CFG                 0x2208
+#define WM0_IMAGE_ADDR          0x2214
+#define WM0_IMAGE_ADDR_OFFSET   0x2218
+#define WM0_WIDTH               0x221c
+#define WM0_HEIGHT              0x2220
+#define WM0_PACKER              0x2224
+#define WM0_STRIDE              0x2228
+#define WM0_IRQ_SUB_PERIOD      0x2248
+#define WM0_IRQ_SUB_PATTERN     0x224c
+#define WM0_FRAMEDROP_PERIOD    0x2250
+#define WM0_FRAMEDROP_PATTERN   0x2254
+#define WM0_FRAME_INC           0x2258
+#define WM0_BURST_LIMIT         0x225c
+
+static vm_offset_t csid, ife, csiphy;
+static bool csid_running, ife_running, tpg_running;
+
+/* A register of the three camera blocks: written, and read back where it is one that keeps what it is given. */
+static bool
+blk_put(vm_offset_t base, const char *what, uint32_t offset, uint32_t value, bool check)
+{
+	wr(base + offset, value);
+	__asm__ volatile ("dsb sy");
+	if (check && rd(base + offset) != value) {
+		say("camera: %s %#x <- %#x, but it reads %#x\n", what, offset, value, rd(base + offset));
+		give_up("a camera register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+wait_reg(vm_offset_t base, uint32_t offset, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t waited = 0; waited <= us; waited += 10) {
+		if ((rd(base + offset) & mask) == want) {
+			return true;
+		}
+		spin_us(10);
+	}
+	return false;
+}
+
+/* cam_ife_csid_global_reset() and reset_regs(): interrupts masked and cleared, then the registers, then the hardware. */
+static bool
+csid_reset(void)
+{
+	blk_put(csid, "CSID", CSID_CSI2_RX_IRQ_MASK, 0, false);
+	for (unsigned r = 0; r < 4; r++) {
+		blk_put(csid, "CSID", CSID_RDI0_IRQ_MASK + 0x10 * r, 0, false);
+	}
+	blk_put(csid, "CSID", CSID_TOP_IRQ_CLEAR, 1, false);
+	blk_put(csid, "CSID", CSID_CSI2_RX_IRQ_CLEAR, 0xfffffff, false);
+	for (unsigned r = 0; r < 4; r++) {
+		blk_put(csid, "CSID", CSID_RDI0_IRQ_CLEAR + 0x10 * r, 0x7fff, false);
+	}
+	blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+	blk_put(csid, "CSID", CSID_CSI2_RX_CFG1, 0x80, false);
+	for (unsigned r = 0; r < 4; r++) {
+		blk_put(csid, "CSID", CSID_RDI0_CFG0 + 0x100 * r, 2, false);
+	}
+	for (unsigned hw = 0; hw < 2; hw++) {
+		blk_put(csid, "CSID", CSID_TOP_IRQ_CLEAR, 1, false);
+		blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+		if (hw) {
+			blk_put(csid, "CSID", CSID_TOP_IRQ_MASK, 1, false);
+			blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+		}
+		blk_put(csid, "CSID", CSID_RST_STROBES, hw ? 0x1e : 0x1, false);
+		if (!hw) {
+			blk_put(csid, "CSID", CSID_TOP_IRQ_MASK, 1, false);
+			blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+		}
+		if (!wait_reg(csid, CSID_TOP_IRQ_STATUS, 1, 1, 100000)) {
+			say("camera: the CSID's %s reset does not finish (top irq %#x)\n", hw ? "hardware" : "registers'",
+			    rd(csid + CSID_TOP_IRQ_STATUS));
+			give_up("a CSID that does not reset");
+			return false;
+		}
+		blk_put(csid, "CSID", CSID_TOP_IRQ_CLEAR, 1, false);
+		blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+	}
+	say("camera: CSID-lite 0 reset (version %#x)\n", rd(csid + CSID_HW_VERSION));
+	return true;
+}
+
+/* The RX (from a PHY, or the test pattern generator: `phy' -1) and RDI 0, for RAW10 of vc/dt, written as it comes (packed). */
+static bool
+csid_config(int phy, unsigned lanes, uint32_t lane_cfg, uint32_t vc, uint32_t width, uint32_t height, bool cphy)
+{
+	uint32_t cfg0 = vc << 22 | RAW10_DT << 16 | 0u << 27 | 0xfu << 12 | 0u << 10 | 1u << 2 | 3u;
+
+	if (!blk_put(csid, "CSID", CSID_CSI2_RX_CFG0, (lanes - 1) | lane_cfg << 4 | (uint32_t)cphy << 24 |
+	    (uint32_t)(phy < 0 ? 0 : phy & 3) << 20,
+	    true) || !blk_put(csid, "CSID", CSID_CSI2_RX_CFG1, 1u << 6 | 1u, true)) {
+		return false;
+	}
+	if (phy < 0) {
+		/* cam_ife_csid_config_tpg(): one data type, frames without end, blanking 0x3ff lines and 0x740 pixels, RAW10, colour bars */
+		if (!blk_put(csid, "CSID", CSID_TPG_VC_CFG0, 0u << 16 | 1u << 10 | vc, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_VC_CFG1, 0x3ffu << 12 | 0x740, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_LFSR_SEED, 0x12345678, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_DT0_CFG0, width << 16 | height, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_DT0_CFG1, RAW10_DT, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_DT0_CFG2, (3u - 1) << 16 | 0x8, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_COLOR_BARS_CFG, 1u << 5, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_COMMON_GEN_CFG, 0, true)) {
+			return false;
+		}
+	}
+	/* cam_ife_csid_init_config_rdi_path() */
+	if (!blk_put(csid, "CSID", CSID_RDI0_CFG0, cfg0, true) || !blk_put(csid, "CSID", CSID_RDI0_CFG1, 2, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_FRM_DROP_PERIOD, 1, true) || !blk_put(csid, "CSID", CSID_RDI0_FRM_DROP_PATTERN, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_IRQ_SUB_PERIOD, 1, true) || !blk_put(csid, "CSID", CSID_RDI0_IRQ_SUB_PATTERN, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_PIX_DROP_PATTERN, 0, true) || !blk_put(csid, "CSID", CSID_RDI0_PIX_DROP_PERIOD, 1, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_LINE_DROP_PATTERN, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_LINE_DROP_PERIOD, 1, true) || !blk_put(csid, "CSID", CSID_RDI0_CTRL, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_CFG0, cfg0 | 1u << 31, true)) {
+		return false;
+	}
+	csid_running = true;
+	/* cam_ife_csid_enable_rdi_path(): resume at the frame's boundary; the reset, overflow and count errors seen */
+	return blk_put(csid, "CSID", CSID_RDI0_CTRL, 1, true) &&
+	       blk_put(csid, "CSID", CSID_RDI0_IRQ_MASK, 1u << 1 | 1u << 2 | 1u << 3 | 1u << 4 | 1u << 5 | 1u << 6, true);
+}
+
+static bool
+tpg_start(void)
+{
+	/* cam_ife_csid_tpg_start(): four lanes' worth */
+	if (!blk_put(csid, "CSID", CSID_TPG_CTRL, 4u << 20 | 0x80u << 8 | 3u << 4 | 7u, true)) {
+		return false;
+	}
+	tpg_running = true;
+	return true;
+}
+
+/* cam_vfe_top_reset(), cam_vfe_bus_init_hw(), cam_vfe_bus_start_wm() and update_wm() for RDI 0 in frame mode. */
+static bool
+ife_config(uint64_t address, uint32_t frame_bytes, uint32_t frame_inc)
+{
+	blk_put(ife, "IFE", IFE_IRQ_MASK0, 1u << 31, false);
+	blk_put(ife, "IFE", IFE_GLOBAL_RESET, 0x3f9f, false);
+	if (!wait_reg(ife, IFE_IRQ_STATUS0, 1u << 31, 1u << 31, 100000)) {
+		say("camera: the IFE does not reset (irq %#x)\n", rd(ife + IFE_IRQ_STATUS0));
+		give_up("an IFE that does not reset");
+		return false;
+	}
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR0, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR1, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+	say("camera: IFE-lite 0 reset (version %#x, bus %#x)\n", rd(ife + IFE_HW_VERSION), rd(ife + BUS_HW_VERSION));
+	if (!blk_put(ife, "IFE", BUS_ADDR_SYNC_FRAME_HDR, 0, true) || !blk_put(ife, "IFE", BUS_CGC_OVD, 0xfffff, false) ||
+	    !blk_put(ife, "IFE", BUS_TEST_CTRL, 0, false) || !blk_put(ife, "IFE", BUS_ADDR_SYNC_NO_SYNC, 0xffffff, false) ||
+	    !blk_put(ife, "IFE", WM0_BURST_LIMIT, 0xf, true) || !blk_put(ife, "IFE", WM0_WIDTH, 0xff01, true) ||
+	    !blk_put(ife, "IFE", WM0_HEIGHT, 0, true) || !blk_put(ife, "IFE", WM0_PACKER, 0, true) ||
+	    !blk_put(ife, "IFE", WM0_STRIDE, 0xff01, true) || !blk_put(ife, "IFE", WM0_FRAMEDROP_PERIOD, 0, true) ||
+	    !blk_put(ife, "IFE", WM0_FRAMEDROP_PATTERN, 1, true) || !blk_put(ife, "IFE", WM0_IRQ_SUB_PERIOD, 0, true) ||
+	    !blk_put(ife, "IFE", WM0_IRQ_SUB_PATTERN, 1, true) || !blk_put(ife, "IFE", BUS_IRQ_MASK1, 1, false) ||
+	    !blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)address, false) || !blk_put(ife, "IFE", WM0_FRAME_INC, frame_inc, true) ||
+	    !blk_put(ife, "IFE", WM0_CFG, 3, true)) {
+		return false;
+	}
+	ife_running = true;
+	/* the RDI 0 resource's start: its register update */
+	return blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+}
+
+static void
+show_paths(const char *when)
+{
+	say("camera: %s: CSID rx irq %#x, packets %u, ecc %#x, crc %u; RDI0 irq %#x status %#x, bytes %u/%u; IFE irq %#x %#x, "
+	    "violation %#x; bus irq %#x %#x %#x, comp error %#x; WM0 status %#x %#x\n", when, rd(csid + CSID_CSI2_RX_IRQ_STATUS),
+	    rd(csid + CSID_CSI2_RX_PKTS), rd(csid + CSID_CSI2_RX_ECC), rd(csid + CSID_CSI2_RX_CRC), rd(csid + CSID_RDI0_IRQ_STATUS),
+	    rd(csid + CSID_RDI0_STATUS), rd(csid + CSID_RDI0_BYTES_PING), rd(csid + CSID_RDI0_BYTES_PONG), rd(ife + IFE_IRQ_STATUS0),
+	    rd(ife + IFE_IRQ_STATUS1), rd(ife + IFE_VIOLATION_STATUS), rd(ife + BUS_IRQ_STATUS0), rd(ife + BUS_IRQ_STATUS1),
+	    rd(ife + BUS_IRQ_STATUS2), rd(ife + BUS_COMP_ERROR), rd(ife + WM0_STATUS0), rd(ife + WM0_STATUS1));
+}
+
+static void
+paths_down(void)
+{
+	if (tpg_running) {
+		wr(csid + CSID_TPG_CTRL, 0);
+		tpg_running = false;
+	}
+	if (csid_running) {
+		/* cam_ife_csid_disable_rdi_path(): halted at once, then the path off */
+		wr(csid + CSID_RDI0_IRQ_MASK, 0);
+		wr(csid + CSID_RDI0_CTRL, (rd(csid + CSID_RDI0_CTRL) & ~3u) | 2);
+		wr(csid + CSID_RDI0_CFG0, rd(csid + CSID_RDI0_CFG0) & ~(1u << 31));
+		wr(csid + CSID_CSI2_RX_CFG0, 0);
+		csid_running = false;
+	}
+	if (ife_running) {
+		wr(ife + WM0_CFG, 0);
+		wr(ife + IFE_REG_UPDATE, 0x2);
+		spin_us(1000);
+		ife_running = false;
+	}
+}
+
+/* The camera's blocks up to their clocks; false (and everything taken back by titan_down()) on any fault. */
+static bool
+titan_up(void)
+{
+	static vm_offset_t csiphys[4];
+
+	if (csid == 0) {
+		csid = ml_io_map(CSID_PHYS, 0x1000);
+		ife = ml_io_map(IFE_PHYS, 0x4000);
+	}
+	if (csiphys[hw->csiphy] == 0) {
+		csiphys[hw->csiphy] = ml_io_map(CSIPHY_PHYS(hw->csiphy), 0x2000);
+	}
+	csiphy = csiphys[hw->csiphy];   /* (the sensor's: another one after a change of sensor) */
+	if (!(rd(camcc + TITAN_TOP_GDSCR) & GDSC_ON) && !gdsc_on()) {
+		return false;
+	}
+	if (!rails(true)) {
+		give_up("RPMh did not take the camera's rails");
+		return false;
+	}
+	return pll0_up() && clocks_up();
+}
+
+static void
+titan_down(void)
+{
+	paths_down();
+	smmu_down();
+	clocks_down();
+	pll0_down();
+	if (rails_voted) {
+		rails_voted = false;
+		(void)rails(false);
+	}
+}
+
+/* cam=3: a few frames of the CSID's test pattern through RDI 0 and IFE-lite 0 into memory. */
+static void
+capture_tpg(void)
+{
+	const uint32_t width = 1600, height = 1200, stride = width * 10 / 8;
+	struct cam_header *h;
+
+	if (!frames_alloc(width, height, stride, 0) || !titan_up() || !smmu_up() || !csid_reset() ||
+	    !csid_config(-1, 4, 0x3210, TPG_VC, width, height, false) || !ife_config(FRAME_ADDRESSES + CAM_HEADER_BYTES, stride * height, stride * height)) {
+		titan_down();
+		return;
+	}
+	show_paths("configured");
+	if (!tpg_start()) {
+		titan_down();
+		return;
+	}
+	h = (struct cam_header *)frames;
+	for (unsigned ms = 0; ms < 2000; ms += 100) {
+		wait_ms(100);
+		if (rd(ife + BUS_IRQ_STATUS1) & 1) {
+			h->frames = 1;
+			say("camera: write master 0 says its frame is done after %u ms\n", ms + 100);
+			break;
+		}
+	}
+	show_paths("after the frames");
+	smmu_faults();
+	titan_down();
+	/* (what the IFE wrote, a look: the first bytes of the frame, past the processor's caches) */
+	for (vm_offset_t line = frames; line < frames + CAM_HEADER_BYTES + 256; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	const uint8_t *p = (const uint8_t *)(frames + CAM_HEADER_BYTES);
+	say("camera: the frame's first bytes: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x ... (frames done: %u)\n", p[0], p[1], p[2],
+	    p[3], p[4], p[5], p[6], p[7], p[8], p[9], h->frames);
+	for (vm_offset_t line = frames; line < frames + CAM_HEADER_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+}
+
+/* ---- cam=4: the sensor's own frames ------------------------------------------------------------------ */
+
+/*
+ * The sensor's tables are Android's, read at run time: tools/camsensor.py makes camera-ov02b10.tab
+ * and camera-s5khm2sd.tab out of the module files (userland/build.sh puts them into fw/ of the small
+ * image). The sequence is Android's: power up, the chip ID, the initialisation ("init": the macro's
+ * 108 writes, a soft reset and then its registers page by page; the wide one's 1441), the mode's own
+ * table ("resN": boot-arg cam_mode=N, or the mode with the fewest pixels: the macro's 1600x1200 RAW10
+ * on one lane at 665.6 Mbit/s, 30 frames a second; the wide one's 1920x1080 RAW10 on three C-PHY
+ * trios at 3.11 Gbit/s each, 120 frames a second); the sensor's CSIPHY, CSID-lite 0's RX from that
+ * PHY and RDI 0, IFE-lite 0's write master as for cam=3; then "on", the frames, "off" (and its 30 ms),
+ * and everything down again. The sensor's writes are not read back (some of its registers start
+ * something and clear themselves, a soft reset among them); each byte must be acknowledged.
+ *
+ * The CSIPHY ("qcom,csiphy-v1.2.1": Android's cam_csiphy_1_2_1_hwreg.h, cam_csiphy_core.c): its reset,
+ * the common registers with the lanes to enable (from the module file's lane assignment: the macro's
+ * data lane 0 and the clock lane; the wide one's three trios), then the two-phase (D-PHY) settings of
+ * every lane position or the three-phase (C-PHY) ones of every trio with the row of the data rate's
+ * table that covers the rate, the settle count among them, and its interrupts (status only, nothing
+ * handled). The settle count is the module file's for the mode (the macro's 20, the wide one's 34,
+ * in periods of the 300 MHz timer). Boot-arg cam_settle=N sets it instead.
+ */
+/* One of the sensor's tables written in order, as Android's sensor driver writes it. */
+static bool
+sensor_table(const char *name)
+{
+	uint32_t count;
+	const struct ctab_entry *e = ctab_find(name, &count);
+
+	if (e == NULL) {
+		say("camera: the tables have no \"%s\"\n", name);
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint8_t out[4];
+		unsigned n = 0;
+
+		if (e[i].operation != 0 || e[i].address_bytes < 1 || e[i].address_bytes > 2 || e[i].data_bytes < 1 || e[i].data_bytes > 2) {
+			say("camera: \"%s\" %u: an operation not known here (%u, %u/%u bytes)\n", name, i, e[i].operation, e[i].address_bytes,
+			    e[i].data_bytes);
+			give_up("a sensor table not understood");
+			return false;
+		}
+		if (e[i].address_bytes == 2) {
+			out[n++] = (uint8_t)(e[i].address >> 8);
+		}
+		out[n++] = (uint8_t)e[i].address;
+		if (e[i].data_bytes == 2) {
+			out[n++] = (uint8_t)(e[i].data >> 8);
+		}
+		out[n++] = (uint8_t)e[i].data;
+		if (broken || !i2c_transfer(&cci_bus, sensor_address(), out, n, NULL, 0)) {
+			say("camera: \"%s\" %u: %#x <- %#x not acknowledged\n", name, i, e[i].address, e[i].data);
+			give_up("a sensor write nobody acknowledged");
+			return false;
+		}
+		if (e[i].delay_us != 0) {
+			spin_us(e[i].delay_us > 100000 ? 100000 : e[i].delay_us);
+		}
+	}
+	say("camera: the sensor's \"%s\": %u writes\n", name, count);
+	return true;
+}
+
+static bool csiphy_running;
+
+/* The common part of cam_csiphy_config_dev(): the lanes to enable, then the registers of the PHY's kind. */
+static bool
+csiphy_common(uint32_t lane_enable, bool cphy)
+{
+	if (!blk_put(csiphy, "CSIPHY", 0x814, lane_enable, true) || !blk_put(csiphy, "CSIPHY", 0x818, 0x01, true) ||
+	    !blk_put(csiphy, "CSIPHY", 0x81c, cphy ? 0x52 : 0x02, true)) {
+		return false;
+	}
+	wr(csiphy + 0x800, 0x03);
+	spin_us(1);
+	wr(csiphy + 0x800, cphy ? 0x0e : 0x02);
+	return true;
+}
+
+/* D-PHY: csiphy_2ph_v1_2_1_reg, every lane position (data lanes 0..3 and the clock lane) */
+static bool
+csiphy_dphy(unsigned settle)
+{
+	static const uint32_t lanes[5][2] = {           /* each lane position's two blocks: data lane 0, the clock lane, data lanes 1, 2, 3 */
+		{ 0x000, 0x900 }, { 0x700, 0xc80 }, { 0x200, 0xa00 }, { 0x400, 0xb00 }, { 0x600, 0xc00 },
+	};
+
+	for (unsigned l = 0; l < 5; l++) {
+		uint32_t b = lanes[l][0], m = lanes[l][1];
+		bool clock = l == 1;
+
+		if (!blk_put(csiphy, "CSIPHY", b + 0x30, 0x00, true) || !blk_put(csiphy, "CSIPHY", m + 0x0, 0x05, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x8, 0x10, true) || !blk_put(csiphy, "CSIPHY", m + 0x4, 0x00, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x4, 0x07, true) || !blk_put(csiphy, "CSIPHY", b + 0x04, 0x0c, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x2c, 0x01, true) || !blk_put(csiphy, "CSIPHY", b + 0x34, 0x07, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x10, 0x02, true) || !blk_put(csiphy, "CSIPHY", b + 0x1c, 0x08, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x3c, 0xb8, true) || !blk_put(csiphy, "CSIPHY", b + 0x08, settle & 0xff, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x00, clock ? 0x80 : 0x8d, true) ||
+		    (clock && !blk_put(csiphy, "CSIPHY", b + 0x0c, 0xa5, true)) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x38, clock ? 0x1f : 0xfe, true) || !blk_put(csiphy, "CSIPHY", b + 0x14, 0x60, true) ||
+		    (clock && !blk_put(csiphy, "CSIPHY", b + 0x28, 0x04, true)) || !blk_put(csiphy, "CSIPHY", 0x800, 0x02, true) ||
+		    !blk_put(csiphy, "CSIPHY", 0x884, 0x01, true)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * C-PHY: csiphy_3ph_v1_2_1_reg, every trio position (three), then cam_csiphy_cphy_data_rate_config()'s
+ * deltas of data_rate_delta_table_1_2_1 for the first rate that covers this one (its rows go up to
+ * 2.5, 3.5 and 4.5 Gsym/s a trio, 2.28 bits a symbol).
+ */
+static bool
+csiphy_cphy(unsigned settle, uint64_t bits_per_trio)
+{
+	static const uint32_t trios[3][2] = { { 0x100, 0x980 }, { 0x300, 0xa80 }, { 0x500, 0xb80 } };
+	static const struct {
+		uint64_t        bandwidth;
+		uint8_t         r144, r164, r16c, rb4;  /* (rb4: 0 for none) */
+	} rates[3] = {
+		{ 5700000000ull, 0x32, 0x0b, 0x25, 0 }, { 7980000000ull, 0xb2, 0x33, 0x1d, 0x03 }, { 10260000000ull, 0xb2, 0x33, 0x25, 0x02 },
+	};
+	unsigned r = 0;
+
+	for (unsigned t = 0; t < 3; t++) {
+		uint32_t b = trios[t][0], m = trios[t][1];
+
+		if (!blk_put(csiphy, "CSIPHY", m + 0x10, 0x00, true) || !blk_put(csiphy, "CSIPHY", m + 0x14, 0x00, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x18, 0x00, true) || !blk_put(csiphy, "CSIPHY", m + 0x10, 0x08, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x14, 0x08, true) || !blk_put(csiphy, "CSIPHY", m + 0x18, 0x1a, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x0c, 0xaf, true)) {
+			return false;
+		}
+		spin_us(1);
+		if (!blk_put(csiphy, "CSIPHY", b + 0x5c, 0x46, true) || !blk_put(csiphy, "CSIPHY", b + 0x68, 0xa0, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x04, 0x06, true) || !blk_put(csiphy, "CSIPHY", b + 0x0c, settle & 0xff, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x08, (settle >> 8) & 0xff, true) || !blk_put(csiphy, "CSIPHY", b + 0x14, 0x20, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x50, 0x00, true) || !blk_put(csiphy, "CSIPHY", b + 0x88, 0x00, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x8c, 0x7f, true) || !blk_put(csiphy, "CSIPHY", b + 0x90, 0x7f, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x18, 0x3e, true) || !blk_put(csiphy, "CSIPHY", b + 0x1c, 0x41, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x20, 0x41, true) || !blk_put(csiphy, "CSIPHY", b + 0x24, 0x7f, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x28, 0x00, true) || !blk_put(csiphy, "CSIPHY", b + 0x2c, 0x00, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x60, 0x02, true) || !blk_put(csiphy, "CSIPHY", b + 0xcc, 0x41, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0xdc, 0x50, true) || !blk_put(csiphy, "CSIPHY", m + 0x04, 0x20, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x08, 0x05, true) || !blk_put(csiphy, "CSIPHY", m + 0x00, 0x60, true) ||
+		    !blk_put(csiphy, "CSIPHY", m + 0x2c, 0x35, true) || !blk_put(csiphy, "CSIPHY", m + 0x30, 0x01, true) ||
+		    !blk_put(csiphy, "CSIPHY", 0x800, 0x0e, true) || !blk_put(csiphy, "CSIPHY", 0x884, 0x01, true)) {
+			return false;
+		}
+	}
+	while (r < 2 && bits_per_trio > rates[r].bandwidth) {
+		r++;
+	}
+	for (unsigned t = 0; t < 3; t++) {
+		uint32_t b = trios[t][0], m = trios[t][1];
+
+		if (!blk_put(csiphy, "CSIPHY", b + 0x44, rates[r].r144, true) || !blk_put(csiphy, "CSIPHY", b + 0x64, rates[r].r164, true) ||
+		    !blk_put(csiphy, "CSIPHY", b + 0x6c, rates[r].r16c, true) ||
+		    (rates[r].rb4 != 0 && !blk_put(csiphy, "CSIPHY", m + 0x34, rates[r].rb4, true))) {
+			return false;
+		}
+		if (rates[r].rb4 != 0) {
+			spin_us(1);
+		}
+	}
+	say("camera: CSIPHY %u: C-PHY rate row %u (up to %llu bit/s a trio) for %llu\n", hw->csiphy, r, rates[r].bandwidth, bits_per_trio);
+	return true;
+}
+
+/* cam_csiphy_reset(), then the configuration for `lanes' lanes (trios) of the lane assignment, and the interrupt masks. */
+static bool
+csiphy_up(unsigned lanes, bool cphy, uint32_t lane_assign, unsigned settle, uint64_t bits_per_lane)
+{
+	static const uint8_t irq_masks[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+	uint32_t lane_enable = 0;
+
+	/* cam_csiphy_get_lane_enable(): D-PHY data lane n at bit 2n, the clock lane at 7; C-PHY trio n at bit 2n + 1 */
+	for (unsigned l = 0; l < lanes; l++, lane_assign >>= 4) {
+		unsigned n = lane_assign & 0xf;
+
+		if (n > (cphy ? 2u : 3u)) {
+			give_up("a lane assignment not known here");
+			return false;
+		}
+		lane_enable |= cphy ? 1u << (2 * n + 1) : 1u << (2 * n) | 0x80u;
+	}
+	wr(csiphy + 0x814, 0x00);
+	spin_us(5);
+	wr(csiphy + 0x818, 0x00);
+	wr(csiphy + 0x81c, 0x00);
+	wr(csiphy + 0x800, 0x01);
+	spin_us(1);
+	wr(csiphy + 0x800, 0x00);
+	csiphy_running = true;
+	if (!csiphy_common(lane_enable, cphy) || !(cphy ? csiphy_cphy(settle, bits_per_lane) : csiphy_dphy(settle))) {
+		return false;
+	}
+	for (unsigned i = 0; i < 11; i++) {
+		wr(csiphy + 0x82c + 4 * i, irq_masks[i]);
+		wr(csiphy + 0x858 + 4 * i, 0xff);
+	}
+	wr(csiphy + 0x828, 0x1);
+	wr(csiphy + 0x828, 0x0);
+	say("camera: CSIPHY %u configured: %u %s (lanes enabled %#x), settle count %u\n", hw->csiphy, lanes, cphy ? "trio(s), C-PHY" :
+	    "lane(s), D-PHY", lane_enable, settle);
+	return true;
+}
+
+static void
+show_csiphy(const char *when)
+{
+	char line[200];
+	int at = snprintf(line, sizeof(line), "camera: CSIPHY %u %s, interrupt status:", hw->csiphy, when);
+
+	for (unsigned i = 0; i < 11 && at < (int)sizeof(line) - 6; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %02x", rd(csiphy + 0x8b0 + 4 * i) & 0xff);
+	}
+	say("%s\n", line);
+}
+
+static void
+csiphy_down(void)
+{
+	if (!csiphy_running) {
+		return;
+	}
+	wr(csiphy + 0x814, 0x00);
+	spin_us(5);
+	wr(csiphy + 0x818, 0x00);
+	wr(csiphy + 0x81c, 0x00);
+	wr(csiphy + 0x800, 0x01);
+	spin_us(1);
+	wr(csiphy + 0x800, 0x00);
+	csiphy_running = false;
+}
+
+/*
+ * The exposure. The OV02B10's module file has a table that sets it (page 1: analog gain 0x22, the
+ * frame's extra lines 0x14/0x15, the exposure in lines 0x0e/0x0f, 0x9b, then 0xfe = 2 to apply it;
+ * "holdon" here), written as Android's camera stack writes its first one; the S5KHM2SD's starts as
+ * its tables leave it. Boot-args for a look in other light, written the sensor's way: cam_shutter=
+ * LINES, cam_gain=N (OV02B10: 0x22, 16 is 1x; S5KHM2SD: 0x0204, 32 is 1x), cam_vblank=LINES (the
+ * frame that much longer: OV02B10 0x14/0x15; S5KHM2SD 0x0340, the frame length, by as many lines),
+ * the S5KHM2SD's between its group hold on and off (0x0104, its "holdon"/"holdoff" tables). The
+ * other two sensors (the S5K4H7 has the SMIA registers too) start as their tables leave them; the
+ * boot-args are for the macro and the wide one.
+ */
+static bool
+sensor_write(uint16_t address, uint16_t value, bool sixteen)
+{
+	uint8_t out[4] = { (uint8_t)(address >> 8), (uint8_t)address, (uint8_t)(value >> 8), (uint8_t)value };
+
+	if (hw->regs == REGS_OV_PAGED) {
+		out[0] = (uint8_t)address;
+		out[1] = (uint8_t)value;
+		return i2c_transfer(&cci_bus, sensor_address(), out, 2, NULL, 0);
+	}
+	return sixteen ? i2c_transfer(&cci_bus, sensor_address(), out, 4, NULL, 0) :
+	       i2c_transfer(&cci_bus, sensor_address(), (uint8_t[]){ out[0], out[1], out[3] }, 3, NULL, 0);
+}
+
+/*
+ * The wide camera's lens: a voice-coil motor driven by a Dongwoon DW9800 on the sensor's own I2C at
+ * 0x0c (the module file's actuatorDriver, "hakios_sunny_s5khm2sd_dw9800_wide"), powered by the
+ * PM8350C's L9 (the device tree's actuator0: cam_vaf at 2.8 V, a regulator the SD card's slot has as
+ * its vdd too; RPMh's "ldoc9"). The module file's initialisation, as it is: 0x02 = 0x01 (power down),
+ * 0x02 = 0x00 and 1 ms, 0x02 = 0x02 (ring control), 0x06 = 0x40 (SAC3), 0x07 = 0x07 (its timing), the
+ * position 0x190 and 20 ms, then 0x12c. The position is ten bits, 0x03 (the high two) and 0x04 written
+ * together (its registerParam). Those registers only are written. The other three cameras' lenses
+ * are fixed. When the motor does not answer, L9 is switched on (and back off at the end) and it is
+ * asked again; at the end the lens is let down to 0 and the chip powered down.
+ */
+#define AF_ADDRESS              0x0c
+#define AF_CONTROL              0x02            /* [0] power down, [1] ring control */
+#define AF_POSITION             0x03            /* and 0x04: ten bits */
+#define AF_MODE                 0x06
+#define AF_TIMING               0x07
+#define VAF_MV                  2800
+#define VRM_VOLTAGE             0x0             /* an RPMh VRM resource's registers (rpmh-regulator.c) */
+#define VRM_ENABLE              0x4
+#define VRM_MODE                0x8
+#define VRM_MODE_HPM            7               /* a PMIC5 LDO's high power mode */
+
+static bool vaf_voted;
+static uint32_t af_position = HAKIOS_CAMERA_NO_FOCUS;
+
+/* (a look, for now: what the LDOs say after the motor does something; said only when not all is well) */
+static void
+af_look(const char *when)
+{
+	for (unsigned n = 1; n <= 7; n++) {
+		uint8_t status = 0;
+
+		if (ldo_switched[n] && pm8008_get(PM8008_REGULATORS, (uint16_t)(LDO_BASE(n) + LDO_STATUS1), &status, 1) &&
+		    (status & 0xb8) != 0x80) {
+			say("camera: %s: PM8008i LDO%u status %#04x\n", when, n, status);
+		}
+	}
+}
+
+static bool
+af_write(uint8_t reg, uint16_t value)
+{
+	uint8_t out[3] = { reg, (uint8_t)value, 0 };
+
+	if (reg != AF_CONTROL && reg != AF_POSITION && reg != AF_MODE && reg != AF_TIMING) {
+		return false;
+	}
+	if (reg == AF_POSITION) {
+		out[1] = (uint8_t)(value >> 8 & 3);
+		out[2] = (uint8_t)value;
+	}
+	return i2c_transfer(&cci_bus, AF_ADDRESS, out, reg == AF_POSITION ? 3 : 2, NULL, 0);
+}
+
+/* L9C at 2.8 V in high power mode, or given back. True: RPMh has said done. */
+static bool
+vaf(bool on)
+{
+	uint16_t levels[1];
+	unsigned count;
+	uint32_t base = rpmh_resource("ldoc9", levels, 1, &count), addresses[3], values[3];
+	bool done;
+
+	if (base == 0) {
+		say("camera: RPMh has no ldoc9 (the lens motor's supply)\n");
+		return false;
+	}
+	addresses[0] = base + VRM_VOLTAGE;
+	values[0] = VAF_MV;
+	addresses[1] = base + VRM_MODE;
+	values[1] = VRM_MODE_HPM;
+	addresses[2] = base + VRM_ENABLE;
+	values[2] = on;
+	/* the vote is recorded before the request, as rails() does: one RPMh finishes after our wait must still be given back */
+	vaf_voted = on;
+	done = on ? rpmh_write(3, addresses, values) : rpmh_write(1, &addresses[2], &values[2]);
+	say("camera: RPMh %s L9C (%#x) %s\n", done ? "took" : "DID NOT SAY IT TOOK", base, on ? "on at 2800 mV" : "off");
+	return done;
+}
+
+static void
+af_up(bool sensor_frames)
+{
+	af_position = HAKIOS_CAMERA_NO_FOCUS;
+	if (hw != &sensors[1] || !sensor_frames) {
+		return;
+	}
+	if (!af_write(AF_CONTROL, 0x01)) {
+		say("camera: the lens motor (DW9800 at 0x0c) does not answer: its supply on\n");
+		if (!vaf(true)) {
+			return;
+		}
+		wait_ms(2);
+		af_look("the lens motor's supply on");
+		if (!af_write(AF_CONTROL, 0x01)) {
+			say("camera: the lens motor does not answer with its supply on either: no focus in this session\n");
+			(void)vaf(false);
+			return;
+		}
+	}
+	if (!af_write(AF_CONTROL, 0x00)) {
+		goto failed;
+	}
+	wait_ms(1);
+	if (!af_write(AF_CONTROL, 0x02) || !af_write(AF_MODE, 0x40) || !af_write(AF_TIMING, 0x07) || !af_write(AF_POSITION, 0x190)) {
+		goto failed;
+	}
+	wait_ms(20);
+	if (!af_write(AF_POSITION, 0x12c)) {
+		goto failed;
+	}
+	af_position = 0x12c;
+	af_look("the lens motor initialised");
+	say("camera: the lens motor (DW9800) is up, the lens at %u\n", af_position);
+	return;
+failed:
+	say("camera: the lens motor stopped answering during its initialisation: no focus in this session\n");
+}
+
+static void
+af_move(uint32_t position)
+{
+	if (af_position == HAKIOS_CAMERA_NO_FOCUS) {
+		return;
+	}
+	position = position > 1023 ? 1023 : position;
+	if (position != af_position && af_write(AF_POSITION, (uint16_t)position)) {
+		char when[48];
+
+		snprintf(when, sizeof(when), "the lens from %u to %u", af_position, position);
+		af_position = position;
+		af_look(when);
+	}
+}
+
+static void
+af_down(void)
+{
+	if (af_position != HAKIOS_CAMERA_NO_FOCUS) {
+		/* down in steps, not to knock the lens against its stop */
+		while (af_position > 0) {
+			uint32_t was = af_position;
+
+			af_move(af_position > 48 ? af_position - 48 : 0);
+			if (af_position == was) {
+				break;
+			}
+			wait_ms(10);
+		}
+		(void)af_write(AF_CONTROL, 0x01);
+		af_position = HAKIOS_CAMERA_NO_FOCUS;
+	}
+	if (vaf_voted) {
+		(void)vaf(false);
+	}
+}
+
+static bool
+exposure(const struct ctab_mode *mode)
+{
+	uint32_t shutter = 0, gain = 0, vblank = 0;
+	bool ok;
+
+	(void)PE_parse_boot_argn("cam_shutter", &shutter, sizeof(shutter));
+	(void)PE_parse_boot_argn("cam_gain", &gain, sizeof(gain));
+	(void)PE_parse_boot_argn("cam_vblank", &vblank, sizeof(vblank));
+	if (hw->regs == REGS_OV_PAGED && !sensor_table("holdon")) {
+		return false;
+	}
+	if (shutter == 0 && gain == 0 && vblank == 0) {
+		return true;
+	}
+	if (hw->regs != REGS_OV_PAGED && hw != &sensors[1]) {
+		say("camera: cam_shutter, cam_gain and cam_vblank are for the macro and the wide camera: the %s one's exposure is "
+		    "its tables'\n", hw->name);
+		return true;
+	}
+	vblank = vblank > 0x3fff ? 0x3fff : vblank;
+	if (shutter > mode->frame_length + vblank - 40) {
+		shutter = mode->frame_length + vblank - 40;     /* (within the frame's lines, as the sensors want) */
+	}
+	if (hw->regs == REGS_OV_PAGED) {
+		gain = gain > 0xf8 ? 0xf8 : gain;
+		ok = sensor_write(0xfd, 0x01, false) && (vblank == 0 || (sensor_write(0x14, (uint16_t)(vblank >> 8), false) &&
+		    sensor_write(0x15, (uint16_t)(vblank & 0xff), false))) && (shutter == 0 ||
+		    (sensor_write(0x0e, (uint16_t)(shutter >> 8), false) && sensor_write(0x0f, (uint16_t)(shutter & 0xff), false))) &&
+		    (gain == 0 || sensor_write(0x22, (uint16_t)gain, false)) && sensor_write(0xfe, 0x02, false) &&
+		    sensor_write(0xfd, 0x00, false);
+	} else {
+		gain = gain > 0x1000 ? 0x1000 : gain;
+		ok = sensor_table("holdon") && (vblank == 0 || sensor_write(0x0340, (uint16_t)(mode->frame_length + vblank), true)) &&
+		    (shutter == 0 || sensor_write(0x0202, (uint16_t)shutter, true)) && (gain == 0 || sensor_write(0x0204, (uint16_t)gain, true)) &&
+		    sensor_table("holdoff");
+	}
+	if (!ok) {
+		give_up("a sensor write nobody acknowledged");
+		return false;
+	}
+	say("camera: the exposure set to %u lines, gain %#x, %u extra lines a frame\n", shutter, gain, vblank);
+	return true;
+}
+
+static void
+capture_sensor(void)
+{
+	uint32_t width, height, stride, settle = 0, pattern = 0, wanted = 8, mode_n = ~0u;
+	const struct ctab_mode *mode;
+	struct cam_header *h;
+	char res[8];
+	uint64_t rate;
+
+	if (!ctab_load()) {
+		return;
+	}
+	/* the mode: cam_mode=N, or the one with the fewest pixels */
+	if (!PE_parse_boot_argn("cam_mode", &mode_n, sizeof(mode_n)) || mode_n >= ctab->modes) {
+		mode_n = 0;
+		for (uint32_t m = 1; m < ctab->modes; m++) {
+			if ((uint64_t)ctab_modes[m].width * ctab_modes[m].height <
+			    (uint64_t)ctab_modes[mode_n].width * ctab_modes[mode_n].height) {
+				mode_n = m;
+			}
+		}
+	}
+	mode = &ctab_modes[mode_n];
+	snprintf(res, sizeof(res), "res%u", mode_n);
+	width = mode->width;
+	height = mode->height;
+	stride = RAW10_STRIDE(width);
+	rate = (uint64_t)mode->pixel_clock * 10 / (mode->lanes ? mode->lanes : 1);
+	(void)PE_parse_boot_argn("cam_frames", &wanted, sizeof(wanted));
+	wanted = wanted < 1 ? 1 : wanted > 300 ? 300 : wanted;
+	if (!PE_parse_boot_argn("cam_settle", &settle, sizeof(settle)) || settle == 0) {
+		settle = mode->settle;  /* (the module file's, for this mode) */
+	}
+	/* (sides over 16384 would wrap the 32-bit frame size below; a frame_length of 40 or less would wrap exposure()'s `- 40') */
+	if (mode->lanes < 1 || mode->lanes > (mode->cphy ? 3u : 4u) || mode->data_type != RAW10_DT || width % 4 != 0 ||
+	    width > 16384 || height > 16384 || mode->frame_length <= 40) {
+		say("camera: mode %u: %u lanes, data type %#x: not what this is written for\n", mode_n, mode->lanes, mode->data_type);
+		return;
+	}
+	say("camera: mode %u: %ux%u, %u %s at %llu bit/s each, settle count %u\n", mode_n, width, height, mode->lanes,
+	    mode->cphy ? "trio(s)" : "lane(s)", rate, settle);
+	if (!frames_alloc(width, height, stride, 1)) {
+		return;
+	}
+	if (!power_up() || !healthy() || !read_chip_id() || !sensor_table("init") || !sensor_table(res) || !healthy() ||
+	    !titan_up() || !smmu_up() || !csid_reset() ||
+	    !csid_config((int)hw->csiphy, mode->lanes, ctab->lane_assign & ((1u << (4 * mode->lanes)) - 1), 0, width, height,
+	    mode->cphy != 0) || !ife_config(FRAME_ADDRESSES + CAM_HEADER_BYTES, stride * height, stride * height) ||
+	    !csiphy_up(mode->lanes, mode->cphy != 0, ctab->lane_assign, settle, rate)) {
+		csiphy_down();
+		titan_down();
+		return;
+	}
+	show_paths("configured");
+	h = (struct cam_header *)frames;
+	(void)PE_parse_boot_argn("cam_pattern", &pattern, sizeof(pattern));
+	/*
+	 * The picture's order is the one each sensor's module file gives its modes (resolutionData's
+	 * colorFilterArrangement, in CamX's order: 0 BGGR, 1 GBRG, 2 GRBG, 3 RGGB -- camera.qcom.so's
+	 * TranslateColorFilterArrangement turns it into Android's by the table 3, 2, 1, 0): the OV02B10's
+	 * and the OV16A1Q's BGGR, the S5KHM2SD's and the S5K4H7's GRBG (tools/camsensor.py lists it).
+	 * Their greens are where a picture of a room has them (the sites of a cell that track each
+	 * other); red against blue had been guessed from raw levels under a warm light, the other way
+	 * round, and every picture had the two swapped. The OV02B10's own colour bars (cam_pattern=1)
+	 * are still taken for GBRG, as before: the module file says nothing of them. A sensor whose
+	 * module file has no colour bars (the wide one's and the ultra-wide's have none) gives its
+	 * picture instead.
+	 */
+	uint32_t tpg_count = 0;
+	const struct ctab_entry *tpgon = ctab_find("tpgon", &tpg_count);
+
+	if (pattern && (tpgon == NULL || tpg_count == 0 || tpgon[0].address == 0)) {
+		say("camera: cam_pattern=1: the %s sensor's module file has no colour bars of its own: its picture\n", hw->name);
+		pattern = 0;
+	}
+	h->bayer = pattern ? hw->pattern_bayer : hw->bayer;
+	if ((pattern == 0 || sensor_table("tpgon")) && sensor_table("on") && exposure(mode)) {
+		/* frames one after the other into the two places, the last of `wanted' kept (the first ones come before the exposure) */
+		for (unsigned ms = 0, done = 0; ms < 5000 && done < wanted; ms += 2) {
+			sensor_delay(2000);
+			if (!(rd(ife + BUS_IRQ_STATUS1) & 1)) {
+				continue;
+			}
+			done++;
+			if (done <= 3 || done == wanted) {
+				say("camera: frame %u written, %u ms after the sensor was started\n", done, ms + 2);
+			}
+			blk_put(ife, "IFE", BUS_IRQ_CLEAR1, 1, false);
+			blk_put(ife, "IFE", BUS_IRQ_GLOBAL_CLEAR, 1, false);
+			if (done < wanted) {
+				blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)(FRAME_ADDRESSES + CAM_HEADER_BYTES + (uint64_t)(done & 1) *
+				    stride * height), false);
+				blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+			}
+			h->frames = done < CAM_FRAMES ? done : CAM_FRAMES;
+			h->last = (done - 1) & 1;
+			if ((done & 7) == 0 && !healthy()) {
+				break;
+			}
+		}
+		show_paths("after the frames");
+		show_csiphy("after the frames");
+		(void)sensor_table("off");
+	}
+	smmu_faults();
+	csiphy_down();
+	titan_down();
+	for (vm_offset_t line = frames; line < frames + CAM_HEADER_BYTES + 256; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	const uint8_t *p = (const uint8_t *)(frames + CAM_HEADER_BYTES);
+	say("camera: the frame's first bytes: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x ... (frames done: %u)\n", p[0], p[1], p[2],
+	    p[3], p[4], p[5], p[6], p[7], p[8], p[9], h->frames);
+	for (vm_offset_t line = frames; line < frames + CAM_HEADER_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+}
+
+/* ---- cam=5: the wide camera for Darwin (/dev/hakios-camera) ------------------------------------------- */
+
+/*
+ * The sensor's frames for a program (Darwin's camera stack in mediaserverd, libhakios.media.dylib), for
+ * as long as it holds /dev/hakios-camera open (sys/hakios.camera.h): the sensor powered up and
+ * streaming at the first read after the open, everything down again at the last close, after
+ * IDLE_MS without a read, and on any fault (and then for the rest of the run). The sequence is
+ * cam=4's. The frames go into three places in turn (kernel memory, mapped page by page through the
+ * SMMU): one the IFE writes, one a read may be copying, one ready.
+ *
+ * Which place the IFE writes: at each start of frame (RDI 0's SOF, polled every millisecond) the
+ * address of the place for the frame after it goes to the write master, which takes it at the next
+ * SOF (the register update is latched there): a whole frame's time to give it in, not the blanking
+ * between two frames. Should no address be waiting at an SOF (the write master's frame increment is
+ * 0 here: it then writes the frame where the last one went, not past it), that frame is counted as
+ * written over. The exposure the program asks for is written between two frames, after
+ * the address, in the sensor's group hold; it counts from the second frame after.
+ *
+ * A picture for the host (HAKIOS_CAMERA_KEEP: what the program made of a frame) goes into one
+ * piece of memory the loader hands over after the run, as cam=3 and cam=4's frames do (xl camera).
+ */
+#define RING                    3
+#define PLACE_SPARE             (256u << 10)    /* room after each frame: some come longer than the mode's lines */
+#define IDLE_MS                 1000
+#define FRAME_TIMEOUT_MS        1500
+#define EXPOSURE_MARGIN         40
+#define GAIN_UNITY              (hw->gain_unity)
+#define GAIN_MAX                (hw->gain_max)
+#define FRAME_LINES_MAX         0xfff0
+#define RDI0_SOF                (1u << 27)      /* IFE_IRQ_STATUS0 (cam_vfe_lite16x.h: sof_irq_mask of RDI 0) */
+#define WM0_DONE                1u              /* BUS_IRQ_STATUS1 */
+
+enum { PLACE_FREE, PLACE_WRITING, PLACE_READY, PLACE_READING };
+
+static LCK_GRP_DECLARE(darwin_lck_grp, "hakios-camera");
+static LCK_MTX_DECLARE(darwin_lock, &darwin_lck_grp);
+static struct {
+	uint8_t         state;
+	uint64_t        sequence, time;
+	uint32_t        exposure_lines, gain, frame_lines;
+} place[RING];
+static vm_offset_t ring;
+static uint64_t ring_bytes, ring_tables_bytes, ring_place_bytes;
+static uint32_t ring_frame_bytes, darwin_odd_frames;
+static const struct ctab_mode *darwin_mode;
+static uint32_t darwin_mode_n, darwin_line_ns;
+static volatile bool darwin_open, darwin_streaming, darwin_wanted;  /* open; frames coming; a read wants them */
+static uint64_t darwin_last_read, darwin_given, darwin_frames_done, darwin_writes_late;
+/* reads copying from the ring now (under darwin_lock): a session's end waits for them before it frees the ring */
+static unsigned darwin_readers;
+static struct { uint32_t lines, gain, frame_lines; bool pending; uint32_t focus; bool focus_pending; } darwin_ask;
+static struct { uint32_t lines, gain, frame_lines; uint64_t from; } darwin_now, darwin_next;
+/*
+ * What the frames are (boot-arg cam_pattern): 0 the sensor's picture; 1 colour bars -- the sensor's own,
+ * where its module file has a table for them (Android's "testPatternData"), else the CSID's; 2 the
+ * CSID's colour bars (no sensor at all). The wide camera's module file has no colour bars of the
+ * sensor's (its one test pattern table is empty), so cam_pattern=1 gives it the CSID's.
+ */
+enum { SOURCE_SENSOR, SOURCE_SENSOR_PATTERN, SOURCE_CSID_TPG };
+static int darwin_source = SOURCE_SENSOR;
+/* HAKIOS_CAMERA_SENSOR: the sensor (and mode) to change to, taken between sessions */
+static volatile unsigned darwin_switch_to;         /* 1 + the sensor's index; 0: none asked for */
+static uint32_t darwin_switch_mode;
+
+static uint64_t
+darwin_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* exposure_lines, gain, frame_lines within what the sensor takes (frame_lines 0: the shortest that holds the exposure) */
+static void
+exposure_limits(uint32_t *lines, uint32_t *gain, uint32_t *frame_lines)
+{
+	uint32_t shortest = darwin_mode->frame_length;
+
+	*gain = *gain < GAIN_UNITY ? GAIN_UNITY : *gain > GAIN_MAX ? GAIN_MAX : *gain;
+	*lines = *lines < 4 ? 4 : *lines > FRAME_LINES_MAX - EXPOSURE_MARGIN ? FRAME_LINES_MAX - EXPOSURE_MARGIN : *lines;
+	if (*frame_lines == 0) {
+		*frame_lines = *lines + EXPOSURE_MARGIN > shortest ? *lines + EXPOSURE_MARGIN : shortest;
+	}
+	*frame_lines = *frame_lines < shortest ? shortest : *frame_lines > FRAME_LINES_MAX ? FRAME_LINES_MAX : *frame_lines;
+	if (*lines > *frame_lines - EXPOSURE_MARGIN) {
+		*lines = *frame_lines - EXPOSURE_MARGIN;
+	}
+}
+
+/*
+ * The exposure, gain and frame length, written the sensor's way in its group hold (its module file's
+ * "holdon" and "holdoff" tables; the OV02B10's page 1 and its 0xfe = 2):
+ *   SMIA      0x0340 frame length, 0x0202 coarse integration (lines), 0x0204 analog gain (32 is 1x)
+ *   OV16A1Q   0x380e/0x380f frame length (VTS), 0x3500..0x3502 exposure (lines, 20 bits), 0x3508/0x3509
+ *             gain (0x100 is 1x) -- the registers its tables set the first exposure in
+ *   OV02B10   0x14/0x15 the frame's extra lines, 0x0e/0x0f exposure (lines), 0x22 gain (16 is 1x)
+ */
+static bool
+exposure_write(uint32_t lines, uint32_t gain, uint32_t frame_lines)
+{
+	bool ok;
+
+	switch (hw->regs) {
+	case REGS_SMIA:
+		ok = sensor_table("holdon") && sensor_write(0x0340, (uint16_t)frame_lines, true) && sensor_write(0x0202, (uint16_t)lines, true) &&
+		    sensor_write(0x0204, (uint16_t)gain, true) && sensor_table("holdoff");
+		break;
+	case REGS_OV16:
+		ok = sensor_table("holdon") && sensor_write(0x380e, (uint16_t)(frame_lines >> 8), false) &&
+		    sensor_write(0x380f, (uint16_t)(frame_lines & 0xff), false) && sensor_write(0x3500, (uint16_t)(lines >> 16 & 0xf), false) &&
+		    sensor_write(0x3501, (uint16_t)(lines >> 8 & 0xff), false) && sensor_write(0x3502, (uint16_t)(lines & 0xff), false) &&
+		    sensor_write(0x3508, (uint16_t)(gain >> 8 & 0x1f), false) && sensor_write(0x3509, (uint16_t)(gain & 0xff), false) &&
+		    sensor_table("holdoff");
+		break;
+	default: {
+		uint32_t extra = frame_lines - darwin_mode->frame_length;
+
+		ok = sensor_write(0xfd, 0x01, false) && sensor_write(0x14, (uint16_t)(extra >> 8), false) &&
+		    sensor_write(0x15, (uint16_t)(extra & 0xff), false) && sensor_write(0x0e, (uint16_t)(lines >> 8), false) &&
+		    sensor_write(0x0f, (uint16_t)(lines & 0xff), false) && sensor_write(0x22, (uint16_t)gain, false) &&
+		    sensor_write(0xfe, 0x02, false) && sensor_write(0xfd, 0x00, false);
+		break;
+	}
+	}
+	if (!ok) {
+		give_up("a sensor write nobody acknowledged");
+		return false;
+	}
+	return true;
+}
+
+static void
+ring_free(void)
+{
+	if (page_tables != 0) {
+		kmem_free(kernel_map, page_tables, ring_tables_bytes);
+		page_tables = 0;
+	}
+	if (ring != 0) {
+		kmem_free(kernel_map, ring, ring_bytes);
+		ring = 0;
+	}
+	frames = 0;
+	frames_bytes = 0;
+}
+
+static bool
+ring_alloc(uint32_t frame_bytes)
+{
+	ring_frame_bytes = frame_bytes;
+	ring_place_bytes = round_page(frame_bytes) + PLACE_SPARE;
+	ring_bytes = RING * ring_place_bytes;
+	if (kmem_alloc(kernel_map, &ring, ring_bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("camera: no memory for %u frames (%llu KB)\n", RING, ring_bytes >> 10);
+		ring = 0;
+		return false;
+	}
+	for (vm_offset_t line = ring; line < ring + ring_bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	frames = ring;                  /* (what smmu_up() maps) */
+	frames_bytes = ring_bytes;
+	ring_tables_bytes = (2 + ((ring_bytes + 0x1fffff) >> 21)) * 4096;
+	return true;
+}
+
+/*
+ * Waits until no read is copying from the ring. Every place is FREE by now, so no new read can start
+ * one; this stops ring_free() from freeing the memory under a read that is mid-copy.
+ */
+static void
+darwin_drain_readers(void)
+{
+	lck_mtx_lock(&darwin_lock);
+	while (darwin_readers != 0) {
+		(void)msleep(&darwin_readers, &darwin_lock, PZERO, "hakios-camera-drain", NULL);
+	}
+	lck_mtx_unlock(&darwin_lock);
+}
+
+/* The session's end, whatever ended it: the sensor's "off", the blocks, the supplies, the memory. */
+static void
+darwin_stop(const char *why)
+{
+	lck_mtx_lock(&darwin_lock);
+	darwin_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	lck_mtx_unlock(&darwin_lock);
+	wakeup(&darwin_frames_done);
+	if (!broken && darwin_source != SOURCE_CSID_TPG) {
+		(void)sensor_table("off");
+	}
+	af_down();
+	/* (only when the paths were set up: a start that failed before them -- a PMIC that did not answer -- has no CSID mapped) */
+	if (csid_running || ife_running) {
+		show_paths("at the end");
+	}
+	smmu_faults();
+	csiphy_down();
+	titan_down();
+	power_down();
+	darwin_drain_readers();
+	ring_free();
+	say("camera: the frames for Darwin stopped (%s): %llu done, %llu given, %llu written over\n", why, darwin_frames_done, darwin_given,
+	    darwin_writes_late);
+}
+
+static const char *darwin_res(void);
+
+static bool
+darwin_start(void)
+{
+	uint32_t lines, gain, frame_lines;
+
+	darwin_frames_done = darwin_given = darwin_writes_late = 0;
+	darwin_odd_frames = 0;
+	if (!ring_alloc(RAW10_STRIDE(darwin_mode->width) * darwin_mode->height)) {
+		return false;
+	}
+	if (darwin_source == SOURCE_CSID_TPG) {
+		/* the CSID's colour bars in the mode's size, as cam=3 makes them: no sensor, no CSIPHY */
+		if (!titan_up() || !smmu_up() || !csid_reset() ||
+		    !csid_config(-1, 4, 0x3210, TPG_VC, darwin_mode->width, darwin_mode->height, false) ||
+		    !ife_config(FRAME_ADDRESSES, ring_frame_bytes, 0) || !tpg_start()) {
+			return false;
+		}
+		lck_mtx_lock(&darwin_lock);
+		for (int i = 0; i < RING; i++) {
+			place[i].state = PLACE_FREE;
+		}
+		place[0].state = PLACE_WRITING;
+		lck_mtx_unlock(&darwin_lock);
+		darwin_now.lines = darwin_next.lines = darwin_mode->frame_length - EXPOSURE_MARGIN;
+		darwin_now.gain = darwin_next.gain = GAIN_UNITY;
+		darwin_now.frame_lines = darwin_next.frame_lines = darwin_mode->frame_length;
+		darwin_next.from = 0;
+		say("camera: the frames for Darwin: the CSID's colour bars, %ux%u (no sensor)\n", darwin_mode->width, darwin_mode->height);
+		return true;
+	}
+	if (!power_up() || !healthy() || !read_chip_id() || !sensor_table("init") || !sensor_table(darwin_res()) || !healthy() ||
+	    !titan_up() || !smmu_up() || !csid_reset() ||
+	    !csid_config((int)hw->csiphy, darwin_mode->lanes, ctab->lane_assign & ((1u << (4 * darwin_mode->lanes)) - 1), 0, darwin_mode->width,
+	    darwin_mode->height, darwin_mode->cphy != 0) || !ife_config(FRAME_ADDRESSES, ring_frame_bytes, 0) ||
+	    !csiphy_up(darwin_mode->lanes, darwin_mode->cphy != 0, ctab->lane_assign, darwin_mode->settle,
+	    (uint64_t)darwin_mode->pixel_clock * 10 / darwin_mode->lanes)) {
+		return false;
+	}
+	if (darwin_source == SOURCE_SENSOR_PATTERN && !sensor_table("tpgon")) {
+		return false;
+	}
+	lck_mtx_lock(&darwin_lock);
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	place[0].state = PLACE_WRITING;
+	lines = darwin_ask.lines;
+	gain = darwin_ask.gain;
+	frame_lines = darwin_ask.frame_lines;
+	darwin_ask.pending = false;
+	lck_mtx_unlock(&darwin_lock);
+	exposure_limits(&lines, &gain, &frame_lines);
+	if (!sensor_table("on") || !exposure_write(lines, gain, frame_lines)) {
+		return false;
+	}
+	af_up(darwin_source == SOURCE_SENSOR);
+	darwin_now.lines = darwin_next.lines = lines;
+	darwin_now.gain = darwin_next.gain = gain;
+	darwin_now.frame_lines = darwin_next.frame_lines = frame_lines;
+	darwin_next.from = 0;
+	say("camera: the frames for Darwin: mode %u, %ux%u, %u lines of %u ns a frame at the shortest; exposure %u lines, gain %#x, "
+	    "frame %u lines\n", darwin_mode_n, darwin_mode->width, darwin_mode->height, darwin_mode->frame_length, darwin_line_ns, lines, gain, frame_lines);
+	return true;
+}
+
+static void
+darwin_session(void)
+{
+	int writing = 0, next = 0;      /* (place 0's address is the write master's from ife_config(): taken at the first SOF) */
+	uint64_t last_frame;
+
+	if (!darwin_start()) {
+		give_up("the camera did not start");
+		darwin_stop("it did not start");
+		return;
+	}
+	last_frame = darwin_ms();
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR0, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+	lck_mtx_lock(&darwin_lock);
+	darwin_streaming = true;
+	darwin_last_read = darwin_ms();
+	lck_mtx_unlock(&darwin_lock);
+	while (!broken && darwin_open && darwin_switch_to == 0) {
+		uint32_t top, bus;
+		uint64_t now;
+
+		wait_ms(1);
+		now = darwin_ms();
+		top = rd(ife + IFE_IRQ_STATUS0);
+		bus = rd(ife + BUS_IRQ_STATUS1);
+		if (!(top & RDI0_SOF) && !(bus & WM0_DONE)) {
+			if (now - last_frame > FRAME_TIMEOUT_MS) {
+				show_paths("no frame");
+				give_up("no frame for 1.5 s");
+				break;
+			}
+			if (now - darwin_last_read > IDLE_MS) {
+				break;
+			}
+			continue;
+		}
+		blk_put(ife, "IFE", IFE_IRQ_CLEAR0, top & RDI0_SOF, false);
+		blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+		blk_put(ife, "IFE", BUS_IRQ_CLEAR1, bus & WM0_DONE, false);
+		blk_put(ife, "IFE", BUS_IRQ_GLOBAL_CLEAR, 1, false);
+		lck_mtx_lock(&darwin_lock);
+		if (bus & WM0_DONE) {
+			uint32_t ping = rd(csid + CSID_RDI0_BYTES_PING), pong = rd(csid + CSID_RDI0_BYTES_PONG);
+			uint32_t data = darwin_mode->width * 10 / 8 * darwin_mode->height;
+
+			last_frame = now;
+			darwin_frames_done++;
+			if ((ping != data || (pong != data && darwin_frames_done > 1)) && darwin_odd_frames++ < 8) {
+				say("camera: frame %llu: the CSID counted %u and %u bytes (the mode's frame is %u)\n", darwin_frames_done, ping, pong,
+				    data);
+			}
+			if (darwin_frames_done >= darwin_next.from && darwin_next.from != 0) {
+				darwin_now = darwin_next;
+				darwin_next.from = 0;
+			}
+			place[writing].state = PLACE_READY;
+			place[writing].sequence = darwin_frames_done;
+			place[writing].time = mach_absolute_time();
+			place[writing].exposure_lines = darwin_now.lines;
+			place[writing].gain = darwin_now.gain;
+			place[writing].frame_lines = darwin_now.frame_lines;
+		}
+		if (top & RDI0_SOF) {
+			if (next >= 0) {
+				writing = next;         /* (the address given at the last SOF, taken at this one) */
+				next = -1;
+			} else {
+				darwin_writes_late++;      /* no address waiting: this frame goes where the last one went */
+			}
+			place[writing].state = PLACE_WRITING;
+			/* the address for the frame after this one, taken at the next SOF: a whole frame's time to give it in */
+			for (int i = 0; i < RING; i++) {
+				int c = (writing + 1 + i) % RING;
+
+				if (c != writing && place[c].state != PLACE_READING && (next < 0 || place[c].sequence < place[next].sequence)) {
+					next = c;
+				}
+			}
+			if (next >= 0) {
+				blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)(FRAME_ADDRESSES + (uint64_t)next * ring_place_bytes), false);
+				blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+			}
+		}
+		bool ask = (bus & WM0_DONE) && darwin_ask.pending, focus = (bus & WM0_DONE) && darwin_ask.focus_pending;
+		uint32_t lines = darwin_ask.lines, gain = darwin_ask.gain, frame_lines = darwin_ask.frame_lines, position = darwin_ask.focus;
+
+		darwin_ask.pending = darwin_ask.pending && !ask;
+		darwin_ask.focus_pending = darwin_ask.focus_pending && !focus;
+		lck_mtx_unlock(&darwin_lock);
+		if (focus) {
+			af_move(position);
+		}
+		if (bus & WM0_DONE) {
+			wakeup(&darwin_frames_done);
+		}
+		if (ask && darwin_source != SOURCE_CSID_TPG) {
+			exposure_limits(&lines, &gain, &frame_lines);
+			if (lines != darwin_now.lines || gain != darwin_now.gain || frame_lines != darwin_now.frame_lines) {
+				if (!exposure_write(lines, gain, frame_lines)) {
+					break;
+				}
+				darwin_next.lines = lines;
+				darwin_next.gain = gain;
+				darwin_next.frame_lines = frame_lines;
+				darwin_next.from = darwin_frames_done + 2;
+			}
+		}
+		if ((bus & WM0_DONE) && darwin_frames_done % 30 == 0) {
+			uint32_t fsr = rd(smmu_context + SMMU_CB_FSR);
+
+			if (!healthy()) {
+				break;
+			}
+			if (fsr & SMMU_FSR_ALL) {
+				smmu_faults();
+				give_up("the SMMU refused the IFE");
+				break;
+			}
+			if (darwin_frames_done == 30 || darwin_frames_done % 900 == 0) {
+				show_paths("streaming");
+			}
+		}
+	}
+	darwin_stop(broken ? "a fault" : !darwin_open ? "closed" : darwin_switch_to != 0 ? "another sensor asked for" : "nobody reads");
+}
+
+/*
+ * cam_fake=1 (with cam=5; for QEMU): /dev/hakios-camera without the phone's camera. The sessions,
+ * sensors, modes and frame headers are cam=5's, from the same tables in fw/, but nothing of the phone
+ * is touched: the frames are a colour chart made here -- eight bars (white, beige, red, yellow, green,
+ * cyan, blue, 18 % grey) over a grey ramp -- in RAW10 in the sensor's own Bayer order, as bright as the
+ * exposure asked for makes them, so that everything above the kernel (the ISP of camera_test and of
+ * the media library, the capture graph, Camera.app) runs as it does on the phone and has a known
+ * picture to show. cam_fake_fps: frames a second (default 5: QEMU's processor is slow).
+ */
+static bool fake;
+
+/* the bars' linear reflectance, R, G, B in thousandths */
+static const uint16_t fake_bars[8][3] = {
+	{ 900, 900, 900 }, { 730, 550, 300 }, { 600, 50, 50 }, { 750, 650, 50 },
+	{ 80, 450, 100 }, { 50, 500, 600 }, { 50, 100, 550 }, { 180, 180, 180 },
+};
+
+/* one line of the chart, RAW10: `ramp' the grey ramp's, else the bars'; `odd' the second line of the cells */
+static void
+fake_line(uint8_t *out, uint32_t width, bool odd, bool ramp, uint64_t light)
+{
+	static const int red[4] = { 0, 1, 2, 3 }, blue[4] = { 3, 2, 1, 0 };
+	int r = red[hw->bayer & 3], b = blue[hw->bayer & 3];
+	uint32_t v[4];
+
+	for (uint32_t x = 0; x < width; x += 4) {
+		for (int i = 0; i < 4; i++) {
+			uint32_t px = x + (uint32_t)i, site = (odd ? 2u : 0u) + (px & 1), c = site == (uint32_t)r ? 0 : site == (uint32_t)b ? 2 : 1;
+			uint64_t refl = ramp ? (uint64_t)px * 1000 / width : fake_bars[px * 8 / width][c];
+			/* (2/15 of a 10-bit step per thousandth of reflectance and line at 1x: 18 % grey at AE's 15 % of white near 6000) */
+			uint64_t level = 64 + refl * light * 2 / 15000;
+
+			v[i] = level > 1023 ? 1023 : (uint32_t)level;
+		}
+		uint8_t *g = out + (x / 4) * 5;
+
+		g[0] = (uint8_t)(v[0] >> 2);
+		g[1] = (uint8_t)(v[1] >> 2);
+		g[2] = (uint8_t)(v[2] >> 2);
+		g[3] = (uint8_t)(v[3] >> 2);
+		g[4] = (uint8_t)((v[0] & 3) | (v[1] & 3) << 2 | (v[2] & 3) << 4 | (v[3] & 3) << 6);
+	}
+}
+
+/* place p filled with the chart as an exposure of `lines' at `gain' shows it */
+static void
+fake_fill(int p, uint32_t lines, uint32_t gain)
+{
+	uint8_t *at = (uint8_t *)(ring + (uint64_t)p * ring_place_bytes);
+	uint32_t width = darwin_mode->width, height = darwin_mode->height, stride = RAW10_STRIDE(width), ramp_from = height * 3 / 4 & ~1u;
+	uint64_t light = (uint64_t)lines * gain / GAIN_UNITY;
+
+	fake_line(at, width, false, false, light);
+	fake_line(at + stride, width, true, false, light);
+	fake_line(at + (uint64_t)ramp_from * stride, width, false, true, light);
+	fake_line(at + (uint64_t)(ramp_from + 1) * stride, width, true, true, light);
+	for (uint32_t y = 2; y < height; y++) {
+		if (y != ramp_from && y != ramp_from + 1) {
+			memcpy(at + (uint64_t)y * stride, at + (uint64_t)((y & 1) + (y >= ramp_from ? ramp_from : 0)) * stride, stride);
+		}
+	}
+}
+
+/* a session of cam_fake: darwin_session()'s, with the chart for the sensor and a timer for its frames */
+static void
+fake_session(void)
+{
+	uint32_t fps = 5, lines, gain, frame_lines, filled_lines[RING] = { 0 }, filled_gain[RING] = { 0 };
+
+	(void)PE_parse_boot_argn("cam_fake_fps", &fps, sizeof(fps));
+	fps = fps < 1 ? 1 : fps > 30 ? 30 : fps;
+	darwin_frames_done = darwin_given = darwin_writes_late = 0;
+	if (!ring_alloc(RAW10_STRIDE(darwin_mode->width) * darwin_mode->height)) {
+		return;
+	}
+	lck_mtx_lock(&darwin_lock);
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+		place[i].sequence = 0;
+	}
+	lines = darwin_ask.lines;
+	gain = darwin_ask.gain;
+	frame_lines = darwin_ask.frame_lines;
+	darwin_ask.pending = false;
+	exposure_limits(&lines, &gain, &frame_lines);
+	darwin_now.lines = lines;
+	darwin_now.gain = gain;
+	darwin_now.frame_lines = frame_lines;
+	darwin_streaming = true;
+	darwin_last_read = darwin_ms();
+	lck_mtx_unlock(&darwin_lock);
+	say("camera: the frames for Darwin: cam_fake's colour chart, %ux%u in %s's order, %u a second\n", darwin_mode->width, darwin_mode->height,
+	    hw->chip, fps);
+	while (darwin_open && darwin_switch_to == 0) {
+		int p = -1;
+
+		wait_ms(1000 / fps);
+		lck_mtx_lock(&darwin_lock);
+		if (darwin_ms() - darwin_last_read > IDLE_MS) {
+			lck_mtx_unlock(&darwin_lock);
+			break;
+		}
+		if (darwin_ask.pending) {
+			lines = darwin_ask.lines;
+			gain = darwin_ask.gain;
+			frame_lines = darwin_ask.frame_lines;
+			darwin_ask.pending = false;
+			exposure_limits(&lines, &gain, &frame_lines);
+			darwin_now.lines = lines;
+			darwin_now.gain = gain;
+			darwin_now.frame_lines = frame_lines;
+		}
+		for (int i = 0; i < RING; i++) {
+			if (place[i].state != PLACE_READING && (p < 0 || place[i].sequence < place[p].sequence)) {
+				p = i;
+			}
+		}
+		if (p >= 0) {
+			place[p].state = PLACE_WRITING;
+		}
+		lck_mtx_unlock(&darwin_lock);
+		if (p < 0) {
+			darwin_writes_late++;
+			continue;
+		}
+		if (filled_lines[p] != darwin_now.lines || filled_gain[p] != darwin_now.gain) {
+			fake_fill(p, darwin_now.lines, darwin_now.gain);
+			filled_lines[p] = darwin_now.lines;
+			filled_gain[p] = darwin_now.gain;
+		}
+		lck_mtx_lock(&darwin_lock);
+		place[p].state = PLACE_READY;
+		place[p].sequence = ++darwin_frames_done;
+		place[p].time = mach_absolute_time();
+		place[p].exposure_lines = darwin_now.lines;
+		place[p].gain = darwin_now.gain;
+		place[p].frame_lines = darwin_now.frame_lines;
+		lck_mtx_unlock(&darwin_lock);
+		wakeup(&darwin_frames_done);
+	}
+	lck_mtx_lock(&darwin_lock);
+	darwin_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	lck_mtx_unlock(&darwin_lock);
+	wakeup(&darwin_frames_done);
+	darwin_drain_readers();
+	ring_free();
+	say("camera: the frames for Darwin stopped (%s): %llu done, %llu given\n", !darwin_open ? "closed" : darwin_switch_to != 0 ?
+	    "another sensor asked for" : "nobody reads", darwin_frames_done, darwin_given);
+}
+
+static const char *
+darwin_res(void)
+{
+	static char res[8];
+
+	snprintf(res, sizeof(res), "res%u", darwin_mode_n);
+	return res;
+}
+
+static int
+camdev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	if (broken) {
+		return EIO;
+	}
+	darwin_open = true;
+	return 0;
+}
+
+/* (the last close) */
+static int
+camdev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	darwin_open = false;
+	darwin_wanted = false;
+	wakeup(&darwin_open);
+	return 0;
+}
+
+static int
+camdev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_camera_frame f;
+	uint64_t since = darwin_ms();
+	int b = -1, error = 0;
+	vm_offset_t at = 0;             /* the place's address and the frame's size, taken under the lock with the place */
+	uint32_t frame_bytes = 0;
+
+	lck_mtx_lock(&darwin_lock);
+	darwin_last_read = darwin_ms();
+	if (!darwin_streaming && !darwin_wanted) {
+		darwin_wanted = true;
+		wakeup(&darwin_open);
+	}
+	for (;;) {
+		if (broken) {
+			lck_mtx_unlock(&darwin_lock);
+			return EIO;
+		}
+		b = -1;
+		for (int i = 0; i < RING; i++) {
+			if (place[i].state == PLACE_READY && place[i].sequence > darwin_given && (b < 0 || place[i].sequence > place[b].sequence)) {
+				b = i;
+			}
+		}
+		if (b >= 0) {
+			break;
+		}
+		if (darwin_ms() - since > (darwin_streaming ? 3000u : 15000u)) {      /* (the sensor's tables take seconds) */
+			lck_mtx_unlock(&darwin_lock);
+			return EAGAIN;
+		}
+		if (!darwin_streaming && !darwin_wanted) {
+			darwin_wanted = true;      /* (the frames stopped meanwhile: another sensor) */
+			wakeup(&darwin_open);
+		}
+		struct timespec ts = { 0, 100 * NSEC_PER_MSEC };
+		error = msleep(&darwin_frames_done, &darwin_lock, PZERO | PCATCH, "hakios-camera", &ts);
+		if (error != 0 && error != EWOULDBLOCK) {
+			lck_mtx_unlock(&darwin_lock);
+			return error;
+		}
+		darwin_last_read = darwin_ms();
+	}
+	place[b].state = PLACE_READING;
+	/*
+	 * Counted as a reader in the same lock hold that chose the place (the ring is live while a place is READY):
+	 * a session's end waits for this read, so the ring is not freed under the copy below (a use-after-free).
+	 */
+	darwin_readers++;
+	at = ring + (uint64_t)b * ring_place_bytes;
+	frame_bytes = ring_frame_bytes;
+	darwin_given = place[b].sequence;
+	bzero(&f, sizeof(f));
+	memcpy(f.magic, HAKIOS_CAMERA_MAGIC, 8);
+	f.header_bytes = sizeof(f);
+	f.width = darwin_mode->width;
+	f.height = darwin_mode->height;
+	f.stride = RAW10_STRIDE(darwin_mode->width);
+	f.format = 1;
+	f.bayer = darwin_source == SOURCE_CSID_TPG ? 0 : darwin_source == SOURCE_SENSOR_PATTERN ? hw->pattern_bayer : hw->bayer;
+	f.black = 64;
+	f.sequence = place[b].sequence;
+	f.time = place[b].time;
+	f.exposure_lines = place[b].exposure_lines;
+	f.line_ns = darwin_line_ns;
+	f.gain = place[b].gain;
+	f.gain_unity = GAIN_UNITY;
+	f.gain_max = GAIN_MAX;
+	f.frame_lines = place[b].frame_lines;
+	f.frame_lines_min = darwin_mode->frame_length;
+	f.frame_lines_max = FRAME_LINES_MAX;
+	f.margin = EXPOSURE_MARGIN;
+	f.sensor = hw_index;
+	f.focus = af_position;
+	lck_mtx_unlock(&darwin_lock);
+
+	error = uiomove((caddr_t)&f, (int)MIN(sizeof(f), (size_t)uio_resid(uio)), uio);
+	if (error == 0 && uio_resid(uio) > 0) {
+		uint32_t n = (uint32_t)MIN((uint64_t)frame_bytes, (uint64_t)uio_resid(uio));
+
+		uint64_t t0 = mach_absolute_time(), t1, t2;
+
+		/* (what the IFE wrote went past the processor's caches) */
+		for (vm_offset_t line = at & ~63ul; line < at + n; line += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (line));
+		}
+		__asm__ volatile ("dsb sy");
+		t1 = mach_absolute_time();
+		error = uiomove((caddr_t)at, (int)n, uio);
+		t2 = mach_absolute_time();
+		if (f.sequence <= 3 || f.sequence % 300 == 0) {
+			uint64_t a, b;
+
+			absolutetime_to_nanoseconds(t1 - t0, &a);
+			absolutetime_to_nanoseconds(t2 - t1, &b);
+			say("camera: frame %llu read: %u bytes, the caches' lines forgotten in %llu us, copied in %llu us\n", f.sequence, n,
+			    a / 1000, b / 1000);
+		}
+	}
+	lck_mtx_lock(&darwin_lock);
+	if (place[b].state == PLACE_READING) {
+		place[b].state = PLACE_READY;
+	}
+	darwin_last_read = darwin_ms();
+	darwin_readers--;                  /* (the copy is over: a session's end waiting to free the ring may go on) */
+	lck_mtx_unlock(&darwin_lock);
+	wakeup(&darwin_readers);
+	return error;
+}
+
+/* serialises the writers of `keep' (never held together with darwin_lock) */
+static LCK_MTX_DECLARE(keep_lock, &darwin_lck_grp);
+
+/* HAKIOS_CAMERA_KEEP: a picture for the host, in one piece of memory the loader hands over. */
+static int
+keep_picture(const struct hakios_camera_command *c, struct uio *uio)
+{
+	struct cam_header *h;
+	uint64_t want = round_page(CAM_HEADER_BYTES + (uint64_t)c->bytes);
+
+	if (c->bytes == 0 || c->d < 1 || c->d > 3 || (uint64_t)c->c * c->b > (uint64_t)c->bytes * 2) {
+		return EINVAL;
+	}
+	if (keep == 0 || keep_bytes < want) {
+		return ENOSPC;                  /* (the piece is made when the device is, while there is memory in one piece) */
+	}
+	/*
+	 * One writer at a time (its own mutex: darwin_lock is the capture thread's and must not wait on a user copy):
+	 * two writers would interleave one picture's header with the other's data in `keep'.
+	 */
+	lck_mtx_lock(&keep_lock);
+	h = (struct cam_header *)keep;
+	bzero(h, CAM_HEADER_BYTES);
+	memcpy(h->magic, "RWCAM001", 8);
+	h->width = c->a;
+	h->height = c->b;
+	h->stride = c->c;
+	h->format = c->d;
+	h->bayer = c->d == 1 ? hw->bayer : 0;
+	h->frame_bytes = c->bytes;
+	h->source = 2;
+	strlcpy(h->sensor, "Darwin", sizeof(h->sensor));
+	int error = uiomove((caddr_t)(keep + CAM_HEADER_BYTES), (int)MIN((uint64_t)c->bytes, (uint64_t)uio_resid(uio)), uio);
+	h->frames = error == 0 ? 1 : 0;
+	for (vm_offset_t line = keep; line < keep + want; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	loader_recording[0] = kvtophys(keep);
+	loader_recording[1] = want;
+	loader_recording[2] = (uint64_t)keep;
+	lck_mtx_unlock(&keep_lock);
+	say("camera: a picture from Darwin for the host: %ux%u, format %u, %u bytes\n", c->a, c->b, c->d, c->bytes);
+	return error;
+}
+
+static int
+camdev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_camera_command c;
+	int error;
+
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c) || (error = uiomove((caddr_t)&c, sizeof(c), uio)) != 0) {
+		return EINVAL;
+	}
+	if (c.command == HAKIOS_CAMERA_EXPOSURE) {
+		lck_mtx_lock(&darwin_lock);
+		darwin_ask.lines = c.a;
+		darwin_ask.gain = c.b;
+		darwin_ask.frame_lines = c.c;
+		darwin_ask.pending = true;
+		lck_mtx_unlock(&darwin_lock);
+		return 0;
+	}
+	if (c.command == HAKIOS_CAMERA_KEEP) {
+		return keep_picture(&c, uio);
+	}
+	if (c.command == HAKIOS_CAMERA_FOCUS) {
+		lck_mtx_lock(&darwin_lock);
+		darwin_ask.focus = c.a;
+		darwin_ask.focus_pending = true;
+		lck_mtx_unlock(&darwin_lock);
+		return 0;
+	}
+	if (c.command == HAKIOS_CAMERA_SENSOR) {
+		if (c.a >= sizeof(sensors) / sizeof(sensors[0])) {
+			return EINVAL;
+		}
+		lck_mtx_lock(&darwin_lock);
+		darwin_switch_mode = c.b;
+		darwin_switch_to = c.a + 1;
+		lck_mtx_unlock(&darwin_lock);
+		wakeup(&darwin_open);
+		return 0;
+	}
+	return EINVAL;
+}
+
+static const struct cdevsw camdev_cdevsw = {
+	.d_open = camdev_open, .d_close = camdev_close, .d_read = camdev_read, .d_write = camdev_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/*
+ * The device node, made as the thread starts (before mediaserverd does: its capture stack looks for
+ * cameras once, when it starts); reads wait until serve_darwin() is there to answer them.
+ */
+static bool camdev_made;
+
+static void
+camdev_make(void)
+{
+	int major = cdevsw_add(-1, &camdev_cdevsw);
+
+	camdev_made = major >= 0 && devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-camera") != NULL;
+}
+
+/*
+ * The sensor (and its mode) the sessions take: its tables, the mode asked for or else the one with
+ * the most pixels of those at 4:3, at most 30 frames a second and 13 megapixels (the wide one's
+ * 4000x3000, the front one's 2304x1728, the ultra-wide's 3264x2448, the macro's 1600x1200), the
+ * colour bars' source (cam_pattern), the first exposure. False if the sensor cannot be used.
+ */
+static bool
+darwin_select(unsigned index, uint32_t mode_n)
+{
+	select_sensor(index);
+	if (!fake) {
+		find_pins();
+	}
+	if (!ctab_load()) {
+		return false;
+	}
+	if (mode_n >= ctab->modes) {
+		uint64_t best = 0;
+
+		mode_n = 0;
+		for (uint32_t m = 0; m < ctab->modes; m++) {
+			const struct ctab_mode *o = &ctab_modes[m];
+			uint64_t pixels = (uint64_t)o->width * o->height;
+
+			if (o->width * 3 == o->height * 4 && o->fps_milli <= 31000 && pixels <= 13000000 && pixels > best) {
+				best = pixels;
+				mode_n = m;
+			}
+		}
+	}
+	darwin_mode_n = mode_n;
+	darwin_mode = &ctab_modes[mode_n];
+	if (darwin_mode->lanes < 1 || darwin_mode->lanes > (darwin_mode->cphy ? 3u : 4u) || darwin_mode->data_type != RAW10_DT ||
+	    darwin_mode->width % 4 != 0 || darwin_mode->fps_milli == 0 || darwin_mode->frame_length == 0 ||
+	    /* (a frame_length not above the margin makes `frame_length - EXPOSURE_MARGIN' wrap; sides over 16384 make the
+	     * 32-bit frame size wrap, so the ring and the IFE's writes would disagree) */
+	    darwin_mode->frame_length <= EXPOSURE_MARGIN || darwin_mode->frame_length > FRAME_LINES_MAX || darwin_mode->width > 16384 ||
+	    darwin_mode->height > 16384) {
+		say("camera: mode %u is not what this is written for\n", mode_n);
+		return false;
+	}
+	darwin_line_ns = (uint32_t)(1000000000000ull / ((uint64_t)darwin_mode->fps_milli * darwin_mode->frame_length));
+	uint32_t pattern = 0, count = 0;
+	const struct ctab_entry *tpgon;
+
+	(void)PE_parse_boot_argn("cam_pattern", &pattern, sizeof(pattern));
+	tpgon = ctab_find("tpgon", &count);
+	darwin_source = pattern == 0 ? SOURCE_SENSOR : pattern == 1 && tpgon != NULL && count > 0 && tpgon[0].address != 0 ?
+	    SOURCE_SENSOR_PATTERN : SOURCE_CSID_TPG;
+	if (pattern != 0) {
+		say("camera: cam_pattern=%u: %s\n", pattern, darwin_source == SOURCE_SENSOR_PATTERN ? "the sensor's colour bars (its tpgon table)" :
+		    "the CSID's colour bars");
+	}
+	/* the first exposure, until the program asks for its own: boot-args as cam=4's, else a room's */
+	darwin_ask.lines = darwin_mode->frame_length - EXPOSURE_MARGIN;
+	darwin_ask.gain = 8 * GAIN_UNITY;
+	darwin_ask.frame_lines = 0;
+	(void)PE_parse_boot_argn("cam_shutter", &darwin_ask.lines, sizeof(darwin_ask.lines));
+	(void)PE_parse_boot_argn("cam_gain", &darwin_ask.gain, sizeof(darwin_ask.gain));
+	say("camera: /dev/hakios-camera: the %s camera's frames (mode %u: %ux%u, %u.%03u frames/s at the most), whenever it is "
+	    "read\n", hw->name, mode_n, darwin_mode->width, darwin_mode->height, darwin_mode->fps_milli / 1000, darwin_mode->fps_milli % 1000);
+	return true;
+}
+
+/* cam=5: a session whenever a read wants frames, another sensor whenever one is asked for, until a fault. */
+static void
+serve_darwin(void)
+{
+	uint32_t mode_n = ~0u;
+
+	if (!camdev_made) {
+		say("camera: /dev/hakios-camera cannot be made\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("cam_mode", &mode_n, sizeof(mode_n));
+	if (!darwin_select(hw_index, mode_n)) {
+		return;
+	}
+	while (!broken) {
+		lck_mtx_lock(&darwin_lock);
+		while (!broken && !(darwin_open && darwin_wanted) && darwin_switch_to == 0) {
+			(void)msleep(&darwin_open, &darwin_lock, PZERO, "hakios-camera-idle", NULL);
+		}
+		unsigned to = darwin_switch_to;
+
+		darwin_switch_to = 0;
+		lck_mtx_unlock(&darwin_lock);
+		if (broken) {
+			break;
+		}
+		if (to != 0) {
+			/* (the last session is over: everything is down) */
+			if (!darwin_select(to - 1, darwin_switch_mode)) {
+				give_up("a sensor that cannot be used");
+				break;
+			}
+			continue;
+		}
+		lck_mtx_lock(&darwin_lock);
+		darwin_wanted = false;
+		lck_mtx_unlock(&darwin_lock);
+		if (fake) {
+			fake_session();
+		} else {
+			darwin_session();
+		}
+	}
+	say("camera: /dev/hakios-camera: no more frames in this run\n");
+}
+
+/* ---- the look, and the thread ----------------------------------------------------------------------- */
+
+static void
+show_ldos(void)
+{
+	const struct supply *all[3] = { &hw->vana, &hw->vdig, &hw->vio };
+
+	for (int i = 0; i < 3; i++) {
+		if (all[i]->kind == SUPPLY_LDO) {
+			show_ldo(all[i]->ldo);
+		}
+	}
+}
+
+static void
+look(void)
+{
+	uint8_t regs[5], type = 0, subtype = 0, sts = 0, revid[4] = { 0 }, enable = 0;
+
+	show_clocks();
+	show_pin(PIN_PMIC_SDA, "the PM8008i's I2C data");
+	show_pin(PIN_PMIC_SCL, "the PM8008i's I2C clock");
+	show_pin(hw->mclk_pin, "the sensor's MCLK");
+	show_pin(hw->sda, "the sensor's CCI data");
+	show_pin(hw->scl, "the sensor's CCI clock");
+	show_pin(hw->reset, "the sensor's reset");
+	if (hw->vana.kind == SUPPLY_GPIO) {
+		show_pin(hw->vana.gpio, "the sensor's VANA switch");
+	}
+	if (!pgpio_found || pgpio_read(PGPIO_TYPE, &type) != NULL || pgpio_read(PGPIO_SUBTYPE, &subtype) != NULL ||
+	    pgpio_read(PGPIO_RT_STS, &sts) != NULL || !pgpio_read_all(regs)) {
+		say("camera: the PM8350C's GPIO 3 cannot be read\n");
+		return;
+	}
+	say("camera: the PM8350C's GPIO 3 (the PM8008i's reset): type %#04x subtype %#04x, at %u; vin %#04x pull %#04x mode %#04x "
+	    "source %#04x enable %#04x: %s\n", type, subtype, sts & 1, regs[0], regs[1], regs[2], regs[3], regs[4],
+	    pgpio_active(regs) ? "as Android's pm8008i_active (out of reset)" : "not as Android's pm8008i_active");
+	if (!pm8008_get(PM8008_CHIP, REVID_BASE, revid, 4)) {
+		say("camera: the PM8008i does not answer (in reset, or its bus is not at rest)\n");
+		return;
+	}
+	(void)pm8008_get(PM8008_CHIP, MISC_CHIP_ENABLE, &enable, 1);
+	say("camera: the PM8008i: revision %02x %02x %02x %02x, chip enable %#04x\n", revid[0], revid[1], revid[2], revid[3], enable);
+	show_ldos();
+}
+
+static void
+camera_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t secs = 20;
+	char which[16] = "";
+
+	(void)PE_parse_boot_argn("cam_after", &secs, sizeof(secs));
+	if (level == 5) {
+		camdev_make();
+	}
+	select_sensor(level == 5 ? 1 : 0);
+	if (PE_parse_boot_arg_str("cam_sensor", which, sizeof(which))) {
+		for (unsigned i = 0; i < sizeof(sensors) / sizeof(sensors[0]); i++) {
+			if (strncmp(which, sensors[i].name, strlen(which)) == 0 && (sensors[i].name[strlen(which)] == ' ' ||
+			    sensors[i].name[strlen(which)] == '-')) {
+				select_sensor(i);
+			}
+		}
+	}
+	if (fake) {
+		say("camera: cam=5 cam_fake=1: the %s camera's frames for Darwin are a chart made here; nothing of the phone is touched\n",
+		    hw->name);
+		serve_darwin();
+		say("camera: done\n");
+		thread_terminate(current_thread());
+	}
+	wait_ms(secs * 1000);           /* (the system up first: nothing else is on these buses then) */
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	gcc = ml_io_map(GCC_PHYS, 0x30000);
+	camcc = ml_io_map(CAMCC_PHYS, CAMCC_SIZE);
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_OBSERVER_SIZE);
+	say("camera: cam=%u: the %s camera%s\n", level, hw->name, level == 5 ? ": its frames for Darwin" :
+	    level == 4 ? ": its frames through its CSIPHY and RDI 0 into memory" :
+	    level == 3 ? ": the CSID's test pattern through RDI 0 into memory" :
+	    level == 2 ? ": powered up, its chip ID read, powered down" : ": a look, reading only");
+	pgpio_find();
+	find_pins();
+	look();
+	look_around();
+	if (level == 3) {
+		capture_tpg();
+		power_down();
+	} else if (level == 5) {
+		serve_darwin();
+		power_down();
+	} else if (level == 4) {
+		capture_sensor();
+		power_down();
+	} else if (level >= 2) {
+		if (ctab_load() && power_up() && healthy()) {
+			(void)read_chip_id();
+			(void)healthy();
+			show_ldos();
+		}
+		power_down();
+		look();
+	}
+	say("camera: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_camera_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("cam", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 5 ? 5 : level;
+	uint32_t fake_n = 0;
+
+	fake = level == 5 && PE_parse_boot_argn("cam_fake", &fake_n, sizeof(fake_n)) && fake_n != 0;
+	if (level >= 3) {
+		/*
+		 * Memory in one piece for the host (cam_keep_mb, default 24: a 12-megapixel NV12 picture of cam=5,
+		 * or two frames of cam=3 and cam=4 up to 12 MB each), taken now, while the system's memory still
+		 * is in large pieces.
+		 */
+		uint32_t keep_mb = 24;
+
+		(void)PE_parse_boot_argn("cam_keep_mb", &keep_mb, sizeof(keep_mb));
+		keep_bytes = (uint64_t)(keep_mb > 64 ? 64 : keep_mb) << 20;
+		if (keep_bytes != 0 && kmem_alloc_contig(kernel_map, &keep, keep_bytes, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("camera: no memory in one piece for a picture for the host (%u MB)\n", keep_mb);
+			keep = 0;
+			keep_bytes = 0;
+		}
+	}
+	if (kernel_thread_start(camera_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* At the run's end and on a panic's way out: whatever was switched on, off. */
+void
+hakios_camera_quiesce(void)
+{
+	if (level < 2 || tlmm == 0) {
+		return;
+	}
+	leaving = true;
+	broken = false;                 /* (one last time, whatever went before) */
+	csiphy_down();
+	titan_down();
+	power_down();
+}
diff --git a/bsd/dev/hakios.cell.c b/bsd/dev/hakios.cell.c
new file mode 100644
index 0000000..1a45081
--- /dev/null
+++ b/bsd/dev/hakios.cell.c
@@ -0,0 +1,358 @@
+/*
+ * en1: the modem's packets as a network interface Darwin will use.
+ *
+ * Darwin's own cellular interface (pdp_ip0) is made by its baseband stack, which is not here. What
+ * is here is the kernel's Ethernet-looking interface (hakios.net.c) and configd, which treats an
+ * Ethernet interface whose link comes up the way it treats a USB Ethernet adapter: it runs DHCP
+ * on it, takes the address, the router and the DNS servers it is given, and routes through it.
+ * So the modem's IP packets (hakios.ipa.c, QMAP mux 1) are shown as Ethernet frames between two
+ * made-up stations, the interface's and "the router's", and this file answers, in the kernel,
+ * what the stack asks of the router: ARP for any address (everything is behind the router) and
+ * DHCP with the data session's settings (the address and DNS servers the modem got from the
+ * network, hakios.mpss.c, QMI WDS). Packets to the router go to the modem; packets from the modem
+ * come from the router. IPv6 is not carried (the session is IPv4).
+ *
+ * The mask and the router given to DHCP are not the modem's: a cellular session is a point-to-point
+ * link, and its "gateway" need not be in any subnet with the address, which DHCP cannot express.
+ * The interface gets a /24 around its address with the router at its .1 (or .2): any router will
+ * do, since every packet goes to the modem anyway.
+ */
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/systm.h>
+#include <sys/hakios.net.h>
+#include <sys/hakios.ipa.h>
+
+#define CELL_UNIT               1
+#define CELL_MUX                1               /* the QMAP mux id the session is bound to (WDS Bind Mux Data Port) */
+
+static const uint8_t cell_mac[6] = { 0x02, 0x68, 0x61, 0x6b, 0x69, 0x01 };      /* locally administered: "haki", 1 */
+static const uint8_t router_mac[6] = { 0x02, 0x68, 0x61, 0x6b, 0x69, 0xfe };
+
+static LCK_GRP_DECLARE(cell_lock_group, "hakios-cell");
+static LCK_MTX_DECLARE(cell_lock, &cell_lock_group);
+static struct {
+	bool            up;
+	uint32_t        address, mask, router, dns1, dns2, mtu;        /* host order; what DHCP gives out */
+	uint32_t        modem_mask, modem_gateway;                      /* what the modem said, for the log */
+} session;
+static struct {
+	uint64_t        arp, dhcp, to_modem, from_modem, dropped_out, dropped_in, not_ip4;
+} cell_count;
+static bool cell_attached, cell_trace;
+
+static inline uint32_t
+get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static inline void
+put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+static inline void
+put16(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 8); p[1] = (uint8_t)v;
+}
+
+static uint16_t
+checksum(const uint8_t *data, size_t length)
+{
+	uint32_t sum = 0;
+
+	for (size_t i = 0; i + 1 < length; i += 2) {
+		sum += (uint32_t)data[i] << 8 | data[i + 1];
+	}
+	if (length & 1) {
+		sum += (uint32_t)data[length - 1] << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
+
+/* ---- ARP: the router answers for everything ---------------------------------------------------- */
+
+static bool
+arp_answer(const uint8_t *frame, size_t length)
+{
+	const uint8_t *arp = frame + 14;
+	uint8_t reply[42];
+
+	/* Ethernet/IPv4, a request, not for our own address */
+	if (length < 42 || get32(arp) != 0x00010800 || arp[4] != 6 || arp[5] != 4 || arp[7] != 1 || get32(arp + 24) == session.address) {
+		return false;
+	}
+	memcpy(reply, frame + 6, 6);                    /* to the asker */
+	memcpy(reply + 6, router_mac, 6);
+	put16(reply + 12, 0x0806);
+	put32(reply + 14, 0x00010800);
+	reply[18] = 6; reply[19] = 4;
+	put16(reply + 20, 2);                           /* a reply */
+	memcpy(reply + 22, router_mac, 6);              /* "that address is me" */
+	memcpy(reply + 28, arp + 24, 4);
+	memcpy(reply + 32, arp + 8, 10);                /* the asker's addresses */
+	cell_count.arp++;
+	if (cell_trace) {
+		printf("cell: ARP: %u.%u.%u.%u is the router\n", arp[24], arp[25], arp[26], arp[27]);
+	}
+	hakios_net_input_unit(CELL_UNIT, reply, sizeof(reply));
+	return true;
+}
+
+/* ---- DHCP: the session's settings ---------------------------------------------------------------- */
+
+#define DHCP_DISCOVER           1
+#define DHCP_OFFER              2
+#define DHCP_REQUEST            3
+#define DHCP_ACK                5
+#define DHCP_NAK                6
+
+/* Is this a DHCP request (UDP 68 -> 67)? `udp` is set to its UDP header. */
+static bool
+dhcp_request(const uint8_t *frame, size_t length, const uint8_t **udp)
+{
+	const uint8_t *ip = frame + 14;
+	size_t ihl;
+
+	if (length < 14 + 20 + 8 + 240 || (ip[0] >> 4) != 4 || ip[9] != 17) {
+		return false;
+	}
+	ihl = 4 * (ip[0] & 0xf);
+	if (ihl < 20 || 14 + ihl + 8 + 240 > length) {
+		return false;
+	}
+	*udp = ip + ihl;
+	return ((*udp)[2] << 8 | (*udp)[3]) == 67;
+}
+
+/* The answer to a DHCP request: an offer for a discover, an acknowledgement for a request, with the session's settings. */
+static bool
+dhcp_answer(const uint8_t *frame, size_t length, const uint8_t *udp)
+{
+	const uint8_t *request = udp + 8, *end = frame + length, *option;
+	uint8_t reply[14 + 20 + 8 + 240 + 64], *ip = reply + 14, *rudp = ip + 20, *bootp = rudp + 8, *o;
+	uint32_t type = 0, wanted = 0, kind;
+	size_t size;
+
+	if (request[0] != 1 || request[1] != 1 || request[2] != 6 || get32(request + 236) != 0x63825363) {
+		return false;
+	}
+	/* the options: the message type, the address asked for */
+	for (option = request + 240; option + 2 <= end && *option != 255; option += option[0] == 0 ? 1 : 2 + option[1]) {
+		if (option[0] == 0) {
+			continue;
+		}
+		if (option + 2 + option[1] > end) {
+			break;
+		}
+		if (option[0] == 53 && option[1] == 1) {
+			type = option[2];
+		} else if (option[0] == 50 && option[1] == 4) {
+			wanted = get32(option + 2);
+		}
+	}
+	if (type != DHCP_DISCOVER && type != DHCP_REQUEST) {
+		return false;
+	}
+	kind = type == DHCP_DISCOVER ? DHCP_OFFER : wanted != 0 && wanted != session.address ? DHCP_NAK : DHCP_ACK;
+	bzero(reply, sizeof(reply));
+	/* BOOTP */
+	bootp[0] = 2; bootp[1] = 1; bootp[2] = 6;      /* a reply, Ethernet */
+	memcpy(bootp + 4, request + 4, 4);              /* the transaction */
+	memcpy(bootp + 10, request + 10, 2);            /* the flags (broadcast) */
+	if (kind != DHCP_NAK) {
+		put32(bootp + 16, session.address);     /* yiaddr */
+		put32(bootp + 20, session.router);      /* siaddr */
+	}
+	memcpy(bootp + 28, request + 28, 16);           /* the client's hardware address */
+	put32(bootp + 236, 0x63825363);
+	o = bootp + 240;
+	*o++ = 53; *o++ = 1; *o++ = (uint8_t)kind;
+	*o++ = 54; *o++ = 4; put32(o, session.router); o += 4;      /* the server: the router */
+	if (kind != DHCP_NAK) {
+		*o++ = 51; *o++ = 4; put32(o, 86400); o += 4;           /* a day's lease */
+		*o++ = 1; *o++ = 4; put32(o, session.mask); o += 4;
+		*o++ = 3; *o++ = 4; put32(o, session.router); o += 4;
+		if (session.dns1 != 0 || session.dns2 != 0) {
+			*o++ = 6; *o++ = (uint8_t)(4 * ((session.dns1 != 0) + (session.dns2 != 0)));
+			if (session.dns1 != 0) { put32(o, session.dns1); o += 4; }
+			if (session.dns2 != 0) { put32(o, session.dns2); o += 4; }
+		}
+		if (session.mtu >= 576 && session.mtu <= 1500) {
+			*o++ = 26; *o++ = 2; put16(o, session.mtu); o += 2;
+		}
+	}
+	*o++ = 255;
+	size = (size_t)(o - bootp);
+	if (size < 300) {
+		size = 300;                             /* the traditional minimum, padded with zeros */
+	}
+	/* UDP 67 -> 68, no checksum */
+	put16(rudp, 67); put16(rudp + 2, 68); put16(rudp + 4, (uint32_t)(8 + size)); put16(rudp + 6, 0);
+	/* IPv4 from the router to everyone */
+	ip[0] = 0x45; ip[1] = 0;
+	put16(ip + 2, (uint32_t)(20 + 8 + size));
+	put16(ip + 4, 0); put16(ip + 6, 0);
+	ip[8] = 64; ip[9] = 17;
+	put32(ip + 12, session.router);
+	put32(ip + 16, 0xffffffff);
+	put16(ip + 10, checksum(ip, 20));
+	/* Ethernet to the client */
+	memcpy(reply, request + 28, 6);
+	memcpy(reply + 6, router_mac, 6);
+	put16(reply + 12, 0x0800);
+	cell_count.dhcp++;
+	printf("cell: DHCP %s answered with %s: %u.%u.%u.%u/%u.%u.%u.%u, router %u.%u.%u.%u, DNS %u.%u.%u.%u %u.%u.%u.%u, MTU %u\n",
+	    type == DHCP_DISCOVER ? "discover" : "request", kind == DHCP_OFFER ? "an offer" : kind == DHCP_ACK ? "an acknowledgement" : "a refusal",
+	    session.address >> 24, (session.address >> 16) & 0xff, (session.address >> 8) & 0xff, session.address & 0xff,
+	    session.mask >> 24, (session.mask >> 16) & 0xff, (session.mask >> 8) & 0xff, session.mask & 0xff,
+	    session.router >> 24, (session.router >> 16) & 0xff, (session.router >> 8) & 0xff, session.router & 0xff,
+	    session.dns1 >> 24, (session.dns1 >> 16) & 0xff, (session.dns1 >> 8) & 0xff, session.dns1 & 0xff,
+	    session.dns2 >> 24, (session.dns2 >> 16) & 0xff, (session.dns2 >> 8) & 0xff, session.dns2 & 0xff, session.mtu);
+	hakios_net_input_unit(CELL_UNIT, reply, 14 + 20 + 8 + size);
+	return true;
+}
+
+/* ---- the link ----------------------------------------------------------------------------------- */
+
+/* A frame from the stack: answered here, or its IP packet to the modem. */
+static bool
+cell_transmit(mbuf_t packet, size_t length)
+{
+	uint8_t frame[HAKIOS_NET_FRAME_MAX];
+	const uint8_t *udp;
+	uint32_t type;
+	bool ok;
+
+	if (length < 14 || length > sizeof(frame) || mbuf_copydata(packet, 0, length, frame) != 0) {
+		return false;
+	}
+	type = (uint32_t)frame[12] << 8 | frame[13];
+	lck_mtx_lock(&cell_lock);
+	if (type == 0x0806) {
+		ok = arp_answer(frame, length);
+	} else if (type == 0x0800 && dhcp_request(frame, length, &udp)) {
+		ok = session.up && dhcp_answer(frame, length, udp);
+	} else if (type == 0x0800) {
+		ok = session.up && hakios_ipa_transmit(CELL_MUX, frame + 14, length - 14);
+		if (ok) {
+			cell_count.to_modem++;
+		} else {
+			cell_count.dropped_out++;
+		}
+	} else {
+		cell_count.not_ip4++;                   /* IPv6 and the rest: not carried */
+		ok = false;
+	}
+	lck_mtx_unlock(&cell_lock);
+	return ok;
+}
+
+/* A packet from the modem: an Ethernet frame from the router made around it. */
+static void
+cell_receive(uint8_t mux, const uint8_t *packet, size_t length)
+{
+	uint8_t frame[HAKIOS_NET_FRAME_MAX];
+	uint32_t version = length > 0 ? packet[0] >> 4 : 0;
+
+	if (length < 20 || length + 14 > sizeof(frame) || (version != 4 && version != 6)) {
+		cell_count.dropped_in++;
+		return;
+	}
+	if (cell_trace) {
+		printf("cell: %zu bytes from the modem on mux %u (IPv%u)\n", length, mux, version);
+	}
+	memcpy(frame, cell_mac, 6);
+	memcpy(frame + 6, router_mac, 6);
+	put16(frame + 12, version == 4 ? 0x0800 : 0x86dd);
+	memcpy(frame + 14, packet, length);
+	cell_count.from_modem++;
+	hakios_net_input_unit(CELL_UNIT, frame, 14 + length);
+}
+
+static unsigned
+cell_poll(void)
+{
+	static unsigned ticks;
+	unsigned got = hakios_ipa_poll(cell_receive);
+
+	if (++ticks % 30000 == 0 && (cell_count.to_modem != 0 || cell_count.from_modem != 0 || cell_count.dropped_out != 0)) {
+		char line[256];
+
+		hakios_ipa_status(line, sizeof(line));
+		printf("cell: so far %llu packets to the modem, %llu from it; dropped %llu out, %llu in; %llu not IPv4; ARP %llu, DHCP %llu; "
+		    "IPA: %s\n", cell_count.to_modem, cell_count.from_modem, cell_count.dropped_out, cell_count.dropped_in, cell_count.not_ip4,
+		    cell_count.arp, cell_count.dhcp, line);
+	}
+	return got;
+}
+
+static struct hakios_net_link cell_link = {
+	.name = "the modem through the IPA",
+	.unit = CELL_UNIT,
+	.address = { 0x02, 0x68, 0x61, 0x6b, 0x69, 0x01 },
+	.wireless = false,
+	.up = false,
+	.transmit = cell_transmit,
+	.poll = cell_poll,
+};
+
+void
+hakios_cell_session(bool up, uint32_t address, uint32_t mask, uint32_t gateway, uint32_t dns1, uint32_t dns2, uint32_t mtu)
+{
+	uint32_t router;
+
+	lck_mtx_lock(&cell_lock);
+	session.modem_mask = mask;
+	session.modem_gateway = gateway;
+	/* a /24 around the address, with the router in it (see the top of the file) */
+	mask = 0xffffff00;
+	router = (address & mask) | 1;
+	if (router == address) {
+		router = (address & mask) | 2;
+	}
+	session.address = address;
+	session.mask = mask;
+	session.router = router;
+	session.dns1 = dns1;
+	session.dns2 = dns2;
+	session.mtu = mtu;
+	session.up = up && address != 0;
+	lck_mtx_unlock(&cell_lock);
+	printf("cell: the data session is %s: %u.%u.%u.%u (the modem's mask %u.%u.%u.%u and gateway %u.%u.%u.%u; en1 is told /24 and router "
+	    "%u.%u.%u.%u), DNS %u.%u.%u.%u %u.%u.%u.%u, MTU %u%s\n", session.up ? "UP" : "down",
+	    address >> 24, (address >> 16) & 0xff, (address >> 8) & 0xff, address & 0xff,
+	    session.modem_mask >> 24, (session.modem_mask >> 16) & 0xff, (session.modem_mask >> 8) & 0xff, session.modem_mask & 0xff,
+	    gateway >> 24, (gateway >> 16) & 0xff, (gateway >> 8) & 0xff, gateway & 0xff,
+	    router >> 24, (router >> 16) & 0xff, (router >> 8) & 0xff, router & 0xff,
+	    dns1 >> 24, (dns1 >> 16) & 0xff, (dns1 >> 8) & 0xff, dns1 & 0xff, dns2 >> 24, (dns2 >> 16) & 0xff, (dns2 >> 8) & 0xff, dns2 & 0xff,
+	    mtu, cell_attached ? "" : " (no en1: the IPA's data path is not up)");
+	if (cell_attached) {
+		hakios_net_link_state_unit(CELL_UNIT, session.up);
+	}
+}
+
+void
+hakios_cell_attach(void)
+{
+	uint32_t t = 0;
+
+	if (cell_attached || !hakios_ipa_data_ready()) {
+		return;
+	}
+	PE_parse_boot_argn("modem_ipa_data_trace", &t, sizeof(t));
+	cell_trace = t != 0;
+	cell_attached = hakios_net_attach(&cell_link);
+	if (cell_attached && session.up) {
+		hakios_net_link_state_unit(CELL_UNIT, true);
+	}
+}
diff --git a/bsd/dev/hakios.cpufreq.c b/bsd/dev/hakios.cpufreq.c
new file mode 100644
index 0000000..8b04828
--- /dev/null
+++ b/bsd/dev/hakios.cpufreq.c
@@ -0,0 +1,601 @@
+/*
+ * The clock speed of the processor cores the kernel runs on, on the POCO X5 Pro (redwood).
+ * Only with boot-arg cpufreq=1: the addresses are this phone's.
+ *
+ * The boot loader leaves each group of cores at a modest frequency and expects the operating
+ * system to ask for more. On this SoC that is one register write: the hardware ("EPSS") has
+ * a table of frequencies per group and switches the clock source and the supply voltage by
+ * itself when told which row is wanted. There is no reason for us ever to want less than the
+ * top row, for every group that has a core of ours in it (one core, unless boot-arg cpus=N
+ * says more).
+ *
+ * Register layout: Linux drivers/cpufreq/qcom-cpufreq-hw.c ("epss" variant).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern void loader_log_putc(char c);
+extern void hakios_tl(const char *format, ...) __printflike(1, 2);
+extern bool ml_cpu_idle_time(int cpu_id, uint64_t *idle);
+
+/*
+ * The loader's log as well: this runs early, and the kernel's own log of a run keeps only its end. With
+ * interrupts off -- on the way back to the loader (hakios_ddr_quiesce()) -- the loader's log only: the
+ * kernel's console may not be written there, and printf was a panic ("Console I/O from interrupt-disabled
+ * context") at the end of every run once the memory vote was taken away on the way back.
+ */
+static void
+tell(const char *format, ...) __printflike(1, 2);
+
+static void
+tell(const char *format, ...)
+{
+	char line[256];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	if (ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	}
+}
+
+#define EPSS_PHYS               0x18591000UL    /* three groups ("domains") of 0x1000: small cores, big, biggest */
+#define EPSS_DOMAIN_SIZE        0x1000UL
+#define EPSS_DOMAINS            3
+#define EPSS_FREQ_TABLE         0x100           /* a word per row: [31:30] clock source, [7:0] multiple of 19.2 MHz */
+#define EPSS_TABLE_ROWS         40
+#define EPSS_PERF_STATE         0x320           /* the row that is wanted */
+#define XO_KHZ                  19200
+#define ALTERNATE_KHZ           300000          /* source 0: a fixed 300 MHz */
+
+/* How fast a simple loop runs, in thousands of iterations per millisecond. */
+static uint32_t
+loop_speed(void)
+{
+	volatile uint64_t sink = 0;
+	uint64_t start = mach_absolute_time(), nanos;
+
+	for (uint32_t i = 0; i < 2000000; i++) {
+		sink += i;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &nanos);
+	return nanos ? (uint32_t)(2000000ULL * 1000 / nanos) : 0;
+}
+
+/* The group of the core with that number in its MPIDR (the device tree's "reg": the number is the second field). */
+static uint32_t
+domain_of(uint32_t phys_id)
+{
+	uint32_t core = (phys_id >> 8) & 0xff;
+
+	return core < 4 ? 0 : core < 7 ? 1 : 2;
+}
+
+static void
+raise_domain(uint32_t domain, uint32_t cores)
+{
+	uint32_t top = 0, top_khz = 0, was;
+	vm_offset_t base;
+
+	base = ml_io_map(EPSS_PHYS + domain * EPSS_DOMAIN_SIZE, EPSS_DOMAIN_SIZE);
+	for (uint32_t row = 0; row < EPSS_TABLE_ROWS; row++) {
+		uint32_t entry = *(volatile uint32_t *)(base + EPSS_FREQ_TABLE + 4 * row);
+		uint32_t khz = (entry >> 30) ? XO_KHZ * (entry & 0xff) : ALTERNATE_KHZ;
+
+		if (row > 0 && khz <= top_khz) {
+			break;                  /* the table ends by repeating its last row */
+		}
+		top = row;
+		top_khz = khz;
+	}
+	was = *(volatile uint32_t *)(base + EPSS_PERF_STATE);
+	*(volatile uint32_t *)(base + EPSS_PERF_STATE) = top;
+	delay_for_interval(20, NSEC_PER_MSEC);
+	tell("cpufreq: group %u (%u of our cores): row %u -> %u of the frequency table, %u MHz\n", domain, cores, was, top,
+	    top_khz / 1000);
+}
+
+/*
+ * Boot-arg membench=1: how fast this processor reads, writes and copies memory, in MB a second
+ * (32 MB at a time, far more than any cache): what the memory's clock allows a processor, which
+ * nobody here asks to be raised.
+ */
+static void
+memory_bench(void)
+{
+	const vm_size_t size = 32u << 20;
+	vm_offset_t a = 0, b = 0;
+	uint64_t began, ns[3] = { 0, 0, 0 };
+	volatile uint64_t sum = 0;
+
+	if (kmem_alloc(kernel_map, &a, size, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &b, size, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS) {
+		printf("membench: no memory\n");
+		return;
+	}
+	memset((void *)a, 1, size);
+	memset((void *)b, 2, size);
+	for (int round = 0; round < 4; round++) {
+		uint64_t t;
+
+		began = mach_absolute_time();
+		memset((void *)a, round, size);
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &t);
+		ns[0] += t;
+		began = mach_absolute_time();
+		for (const uint64_t *p = (const uint64_t *)b, *end = (const uint64_t *)(b + size); p < end; p += 8) {
+			sum += p[0] + p[1] + p[2] + p[3] + p[4] + p[5] + p[6] + p[7];
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &t);
+		ns[1] += t;
+		began = mach_absolute_time();
+		memcpy((void *)b, (const void *)a, size);
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &t);
+		ns[2] += t;
+	}
+	tell("membench: on core %llu: writing %llu MB/s, reading %llu MB/s, copying %llu MB/s\n",
+	    (__builtin_arm_rsr64("MPIDR_EL1") >> 8) & 0xff, 4ull * (size >> 20) * 1000000000ull / ns[0],
+	    4ull * (size >> 20) * 1000000000ull / ns[1], 4ull * (size >> 20) * 1000000000ull / ns[2]);
+	kmem_free(kernel_map, a, size);
+	kmem_free(kernel_map, b, size);
+}
+
+/*
+ * Boot-arg membench=2: the same on every core of ours at once (a thread each, started together, 16 MB
+ * at a time), 2 s after this starts, so that all the cores are up: the sum of what they get is what
+ * the memory gives at the clock it has been left at.
+ */
+#define BENCH_THREADS   8
+static struct {
+	volatile uint32_t ready, go, done;
+	uint64_t ns[BENCH_THREADS][3];
+	uint32_t core[BENCH_THREADS];
+} bench;
+
+static void
+bench_thread(void *arg, wait_result_t wr __unused)
+{
+	const vm_size_t size = 16u << 20;
+	uintptr_t index = (uintptr_t)arg;
+	vm_offset_t a = 0, b = 0;
+	volatile uint64_t sum = 0;
+
+	if (kmem_alloc(kernel_map, &a, size, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &b, size, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS) {
+		os_atomic_inc(&bench.ready, relaxed);
+		os_atomic_inc(&bench.done, relaxed);
+		return;
+	}
+	memset((void *)a, 1, size);
+	memset((void *)b, 2, size);
+	os_atomic_inc(&bench.ready, relaxed);
+	while (!os_atomic_load(&bench.go, acquire)) {
+	}
+	bench.core[index] = (uint32_t)(__builtin_arm_rsr64("MPIDR_EL1") >> 8) & 0xff;
+	for (int round = 0; round < 4; round++) {
+		uint64_t began, t;
+
+		began = mach_absolute_time();
+		memset((void *)a, round, size);
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &t);
+		bench.ns[index][0] += t;
+		began = mach_absolute_time();
+		for (const uint64_t *p = (const uint64_t *)b, *end = (const uint64_t *)(b + size); p < end; p += 8) {
+			sum += p[0] + p[1] + p[2] + p[3] + p[4] + p[5] + p[6] + p[7];
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &t);
+		bench.ns[index][1] += t;
+		began = mach_absolute_time();
+		memcpy((void *)b, (const void *)a, size);
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &t);
+		bench.ns[index][2] += t;
+	}
+	os_atomic_inc(&bench.done, release);
+	kmem_free(kernel_map, a, size);
+	kmem_free(kernel_map, b, size);
+}
+
+static void
+bench_all(void *arg __unused, wait_result_t wr __unused)
+{
+	const uint32_t threads = MIN(ml_get_topology_info()->num_cpus, BENCH_THREADS);
+	const uint64_t mb = 4 * 16;                     /* per thread and test */
+	uint64_t total[3] = { 0, 0, 0 };
+
+	delay_for_interval(2000, NSEC_PER_MSEC);
+	for (uintptr_t i = 0; i < threads; i++) {
+		thread_t thread;
+
+		if (kernel_thread_start(bench_thread, (void *)i, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			os_atomic_inc(&bench.ready, relaxed);
+			os_atomic_inc(&bench.done, relaxed);
+		}
+	}
+	while (os_atomic_load(&bench.ready, relaxed) < threads) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	os_atomic_store(&bench.go, 1, release);
+	while (os_atomic_load(&bench.done, acquire) < threads) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	for (uint32_t i = 0; i < threads; i++) {
+		tell("membench: all at once: core %u: writing %llu MB/s, reading %llu MB/s, copying %llu MB/s\n", bench.core[i],
+		    bench.ns[i][0] ? mb * 1000000000ull / bench.ns[i][0] : 0, bench.ns[i][1] ? mb * 1000000000ull / bench.ns[i][1] : 0,
+		    bench.ns[i][2] ? mb * 1000000000ull / bench.ns[i][2] : 0);
+		for (int k = 0; k < 3; k++) {
+			total[k] += bench.ns[i][k] ? mb * 1000000000ull / bench.ns[i][k] : 0;
+		}
+	}
+	tell("membench: all %u at once, together: writing %llu MB/s, reading %llu MB/s, copying %llu MB/s\n", threads, total[0],
+	    total[1], total[2]);
+}
+
+/*
+ * Boot-arg cpuload=MS: every MS milliseconds, how busy each of our cores was meanwhile, in
+ * percent, to the loader's log (tools/frames.py shows it per gesture):
+ *   tl: u at US 7:NN 6:NN ... 1:NN      the core's number (as in its MPIDR), then its share
+ * of the time it was not idle (interrupts included).
+ */
+static uint32_t load_every_ms;
+
+static void
+load_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint64_t idle_before[MAX_CPUS] = { 0 }, then = mach_absolute_time();
+
+	for (;;) {
+		char line[192];
+		int at;
+		uint64_t now, us;
+
+		delay_for_interval(load_every_ms, NSEC_PER_MSEC);
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now, &us);
+		at = snprintf(line, sizeof(line), "tl: u at %llu", us / 1000);
+		for (unsigned int i = 0; i < topology->num_cpus && i < MAX_CPUS; i++) {
+			uint64_t idle = 0, busy;
+
+			if (!ml_cpu_idle_time((int)i, &idle)) {
+				continue;
+			}
+			busy = (now - then) > (idle - idle_before[i]) ? (now - then) - (idle - idle_before[i]) : 0;
+			idle_before[i] = idle;
+			if (at < (int)sizeof(line) - 12) {
+				at += snprintf(line + at, sizeof(line) - at, " %u:%llu", (topology->cpus[i].phys_id >> 8) & 0xff,
+				    100 * busy / (now - then));
+			}
+		}
+		then = now;
+		hakios_tl("%s\n", line);
+	}
+}
+
+static void
+load_start(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("cpuload", &load_every_ms, sizeof(load_every_ms)) || load_every_ms == 0) {
+		return;
+	}
+	if (kernel_thread_start(load_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * Boot-arg ddr=1: the memory's bus clock managers ("BCM") in the command database the boot loader
+ * left, with what is needed to vote for bandwidth on them -- only read. (membench=2 says the cores
+ * together get no more from memory than one alone: 12 GB/s; nobody here votes for more.)
+ */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+#define CMD_DB_BCM              5               /* the kind of resource in a slave's id: bus clock managers */
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+struct cmd_db_bcm {                             /* a BCM's auxiliary data (Linux: struct bcm_db) */
+	uint32_t unit;
+	uint16_t width;
+	uint8_t vcd, reserved;
+};
+
+/* (the same condition as the cores' clocks: the addresses are this phone's) */
+static bool
+cpufreq_wanted(void)
+{
+	uint32_t on = 0;
+
+	return PE_parse_boot_argn("cpufreq", &on, sizeof(on)) && on != 0;
+}
+
+static void
+ddr_look(void)
+{
+	/* (memory, not registers: mapped so that reads of any size and alignment are allowed) */
+	const struct cmd_db_header *db = (const struct cmd_db_header *)ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		tell("ddr: no command database\n");
+		return;
+	}
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id != CMD_DB_BCM || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			struct cmd_db_bcm aux = { 0 };
+			char name[9] = { 0 };
+
+			memcpy(name, entry[i].id, 8);
+			/* (the data starts after the header, so the header counts: this keeps the read inside the mapped database) */
+			if (entry[i].length >= sizeof(aux) &&
+			    sizeof(*db) + slave->data_offset + entry[i].offset + sizeof(aux) <= CMD_DB_SIZE) {
+				memcpy(&aux, db->data + slave->data_offset + entry[i].offset, sizeof(aux));
+			}
+			tell("ddr: BCM %-8s at %#x: unit %u, width %u, vcd %u (aux %u bytes)\n", name, entry[i].address, aux.unit,
+			    aux.width, aux.vcd, entry[i].length);
+		}
+	}
+}
+
+/*
+ * ... and what the boot loader's firmware left in the application processor's RPMh command slots
+ * ("DRV 2"; Linux: rpmh-rsc.c): 2 active, 3 sleep, 3 wake slot sets and a control one, of 16 commands
+ * each (sc7280's qcom,tcs-config): every command with an address, and which of them go to the BCMs
+ * above -- the bandwidth it asked for, and that is in force whenever the processors are awake.
+ */
+#define RSC_PHYS                0x18220000UL
+#define RSC_SIZE                0x10000UL
+#define RSC_TCS(n, reg)         (0xd00 + 0x2a0 * (n) + (reg))
+#define RSC_TCS_COUNT           9
+#define RSC_CMDS                16
+
+static void
+ddr_slots(void)
+{
+	vm_offset_t rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+
+	for (unsigned t = 0; t < RSC_TCS_COUNT; t++) {
+		uint32_t enabled = *(volatile uint32_t *)(rsc + RSC_TCS(t, 0x1c));
+
+		for (unsigned c = 0; c < RSC_CMDS; c++) {
+			uint32_t msgid = *(volatile uint32_t *)(rsc + RSC_TCS(t, 0x30 + 20 * c));
+			uint32_t address = *(volatile uint32_t *)(rsc + RSC_TCS(t, 0x34 + 20 * c));
+			uint32_t data = *(volatile uint32_t *)(rsc + RSC_TCS(t, 0x38 + 20 * c));
+
+			if (address == 0 && data == 0) {
+				continue;
+			}
+			tell("ddr: slot set %u (%s) command %u%s: message %#x, address %#x, data %#x%s\n", t,
+			    t < 2 ? "active" : t < 5 ? "sleep" : t < 8 ? "wake" : "control", c, enabled & (1u << c) ? " (on)" : "",
+			    msgid, address, data, (address >> 16 & 0xf) == CMD_DB_BCM ? " <- a BCM" : "");
+		}
+	}
+}
+
+/*
+ * The memory's bandwidth (on by default; boot-arg ddr=0: not): a vote through RPMh -- the most there
+ * is -- on the bus clock managers of the memory controller (MC0: the memory's clock) and of the
+ * shared hub in front of it with the system cache (SH0), as Linux's interconnect driver casts for
+ * a busy GPU (icc-bcm-voter.c: a BCM command is commit, valid, the average and the peak, 14 bits each,
+ * in the BCM's units; the BCM takes the highest of its levels the vote reaches), and the memory kept
+ * on for this processor (ACV, bit 3, which the boot loader's firmware had set already, the same).
+ * All cores together got 12.4 GB/s writing without it (membench=2: what one core gets alone), 14.8
+ * with it; frames over 16.7 ms 28% instead of 34-36%. ddr_vote=N: N instead of the most (16383).
+ * When the kernel goes back to the loader (hakios_ddr_quiesce(), on every way back, a panic's too)
+ * the vote goes down to ddr_rest=N (default 1024). What the firmware had voted cannot be read back,
+ * but what the cores get from memory can be measured (membench=2, writing): with any vote from 4
+ * to 4096 12.0 to 12.4 GB/s, as before the first vote (12.4); with the most, 15.4; with none at all
+ * ("no request", valid clear: what Linux sends for nothing) 0.2 -- the memory at its floor, and the
+ * loader's USB transfers at 8 MB/s instead of 30. So the firmware had a vote of its own in our name,
+ * of that middle range, and one from the middle of it is left.
+ */
+#define BCM_COMMIT              (1u << 30)
+#define BCM_VALID               (1u << 29)
+#define BCM_VOTE(x, y)          (BCM_COMMIT | BCM_VALID | ((uint32_t)(x) & 0x3fff) << 14 | ((uint32_t)(y) & 0x3fff))
+#define TCS_REG(reg)            (ddr_rsc + 0xd00 + (reg))       /* command slot set 0, an "active" one */
+#define BCM_ACV_APPS            8
+#define DDR_REST                1024            /* the vote left for the loader (ddr_rest=N); see hakios_ddr_quiesce() */
+
+static vm_offset_t ddr_rsc;
+static uint32_t ddr_mc0, ddr_sh0, ddr_acv;
+static bool ddr_voted;
+
+static uint32_t
+cmd_db_address(const char *name)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id != CMD_DB_BCM || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+/* Up to three writes through command slot set 0, and the wait until RPMh has done them (as drivers/input/hakios.goodix.c) */
+static bool
+ddr_rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
+{
+	uint32_t irq_enable = *(volatile uint32_t *)TCS_REG(0x00);
+	bool done = false;
+
+	for (int i = 0; *(volatile uint32_t *)TCS_REG(0x18) == 0; i++) {
+		if (i > 2000) {
+			tell("ddr: RPMh: the command slots stay busy\n");
+			return false;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	*(volatile uint32_t *)TCS_REG(0x14) &= ~(1u << 24);
+	*(volatile uint32_t *)TCS_REG(0x14) &= ~(1u << 16);
+	*(volatile uint32_t *)TCS_REG(0x08) = 1;
+	for (unsigned i = 0; i < count; i++) {
+		*(volatile uint32_t *)TCS_REG(0x30 + 20 * i) = 0x10008 | 0x100;        /* a 4-byte write, with a response */
+		*(volatile uint32_t *)TCS_REG(0x34 + 20 * i) = address[i];
+		*(volatile uint32_t *)TCS_REG(0x38 + 20 * i) = data[i];
+	}
+	*(volatile uint32_t *)TCS_REG(0x10) = (1u << count) - 1;
+	*(volatile uint32_t *)TCS_REG(0x1c) = (1u << count) - 1;
+	*(volatile uint32_t *)TCS_REG(0x00) = irq_enable | 1;
+	*(volatile uint32_t *)TCS_REG(0x14) = 1u << 16;
+	*(volatile uint32_t *)TCS_REG(0x14) = 1u << 16 | 1u << 24;
+	for (int i = 0; i < 2000 && !done; i++) {
+		done = (*(volatile uint32_t *)TCS_REG(0x04) & 1) != 0;
+		if (!done) {
+			delay_for_interval(100, NSEC_PER_USEC);
+		}
+	}
+	*(volatile uint32_t *)TCS_REG(0x14) &= ~(1u << 24);
+	*(volatile uint32_t *)TCS_REG(0x14) &= ~(1u << 16);
+	*(volatile uint32_t *)TCS_REG(0x1c) = 0;
+	*(volatile uint32_t *)TCS_REG(0x10) = 0;
+	*(volatile uint32_t *)TCS_REG(0x08) = 1;
+	*(volatile uint32_t *)TCS_REG(0x00) = irq_enable;
+	if (!done) {
+		tell("ddr: RPMh: no answer to the vote\n");
+	}
+	return done;
+}
+
+static bool
+ddr_vote(uint32_t vote)
+{
+	uint32_t address[3] = { ddr_mc0, ddr_sh0, ddr_acv };
+	uint32_t data[3] = { BCM_VOTE(vote, vote), BCM_VOTE(vote, vote), BCM_VOTE(0, BCM_ACV_APPS) };
+
+	return ddr_rpmh_write(address, data, 3);
+}
+
+static void
+ddr_raise(void)
+{
+	uint32_t vote = 0x3fff;
+
+	PE_parse_boot_argn("ddr_vote", &vote, sizeof(vote));
+	ddr_mc0 = cmd_db_address("MC0");
+	ddr_sh0 = cmd_db_address("SH0");
+	ddr_acv = cmd_db_address("ACV");
+	if (ddr_mc0 == 0 || ddr_sh0 == 0 || ddr_acv == 0 || vote == 0 || vote > 0x3fff) {
+		tell("ddr: no vote (MC0 %#x, SH0 %#x, ACV %#x, vote %u)\n", ddr_mc0, ddr_sh0, ddr_acv, vote);
+		return;
+	}
+	ddr_rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+	ddr_voted = ddr_vote(vote);
+	tell("ddr: memory bandwidth vote %u on MC0 (%#x) and SH0 (%#x)%s\n", vote, ddr_mc0, ddr_sh0, ddr_voted ? "" : ": FAILED");
+}
+
+/* On the way back to the loader (osfmk/arm64/loader_return.c: loader_return(), whatever the reason; the other processors are stopped) */
+void hakios_ddr_quiesce(void);
+
+void
+hakios_ddr_quiesce(void)
+{
+	uint32_t address[2] = { ddr_mc0, ddr_sh0 };
+	uint32_t rest = DDR_REST, data[2];
+	bool done;
+
+	if (!ddr_voted) {
+		return;
+	}
+	ddr_voted = false;
+	PE_parse_boot_argn("ddr_rest", &rest, sizeof(rest));
+	rest = MIN(rest, 0x3fff);
+	data[0] = data[1] = rest != 0 ? BCM_VOTE(rest, rest) : BCM_COMMIT;     /* 0: no request */
+	done = ddr_rpmh_write(address, data, 2);
+	tell("ddr: memory bandwidth vote %u for the loader: %s\n", rest, done ? "done" : "FAILED");
+}
+
+void
+hakios_cpufreq_init(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t enabled = 0, membench = 0, cores[EPSS_DOMAINS] = { 0 }, before, here;
+
+	load_start();
+	enabled = 2;
+	PE_parse_boot_argn("ddr", &enabled, sizeof(enabled));
+	if (enabled == 1) {
+		ddr_look();
+		ddr_slots();
+	} else if (enabled == 2 && cpufreq_wanted()) {
+		ddr_raise();
+	}
+	enabled = 0;
+	if (!PE_parse_boot_argn("cpufreq", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		cores[domain_of(topology->cpus[i].phys_id)]++;
+	}
+	/* (whichever core this thread happens to be on, and stays on or not: it only goes to the log) */
+	here = (uint32_t)(__builtin_arm_rsr64("MPIDR_EL1") >> 8) & 0xff;
+	before = loop_speed();
+	for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+		if (cores[domain] != 0) {
+			raise_domain(domain, cores[domain]);
+		}
+	}
+	printf("cpufreq: on core %u a loop ran at %u, now at %u\n", here, before, loop_speed());
+	/* membench has its own variable: when the boot-arg is absent, the cpufreq value (2 means on) must not start the benchmark */
+	PE_parse_boot_argn("membench", &membench, sizeof(membench));
+	if (membench == 1) {
+		memory_bench();
+	} else if (membench == 2) {
+		thread_t thread;
+
+		if (kernel_thread_start(bench_all, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
