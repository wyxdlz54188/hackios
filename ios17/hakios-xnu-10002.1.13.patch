+
+/* What the chip holds now, against Android's (registers 0x00..0x7c; 0x32 and 0x42 are data ports, not read). */
+static void
+show_registers(void)
+{
+	unsigned differ = 0;
+
+	for (unsigned reg = 0; reg <= 0x7c; reg++) {
+		uint8_t value = 0;
+
+		if (reg == 0x32 || reg == 0x42) {
+			continue;
+		}
+		if (!regs_read((uint8_t)reg, &value, 1)) {
+			say("haptic: %#04x NOT READ\n", reg);
+			return;
+		}
+		if (value != android_regs[reg]) {
+			differ++;
+			say("haptic: %#04x = %#04x (Android leaves %#04x)\n", reg, value, android_regs[reg]);
+		}
+	}
+	say("haptic: %u registers differ from what Android leaves in them\n", differ);
+}
+
+static bool
+chip_answers(void)
+{
+	uint8_t id[2] = { 0, 0 };
+
+	if (!regs_read(AW_CHIPIDH, id, 2)) {
+		say("haptic: nobody answers at %#x on the bus of gpio%u/%u\n", AW_ADDRESS, PIN_SDA, PIN_SCL);
+		return false;
+	}
+	say("haptic: the chip at %#x is %#06x%s\n", AW_ADDRESS, id[0] << 8 | id[1], (id[0] << 8 | id[1]) == AW_CHIPID ? ", an AW86927" :
+	    ": NOT THE AW86927 EXPECTED");
+	return (id[0] << 8 | id[1]) == AW_CHIPID;
+}
+
+/*
+ * Android's configuration: the registers its driver sets (and the mainline Linux driver aw86927.c sets the
+ * same way), with Android's values -- those that differ from the chip's own after a reset, as the phone
+ * showed (haptic=2). Not written: the status and interrupt flags, the RAM's address and data ports, the
+ * results of the chip's measurements (0x25..0x28: they do not take what is written, they are what its f0
+ * tracking found under Android; 0x4f, 0x51, 0x59, 0x5a likewise), and what is set for each playing (0x08 the mode,
+ * 0x0a/0x12 the waveform and its repeats). The values are all read from the chip as Android leaves it.
+ */
+static const uint8_t android_config[][2] = {
+	{ 0x03, 0x59 },         /* the interrupt mask */
+	{ 0x06, 0x47 },         /* PLAYCFG1: the boost in bypass, its voltage setting 0x47 (Android's vmax 7938 mV) */
+	{ 0x1a, 0x71 },         /* CONTCFG3 */
+	{ 0x1d, 0xcf },         /* CONTCFG6: f0 tracking on, the first drive level 0x4f */
+	{ 0x1e, 0x28 },         /* CONTCFG7: the second drive level */
+	{ 0x2f, 0x46 },         /* the FIFO's thresholds */
+	{ 0x36, 0x02 }, { 0x37, 0x02 }, { 0x38, 0x02 },  /* the trigger pins' waveforms (the triggers stay off) */
+	{ 0x39, 0x00 }, { 0x3a, 0x00 },  /* ... and off */
+	{ 0x46, 0x09 },         /* SYSCTRL4: 24 kHz waveforms, the gain applied as it is */
+	{ 0x47, 0x5a },
+};
+/*
+ * ... and the analog ones, behind AW_TMCFG (the boost: skip mode, peak current 3.45 A, peak back, slew).
+ * These too are Android's: what the phone's registers hold under Android (they differ from the chip's
+ * own after a reset, so Android's driver set them); mainline Linux's aw86927.c sets the same values.
+ */
+static const uint8_t android_analog[][2] = {
+	{ 0x70, 0x0f }, { 0x71, 0x93 }, { 0x72, 0x69 }, { 0x74, 0x89 }, { 0x75, 0x88 },
+	{ AW_TRIM_LRA, 0x0d },  /* Android's f0 calibration of this motor (its log: "f0_cali_data = 0x0D") */
+};
+
+/* The analog registers opened or closed for writing (AW_TMCFG reads back as 0 either way: what tells is that the writes stick). */
+static bool
+unlock(bool open)
+{
+	uint8_t value = open ? 0x7d : 0x00;
+
+	if (broken || !regs_write(AW_TMCFG, &value, 1)) {
+		give_up("the analog registers could not be opened");
+		return false;
+	}
+	say("haptic: %#04x <- %#04x (the analog registers %s)\n", AW_TMCFG, value, open ? "opened" : "closed");
+	return true;
+}
+
+static bool
+configure(void)
+{
+	say("haptic: Android's configuration is written\n");
+	for (unsigned i = 0; i < sizeof(android_config) / sizeof(android_config[0]); i++) {
+		if (!put(android_config[i][0], android_config[i][1])) {
+			return false;
+		}
+	}
+	if (!unlock(true)) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(android_analog) / sizeof(android_analog[0]); i++) {
+		if (!put(android_analog[i][0], android_analog[i][1])) {
+			(void)unlock(false);
+			return false;
+		}
+	}
+	return unlock(false) && healthy("after the configuration");
+}
+
+static uint32_t states_seen;           /* the GLBRD5 states seen by the last wait, a bit each */
+
+/* until the chip says it is in standby (GLBRD5 state 0), at most `ms' */
+static bool
+wait_standby(unsigned ms)
+{
+	states_seen = 0;
+	for (unsigned waited = 0; waited <= ms; waited += 2) {
+		uint8_t state = 0xff;
+
+		if (!get(AW_GLBRD5, &state)) {
+			return false;
+		}
+		states_seen |= 1u << (state & 0x0f);
+		if ((state & 0x0f) == 0) {
+			return true;
+		}
+		wait_ms(2);
+	}
+	return false;
+}
+
+/*
+ * Android's waveforms into the chip's RAM: the file is a checksum (16 bits, of all that follows), the
+ * address the RAM's contents begin at (0x0800), and those contents -- a version byte, the start and end
+ * address of each waveform, the waveforms. Written through the data port with the address counting up,
+ * then read back the same way and compared.
+ */
+static bool
+load_waveforms(void)
+{
+	uint64_t size = 0;
+	const uint8_t *file = hakios_image_file("fw", "aw8697_haptic.bin", &size, NULL);
+	uint32_t sum = 0, base, length;
+	uint8_t address[2], back[64];
+
+	if (file == NULL || size < 8) {
+		say("haptic: no aw8697_haptic.bin in fw/ of the small image (fw-haptic/ when it is built)\n");
+		return false;
+	}
+	for (uint64_t i = 2; i < size; i++) {
+		sum += file[i];
+	}
+	if ((sum & 0xffff) != (uint32_t)(file[0] << 8 | file[1])) {
+		say("haptic: aw8697_haptic.bin does not add up (%#x, it says %#x): not loaded\n", sum & 0xffff, file[0] << 8 | file[1]);
+		return false;
+	}
+	base = (uint32_t)(file[2] << 8 | file[3]);
+	length = (uint32_t)size - 4;
+	say("haptic: Android's waveforms: %u bytes from %#x on, %u waveforms\n", length, base, (unsigned)(((file[5] << 8 | file[6]) -
+	    base - 1) / 4));
+	if (!wait_standby(250) || !put(AW_SYSCTRL3, (uint8_t)(android_regs[AW_SYSCTRL3] | 0x04))) {
+		give_up("the RAM could not be opened");
+		return false;
+	}
+	address[0] = (uint8_t)(base >> 8);
+	address[1] = (uint8_t)base;
+	if (!put(AW_BASEADDRH, address[0]) || !put(AW_BASEADDRL, address[1]) || !regs_write(AW_RAMADDRH, address, 2)) {
+		give_up("the RAM's address could not be set");
+		return false;
+	}
+	for (uint32_t at = 0; at < length; at += 32) {
+		unsigned n = length - at < 32 ? length - at : 32;
+
+		if (!regs_write(AW_RAMDATA, file + 4 + at, n)) {
+			give_up("the RAM could not be written");
+			return false;
+		}
+	}
+	if (!regs_write(AW_RAMADDRH, address, 2)) {
+		give_up("the RAM's address could not be set again");
+		return false;
+	}
+	for (uint32_t at = 0; at < length; at += sizeof(back)) {
+		unsigned n = length - at < sizeof(back) ? length - at : sizeof(back);
+
+		if (!regs_read(AW_RAMDATA, back, n) || memcmp(back, file + 4 + at, n) != 0) {
+			say("haptic: the RAM reads back differently at %#x\n", base + at);
+			give_up("the waveforms did not load");
+			return false;
+		}
+	}
+	if (!put(AW_SYSCTRL3, android_regs[AW_SYSCTRL3])) {
+		return false;
+	}
+	say("haptic: Android's waveforms are in the chip's RAM and read back as written\n");
+	return healthy("after the waveforms");
+}
+
+/* One waveform played once (Android's effect `effect' - 1), stopped at HAPTIC_MAX_MS at the latest. */
+static bool
+play_effect(unsigned effect)
+{
+	uint64_t began = mach_absolute_time(), ended;
+	bool done;
+
+	say("haptic: waveform %u is played once, at Android's gain %#x\n", effect, android_regs[AW_PLAYCFG2]);
+	if (!wait_standby(250) || !put(AW_PLAYCFG3, 0x04) || !put(AW_WAVCFG1, (uint8_t)effect) || !put(AW_WAVCFG2, 0x00) ||
+	    !put(AW_WAVCFG9, 0x00) || !put(AW_PLAYCFG2, android_regs[AW_PLAYCFG2]) || !healthy("before playing")) {
+		return false;
+	}
+	{
+		uint8_t go = 0x01;
+
+		if (!regs_write(AW_PLAYCFG4, &go, 1)) {
+			give_up("the start was not acknowledged");
+			return false;
+		}
+	}
+	wait_ms(2);
+	done = wait_standby(HAPTIC_MAX_MS);
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ended);
+	if (!done) {
+		uint8_t stop = 0x02;
+
+		say("haptic: STILL PLAYING after %u ms: stopped\n", HAPTIC_MAX_MS);
+		(void)regs_write(AW_PLAYCFG4, &stop, 1);
+		if (!wait_standby(50)) {
+			give_up("it does not stop");
+			return false;
+		}
+	}
+	say("haptic: the waveform has played: back in standby after %llu ms (states seen meanwhile: %#x, a bit each; 0 is "
+	    "standby)\n", ended / NSEC_PER_MSEC, states_seen);
+	return healthy("after playing");
+}
+
+/* ---- haptic=5: the motor for Darwin ------------------------------------------------------------------- */
+
+#define ACTIVE_US               30000           /* a write that was not silence counts for this long */
+#define SILENT_BELOW            256             /* of 32768: samples no larger are silence */
+#define TAP_US                  60000           /* longer than this, and it is a vibration, not a tap */
+#define SETTLE_US               8000            /* how long Darwin's waveform is listened to before a tap: its loudness */
+#define FOLLOW_US               20000           /* how often a vibration's strength follows Darwin's */
+
+#define TOLD_EVENTS             24              /* the first so many taps and vibrations are each said */
+
+static volatile uint64_t heard_us;              /* when the last write that was not silence came */
+static volatile uint64_t quiet_us;              /* when the last write that was silence came */
+static volatile uint64_t onset_us;              /* when Darwin's last waveform began: the first write not silence after a pause */
+static volatile uint32_t heard_peak;            /* the largest sample of that waveform, or since the service last looked */
+static uint64_t written_frames;
+static unsigned taps, loops, capped;            /* what has been played, for the run's end */
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* From the audio server's I/O thread: never waits. */
+static int
+haptic_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+
+			peak = v > peak ? v : peak;
+		}
+		written_frames += (uint64_t)bytes / 2;
+		if (peak > SILENT_BELOW) {
+			uint64_t now = now_us();
+
+			if (heard_us == 0 || quiet_us > heard_us || now - heard_us >= ACTIVE_US) {
+				onset_us = now;
+				heard_peak = 0;
+			}
+			heard_us = now;
+			if (peak > heard_peak) {
+				heard_peak = peak;
+			}
+		} else {
+			quiet_us = now_us();
+		}
+	}
+	return error;
+}
+
+/*
+ * A test's stand-in for Darwin's waveform (hakios.mic.c, mic_tap=1: the microphone hears the motor): as if
+ * a write of this loudness (of 32767) had just come, or silence for 0. The service plays it with all its
+ * own limits, as it plays Darwin's.
+ */
+void
+hakios_haptic_pretend(uint32_t peak)
+{
+	uint64_t now = now_us();
+
+	if (peak <= SILENT_BELOW) {
+		quiet_us = now;
+		return;
+	}
+	if (heard_us == 0 || quiet_us > heard_us || now - heard_us >= ACTIVE_US) {
+		onset_us = now;
+		heard_peak = 0;
+	}
+	heard_us = now;
+	if (peak > heard_peak) {
+		heard_peak = peak;
+	}
+}
+
+static int
+haptic_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw haptic_cdevsw = {
+	.d_open = haptic_open, .d_close = haptic_open, .d_read = eno_rdwrt, .d_write = haptic_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* Start a waveform without waiting for it: once, or (`forever') until stopped. */
+static bool
+start_waveform(unsigned waveform, bool forever, uint8_t gain)
+{
+	uint8_t go = 0x01;
+
+	if (!put(AW_PLAYCFG3, 0x04) || !put(AW_WAVCFG1, (uint8_t)waveform) || !put(AW_WAVCFG2, 0x00) ||
+	    !put(AW_WAVCFG9, forever ? 0xf0 : 0x00) || !put(AW_PLAYCFG2, gain)) {
+		return false;
+	}
+	if (!regs_write(AW_PLAYCFG4, &go, 1)) {
+		give_up("the start was not acknowledged");
+		return false;
+	}
+	return true;
+}
+
+static bool
+stop_waveform(void)
+{
+	uint8_t stop = 0x02;
+
+	if (!regs_write(AW_PLAYCFG4, &stop, 1) || !wait_standby(50)) {
+		give_up("it does not stop");
+		return false;
+	}
+	return true;
+}
+
+/* the chip's state (GLBRD5: 0 standby, 7 and 11 seen while a waveform plays), 0xff if it cannot be read */
+static unsigned
+chip_state(void)
+{
+	uint8_t state = 0xff;
+
+	return get(AW_GLBRD5, &state) ? state & 0x0f : 0xff;
+}
+
+/*
+ * How strong to play what Darwin plays. Darwin drives its Taptic Engine with waveforms far under full
+ * scale for most feedbacks (a tap's peak anywhere from 1000 to 33000 of 32768, a vibration's
+ * about 17000), and followed in proportion (gain = Android's * peak / full scale) most of them came
+ * out at a tenth of Android's gain or less: not felt at all. Android plays its own clicks and
+ * vibrations at its gain, 0x80. So: Android's gain from a third of full scale up, and below that
+ * down to five eighths of it for the softest -- never above Android's.
+ */
+static uint8_t
+gain_for(uint32_t peak)
+{
+	uint32_t top = android_regs[AW_PLAYCFG2], low = top * 5 / 8, third = 32767 / 3;
+
+	return (uint8_t)(peak >= third ? top : low + (top - low) * peak / third);
+}
+
+static void
+serve(void)
+{
+	enum { IDLE, TAP, LOOP, REST } state = IDLE;
+	uint64_t since = 0, rest_until = 0, last_look = 0, tap_onset = 0, followed = 0;
+	uint8_t playing_gain = 0;
+	unsigned follows = 0;                   /* how often the vibration playing now has changed strength */
+	int major = cdevsw_add(-1, &haptic_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-haptic") == NULL) {
+		say("haptic: /dev/hakios-haptic cannot be made\n");
+		return;
+	}
+	say("haptic: THE MOTOR PLAYS WHAT DARWIN PLAYS ON ITS ACTUATOR (/dev/hakios-haptic) from here on, until the run ends\n");
+	while (!broken) {
+		uint64_t now = now_us();
+		bool active = heard_us != 0 && now - heard_us < ACTIVE_US;
+		uint32_t peak = heard_peak;
+		uint8_t gain = gain_for(peak);
+
+		switch (state) {
+		case IDLE:
+		case TAP:
+			/*
+			 * A waveform of Darwin's that has begun (after a pause: a tap of a series is a tap of its own) is
+			 * a tap -- once its first milliseconds are heard: a waveform begins softly, and they say how
+			 * loud it is; one that goes on without a pause, a vibration.
+			 */
+			if (active && onset_us != tap_onset && now - onset_us >= SETTLE_US) {
+				uint64_t began = onset_us;
+
+				if (state == TAP && !wait_standby(0) && !stop_waveform()) {
+					break;
+				}
+				if (!start_waveform(1, false, gain ? gain : 1)) {
+					break;
+				}
+				state = TAP;
+				since = now;
+				tap_onset = began;
+				taps++;
+				if (taps + loops <= TOLD_EVENTS) {
+					wait_ms(4);
+					say("haptic: tap %u: Darwin's waveform peaks at %u of 32768: Android's waveform 1 at gain %#04x; the "
+					    "chip's state %u\n", taps, peak, gain ? gain : 1, chip_state());
+				}
+				break;
+			}
+			if (state == IDLE) {
+				break;
+			}
+			if (active && quiet_us < tap_onset && now - since > TAP_US) {
+				if (stop_waveform() && start_waveform(11, true, gain ? gain : 1)) {
+					state = LOOP;
+					since = followed = now;
+					playing_gain = gain ? gain : 1;
+					follows = 0;
+					loops++;
+					heard_peak = 0;
+					if (taps + loops <= TOLD_EVENTS) {
+						wait_ms(4);
+						say("haptic: vibration %u: Darwin goes on playing (peak %u): Android's waveform 11 over and over at "
+						    "gain %#04x, %u ms at most; the chip's state %u\n", loops, peak, gain ? gain : 1,
+						    HAPTIC_MAX_MS, chip_state());
+					}
+				}
+			} else if (!active && now - since > TAP_US) {
+				state = wait_standby(0) || stop_waveform() ? IDLE : state;
+			}
+			break;
+		case LOOP:
+			/* as strong as Darwin's waveform is now (Android's gain at full scale, never more) */
+			if (active && now - followed >= FOLLOW_US) {
+				followed = now;
+				heard_peak = 0;
+				if (peak != 0 && (gain > playing_gain + 8 || gain + 8 < playing_gain)) {
+					if (!put(AW_PLAYCFG2, gain)) {
+						break;
+					}
+					playing_gain = gain;
+					follows++;
+				}
+			}
+			if (!active || now - since > HAPTIC_MAX_MS * 1000ull) {
+				bool cut = now - since > HAPTIC_MAX_MS * 1000ull;
+
+				if (cut) {
+					capped++;
+					rest_until = now + HAPTIC_MAX_MS * 1000ull;
+				}
+				if (stop_waveform()) {
+					state = rest_until > now ? REST : IDLE;
+					if (taps + loops <= TOLD_EVENTS + 1) {
+						say("haptic: vibration %u: %s after %llu ms (its strength changed %u times, last to gain %#04x); "
+						    "the chip is in standby\n", loops, cut ? "CUT at the limit" : "Darwin stopped, and so does the motor",
+						    (now - since) / 1000, follows, playing_gain);
+					}
+				}
+			}
+			break;
+		case REST:
+			if (now >= rest_until) {
+				state = IDLE;
+			}
+			break;
+		}
+		if (state != IDLE && state != REST && now - last_look > 50000) {
+			last_look = now;
+			if (!healthy("while playing")) {
+				break;
+			}
+		}
+		wait_ms(4);
+	}
+	say("haptic: the motor is given up on (%u taps and %u vibrations played, %u cut at %u ms)\n", taps, loops, capped,
+	    HAPTIC_MAX_MS);
+}
+
+static void
+haptic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	bool loaded = false;
+
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	say("haptic: level %u: %s\n", level, level == 1 ? "a look, reading only" : level == 2 ? "the reset released, registers read" :
+	    level == 3 ? "the chip configured and its waveforms loaded, nothing played" : level == 4 ? "one effect played" :
+	    "the motor for Darwin");
+	show_pins();
+	if (level >= 2 && !((rd(GPIO_CFG(PIN_RESET)) & CFG_OUTPUT) && (rd(GPIO_IO(PIN_RESET)) & 2))) {
+		/* (Android's driver: the pin low, 5 ms, high, and the chip ready for I2C 8 ms later) */
+		say("haptic: the reset is released: gpio%u low for 5 ms, then high\n", PIN_RESET);
+		reset_pin(false);
+		wait_ms(5);
+		reset_pin(true);
+		wait_ms(8);
+	}
+	if (!chip_answers()) {
+		say("haptic: (the reset pin %s)\n", (rd(GPIO_CFG(PIN_RESET)) & CFG_OUTPUT) && (rd(GPIO_IO(PIN_RESET)) & 2) ?
+		    "drives high: the chip should answer" : "does not drive high: the chip is held in reset or not powered");
+		if (released) {
+			give_up("the chip does not answer");
+		}
+	} else {
+		show_registers();
+		/* (kept apart from `level == 4' so that level 5 can tell that the waveforms are really in the RAM) */
+		loaded = level >= 3 && configure() && load_waveforms();
+		if (loaded && level == 4) {
+			uint32_t effect = 1;
+
+			PE_parse_boot_argn("haptic_effect", &effect, sizeof(effect));
+			if (effect < 1 || effect > 10) {
+				effect = 1;     /* (the short ones only) */
+			}
+			(void)play_effect(effect);
+		} else if (level == 5 && !broken && loaded) {
+			/* (not started when the waveforms did not load: it would play whatever the RAM held) */
+			serve();
+		} else if (level == 5 && !broken) {
+			give_up("the waveforms are not loaded");
+		}
+	}
+	say("haptic: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_haptic_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("haptic", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	if (level > 5) {
+		level = 5;
+	}
+	if (kernel_thread_start(haptic_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* At the run's end and on a panic's way out: the chip back into reset, if it was let out. */
+void
+hakios_haptic_quiesce(void)
+{
+	if (released && tlmm != 0) {
+		leaving = true;
+		reset_pin(false);
+		if (level == 5) {
+			say("haptic: at the run's end: %u taps and %u vibrations played (%u cut at %u ms), from %llu frames Darwin "
+			    "wrote; the chip is held in reset\n", taps, loops, capped, HAPTIC_MAX_MS, written_frames);
+		}
+	}
+}
diff --git a/bsd/dev/hakios.image.c b/bsd/dev/hakios.image.c
new file mode 100644
index 0000000..c153e5a
--- /dev/null
+++ b/bsd/dev/hakios.image.c
@@ -0,0 +1,187 @@
+/*
+ * A file of one of this port's RAM disks, by path, for the drivers that want one before there is
+ * a root or without asking it: the GPU's firmware (hakios.adreno.c), the Wi-Fi DSP's
+ * (hakios.wifi.c), the audio DSP's (hakios.adsp.c) -- "fw/NAME" of the image that travels with
+ * the kernel (md1; md0 when there is nothing else) or of the resident one (md0).
+ *
+ * The image is an APFS container (tools/apfs/mkapfs.py: what userland/build.sh makes).  A file
+ * stored as it is in one piece is used where it lies in the RAM disk's memory, as the drivers
+ * always did (build.sh has mkapfs.py store fw/ that way: --plain fw).
+ * Any other APFS file is read out once by apfs_lib -- the same code as the volume's when
+ * mounted, compressed or not -- into memory of its own, and kept: firmware is asked for once
+ * or twice a session and its driver keeps it while the phone runs, so nothing gives it back.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <miscfs/apfs/apfs_lib.h>
+
+extern dev_t mdevlookup(int devid);
+extern int mdevgetkernelrange(dev_t dev, vm_offset_t *base, uint64_t *size);
+
+const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+/* ---- APFS ---- */
+
+struct mem_dev {
+	const uint8_t *base;
+	uint64_t       length;
+};
+
+static int
+mem_read(void *ctx, uint64_t off, void *buf, size_t len)
+{
+	struct mem_dev *m = ctx;
+
+	if (off > m->length || len > m->length - off) {
+		return EIO;
+	}
+	memcpy(buf, m->base + off, len);
+	return 0;
+}
+
+static LCK_GRP_DECLARE(image_lck_grp, "hakios_image");
+static LCK_MTX_DECLARE(image_lock, &image_lck_grp);    /* kept[]: the drivers start beside each other */
+static struct {
+	int       disk;
+	char      path[96];
+	uint8_t  *data;
+	uint64_t  size;
+} kept[64];
+
+static const uint8_t *
+apfs_file(int disk, const uint8_t *base, uint64_t length, const char *dir, const char *name, uint64_t *size)
+{
+	struct mem_dev m = { .base = base, .length = length };
+	struct apfs_dev dev = { .ctx = &m, .size = length, .read = mem_read, .read_data = mem_read };
+	struct apfs_nx *nx = NULL;
+	struct apfs_vol *vol = NULL;
+	struct apfs_inode ino;
+	struct apfs_cfile cf;
+	char path[96];
+	uint64_t id = 0, fsize = 0, off = 0;
+	uint8_t dt = 0, *data = NULL;
+	uint32_t i;
+	int error;
+
+	if (length < 4096 || memcmp(base + 32, "NXSB", 4) != 0) {
+		return NULL;
+	}
+	snprintf(path, sizeof(path), "/%s/%s", dir, name);
+	lck_mtx_lock(&image_lock);
+	for (i = 0; i < sizeof(kept) / sizeof(kept[0]) && kept[i].data != NULL; i++) {
+		if (kept[i].disk == disk && strcmp(kept[i].path, path) == 0) {
+			*size = kept[i].size;
+			lck_mtx_unlock(&image_lock);
+			return kept[i].data;
+		}
+	}
+	nx = kalloc_type(struct apfs_nx, Z_WAITOK | Z_ZERO);
+	vol = kalloc_type(struct apfs_vol, Z_WAITOK | Z_ZERO);
+	if (nx == NULL || vol == NULL) {
+		goto out;
+	}
+	if (apfs_nx_open(nx, &dev) != 0) {
+		kfree_type(struct apfs_nx, nx);
+		nx = NULL;
+		goto out;
+	}
+	error = ENOENT;
+	for (uint32_t v = 0; v < APFS_NX_MAX_FILE_SYSTEMS && error != 0; v++) {
+		if (nx->fs_oid[v] != 0 && apfs_vol_open(nx, v, vol) == 0) {
+			error = apfs_path_lookup(vol, path, &id, &dt);
+		}
+	}
+	if (error == 0) {
+		error = apfs_inode_get(vol, id, &ino);
+	}
+	if (error == 0 && (ino.mode & APFS_S_IFMT) != APFS_S_IFREG) {
+		error = EISDIR;
+	}
+	if (error == 0) {
+		error = apfs_inode_size(vol, &ino, &fsize);
+	}
+	if (error == 0 && (fsize == 0 || fsize > 256 * 1024 * 1024)) {
+		error = EFBIG;
+	}
+	if (error == 0) {
+		uint64_t addr = 0;
+
+		/* in one piece as it is: where it lies, no copy */
+		if (apfs_file_in_place(vol, &ino, &addr) == 0 && addr <= length / nx->block_size &&
+		    fsize <= length - addr * nx->block_size) {
+			apfs_nx_close(nx);
+			*size = fsize;
+			data = __DECONST(uint8_t *, base) + addr * nx->block_size;
+			goto out;
+		}
+		if (i == sizeof(kept) / sizeof(kept[0])) {
+			printf("hakios_image: %s of /dev/md%d: kept %lu files already, no room for a copy of another\n", path, disk,
+			    (unsigned long)i);
+			error = ENOSPC;
+		}
+	}
+	if (error == 0) {
+		data = kalloc_data((vm_size_t)fsize, Z_WAITOK);
+		error = data == NULL ? ENOMEM : 0;
+	}
+	memset(&cf, 0, sizeof(cf));
+	cf.held = APFS_NO_PIECE;
+	while (error == 0 && off < fsize) {
+		size_t got = 0;
+
+		error = apfs_read_file(vol, &ino, &cf, off, data + off, (size_t)(fsize - off), &got);
+		if (error == 0 && got == 0) {
+			error = EIO;
+		}
+		off += got;
+	}
+	apfs_cfile_fini(&cf);
+	apfs_nx_close(nx);
+	if (error == 0) {
+		kept[i].disk = disk;
+		strlcpy(kept[i].path, path, sizeof(kept[i].path));
+		kept[i].size = fsize;
+		kept[i].data = data;            /* (last: a reader of the table sees all of it or none) */
+		*size = fsize;
+	} else if (data != NULL) {
+		kfree_data(data, (vm_size_t)fsize);
+		data = NULL;
+	}
+out:
+	lck_mtx_unlock(&image_lock);
+	if (vol != NULL) {
+		kfree_type(struct apfs_vol, vol);
+	}
+	if (nx != NULL) {
+		kfree_type(struct apfs_nx, nx);
+	}
+	return data;
+}
+
+const uint8_t *
+hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out)
+{
+	for (int disk = 1; disk >= 0; disk--) {
+		vm_offset_t base = 0;
+		uint64_t length = 0;
+		const uint8_t *data;
+		dev_t dev = mdevlookup(disk);
+
+		if (dev == (dev_t)-1 || mdevgetkernelrange(dev, &base, &length) != 0) {
+			continue;
+		}
+		data = apfs_file(disk, (const uint8_t *)base, length, dir, name, size);
+		if (data != NULL) {
+			if (disk_out != NULL) {
+				*disk_out = disk;
+			}
+			return data;
+		}
+	}
+	return NULL;
+}
diff --git a/bsd/dev/hakios.input.c b/bsd/dev/hakios.input.c
new file mode 100644
index 0000000..8452a55
--- /dev/null
+++ b/bsd/dev/hakios.input.c
@@ -0,0 +1,295 @@
+/*
+ * /dev/hakios-touch: a queue of touch samples (see sys/hakios.input.h).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <pexpert/pexpert.h>
+
+#define TOUCH_QUEUE     512             /* records; a power of two */
+
+/*
+ * Boot-arg touch_lat=1: for measuring how long a touch takes to reach the panel, a line for every
+ * sample posted ("tl: p TYPE FINGER X Y at US", the time in microseconds of mach_absolute_time),
+ * to be matched with the window server's lines about reading it (userland/src/inject.c), drawing
+ * (eagl.c) and the display driver's about the frame (MiniIOMobileFramebuffer.cpp): see
+ * tools/latency.py.
+ */
+static uint32_t touch_lat = 2;          /* 2: not yet looked up */
+
+extern void loader_log_line(const char *line);
+
+/*
+ * A "tl:" line, for the kernel's drivers: into the loader's log as it is written -- the kernel's own
+ * log keeps only the last of a run, and a live look at the loader's (XL_FOLLOW) then misses nothing.
+ */
+void hakios_tl(const char *format, ...) __printflike(1, 2);
+
+void
+hakios_tl(const char *format, ...)
+{
+	char line[192];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	loader_log_line(line);
+}
+
+static bool
+latency_lines(void)
+{
+	if (touch_lat == 2) {
+		uint32_t on = 0;
+
+		touch_lat = PE_parse_boot_argn("touch_lat", &on, sizeof(on)) && on != 0;
+	}
+	return touch_lat != 0;
+}
+
+static LCK_GRP_DECLARE(touch_lck_grp, "hakios-touch");
+static LCK_MTX_DECLARE(touch_lock, &touch_lck_grp);
+static struct hakios_touch touch_queue[TOUCH_QUEUE];
+static uint32_t touch_head, touch_tail;        /* read from head, add at tail */
+
+/*
+ * The way out when nothing else is at hand: five fingers held on the screen for a second and a
+ * half end the run -- control goes back to the loader, as when loader_return_after expires.
+ * Only a driver's fingers count, not samples a program writes to the device.
+ */
+#define EXIT_FINGERS    5
+#define EXIT_HOLD_MS    1500
+
+extern void loader_return(void);
+
+static thread_call_t exit_call;
+static uint32_t fingers_down;           /* one bit for each finger a driver says is down */
+
+static void
+exit_hold_elapsed(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	printf("\n--- %d fingers held on the screen for %d ms: back to the loader ---\n", EXIT_FINGERS, EXIT_HOLD_MS);
+	hakios_adreno_stop();
+	loader_return();
+}
+
+/* With touch_lock held. */
+static void
+count_fingers(uint32_t type, uint32_t finger)
+{
+	int before = __builtin_popcount(fingers_down), now;
+	uint64_t deadline;
+
+	if (finger >= 32 || exit_call == NULL || (type != HAKIOS_TOUCH_DOWN && type != HAKIOS_TOUCH_UP)) {
+		return;
+	}
+	if (type == HAKIOS_TOUCH_DOWN) {
+		fingers_down |= 1u << finger;
+	} else {
+		fingers_down &= ~(1u << finger);
+	}
+	now = __builtin_popcount(fingers_down);
+	if (now >= EXIT_FINGERS && before < EXIT_FINGERS) {
+		clock_interval_to_deadline(EXIT_HOLD_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(exit_call, deadline);
+	} else if (now < EXIT_FINGERS && before >= EXIT_FINGERS) {
+		thread_call_cancel(exit_call);
+	}
+}
+
+/*
+ * What the fingers' samples were like, said every 8 strokes: the lines of touch_lat=1 are many, and a long run's log keeps only its
+ * beginning and its end. From the first move after a finger came down, between moves, and from the last move to its lift.
+ */
+static struct {
+	uint64_t last;
+	uint32_t strokes, moves, firsts, slow_moves, longest_move, first_sum, first_longest, lift_sum, lift_longest;
+	uint32_t finger;
+	bool down, moved;
+} touch_feel;
+
+static void
+touch_feel_add(uint32_t type, uint32_t finger, uint64_t now)
+{
+	uint64_t nanos;
+	uint32_t ms;
+
+	if (type == HAKIOS_TOUCH_DOWN && !touch_feel.down) {
+		touch_feel.down = true;
+		touch_feel.moved = false;
+		touch_feel.finger = finger;
+		touch_feel.last = now;
+		return;
+	}
+	if (!touch_feel.down || finger != touch_feel.finger) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - touch_feel.last, &nanos);
+	ms = (uint32_t)(nanos / 1000000);
+	touch_feel.last = now;
+	if (type == HAKIOS_TOUCH_UP) {
+		touch_feel.down = false;
+		touch_feel.strokes++;
+		touch_feel.lift_sum += ms;
+		touch_feel.lift_longest = ms > touch_feel.lift_longest ? ms : touch_feel.lift_longest;
+		if (touch_feel.strokes % 8 == 0) {
+			printf("touch: %u strokes: first move after %u ms on average, %u at most; %u moves, %u of them over 13 ms apart, %u at most; "
+			    "the lift %u ms after the last move on average, %u at most\n", touch_feel.strokes,
+			    touch_feel.firsts != 0 ? touch_feel.first_sum / touch_feel.firsts : 0, touch_feel.first_longest, touch_feel.moves,
+			    touch_feel.slow_moves, touch_feel.longest_move, touch_feel.lift_sum / touch_feel.strokes, touch_feel.lift_longest);
+		}
+	} else if (!touch_feel.moved) {
+		touch_feel.moved = true;
+		touch_feel.firsts++;
+		touch_feel.first_sum += ms;
+		touch_feel.first_longest = ms > touch_feel.first_longest ? ms : touch_feel.first_longest;
+	} else {
+		touch_feel.moves++;
+		touch_feel.slow_moves += ms > 13;
+		touch_feel.longest_move = ms > touch_feel.longest_move ? ms : touch_feel.longest_move;
+	}
+}
+
+static void
+touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y, bool from_driver)
+{
+	struct hakios_touch *t;
+
+	lck_mtx_lock(&touch_lock);
+	if (touch_tail - touch_head == TOUCH_QUEUE) {
+		touch_head++;                   /* nobody reads: drop the oldest */
+	}
+	t = &touch_queue[touch_tail++ % TOUCH_QUEUE];
+	t->time = mach_absolute_time();
+	if (from_driver) {
+		touch_feel_add(type, finger, t->time);
+	}
+	if (latency_lines()) {
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(t->time, &ns);
+		hakios_tl("tl: p %u %u %u %u at %llu\n", type, finger, x, y, ns / 1000);
+	}
+	t->type = type;
+	t->finger = finger;
+	t->x = x > 65535 ? 65535 : x;
+	t->y = y > 65535 ? 65535 : y;
+	if (from_driver) {
+		count_fingers(type, finger);
+	}
+	lck_mtx_unlock(&touch_lock);
+	wakeup(&touch_queue);
+}
+
+void
+hakios_touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y)
+{
+	touch_post(type, finger, x, y, true);
+}
+
+static int
+touch_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+touch_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+touch_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_touch t;
+	int error = 0, moved = 0;
+
+	/* a buffer smaller than one record can never be served: say so, instead of blocking for data and then returning 0 (end of file) */
+	if (uio_resid(uio) == 0) {
+		return 0;
+	}
+	if (uio_resid(uio) < (user_ssize_t)sizeof(t)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&touch_lock);
+	while (touch_head == touch_tail) {
+		error = msleep(&touch_queue, &touch_lock, PZERO | PCATCH, "hakios-touch", NULL);
+		if (error) {
+			lck_mtx_unlock(&touch_lock);
+			return error;
+		}
+	}
+	while (touch_head != touch_tail && uio_resid(uio) >= (user_ssize_t)sizeof(t)) {
+		t = touch_queue[touch_head++ % TOUCH_QUEUE];
+		lck_mtx_unlock(&touch_lock);
+		error = uiomove((caddr_t)&t, sizeof(t), uio);
+		lck_mtx_lock(&touch_lock);
+		if (error) {
+			/* the copy-out failed: put the record back at the head so a lost DOWN or UP does not leave a finger stuck (only if the ring still has room for it) */
+			if (touch_tail - touch_head < TOUCH_QUEUE) {
+				touch_queue[--touch_head % TOUCH_QUEUE] = t;
+			}
+			break;
+		}
+		moved++;
+	}
+	lck_mtx_unlock(&touch_lock);
+	return moved ? 0 : error;
+}
+
+static int
+touch_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_touch t;
+	int error = 0;
+
+	while (uio_resid(uio) >= (user_ssize_t)sizeof(t)) {
+		error = uiomove((caddr_t)&t, sizeof(t), uio);
+		if (error) {
+			break;
+		}
+		if (t.type < HAKIOS_TOUCH_DOWN || t.type > HAKIOS_BUTTON_UP) {
+			return EINVAL;
+		}
+		touch_post(t.type, t.finger, t.x, t.y, false);
+	}
+	return error;
+}
+
+static const struct cdevsw touch_cdevsw = {
+	.d_open = touch_open, .d_close = touch_close, .d_read = touch_read, .d_write = touch_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+void
+hakios_input_init(void)
+{
+	int major = cdevsw_add(-1, &touch_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-touch") == NULL) {
+		printf("hakios-touch: cannot create the device\n");
+	}
+	exit_call = thread_call_allocate(exit_hold_elapsed, NULL);
+	hakios_cpufreq_init();
+	hakios_virtio_input_init();
+	hakios_goodix_init();
+	hakios_buttons_init();
+	hakios_battery_init();
+	hakios_ufs_init();
+	hakios_net_init();
+	hakios_adreno_init();
+	hakios_wifi_init();
+	hakios_adsp_init();
+	hakios_mpss_init();
+}
diff --git a/bsd/dev/hakios.ipa.c b/bsd/dev/hakios.ipa.c
new file mode 100644
index 0000000..e2d9bf9
--- /dev/null
+++ b/bsd/dev/hakios.ipa.c
@@ -0,0 +1,874 @@
+/*
+ * The IPA's data path for this processor: GSI rings, the IPA's endpoints for the application
+ * processor, and the immediate commands that give the IPA its tables.
+ *
+ * The IPA (Qualcomm's "IP accelerator", here IPA 4.11 with GSI 2.11) moves packets between the
+ * modem and this processor. Each side has "endpoints" (pipes) in the IPA and "channels" in the
+ * GSI (the DMA engine beside it): a channel is a ring of transfer elements (TREs: address, length,
+ * flags; 16 bytes) that this processor fills and the hardware consumes, and an event ring the
+ * hardware fills with one event per finished TRE. Writing a doorbell register tells the hardware
+ * how far the ring is filled; the event ring's write pointer, read from a register, tells us how
+ * far the hardware got. No interrupt is used: the interface's thread polls (hakios.cell.c).
+ *
+ * What this processor needs, as Linux's driver sets them up for IPA 4.11 (drivers/net/ipa,
+ * ipa_data-v4.11.c, gsi.c, ipa_endpoint.c, ipa_cmd.c, ipa_table.c; the register layout from
+ * reg/gsi_reg-v4.11.c and reg/ipa_reg-v4.11.c):
+ *   - the command endpoint (7, channel 5): immediate commands to the IPA itself, which is how it
+ *     is told where its filter and route tables and its header table are;
+ *   - the "LAN" receive endpoint (9, channel 14): the IPA's default route (what matches no rule)
+ *     and its exceptions end here; it is looked at and dropped;
+ *   - the modem transmit endpoint (2, channel 2): IP packets to the modem, each behind a QMAP
+ *     header (4 bytes: pad length, mux id, packet length, big-endian);
+ *   - the modem receive endpoint (16, channel 7): IP packets from the modem, QMAP-framed, several
+ *     per buffer (the IPA aggregates them until 12 KB or 500 us).
+ * No checksum offload, no status packets: the network stack computes its checksums itself and
+ * the modem is told QMAP without checksum (hakios.mpss.c, WDA Set Data Format).
+ *
+ * All of this is done before the modem starts (Linux does the same): the tables the commands
+ * write hold pointers to one "zero rule", and the modem then writes its own rules into its part
+ * of them. The IPA reaches this memory through the SMMU context the modem driver gave it, which
+ * shows DDR as it is (physical addresses). The memory is cached for us, so every buffer is
+ * written back and dropped from the cache (dc civac) before the hardware looks at it and before
+ * we look at what the hardware wrote.
+ *
+ * modem_ipa_data_off=1: none of this. modem_ipa_data_trace=1: a line per packet.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+#include <sys/hakios.ipa.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+
+static LCK_GRP_DECLARE(ipa_lock_group, "hakios-ipa");
+static LCK_MTX_DECLARE(ipa_lock, &ipa_lock_group);
+
+/* ---- the registers ---------------------------------------------------------------------------- */
+
+/*
+ * Where the IPA and the GSI are. These are the values of the first phone (POCO X5 Pro, SM7325),
+ * which another Qualcomm phone overrides from its own device tree: the "reg" of the node whose
+ * compatible is "qcom,ipa" (reg-names "ipa-base" and "gsi-base"), passed as boot-args soc_ipa_base
+ * and soc_gsi_base (tools/soc-args.py reads them off the phone's fdt). The IPA driver has one
+ * execution environment's worth of GSI registers mapped, from the inter-EE masks to the scratch.
+ */
+#define IPA_REGS_PHYS_DEFAULT   0x01e40000ull
+#define GSI_PHYS_DEFAULT        0x01e04000ull
+#define IPA_REGS_SIZE           0x1000
+#define GSI_FROM                0xc000          /* what is used of the GSI's registers: from the inter-EE masks (0xc020) to the scratch (0x12400) */
+#define GSI_SIZE                0x7000
+
+static uint64_t ipa_regs_phys = IPA_REGS_PHYS_DEFAULT, gsi_phys = GSI_PHYS_DEFAULT;
+static vm_offset_t ipa_regs, gsi_regs;         /* gsi_regs maps gsi_phys + GSI_FROM */
+
+static inline uint32_t
+ipa_rd(uint32_t offset)
+{
+	return *(volatile uint32_t *)(ipa_regs + offset);
+}
+
+static inline void
+ipa_wr(uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(ipa_regs + offset) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+gsi_rd(uint32_t offset)
+{
+	return *(volatile uint32_t *)(gsi_regs + (offset - GSI_FROM));
+}
+
+static inline void
+gsi_wr(uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(gsi_regs + (offset - GSI_FROM)) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* The GSI's registers for our execution environment (EE 0; another EE's are 0x4000 further) */
+#define CH_CNTXT(c, n)          (0xf000 + 0x80 * (c) + 4 * (n))        /* n 0..3: type/dir/event ring/state, length, address */
+#define CH_QOS(c)               (0xf05c + 0x80 * (c))
+#define CH_SCRATCH(c, n)        (0xf060 + 0x80 * (c) + 4 * (n))
+#define EV_CNTXT(e, n)          (0x10000 + 0x80 * (e) + 4 * (n))       /* n 0..13: type/state, length, address, read/write pointers, moderation, MSI */
+#define CH_DOORBELL(c)          (0x11000 + 8 * (c))
+#define EV_DOORBELL(e)          (0x11100 + 8 * (e))
+#define GSI_STATUS              0x12000
+#define CH_CMD                  0x12008
+#define EV_CH_CMD               0x12010
+#define CNTXT_TYPE_IRQ          0x12080
+#define CNTXT_TYPE_IRQ_MSK      0x12088
+#define CNTXT_SRC_CH_IRQ        0x12090
+#define CNTXT_SRC_EV_CH_IRQ     0x12094
+#define CNTXT_SRC_CH_IRQ_MSK    0x12098
+#define CNTXT_SRC_EV_CH_IRQ_MSK 0x1209c
+#define CNTXT_SRC_CH_IRQ_CLR    0x120a0
+#define CNTXT_SRC_EV_CH_IRQ_CLR 0x120a4
+#define CNTXT_SRC_IEOB_IRQ      0x120b0
+#define CNTXT_SRC_IEOB_IRQ_MSK  0x120b8
+#define CNTXT_SRC_IEOB_IRQ_CLR  0x120c0
+#define CNTXT_GLOB_IRQ_STTS     0x12100
+#define CNTXT_GLOB_IRQ_EN       0x12108
+#define CNTXT_GLOB_IRQ_CLR      0x12110
+#define CNTXT_GSI_IRQ_STTS      0x12118
+#define CNTXT_GSI_IRQ_EN        0x12120
+#define CNTXT_GSI_IRQ_CLR       0x12128
+#define CNTXT_INTSET            0x12180
+#define ERROR_LOG               0x12200
+#define ERROR_LOG_CLR           0x12210
+#define INTER_EE_SRC_CH_IRQ_MSK 0xc020
+#define INTER_EE_SRC_EV_CH_IRQ_MSK 0xc024
+
+#define GSI_CH_ALLOCATE         0x0     /* channel commands (CH_CMD bits 31:24; the channel in 7:0) */
+#define GSI_CH_START            0x1
+#define GSI_CH_STOP             0x2
+#define GSI_CH_RESET            0x9
+#define GSI_CH_DE_ALLOC         0xa
+#define GSI_EVT_ALLOCATE        0x0     /* event ring commands (EV_CH_CMD, the same layout) */
+#define GSI_EVT_RESET           0x9
+#define GSI_EVT_DE_ALLOC        0xa
+#define CH_STATE_NOT_ALLOCATED  0       /* CH_CNTXT 0 bits 23:20 */
+#define CH_STATE_ALLOCATED      1
+#define CH_STATE_STARTED        2
+#define CH_STATE_STOPPED        3
+#define EV_STATE_NOT_ALLOCATED  0       /* EV_CNTXT 0 bits 23:20 */
+#define EV_STATE_ALLOCATED      1
+#define GSI_CHANNEL_TYPE_GPI    2
+#define ELEMENT_SIZE            16
+
+/* The IPA's endpoint registers (0x70 apart) */
+#define ENDP_INIT_CFG(ep)       (0x808 + 0x70 * (ep))
+#define ENDP_INIT_NAT(ep)       (0x80c + 0x70 * (ep))
+#define ENDP_INIT_HDR(ep)       (0x810 + 0x70 * (ep))
+#define ENDP_INIT_HDR_EXT(ep)   (0x814 + 0x70 * (ep))
+#define ENDP_INIT_HDR_METADATA_MASK(ep) (0x818 + 0x70 * (ep))
+#define ENDP_INIT_MODE(ep)      (0x820 + 0x70 * (ep))
+#define ENDP_INIT_AGGR(ep)      (0x824 + 0x70 * (ep))
+#define ENDP_INIT_HOL_BLOCK_EN(ep) (0x82c + 0x70 * (ep))
+#define ENDP_INIT_DEAGGR(ep)    (0x834 + 0x70 * (ep))
+#define ENDP_INIT_RSRC_GRP(ep)  (0x838 + 0x70 * (ep))
+#define ENDP_INIT_SEQ(ep)       (0x83c + 0x70 * (ep))
+#define ENDP_STATUS(ep)         (0x840 + 0x70 * (ep))
+#define IPA_SHARED_MEM_SIZE     0x54            /* bits 31:16: the local memory's offset in 8-byte units */
+#define IPA_FILT_ROUT_HASH_FLUSH 0x14c
+
+/* ---- memory the hardware reads and writes ------------------------------------------------------ */
+
+struct dma {
+	vm_offset_t     virt;
+	uint64_t        phys;
+};
+
+/* One page (16 KB), zeroed, written out of the cache; false if there is none. */
+static bool
+dma_page(struct dma *d)
+{
+	vm_offset_t virt = 0;
+
+	if (kmem_alloc(kernel_map, &virt, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	d->virt = virt;
+	d->phys = kvtophys(virt);
+	FlushPoC_DcacheRegion(virt, PAGE_SIZE);
+	return true;
+}
+
+/* Written back and dropped from the cache: before the hardware reads it, and before we read what the hardware wrote. */
+static inline void
+dma_sync(vm_offset_t virt, size_t size)
+{
+	vm_offset_t from = virt & ~63ul;
+
+	FlushPoC_DcacheRegion(from, ((virt + size + 63) & ~63ul) - from);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---- the channels ------------------------------------------------------------------------------ */
+
+struct tre {
+	uint64_t        addr;
+	uint16_t        len_opcode;     /* bytes to transfer, or the immediate command's opcode */
+	uint16_t        reserved;
+	uint32_t        flags;          /* TRE_* */
+};
+#define TRE_CHAIN               (1u << 0)
+#define TRE_IEOT                (1u << 9)       /* an event when done */
+#define TRE_BEI                 (1u << 10)      /* ... but no interrupt for it */
+#define TRE_TYPE_XFER           (2u << 16)
+#define TRE_TYPE_COMMAND        (3u << 16)
+
+struct event {
+	uint64_t        xfer;           /* the address of the TRE that finished */
+	uint16_t        len;            /* bytes moved (what a receive buffer got) */
+	uint8_t         reserved1;
+	uint8_t         code;
+	uint16_t        reserved2;
+	uint8_t         type;
+	uint8_t         chid;
+};
+
+struct channel {
+	const char *    name;
+	uint8_t         id, ring_id, endpoint;  /* the channel, its event ring, the IPA's endpoint */
+	bool            to_ipa, command, qmap, aggregate, close_eof;
+	uint32_t        slots;          /* TREs in the ring, and buffers (a power of two; they fit one page: at most 1024) */
+	uint32_t        tlv;            /* the endpoint's TLV FIFO: how many TREs may be outstanding (ipa_data-v4.11.c tlv_count) */
+	uint32_t        buffer_size;    /* bytes per slot (a divisor or a multiple of the page size) */
+	struct dma      tre_ring, event_ring;
+	struct dma *    pages;          /* the buffers, slot by slot */
+	uint32_t        page_count;
+	uint32_t        next;           /* the next TRE to fill (counts up; the slot is next % slots) */
+	uint32_t        done;           /* the next TRE whose completion is awaited (transmit) */
+	uint32_t        events;         /* the next event to read (counts up) */
+	bool            started;
+	uint64_t        packets, bytes, dropped, errors;
+};
+
+/*
+ * The four: numbers from Linux's ipa_data-v4.11.c (channel, endpoint, TLV counts, which has
+ * QMAP and aggregation). Rings here are smaller than Linux's; the buffers are a page for a receive
+ * slot (the IPA aggregates into it) and 2 KB for a transmit slot (one packet and its header).
+ */
+static struct channel command = { "command", 5, 0, 7, true, true, false, false, false, 16, 20, 64 };
+#define RECEIVE_BUFFER          16384           /* a page: the IPA aggregates into it */
+static struct channel lan_rx = { "lan-rx", 14, 1, 9, false, false, false, true, false, 16, 9, RECEIVE_BUFFER };
+static struct channel modem_tx = { "modem-tx", 2, 2, 2, true, false, true, false, false, 64, 16, 2048 };
+static struct channel modem_rx = { "modem-rx", 7, 3, 16, false, false, true, true, true, 64, 9, RECEIVE_BUFFER };
+static struct channel *channels[] = { &command, &lan_rx, &modem_tx, &modem_rx };
+#define AGGR_LIMIT_KB           12              /* the IPA closes a receive buffer once this much is in it (a page holds another 4 KB packet) */
+#define AGGR_TIME_TICKS         5               /* ... or after 5 ticks of the first pulse generator: 500 us (TIMERS_PULSE_GRAN_CFG gran 0 = 100 us) */
+
+static bool ready, trace;
+static uint32_t mem_offset;                     /* the local memory's offset within the IPA's shared memory */
+static struct dma table, zero;                  /* the tables' page (below) and a page of zeros */
+
+static inline vm_offset_t
+slot_virt(const struct channel *ch, uint32_t slot)
+{
+	uint64_t at = (uint64_t)slot * ch->buffer_size;
+
+	return ch->pages[at / PAGE_SIZE].virt + at % PAGE_SIZE;
+}
+
+static inline uint64_t
+slot_phys(const struct channel *ch, uint32_t slot)
+{
+	uint64_t at = (uint64_t)slot * ch->buffer_size;
+
+	return ch->pages[at / PAGE_SIZE].phys + at % PAGE_SIZE;
+}
+
+static inline struct tre *
+tre_at(const struct channel *ch, uint32_t index)
+{
+	return (struct tre *)(ch->tre_ring.virt + (index % ch->slots) * ELEMENT_SIZE);
+}
+
+static bool
+channel_memory(struct channel *ch)
+{
+	uint64_t bytes = (uint64_t)ch->slots * ch->buffer_size;
+
+	ch->page_count = (uint32_t)((bytes + PAGE_SIZE - 1) / PAGE_SIZE);
+	ch->pages = kalloc_type(struct dma, ch->page_count, Z_WAITOK | Z_ZERO);
+	if (ch->pages == NULL || !dma_page(&ch->tre_ring) || !dma_page(&ch->event_ring)) {
+		return false;
+	}
+	for (uint32_t p = 0; p < ch->page_count; p++) {
+		if (!dma_page(&ch->pages[p])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+gsi_error(const char *what)
+{
+	uint32_t log = gsi_rd(ERROR_LOG);
+
+	printf("ipa: %s: GSI status %#x, error log %#x (code %u, type %u, EE %u, index %u, args %#x), global %#x, general %#x\n", what,
+	    gsi_rd(GSI_STATUS), log, (log >> 12) & 0xf, (log >> 24) & 0xf, log >> 28, (log >> 19) & 0x1f, log & 0xfff,
+	    gsi_rd(CNTXT_GLOB_IRQ_STTS), gsi_rd(CNTXT_GSI_IRQ_STTS));
+	if (log != 0) {
+		gsi_wr(ERROR_LOG, 0);
+		gsi_wr(ERROR_LOG_CLR, ~0u);
+	}
+}
+
+static inline uint32_t
+channel_state(const struct channel *ch)
+{
+	return (gsi_rd(CH_CNTXT(ch->id, 0)) >> 20) & 0xf;
+}
+
+static inline uint32_t
+event_ring_state(const struct channel *ch)
+{
+	return (gsi_rd(EV_CNTXT(ch->ring_id, 0)) >> 20) & 0xf;
+}
+
+/* A command to the GSI about a channel or an event ring; true once the state is `wanted` (within 50 ms). */
+static bool
+gsi_command(struct channel *ch, bool event, uint32_t opcode, uint32_t wanted)
+{
+	uint32_t state = 0, number = event ? ch->ring_id : ch->id;
+
+	gsi_wr(event ? EV_CH_CMD : CH_CMD, number | opcode << 24);
+	for (unsigned us = 0; us < 50000; us += 100) {
+		state = event ? event_ring_state(ch) : channel_state(ch);
+		if (state == wanted) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	/* (the completion is also flagged as an interrupt source, masked: cleared) */
+	gsi_wr(event ? CNTXT_SRC_EV_CH_IRQ_CLR : CNTXT_SRC_CH_IRQ_CLR, 1u << number);
+	if (state != wanted) {
+		printf("ipa: %s: command %#x on %s %u leaves it in state %u, not %u\n", ch->name, opcode, event ? "event ring" : "channel", number,
+		    state, wanted);
+		gsi_error(ch->name);
+		return false;
+	}
+	return true;
+}
+
+/* As Linux's gsi_irq_setup(): interrupts, not MSIs; every source masked (nothing is handled here: the rings are polled). */
+static void
+gsi_interrupts_off(void)
+{
+	gsi_wr(CNTXT_INTSET, 1);
+	gsi_wr(CNTXT_TYPE_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_EV_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_GLOB_IRQ_EN, 0);
+	gsi_wr(CNTXT_SRC_IEOB_IRQ_MSK, 0);
+	gsi_wr(INTER_EE_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(INTER_EE_SRC_EV_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_GSI_IRQ_EN, 0);
+}
+
+/* As Linux's gsi_evt_ring_program() and gsi_channel_program(), for the GPI protocol. */
+static bool
+channel_setup(struct channel *ch)
+{
+	uint32_t e = ch->ring_id, c = ch->id, value;
+
+	if (!gsi_command(ch, true, GSI_EVT_ALLOCATE, EV_STATE_ALLOCATED)) {
+		return false;
+	}
+	gsi_wr(EV_CNTXT(e, 0), GSI_CHANNEL_TYPE_GPI | 1u << 16 /* INTYPE: interrupt, not MSI */ | ELEMENT_SIZE << 24);
+	gsi_wr(EV_CNTXT(e, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(EV_CNTXT(e, 2), (uint32_t)ch->event_ring.phys);
+	gsi_wr(EV_CNTXT(e, 3), (uint32_t)(ch->event_ring.phys >> 32));
+	gsi_wr(EV_CNTXT(e, 8), 32 /* moderation: 1 ms at 32 kHz */ | 1u << 16 /* MODC */);
+	for (unsigned n = 9; n <= 13; n++) {
+		gsi_wr(EV_CNTXT(e, n), 0);              /* no MSI, no read pointer updates */
+	}
+	/* "the last processed event": the ring's last entry, as nothing has been processed */
+	gsi_wr(EV_DOORBELL(e), (uint32_t)(ch->event_ring.phys + (ch->slots - 1) * ELEMENT_SIZE));
+
+	if (!gsi_command(ch, false, GSI_CH_ALLOCATE, CH_STATE_ALLOCATED)) {
+		return false;
+	}
+	gsi_wr(CH_CNTXT(c, 0), GSI_CHANNEL_TYPE_GPI | (ch->to_ipa ? 1u << 3 : 0) | e << 14 | ELEMENT_SIZE << 24);
+	gsi_wr(CH_CNTXT(c, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(CH_CNTXT(c, 2), (uint32_t)ch->tre_ring.phys);
+	gsi_wr(CH_CNTXT(c, 3), (uint32_t)(ch->tre_ring.phys >> 32));
+	/* QOS: the command channel gets the lowest round-robin weight and no escape buffer; the doorbell counts bytes */
+	value = (ch->command ? 0xf : 0) | (ch->command ? 0 : 1u << 10 /* PREFETCH_MODE: escape buffer only */) | 1u << 24;
+	gsi_wr(CH_QOS(c), value);
+	/* the GPI scratch: the most outstanding TREs (in bytes), the threshold 2 TREs */
+	gsi_wr(CH_SCRATCH(c, 0), (ch->tlv * ELEMENT_SIZE) << 16);
+	gsi_wr(CH_SCRATCH(c, 1), (2 * ELEMENT_SIZE) << 16);
+	gsi_wr(CH_SCRATCH(c, 2), 0);
+	gsi_wr(CH_SCRATCH(c, 3), gsi_rd(CH_SCRATCH(c, 3)) & 0xffff);
+	return true;
+}
+
+/* As Linux's ipa_endpoint_program() for IPA 4.11, with no checksum offload and no status. */
+static void
+endpoint_program(const struct channel *ch)
+{
+	uint32_t ep = ch->endpoint, value;
+
+	ipa_wr(ENDP_INIT_CFG(ep), 0);                   /* no fragment or checksum offload */
+	ipa_wr(ENDP_INIT_NAT(ep), 0);                   /* NAT bypassed */
+	value = 0;
+	if (ch->qmap) {
+		value = 4 /* HDR_LEN */ | 1u << 6 /* HDR_OFST_METADATA_VALID, at 0 */;
+		if (!ch->to_ipa) {
+			/* where the IPA writes the mux id (byte 1) and the packet's length (bytes 2-3) of the header it makes */
+			value |= 1u << 7 /* HDR_OFST_METADATA */ | 1u << 19 /* HDR_OFST_PKT_SIZE_VALID */ | 2u << 20 /* HDR_OFST_PKT_SIZE */;
+		}
+	}
+	ipa_wr(ENDP_INIT_HDR(ep), value);
+	value = 0;
+	if (ch->qmap) {
+		value = 1 /* HDR_ENDIANNESS: big */;
+		if (!ch->to_ipa) {
+			value |= 1u << 1 /* HDR_TOTAL_LEN_OR_PAD_VALID (pad) */ | 1u << 3 /* HDR_PAYLOAD_LEN_INC_PADDING */;
+		}
+	}
+	ipa_wr(ENDP_INIT_HDR_EXT(ep), value);
+	if (!ch->to_ipa) {
+		ipa_wr(ENDP_INIT_HDR_METADATA_MASK(ep), ch->qmap ? 0xff000000 : 0);   /* the metadata's low byte, big-endian */
+	} else {
+		/* the command endpoint moves its data to the LAN receive endpoint (DMA mode); the rest is basic */
+		ipa_wr(ENDP_INIT_MODE(ep), ch->command ? 3 | (uint32_t)lan_rx.endpoint << 4 : 0);
+	}
+	if (!ch->to_ipa && ch->aggregate) {
+		value = 1 /* AGGR_EN: aggregate */ | 4u << 2 /* AGGR_TYPE: generic */ | AGGR_LIMIT_KB << 5 | AGGR_TIME_TICKS << 12 |
+		    (ch->close_eof ? 1u << 23 /* SW_EOF_ACTIVE */ : 0);
+	} else if (ch->to_ipa && ch->qmap) {
+		value = 2 /* AGGR_EN: deaggregate */ | 6u << 2 /* AGGR_TYPE: QCMAP */;
+	} else {
+		value = 0;
+	}
+	ipa_wr(ENDP_INIT_AGGR(ep), value);
+	if (!ch->to_ipa) {
+		ipa_wr(ENDP_INIT_HOL_BLOCK_EN(ep), 0);  /* no head-of-line blocking drops */
+	} else {
+		ipa_wr(ENDP_INIT_DEAGGR(ep), 0);
+	}
+	ipa_wr(ENDP_INIT_RSRC_GRP(ep), 0);              /* resource group 0: UL/DL (the only one with limits) */
+	if (ch->to_ipa) {
+		ipa_wr(ENDP_INIT_SEQ(ep), ch->command ? 0 /* DMA */ : 4 /* 2_PASS_SKIP_LAST_UC */);
+	}
+	ipa_wr(ENDP_STATUS(ep), 0);                     /* no status packets */
+}
+
+/* The TRE at `index` of the channel's ring, filled and written out; the doorbell is rung separately. */
+static void
+tre_fill(struct channel *ch, uint32_t index, uint64_t addr, uint16_t len_opcode, uint32_t flags)
+{
+	struct tre *t = tre_at(ch, index);
+
+	t->addr = addr;
+	t->len_opcode = len_opcode;
+	t->reserved = 0;
+	t->flags = flags;
+	dma_sync((vm_offset_t)t, sizeof(*t));
+}
+
+static inline void
+channel_doorbell(struct channel *ch)
+{
+	gsi_wr(CH_DOORBELL(ch->id), (uint32_t)(ch->tre_ring.phys + (ch->next % ch->slots) * ELEMENT_SIZE));
+}
+
+/*
+ * The events the hardware has written since last time, each to `each`. The event ring's write
+ * pointer is in its context register 4; the doorbell afterwards tells the hardware the last event
+ * read, which makes room.
+ */
+static unsigned
+channel_events(struct channel *ch, void (*each)(struct channel *, const struct event *, void *), void *context)
+{
+	uint32_t wp = gsi_rd(EV_CNTXT(ch->ring_id, 4)), base = (uint32_t)ch->event_ring.phys, index;
+	unsigned n = 0;
+
+	if (wp < base || wp >= base + ch->slots * ELEMENT_SIZE) {
+		if (ch->errors++ == 0) {
+			printf("ipa: %s: the event ring's write pointer %#x is outside the ring at %#x\n", ch->name, wp, base);
+		}
+		return 0;
+	}
+	index = (wp - base) / ELEMENT_SIZE;
+	while (ch->events % ch->slots != index) {
+		struct event *e = (struct event *)(ch->event_ring.virt + (ch->events % ch->slots) * ELEMENT_SIZE);
+
+		dma_sync((vm_offset_t)e, sizeof(*e));
+		each(ch, e, context);
+		ch->events++;
+		n++;
+	}
+	if (n != 0) {
+		gsi_wr(EV_DOORBELL(ch->ring_id), (uint32_t)(ch->event_ring.phys + ((ch->events - 1) % ch->slots) * ELEMENT_SIZE));
+	}
+	return n;
+}
+
+/* ---- immediate commands ------------------------------------------------------------------------- */
+
+#define IPA_CMD_IP_V4_FILTER_INIT 0x3
+#define IPA_CMD_IP_V6_FILTER_INIT 0x4
+#define IPA_CMD_IP_V4_ROUTING_INIT 0x7
+#define IPA_CMD_IP_V6_ROUTING_INIT 0x8
+#define IPA_CMD_HDR_INIT_LOCAL  0x9
+#define IPA_CMD_DMA_SHARED_MEM  0x13
+
+struct command_done {
+	uint64_t        tre;
+	bool            done;
+	uint8_t         code;
+};
+
+static void
+command_event(__unused struct channel *ch, const struct event *e, void *context)
+{
+	struct command_done *waiting = context;
+
+	if (e->xfer == waiting->tre) {
+		waiting->done = true;
+		waiting->code = e->code;
+	}
+	command.done++;
+}
+
+/* One immediate command, waited for (up to 200 ms). The payload is copied into the slot's buffer. */
+static bool
+ipa_command(const char *what, uint8_t opcode, const void *payload, size_t size)
+{
+	uint32_t slot = command.next % command.slots;
+	struct command_done waiting = { .tre = command.tre_ring.phys + slot * ELEMENT_SIZE };
+
+	if (size > command.buffer_size || command.next - command.done >= command.slots - 1) {
+		return false;
+	}
+	memcpy((void *)slot_virt(&command, slot), payload, size);
+	dma_sync(slot_virt(&command, slot), size);
+	tre_fill(&command, command.next, slot_phys(&command, slot), opcode, TRE_TYPE_COMMAND | TRE_IEOT);
+	command.next++;
+	channel_doorbell(&command);
+	for (unsigned us = 0; us < 200000 && !waiting.done; us += 200) {
+		channel_events(&command, command_event, &waiting);
+		if (!waiting.done) {
+			delay_for_interval(200, NSEC_PER_USEC);
+		}
+	}
+	if (!waiting.done) {
+		printf("ipa: the command %s (opcode %#x) is not answered in 200 ms; channel state %u\n", what, opcode, channel_state(&command));
+		gsi_error(what);
+		return false;
+	}
+	if (trace) {
+		printf("ipa: the command %s (opcode %#x) done, code %u\n", what, opcode, waiting.code);
+	}
+	return true;
+}
+
+/*
+ * The tables, as Linux's ipa_table_init() lays them out in one buffer: a "zero rule" (8 bytes of
+ * zero, which every table entry points at until somebody installs a rule), then the filter
+ * table's bitmap of the endpoints that filter (bit n+1 for endpoint n: 2, 5 and 8 -- our modem
+ * transmit endpoint and two of the modem's), then as many entries as the longest table (15: the
+ * route tables' size, 0x78 bytes), each the zero rule's address. The filter table is the bitmap
+ * and 3 entries from offset 8; a route table the 15 entries from offset 16.
+ *
+ * The IPA's local memory, in the layout the modem driver zeroed (Android's ipa_4_11_mem_part,
+ * the same offsets as Linux's ipa_mem_local_data for these): IPv4 filter hashed 0x288, not
+ * hashed 0x308, IPv6 0x388/0x408; IPv4 route 0x488/0x508, IPv6 0x588/0x608; the modem's and our
+ * headers 0x688, 0x440 bytes in all.
+ */
+#define FILTERED_ENDPOINTS      ((1ull << 2) | (1ull << 5) | (1ull << 8))
+#define FILTER_ENTRIES          4               /* the bitmap and one per filtering endpoint */
+#define ROUTE_ENTRIES           15
+
+static bool
+table_init(const char *what, uint8_t opcode, bool filter, uint32_t hashed_offset, uint32_t offset)
+{
+	struct {
+		uint64_t hash_rules_addr, flags, nhash_rules_addr;
+	} payload;
+	uint32_t entries = filter ? FILTER_ENTRIES : ROUTE_ENTRIES, size = entries * 8;
+	uint64_t source = table.phys + (filter ? 8 : 16);
+
+	payload.hash_rules_addr = source;
+	payload.nhash_rules_addr = source;
+	payload.flags = (uint64_t)size | (uint64_t)(mem_offset + hashed_offset) << 12 | (uint64_t)size << 28 |
+	    (uint64_t)(mem_offset + offset) << 40;
+	return ipa_command(what, opcode, &payload, sizeof(payload));
+}
+
+static bool
+tables_setup(void)
+{
+	uint64_t *t = (uint64_t *)table.virt;
+	struct {
+		uint64_t hdr_table_addr;
+		uint32_t flags, reserved;
+	} headers;
+
+	t[0] = 0;                                       /* the zero rule */
+	t[1] = FILTERED_ENDPOINTS << 1;                 /* the filter bitmap */
+	for (unsigned n = 0; n < ROUTE_ENTRIES; n++) {
+		t[2 + n] = table.phys;
+	}
+	dma_sync(table.virt, (2 + ROUTE_ENTRIES) * 8);
+	if (!table_init("IPv4 route table init", IPA_CMD_IP_V4_ROUTING_INIT, false, 0x488, 0x508) ||
+	    !table_init("IPv6 route table init", IPA_CMD_IP_V6_ROUTING_INIT, false, 0x588, 0x608) ||
+	    !table_init("IPv4 filter table init", IPA_CMD_IP_V4_FILTER_INIT, true, 0x288, 0x308) ||
+	    !table_init("IPv6 filter table init", IPA_CMD_IP_V6_FILTER_INIT, true, 0x388, 0x408)) {
+		return false;
+	}
+	headers.hdr_table_addr = zero.phys;
+	headers.flags = 0x440 | (mem_offset + 0x688) << 12;
+	headers.reserved = 0;
+	if (!ipa_command("header table init", IPA_CMD_HDR_INIT_LOCAL, &headers, sizeof(headers))) {
+		return false;
+	}
+	ipa_wr(IPA_FILT_ROUT_HASH_FLUSH, 0x1111);      /* the hashed tables' caches, flushed */
+	return true;
+}
+
+/* ---- receiving and sending ---------------------------------------------------------------------- */
+
+/* A receive slot handed to the hardware (one TRE for the whole buffer). */
+static void
+receive_post(struct channel *ch, uint32_t slot)
+{
+	tre_fill(ch, ch->next, slot_phys(ch, slot), (uint16_t)(ch->buffer_size > 0xffff ? 0xffff : ch->buffer_size), TRE_TYPE_XFER | TRE_IEOT);
+	ch->next++;
+}
+
+struct receive_context {
+	void            (*receive)(uint8_t mux, const uint8_t *packet, size_t length);
+	unsigned        packets;
+};
+
+/* A receive buffer is full (or closed): the QMAP packets in it, one by one; then the slot is posted again. */
+static void
+receive_event(struct channel *ch, const struct event *e, void *context)
+{
+	struct receive_context *rc = context;
+	uint32_t slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE), length = e->len;
+	const uint8_t *buffer;
+
+	if (slot >= ch->slots || e->xfer < ch->tre_ring.phys) {
+		if (ch->errors++ < 4) {
+			printf("ipa: %s: an event for TRE %#llx, outside the ring at %#llx\n", ch->name, e->xfer, ch->tre_ring.phys);
+		}
+		return;
+	}
+	/* receives complete in order; ch->done is the next expected slot, ch->next the next to post (slots-1 ahead) */
+	if (slot != ch->done % ch->slots) {
+		if (ch->errors++ < 4) {
+			printf("ipa: %s: slot %u finished while slot %u was expected\n", ch->name, slot, ch->done % ch->slots);
+		}
+	}
+	ch->done++;
+	buffer = (const uint8_t *)slot_virt(ch, slot);
+	if (length > ch->buffer_size) {
+		length = ch->buffer_size;
+	}
+	dma_sync((vm_offset_t)buffer, length);
+	ch->bytes += length;
+	if (trace) {
+		printf("ipa: %s: slot %u: %u bytes (code %u): %02x %02x %02x %02x %02x %02x %02x %02x ...\n", ch->name, slot, length, e->code,
+		    buffer[0], buffer[1], buffer[2], buffer[3], buffer[4], buffer[5], buffer[6], buffer[7]);
+	}
+	if (ch->qmap) {
+		for (uint32_t at = 0; at + 4 <= length;) {
+			uint32_t pad = buffer[at] & 0x3f, cmd = buffer[at] & 0x80, mux = buffer[at + 1];
+			uint32_t packet = (uint32_t)buffer[at + 2] << 8 | buffer[at + 3];
+
+			if (packet == 0 || at + 4 + packet > length || pad > packet) {
+				break;
+			}
+			if (cmd == 0) {
+				ch->packets++;
+				rc->packets++;
+				if (rc->receive != NULL) {
+					rc->receive((uint8_t)mux, buffer + at + 4, packet - pad);
+				}
+			} else if (trace) {
+				printf("ipa: %s: a QMAP command (%u bytes) on mux %u\n", ch->name, packet, mux);
+			}
+			at += 4 + packet;
+		}
+	} else {
+		ch->packets++;                          /* the LAN endpoint: looked at, dropped */
+	}
+	/* the slot posted again -- the one at the ring's next TRE, which is this one while the hardware finishes in order */
+	receive_post(ch, ch->next % ch->slots);
+	channel_doorbell(ch);
+}
+
+static void
+transmit_event(struct channel *ch, const struct event *e, __unused void *context)
+{
+	uint32_t slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE);
+
+	if (slot != ch->done % ch->slots && ch->errors++ < 4) {
+		printf("ipa: %s: slot %u finished while slot %u was expected (code %u)\n", ch->name, slot, ch->done % ch->slots, e->code);
+	}
+	ch->done++;
+}
+
+bool
+hakios_ipa_transmit(uint8_t mux, const void *packet, size_t length)
+{
+	struct channel *ch = &modem_tx;
+	uint32_t slot;
+	uint8_t *buffer;
+
+	if (!ready || length == 0 || length + 4 > ch->buffer_size) {
+		return false;
+	}
+	lck_mtx_lock(&ipa_lock);
+	channel_events(ch, transmit_event, NULL);
+	if (ch->next - ch->done >= ch->slots - 1) {     /* one slot always left free: write==read means empty */
+		ch->dropped++;
+		lck_mtx_unlock(&ipa_lock);
+		return false;
+	}
+	slot = ch->next % ch->slots;
+	buffer = (uint8_t *)slot_virt(ch, slot);
+	buffer[0] = 0;                                  /* no pad, not a command */
+	buffer[1] = mux;
+	buffer[2] = (uint8_t)(length >> 8);
+	buffer[3] = (uint8_t)length;
+	memcpy(buffer + 4, packet, length);
+	dma_sync((vm_offset_t)buffer, length + 4);
+	tre_fill(ch, ch->next, slot_phys(ch, slot), (uint16_t)(length + 4), TRE_TYPE_XFER | TRE_IEOT | TRE_BEI);
+	ch->next++;
+	channel_doorbell(ch);
+	ch->packets++;
+	ch->bytes += length;
+	if (trace) {
+		printf("ipa: %s: slot %u: %zu bytes on mux %u\n", ch->name, slot, length, mux);
+	}
+	lck_mtx_unlock(&ipa_lock);
+	return true;
+}
+
+unsigned
+hakios_ipa_poll(void (*receive)(uint8_t mux, const uint8_t *packet, size_t length))
+{
+	struct receive_context rc = { receive, 0 };
+
+	if (!ready) {
+		return 0;
+	}
+	lck_mtx_lock(&ipa_lock);
+	channel_events(&modem_rx, receive_event, &rc);
+	channel_events(&lan_rx, receive_event, &rc);
+	channel_events(&modem_tx, transmit_event, NULL);
+	lck_mtx_unlock(&ipa_lock);
+	return rc.packets;
+}
+
+void
+hakios_ipa_modem_endpoints(uint32_t *to_modem, uint32_t *from_modem)
+{
+	*to_modem = modem_tx.endpoint;          /* 2: what Linux exports as modem/tx_endpoint_id */
+	*from_modem = modem_rx.endpoint;        /* 16: modem/rx_endpoint_id */
+}
+
+bool
+hakios_ipa_data_ready(void)
+{
+	return ready;
+}
+
+void
+hakios_ipa_status(char *to, size_t size)
+{
+	snprintf(to, size, "to the modem %llu packets (%llu bytes, %llu dropped), from it %llu (%llu bytes), %llu to the LAN endpoint; "
+	    "errors %llu/%llu/%llu; channels %u/%u/%u/%u", modem_tx.packets, modem_tx.bytes, modem_tx.dropped, modem_rx.packets, modem_rx.bytes,
+	    lan_rx.packets, modem_tx.errors, modem_rx.errors, lan_rx.errors, channel_state(&command), channel_state(&lan_rx),
+	    channel_state(&modem_tx), channel_state(&modem_rx));
+}
+
+/* ---- setting up ---------------------------------------------------------------------------------- */
+
+bool
+hakios_ipa_data_setup(void)
+{
+	uint32_t status, shared;
+	char line[256];
+
+	if (ready) {
+		return true;
+	}
+	{
+		uint32_t off = 0;
+
+		if (PE_parse_boot_argn("modem_ipa_data_off", &off, sizeof(off)) && off != 0) {
+			printf("ipa: no data path (modem_ipa_data_off)\n");
+			return false;
+		}
+		PE_parse_boot_argn("modem_ipa_data_trace", &off, sizeof(off));
+		trace = off != 0;
+	}
+	if (PAGE_SIZE != RECEIVE_BUFFER) {
+		printf("ipa: pages of %lu bytes, not %u: no data path\n", (unsigned long)PAGE_SIZE, RECEIVE_BUFFER);
+		return false;
+	}
+	if (ipa_regs == 0) {
+		PE_parse_boot_argn("soc_ipa_base", &ipa_regs_phys, sizeof(ipa_regs_phys));
+		PE_parse_boot_argn("soc_gsi_base", &gsi_phys, sizeof(gsi_phys));
+		ipa_regs = ml_io_map(ipa_regs_phys, IPA_REGS_SIZE);
+		gsi_regs = ml_io_map(gsi_phys + GSI_FROM, GSI_SIZE);
+	}
+	if (ipa_regs == 0 || gsi_regs == 0) {
+		printf("ipa: the registers cannot be mapped: no data path\n");
+		return false;
+	}
+	status = gsi_rd(GSI_STATUS);
+	shared = ipa_rd(IPA_SHARED_MEM_SIZE);
+	mem_offset = 8 * (shared >> 16);
+	if ((status & 1) == 0) {
+		printf("ipa: the GSI is not enabled (status %#x): no data path\n", status);
+		return false;
+	}
+	if (!dma_page(&table) || !dma_page(&zero)) {
+		printf("ipa: no memory for the tables: no data path\n");
+		return false;
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		if (!channel_memory(channels[n])) {
+			printf("ipa: no memory for the %s channel: no data path\n", channels[n]->name);
+			return false;
+		}
+	}
+	printf("ipa: setting up this processor's data path: GSI status %#x, local memory at %#x; rings and buffers in DDR from %#llx "
+	    "(the tables at %#llx)\n", status, mem_offset, modem_rx.pages[0].phys, table.phys);
+	gsi_interrupts_off();
+	for (unsigned n = 0; n < 4; n++) {
+		struct channel *ch = channels[n];
+
+		if (!channel_setup(ch)) {
+			printf("ipa: the %s channel (%u, event ring %u) cannot be set up: no data path\n", ch->name, ch->id, ch->ring_id);
+			return false;
+		}
+		endpoint_program(ch);
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		struct channel *ch = channels[n];
+
+		if (!gsi_command(ch, false, GSI_CH_START, CH_STATE_STARTED)) {
+			printf("ipa: the %s channel does not start: no data path\n", ch->name);
+			return false;
+		}
+		ch->started = true;
+		if (!ch->to_ipa) {
+			/* one short of the ring: the doorbell is the write pointer, and writing it level with
+			 * the read pointer (base) would mean "empty", not "full" */
+			for (uint32_t slot = 0; slot + 1 < ch->slots; slot++) {
+				receive_post(ch, slot);
+			}
+			channel_doorbell(ch);
+		}
+	}
+	if (!tables_setup()) {
+		printf("ipa: the IPA does not take its tables: no data path (the channels stay)\n");
+		return false;
+	}
+	ready = true;
+	hakios_ipa_status(line, sizeof(line));
+	printf("ipa: THE DATA PATH IS UP: endpoints %u (commands), %u (LAN in), %u (to the modem), %u (from the modem); the tables set; %s\n",
+	    command.endpoint, lan_rx.endpoint, modem_tx.endpoint, modem_rx.endpoint, line);
+	return true;
+}
diff --git a/bsd/dev/hakios.lx.c b/bsd/dev/hakios.lx.c
new file mode 100644
index 0000000..6e01bef
--- /dev/null
+++ b/bsd/dev/hakios.lx.c
@@ -0,0 +1,582 @@
+/*
+ * Darwin-on-hakios: the kernel's side of the Wi-Fi driver's object.
+ *
+ * The driver of the phone's radio is Linux's ath11k, compiled unmodified outside this tree on a
+ * layer that gives it the kernel interfaces it expects, and tied into one object that the
+ * kernel links when it is there (tools/mk-ath11k.sh and wifi/lx in the repository; the kernel
+ * is built with that object when xnu-build.sh finds it). The object shows one name, lx_start(),
+ * and asks for the calls of sys/hakios.lx.h, which are here: memory, time, threads, one lock
+ * to sleep under, the kernel's options. What it asks of the radio itself -- its firmware's
+ * files, its view of memory, the processor its firmware runs on -- is hakios.wifi.c's to
+ * answer, which knows the phone.
+ *
+ * A kernel built without the object has the lx_start() at the end of this file, which says so.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.lx.h>
+#include <sys/hakios.net.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define say hakios_wifi_say
+
+static LCK_GRP_DECLARE(lx_lock_group, "hakios-lx");
+static LCK_MTX_DECLARE(lx_lock, &lx_lock_group);
+
+/* ---- memory ------------------------------------------------------------------------------------------ */
+
+void *
+lx_os_alloc(unsigned long size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+void
+lx_os_free(void *memory, unsigned long size)
+{
+	kfree_data(memory, size);
+}
+
+/*
+ * In one physical piece, so that it can be mapped a second time without this processor's cache
+ * in between (as hakios.adreno.c does with what it shares with the GPU); the first, cached
+ * view is written out and never used again.
+ */
+void *
+lx_os_radio_memory(unsigned long size, unsigned long long *address)
+{
+	vm_offset_t cached = 0, uncached;
+	uint64_t physical;
+
+	size = round_page(size);
+	if (kmem_alloc_contig(kernel_map, &cached, size, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		say("lx: no %lu bytes of memory in one piece\n", size);
+		return NULL;
+	}
+	physical = kvtophys(cached);
+	bzero((void *)cached, size);
+	for (vm_offset_t line = cached; line < cached + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	uncached = ml_io_map_unmappable(physical, size, VM_WIMG_WCOMB);
+	if (uncached == 0 || !hakios_wifi_radio_map(physical, size, address)) {
+		return NULL;
+	}
+	return (void *)uncached;
+}
+
+void *
+lx_os_map_registers(unsigned long long physical, unsigned long size)
+{
+	unsigned long long page = trunc_page(physical);
+	vm_offset_t mapped = ml_io_map_unmappable(page, round_page(physical + size) - page, VM_WIMG_IO);
+
+	return mapped == 0 ? NULL : (void *)(mapped + (physical - page));
+}
+
+/* ---- saying things ----------------------------------------------------------------------------------- */
+
+void
+lx_os_print(const char *text)
+{
+	say("%s", text);
+}
+
+void
+lx_os_tell(const char *text)
+{
+	hakios_wifi_tell("%s", text);
+}
+
+void
+lx_os_panic(const char *text)
+{
+	panic("%s", text);
+}
+
+/* ---- time, threads, sleeping --------------------------------------------------------------------------- */
+
+unsigned long long
+lx_os_nanoseconds(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds;
+}
+
+void *
+lx_os_thread_self(void)
+{
+	return current_thread();
+}
+
+struct lx_thread {
+	void (*function)(void *);
+	void *argument;
+};
+
+static void
+lx_thread_runs(void *parameter, __unused wait_result_t result)
+{
+	struct lx_thread start = *(struct lx_thread *)parameter;
+
+	kfree_type(struct lx_thread, parameter);
+	start.function(start.argument);
+	thread_terminate(current_thread());
+}
+
+int
+lx_os_thread(const char *name, void (*function)(void *), void *argument)
+{
+	struct lx_thread *start = kalloc_type(struct lx_thread, Z_WAITOK | Z_ZERO);
+	thread_t thread;
+
+	if (start == NULL) {
+		return ENOMEM;
+	}
+	start->function = function;
+	start->argument = argument;
+	if (kernel_thread_start(lx_thread_runs, start, &thread) != KERN_SUCCESS) {
+		kfree_type(struct lx_thread, start);
+		return EAGAIN;
+	}
+	thread_set_thread_name(thread, name);
+	thread_deallocate(thread);
+	return 0;
+}
+
+void
+lx_os_lock(void)
+{
+	lck_mtx_lock(&lx_lock);
+}
+
+void
+lx_os_unlock(void)
+{
+	lck_mtx_unlock(&lx_lock);
+}
+
+int
+lx_os_sleep(const void *address, unsigned long long nanoseconds)
+{
+	uint64_t deadline;
+
+	if (nanoseconds == 0) {
+		return lck_mtx_sleep(&lx_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT) == THREAD_TIMED_OUT;
+	}
+	nanoseconds_to_absolutetime(nanoseconds, &deadline);
+	deadline += mach_absolute_time();
+	return lck_mtx_sleep_deadline(&lx_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT, deadline) == THREAD_TIMED_OUT;
+}
+
+void
+lx_os_wakeup(const void *address)
+{
+	thread_wakeup((event_t)address);
+}
+
+/* ---- the rest of the machine ------------------------------------------------------------------------- */
+
+void
+lx_os_random(void *buffer, unsigned long size)
+{
+	read_random(buffer, (u_int)size);
+}
+
+unsigned
+lx_os_option(const char *name)
+{
+	return hakios_wifi_option(name);
+}
+
+int
+lx_os_firmware(const char *name, const void **data, unsigned long *size)
+{
+	uint64_t length = 0;
+	const uint8_t *file = hakios_wifi_driver_file(name, &length);
+
+	if (file == NULL) {
+		return ENOENT;
+	}
+	*data = file;
+	*size = (unsigned long)length;
+	return 0;
+}
+
+int
+lx_os_rproc_boot(void)
+{
+	return hakios_wifi_dsp_is_up() ? 0 : ENXIO;
+}
+
+int
+lx_os_radio_address(unsigned char *address)
+{
+	return hakios_wifi_radio_address(address);
+}
+
+int
+lx_os_network(unsigned char *name, unsigned *name_length, unsigned char *passphrase, unsigned *passphrase_length)
+{
+	return hakios_wifi_network(name, name_length, passphrase, passphrase_length);
+}
+
+/* ---- frames: the radio as the link behind en0 (sys/hakios.net.h) ------------------------------------ */
+
+/*
+ * A frame from the network stack comes on whatever thread sends it, and the driver's side keeps
+ * a record of every thread that enters it: so frames are put in a queue here, and one thread of
+ * ours takes them to the driver. A queue that is full drops what comes (TCP sends it again).
+ */
+#define LX_QUEUE        256
+
+struct lx_frame {
+	uint16_t length;
+	uint8_t bytes[HAKIOS_NET_FRAME_MAX];
+};
+
+static bool lx_link_attached;
+static LCK_MTX_DECLARE(lx_queue_lock, &lx_lock_group);
+static struct lx_frame *lx_queue;
+static uint32_t lx_queue_in, lx_queue_out;      /* frames put in and taken out, counted from the start */
+static uint64_t lx_queue_dropped;
+
+static void
+lx_queue_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		struct lx_frame *frame;
+
+		lck_mtx_lock(&lx_queue_lock);
+		while (lx_queue_in == lx_queue_out) {
+			lck_mtx_sleep(&lx_queue_lock, LCK_SLEEP_DEFAULT, (event_t)&lx_queue_in, THREAD_UNINT);
+		}
+		frame = &lx_queue[lx_queue_out % LX_QUEUE];     /* (stays ours until lx_queue_out moves) */
+		lck_mtx_unlock(&lx_queue_lock);
+		lx_transmit(frame->bytes, frame->length);
+		lck_mtx_lock(&lx_queue_lock);
+		lx_queue_out++;
+		lck_mtx_unlock(&lx_queue_lock);
+	}
+}
+
+static bool
+lx_link_transmit(mbuf_t packet, size_t length)
+{
+	struct lx_frame *frame;
+
+	lck_mtx_lock(&lx_queue_lock);
+	if (length > HAKIOS_NET_FRAME_MAX || lx_queue_in - lx_queue_out == LX_QUEUE) {
+		lx_queue_dropped++;
+		lck_mtx_unlock(&lx_queue_lock);
+		return false;
+	}
+	frame = &lx_queue[lx_queue_in % LX_QUEUE];
+	if (mbuf_copydata(packet, 0, length, frame->bytes) != 0) {
+		lck_mtx_unlock(&lx_queue_lock);
+		return false;
+	}
+	frame->length = (uint16_t)length;
+	lx_queue_in++;
+	lck_mtx_unlock(&lx_queue_lock);
+	thread_wakeup((event_t)&lx_queue_in);
+	return true;
+}
+
+static struct hakios_net_link lx_link = {
+	.name = "the phone's radio (ath11k)",
+	.wireless = true,
+	.transmit = lx_link_transmit,
+};
+
+void
+lx_os_net_attach(const unsigned char *address)
+{
+	thread_t thread;
+
+	if (lx_link_attached) {
+		return;
+	}
+	lx_queue = kalloc_data(LX_QUEUE * sizeof(*lx_queue), Z_WAITOK | Z_ZERO);
+	if (lx_queue == NULL || kernel_thread_start(lx_queue_runs, NULL, &thread) != KERN_SUCCESS) {
+		say("lx: no memory or no thread for the frames to send: the radio's frames go nowhere\n");
+		return;
+	}
+	thread_set_thread_name(thread, "wifi-send");
+	thread_deallocate(thread);
+	memcpy(lx_link.address, address, sizeof(lx_link.address));
+	lx_link_attached = hakios_net_attach(&lx_link);
+	say("lx: %s\n", lx_link_attached ? "the radio is the link behind en0" : "EN0 HAS A LINK ALREADY: the radio's frames go "
+	    "nowhere");
+}
+
+/*
+ * With wifi=1 the interface is made when the kernel starts, before the radio is up: Darwin's Wi-Fi
+ * side looks for it and for its registry entry as soon as it runs, once, and a radio that
+ * turns up twelve seconds later is one it has already failed to open.
+ */
+void
+hakios_lx_net_early(void)
+{
+	uint8_t address[6];
+
+	if (hakios_wifi_radio_address(address)) {
+		lx_os_net_attach(address);
+	}
+}
+
+void
+lx_os_net_link(int up)
+{
+	if (lx_link_attached) {
+		hakios_net_link_state(up != 0);
+	}
+}
+
+void
+lx_os_net_input(const unsigned char *frame, unsigned long length)
+{
+	if (lx_link_attached && length <= HAKIOS_NET_FRAME_MAX) {
+		hakios_net_input(frame, length);
+	}
+}
+
+/* ---- the radio's interrupts ------------------------------------------------------------------------------- */
+
+extern kern_return_t gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint32_t intid), void *context);
+extern void gic_v3_spi_mask(uint32_t intid);
+extern void gic_v3_spi_unmask(uint32_t intid);
+extern void gic_v3_spi_detach(uint32_t intid);
+extern uint64_t gic_v3_spi_count(uint32_t intid);
+
+#define LX_VECTORS      32
+
+static struct {
+	void (*function)(void *);
+	void *argument;
+	bool attached;
+} lx_vector[LX_VECTORS];
+static uint32_t lx_irq_first;                   /* the GIC's number of vector 0; 0: no interrupts */
+static uint32_t lx_irq_pending;                 /* the vectors that have fired and are not dealt with yet */
+static uint32_t lx_irq_running;                 /* the vectors whose function the thread is in */
+static thread_t lx_irq_thread;
+static LCK_MTX_DECLARE(lx_irq_lock, &lx_lock_group);
+
+/* In interrupt context: the vector masked, and the thread told. */
+static void
+lx_irq_arrived(__unused void *context, uint32_t intid)
+{
+	gic_v3_spi_mask(intid);
+	os_atomic_or(&lx_irq_pending, 1u << (intid - lx_irq_first), relaxed);
+	thread_wakeup((event_t)&lx_irq_pending);
+}
+
+static void
+lx_irq_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		uint32_t pending;
+
+		for (;;) {
+			assert_wait((event_t)&lx_irq_pending, THREAD_UNINT);
+			if ((pending = os_atomic_xchg(&lx_irq_pending, 0, acquire)) != 0) {
+				clear_wait(current_thread(), THREAD_AWAKENED);
+				break;
+			}
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		for (unsigned v = 0; v < LX_VECTORS; v++) {
+			if (!(pending & 1u << v)) {
+				continue;
+			}
+			lck_mtx_lock(&lx_irq_lock);
+			if (!lx_vector[v].attached) {
+				lck_mtx_unlock(&lx_irq_lock);
+				continue;
+			}
+			lx_irq_running |= 1u << v;
+			lck_mtx_unlock(&lx_irq_lock);
+			lx_vector[v].function(lx_vector[v].argument);
+			lck_mtx_lock(&lx_irq_lock);
+			lx_irq_running &= ~(1u << v);
+			lck_mtx_unlock(&lx_irq_lock);
+			thread_wakeup((event_t)&lx_irq_running);
+		}
+	}
+}
+
+int
+lx_os_irq_msi(unsigned long long *address, unsigned *data)
+{
+	uint32_t first = 0;
+
+	if (!hakios_wifi_radio_msi(address, data, &first)) {
+		return 0;
+	}
+	lx_irq_first = first;
+	return 1;
+}
+
+int
+lx_os_irq_attach(unsigned vector, void (*function)(void *), void *argument)
+{
+	kern_return_t kr;
+
+	if (vector >= LX_VECTORS || lx_irq_first == 0 || function == NULL) {
+		return EINVAL;
+	}
+	if (lx_irq_thread == THREAD_NULL) {
+		hakios_wifi_tell("lx: wifi_irq: THE GIC'S DISTRIBUTOR IS WRITTEN for the radio's interrupts: each vector's SPI (%u + v) edge-"
+		    "triggered, group 1, routed to this processor, then enabled\n", lx_irq_first);
+		if (kernel_thread_start(lx_irq_runs, NULL, &lx_irq_thread) != KERN_SUCCESS) {
+			lx_irq_thread = THREAD_NULL;
+			return ENOMEM;
+		}
+		thread_set_thread_name(lx_irq_thread, "wifi-irq");
+	}
+	lck_mtx_lock(&lx_irq_lock);
+	lx_vector[vector].function = function;
+	lx_vector[vector].argument = argument;
+	lx_vector[vector].attached = true;
+	lck_mtx_unlock(&lx_irq_lock);
+	if ((kr = gic_v3_spi_attach(lx_irq_first + vector, true, lx_irq_arrived, NULL)) != KERN_SUCCESS) {
+		lck_mtx_lock(&lx_irq_lock);
+		lx_vector[vector].attached = false;
+		lck_mtx_unlock(&lx_irq_lock);
+		return kr == KERN_NAME_EXISTS ? EBUSY : EINVAL;
+	}
+	gic_v3_spi_mask(lx_irq_first + vector);
+	return 0;
+}
+
+void
+lx_os_irq_enable(unsigned vector)
+{
+	if (vector < LX_VECTORS && lx_vector[vector].attached) {
+		gic_v3_spi_unmask(lx_irq_first + vector);
+	}
+}
+
+void
+lx_os_irq_disable(unsigned vector)
+{
+	if (vector >= LX_VECTORS || !lx_vector[vector].attached) {
+		return;
+	}
+	gic_v3_spi_mask(lx_irq_first + vector);
+	if (current_thread() == lx_irq_thread) {
+		return;                         /* (from the vector's own function, or another's: nothing to wait for) */
+	}
+	lck_mtx_lock(&lx_irq_lock);
+	while (lx_irq_running & 1u << vector) {
+		lck_mtx_sleep(&lx_irq_lock, LCK_SLEEP_DEFAULT, (event_t)&lx_irq_running, THREAD_UNINT);
+	}
+	lck_mtx_unlock(&lx_irq_lock);
+}
+
+void
+lx_os_irq_detach_all(void)
+{
+	for (unsigned v = 0; v < LX_VECTORS; v++) {
+		if (lx_vector[v].attached) {
+			gic_v3_spi_detach(lx_irq_first + v);
+		}
+	}
+	lck_mtx_lock(&lx_irq_lock);
+	for (unsigned v = 0; v < LX_VECTORS; v++) {
+		lx_vector[v].attached = false;
+	}
+	while (lx_irq_running != 0 && current_thread() != lx_irq_thread) {
+		lck_mtx_sleep(&lx_irq_lock, LCK_SLEEP_DEFAULT, (event_t)&lx_irq_running, THREAD_UNINT);
+	}
+	lck_mtx_unlock(&lx_irq_lock);
+	os_atomic_store(&lx_irq_pending, 0, relaxed);
+}
+
+unsigned long long
+lx_os_irq_count(unsigned vector)
+{
+	return vector < LX_VECTORS && lx_irq_first != 0 ? gic_v3_spi_count(lx_irq_first + vector) : 0;
+}
+
+/* ---- the station (sys/hakios.sta.h) --------------------------------------------------------------------- */
+
+void
+lx_os_station(const struct hakios_sta_ops *ops)
+{
+	hakios_sta_attach(ops);
+}
+
+void
+lx_os_station_lost(int error)
+{
+	hakios_sta_lost(error);
+}
+
+/* ---- the driver ---------------------------------------------------------------------------------------- */
+
+/* The object has its own; this is the one of a kernel built without it. */
+__attribute__((weak)) int
+lx_start(void)
+{
+	say("lx: THE DRIVER IS NOT BUILT IN: its object was not there when this kernel was built (tools/mk-ath11k.sh, then "
+	    "build the kernel again)\n");
+	return ENXIO;
+}
+
+__attribute__((weak)) void
+lx_stop(void)
+{
+}
+
+__attribute__((weak)) int
+lx_prepare(void)
+{
+	return 0;
+}
+
+__attribute__((weak)) int
+lx_transmit(__unused const unsigned char *frame, __unused unsigned long length)
+{
+	return ENXIO;
+}
+
+int
+hakios_lx_start(void)
+{
+	return lx_start();
+}
+
+void
+hakios_lx_stop(void)
+{
+	lx_stop();
+}
+
+int
+hakios_lx_prepare(void)
+{
+	return lx_prepare();
+}
diff --git a/bsd/dev/hakios.mic.c b/bsd/dev/hakios.mic.c
new file mode 100644
index 0000000..c574797
--- /dev/null
+++ b/bsd/dev/hakios.mic.c
@@ -0,0 +1,1852 @@
+/*
+ * The phone's microphones, through the audio DSP. Every address and number below belongs to the
+ * POCO X5 Pro (redwood), from Android's own live device tree, its mixer paths (fw-audio/android/)
+ * and Xiaomi's kernel (hakios-s-oss, techpack/audio: asoc/codecs/bolero/, asoc/codecs/wcd938x/,
+ * soc/swr-mstr-ctrl.c, soc/pinctrl-lpi.c, dsp/q6afe.c, asoc/codecs/audio-ext-clk-up.c). Nothing
+ * here happens unless boot-arg mic=N asks for it, with adsp=1 (hakios.adsp.c), which calls
+ * hakios_mic_dsp_up() once the DSP's audio services are up.
+ *
+ * The main microphone under Android (mixer paths "handset-mic" = "amic1", "audio-record"): the
+ * analog microphone at ADC1 of the WCD938x codec, whose samples go over SoundWire (the TX master
+ * of the LPASS's digital codec, "bolero") into decimator 1 of the TX macro, out of it through the
+ * codec DMA interface TX_CDC_DMA_TX_3, the AFE's port, into a stream that is read (ASM). Before any
+ * of it: the LPASS's own clocks, which the DSP gives out (Android's audio-ref-clk nodes):
+ *   lpass_core_hw_vote   AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST, block 3 ("LPASS_HW_MACRO")
+ *   lpass_audio_hw_vote  the same, block 4 ("LPASS_HW_DCODEC")
+ *   tx_core_clk          AFE clock 0x30c at 19.2 MHz (qcom,codec-lpass-clk-id, -ext-clk-freq)
+ *   tx_npl_clk           AFE clock 0x30d at 19.2 MHz
+ * Without them the macros' registers are not to be touched at all: an access to a block without
+ * its clock may hang the bus.
+ *
+ *   mic=1    a look: the votes and the two clocks asked for, then -- only if all four were given --
+ *            the registers of the TX and VA macros, of the TX SoundWire master, of the LPASS pins
+ *            the master uses and of the codec's reset pin read (nothing written to any of them);
+ *            then the clocks and the votes given back
+ *   mic=2    ... and the codec brought up far enough to answer on SoundWire, nothing of it set:
+ *            its supplies as the boot chain leaves them (L18B and BoB are on: the codec answers; nothing
+ *            of the PMICs is touched), its reset released (GPIO83 low 20 us, then high, 16 mA:
+ *            msm-cdc-pinctrl's two states), the master's pins to their active state (LPASS GPIOs
+ *            0, 1, 2, 14: function 1, 2 mA, slew rate 1; the clock without a pull, the data with a
+ *            keeper), the TX macro's clocks as tx_macro_tx_va_mclk_enable() starts them (bolero's
+ *            "fs-gen-sequence" in the VA macro, FREQ_MCLK, MCLK_CONTROL, FS_CNT_CONTROL, the
+ *            SoundWire clock with a reset), the master started as swrm_runtime_resume() and
+ *            swrm_master_init() start it (the frame 50 rows x 2 columns, auto-enumeration, its
+ *            interrupts' masks), the codec's TX device waited for (ID 0x000d01170223, the tree's
+ *            wcd938x-tx-slave) and its chip ID read over SoundWire. Then all of it undone, in reverse:
+ *            the codec back in reset, the pins and registers as they were found
+ *   mic=3    ... and the main microphone listened to for mic_secs seconds (default 10, at most 600)
+ *            the way Android records from it: the codec set up as wcd938x_bind() and
+ *            wcd938x_init_reg() set it up (its interrupts as edges, the mic biases' 2750 mV, its
+ *            bias and sleep registers); the DSP's side (a stream read through our memory, ASM
+ *            session 2; a device path for recording, ADM; the codec DMA port TX_CDC_DMA_TX_3, AFE
+ *            port 0xB037, 48 kHz, 16 bits, one channel: decimator 1); the TX macro's decimator 1 fed
+ *            from SWR_MIC0 (the mixer controls "TX DEC1 MUX" SWR_MIC, "TX SMIC MUX1" SWR_MIC0, and
+ *            tx_macro_enable_dec()); "MIC BIAS1" and ADC1 in "low power" mode, "ADC1 Volume" 6 (Xiaomi's
+ *            mixer paths); the SoundWire port with the bus as Android has it for its handset
+ *            microphones (see datapath_on()); then the decimator unmuted after 200 ms and its
+ *            filter settled after 300 ms, as tx-macro's delayed work does. Each second's level goes
+ *            to the log; with rec_sound=N rec_sound_mic=1 the samples go into the recording that
+ *            ./xl sound fetches. Every register write is read back (a few registers that read 0
+ *            whatever is written, as on Android, are said so); any mismatch or a DSP command
+ *            refused stops it all. Tests: mic_input=0 (decimator 1 fed from ZERO: exact silence),
+ *            mic_adc=0 (ADC1 left off), mic_test=1 (no mic bias), mic_test=2 (ADC1's input held),
+ *            mic_main=1 (the bus and ports of Android's one-microphone tables: a tone, not the room),
+ *            mic_tap=1 with haptic=5 (the vibration motor from 2 s to 3 s of listening: the motor's
+ *            175.5 Hz in the samples)
+ *
+ * What is asked for is given back at the end, and before the DSP is shut down (hakios_mic_dsp_down()).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
+#include <kern/kalloc.h>
+#include <mach/mach_types.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/hakios.audio.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static LCK_GRP_DECLARE(mic_lock_group, "hakios-mic");
+static LCK_MTX_DECLARE(mic_lock, &mic_lock_group);      /* what is asked for, and given back */
+
+static uint32_t level;
+static bool running;
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+/*
+ * Every line is kept as well, and all of them said again at the run's end (hakios_mic_quiesce()):
+ * the log of a run keeps its beginning and its end, and this happens in between.
+ */
+#define KEPT_LINES              400
+static char kept[KEPT_LINES][168];
+static unsigned kept_count;
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	strlcpy(kept[kept_count++ % KEPT_LINES], line, sizeof(kept[0]));
+	return length;
+}
+
+/* A line that says all went as it should: not said again in Darwin's later recordings (mic=4), where it is the same each time. */
+static bool quiet;
+#define note(...)       do { if (!quiet) { say(__VA_ARGS__); } } while (0)
+
+void
+hakios_mic_quiesce(void)
+{
+	if (kept_count == 0) {
+		return;
+	}
+	for (const char *c = "mic: what happened in this run, again:\n"; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	for (unsigned i = kept_count > KEPT_LINES ? kept_count - KEPT_LINES : 0; i < kept_count; i++) {
+		loader_log_putc('>');
+		loader_log_putc(' ');
+		for (const char *c = kept[i % KEPT_LINES]; *c != 0; c++) {
+			loader_log_putc(*c);
+		}
+		if (kept[i % KEPT_LINES][strlen(kept[i % KEPT_LINES]) - 1] != '\n') {
+			loader_log_putc('\n');
+		}
+	}
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static bool broken;                     /* a write that did not read back: nothing more is written, all is undone */
+static char last_write[120] = "nothing written";
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	uint32_t value;
+
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	value = rd(b->base + offset);
+	note("mic: %s %s (%#x) = %#x\n", b->name, name, b->phys + offset, value);
+	return value;
+}
+
+/*
+ * A register written (and read back, unless `check' is 0: some bits clear themselves). A write that
+ * does not read back as written (in the bits of `check') stops the bring-up.
+ */
+static bool
+put(struct block *b, const char *name, uint32_t offset, uint32_t value, uint32_t check)
+{
+	uint32_t back;
+
+	if (broken) {
+		return false;
+	}
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	snprintf(last_write, sizeof(last_write), "%#x to %s %s (%#x)", value, b->name, name, b->phys + offset);
+	wr(b->base + offset, value);
+	back = rd(b->base + offset);
+	if ((back & check) != (value & check)) {
+		say("mic: %s %s (%#x) <- %#x, but it reads %#x: STOPPING HERE\n", b->name, name, b->phys + offset, value, back);
+		broken = true;
+		return false;
+	}
+	note("mic: %s %s (%#x) <- %#x%s\n", b->name, name, b->phys + offset, value, check ? ", reads back" : "");
+	return true;
+}
+
+/* only the bits of `mask' changed */
+static bool
+put_bits(struct block *b, const char *name, uint32_t offset, uint32_t mask, uint32_t value)
+{
+	uint32_t now;
+
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	now = rd(b->base + offset);
+	return put(b, name, offset, (now & ~mask) | (value & mask), mask);
+}
+
+/* ---- the DSP: votes and clocks ------------------------------------------------------------------- */
+
+#define APR_SVC_AFE                             4
+#define APR_BASIC_RSP_RESULT                    0x000110e8u
+#define APR_WAIT_MS                             1000
+#define AFE_SVC_CMD_SET_PARAM                   0x000100f3u
+#define AFE_MODULE_CLOCK_SET                    0x0001028fu
+#define AFE_PARAM_ID_CLOCK_SET                  0x00010290u
+#define AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST       0x000100f4u
+#define AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST   0x000100f5u
+#define AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST     0x000100f6u
+#define LPASS_HW_MACRO_BLOCK                    3
+#define LPASS_HW_DCODEC_BLOCK                   4
+#define CLOCK_TX_CORE                           0x30c
+#define CLOCK_TX_NPL                            0x30d
+#define CLOCK_HZ                                19200000
+#define CLOCK_COUPLE_NO                         1
+
+static const char *
+dsp_error(uint32_t status)
+{
+	static const char *const names[] = { "ok", "failed", "bad parameter", "unsupported", "version", "unexpected", "panic",
+		                             "no resource", "bad handle", "already", "not ready", "pending", "busy", "aborted",
+		                             "preempted", "continue", "immediate", "not implemented", "need more", "no memory",
+		                             "not there" };
+
+	return status < sizeof(names) / sizeof(names[0]) ? names[status] : "an error this does not know";
+}
+
+static bool
+command(const char *what, uint8_t service, uint32_t opcode, const void *payload, uint32_t length, uint32_t wanted,
+    struct hakios_apr_answer *answer)
+{
+	struct hakios_apr_answer local;
+
+	if (answer == NULL) {
+		answer = &local;
+	}
+	if (!hakios_adsp_apr(service, 0, 0, opcode, payload, length, APR_WAIT_MS, answer)) {
+		say("mic: %s (opcode %#x): NO ANSWER\n", what, opcode);
+		return false;
+	}
+	if (answer->opcode == APR_BASIC_RSP_RESULT && answer->words[0] == opcode) {
+		if (answer->words[1] == 0) {
+			note("mic: %s: done\n", what);
+		} else {
+			say("mic: %s: REFUSED: %s\n", what, dsp_error(answer->words[1]));
+		}
+		return answer->words[1] == 0 && wanted == 0;
+	}
+	if (wanted != 0 && answer->opcode == wanted) {
+		return true;
+	}
+	say("mic: %s: an answer not expected: opcode %#x, %u bytes: %#x %#x\n", what, answer->opcode, answer->length,
+	    answer->words[0], answer->words[1]);
+	return false;
+}
+
+struct afe_param {
+	uint32_t module, param;
+	uint16_t size, reserved;
+} __attribute__((packed));
+
+struct afe_clock_set {
+	uint32_t version, id, hz;
+	uint16_t attribute, root;
+	uint32_t enable;
+} __attribute__((packed));
+
+static bool
+afe_service_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	uint32_t *head = (uint32_t *)packet;
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	head[0] = (uint32_t)sizeof(*p) + size;          /* payload size; address 0 and handle 0: in band */
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, AFE_SVC_CMD_SET_PARAM, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+static bool
+afe_clock(const char *what, uint32_t id, bool on)
+{
+	struct afe_clock_set clock = { 1, id, CLOCK_HZ, CLOCK_COUPLE_NO, 0, on };
+
+	return afe_service_param(what, AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, &clock, sizeof(clock));
+}
+
+static uint32_t vote_handle[5];
+static bool voted[5], core_clock, npl_clock;
+
+static bool
+vote(uint32_t block, const char *client)
+{
+	struct {
+		uint32_t block;
+		char client[8];
+	} __attribute__((packed)) request = { block, { 0 } };
+	struct hakios_apr_answer answer;
+	char what[80];
+
+	strlcpy(request.client, client, sizeof(request.client));
+	snprintf(what, sizeof(what), "the LPASS's vote for block %u (\"%s\")", block, client);
+	if (!command(what, APR_SVC_AFE, AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST, &request, sizeof(request),
+	    AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST, &answer)) {
+		return false;
+	}
+	vote_handle[block] = answer.words[0];
+	voted[block] = true;
+	say("mic: %s: given, handle %u\n", what, vote_handle[block]);
+	return true;
+}
+
+static void
+devote(uint32_t block)
+{
+	uint32_t request[2] = { block, vote_handle[block] };
+	char what[64];
+
+	if (!voted[block]) {
+		return;
+	}
+	snprintf(what, sizeof(what), "the LPASS's vote for block %u, given back", block);
+	(void)command(what, APR_SVC_AFE, AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST, request, sizeof(request), 0, NULL);
+	voted[block] = false;
+}
+
+static bool
+clocks_on(void)
+{
+	if (!vote(LPASS_HW_MACRO_BLOCK, "LPASS_HW_MACRO") || !vote(LPASS_HW_DCODEC_BLOCK, "LPASS_HW_DCODEC")) {
+		return false;
+	}
+	core_clock = afe_clock("the TX macro's core clock (0x30c) at 19.2 MHz, on", CLOCK_TX_CORE, true);
+	if (!core_clock) {
+		return false;
+	}
+	npl_clock = afe_clock("the TX macro's NPL clock (0x30d) at 19.2 MHz, on", CLOCK_TX_NPL, true);
+	return npl_clock;
+}
+
+static void
+clocks_off(void)
+{
+	if (npl_clock) {
+		(void)afe_clock("the TX macro's NPL clock, off", CLOCK_TX_NPL, false);
+		npl_clock = false;
+	}
+	if (core_clock) {
+		(void)afe_clock("the TX macro's core clock, off", CLOCK_TX_CORE, false);
+		core_clock = false;
+	}
+	devote(LPASS_HW_DCODEC_BLOCK);
+	devote(LPASS_HW_MACRO_BLOCK);
+}
+
+/* ---- the blocks, read ------------------------------------------------------------------------------ */
+
+static struct block tx_macro = { "the TX macro", 0x03220000, 0x1000 };
+static struct block va_macro = { "the VA macro", 0x03370000, 0x1000 };
+static struct block tx_swr = { "the TX SoundWire master", 0x03230000, 0x2000 };
+static struct block tx_hctl = { "the TX SoundWire master's HCTL", 0x032a9000, 0x1000 };
+static struct block lpi = { "the LPASS pins", 0x033c0000, 0x10000 };
+static struct block lpi_high = { "the LPASS pins", 0x033ce000, 0x1000 };
+static struct block tlmm = { "the pin controller", 0x0f100000, 0x100000 };
+
+static void
+look(void)
+{
+	static const struct { const char *name; uint32_t offset; } tx[] = {
+		{ "MCLK_CONTROL", 0x000 }, { "FS_CNT_CONTROL", 0x004 }, { "SWR_CONTROL", 0x008 }, { "TOP_CFG0", 0x080 },
+		{ "SWR_CTRL", 0x088 }, { "FREQ_MCLK", 0x090 }, { "SWR_AMIC0_CTL", 0x0d0 }, { "SWR_AMIC1_CTL", 0x0d4 },
+	}, va[] = {
+		{ "MCLK_CONTROL", 0x000 }, { "FS_CNT_CONTROL", 0x004 }, { "TOP_CFG0", 0x080 },
+	}, swr[] = {
+		{ "COMP_HW_VERSION", 0x000 }, { "COMP_CFG", 0x004 }, { "COMP_STATUS", 0x014 }, { "COMP_PARAMS", 0x100 },
+		{ "COMP_MASTER_ID", 0x104 }, { "INTERRUPT_STATUS", 0x200 }, { "ENUMERATOR_CFG", 0x500 },
+		{ "ENUMERATOR_STATUS", 0x504 }, { "MCP_FRAME_CTRL_BANK0", 0x101c }, { "MCP_BUS_CTRL", 0x1044 },
+		{ "MCP_CFG", 0x1048 }, { "MCP_STATUS", 0x104c }, { "MCP_SLV_STATUS", 0x1090 },
+	};
+	static const unsigned pins[] = { 0, 1, 2 };
+
+	for (size_t i = 0; i < sizeof(tx) / sizeof(tx[0]); i++) {
+		(void)get(&tx_macro, tx[i].name, tx[i].offset);
+	}
+	for (size_t i = 0; i < sizeof(va) / sizeof(va[0]); i++) {
+		(void)get(&va_macro, va[i].name, va[i].offset);
+	}
+	for (size_t i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		char name[48];
+
+		snprintf(name, sizeof(name), "gpio%u config (SoundWire TX)", pins[i]);
+		(void)get(&lpi, name, 0x1000 * pins[i]);
+		snprintf(name, sizeof(name), "gpio%u in/out", pins[i]);
+		(void)get(&lpi, name, 0x1000 * pins[i] + 4);
+	}
+	(void)get(&lpi_high, "gpio14 config (SoundWire TX data 2)", 0);
+	(void)get(&lpi_high, "gpio14 in/out", 4);
+	(void)get(&tlmm, "gpio83 config (the codec's reset)", 0x1000 * 83);
+	(void)get(&tlmm, "gpio83 in/out", 0x1000 * 83 + 4);
+	/* (last: the master is a block of its own, and not yet known; with its version above 1.5.1 the votes are all it needs) */
+	for (size_t i = 0; i < sizeof(swr) / sizeof(swr[0]); i++) {
+		(void)get(&tx_swr, swr[i].name, swr[i].offset);
+	}
+	(void)get(&tx_hctl, "HCTL (0x32a90a8)", 0x0a8);
+}
+
+/* ---- the codec's reset, the master's pins ------------------------------------------------------------ */
+
+#define TLMM_CFG_83             (0x1000 * 83)
+#define TLMM_IO_83              (0x1000 * 83 + 4)
+static uint32_t found_reset_cfg, found_reset_io;
+static bool reset_taken;
+
+static bool
+reset_release(void)
+{
+	if (tlmm.base == 0) {
+		tlmm.base = ml_io_map(tlmm.phys, tlmm.size);
+	}
+	found_reset_cfg = rd(tlmm.base + TLMM_CFG_83);
+	found_reset_io = rd(tlmm.base + TLMM_IO_83);
+	reset_taken = true;
+	/* the sleep state: gpio, 16 mA, no pull, output low; 20 us; the active state: output high */
+	if (!put(&tlmm, "gpio83 out (the codec's reset)", TLMM_IO_83, 0, 2) ||
+	    !put(&tlmm, "gpio83 config: gpio, 16 mA, no pull, output", TLMM_CFG_83, 0x3c0, 0x3ff)) {
+		return false;
+	}
+	spin_us(30);
+	if (!put(&tlmm, "gpio83 out: high (the codec out of reset)", TLMM_IO_83, 2, 2)) {
+		return false;
+	}
+	spin_us(30);
+	return true;
+}
+
+static void
+reset_restore(void)
+{
+	if (!reset_taken) {
+		return;
+	}
+	broken = false;         /* (putting back is done whatever went before) */
+	(void)put(&tlmm, "gpio83 out: low (the codec in reset)", TLMM_IO_83, 0, 2);
+	(void)put(&tlmm, "gpio83 config, as it was found", TLMM_CFG_83, found_reset_cfg, 0x3ff);
+	(void)put(&tlmm, "gpio83 out, as it was found", TLMM_IO_83, found_reset_io & 2, 2);
+	reset_taken = false;
+}
+
+static struct block lpi_slew = { "the LPASS pins' slew rates", 0x0355a000, 0x1000 };
+static const struct { unsigned pin, slew_bit; uint32_t pull; const char *name; } swr_pins[] = {
+	{ 0, 0, 0, "gpio0 (SoundWire TX clock)" }, { 1, 2, 2, "gpio1 (data 0)" }, { 2, 4, 2, "gpio2 (data 1)" },
+	{ 14, 6, 2, "gpio14 (data 2)" },
+};
+#define SWR_PINS                (sizeof(swr_pins) / sizeof(swr_pins[0]))
+static uint32_t found_pin_cfg[SWR_PINS], found_pin_dir[SWR_PINS], found_slew;
+static bool pins_taken;
+
+static bool
+pins_on(void)
+{
+	uint32_t slew;
+
+	if (lpi.base == 0) {
+		lpi.base = ml_io_map(lpi.phys, lpi.size);
+	}
+	if (lpi_slew.base == 0) {
+		lpi_slew.base = ml_io_map(lpi_slew.phys, lpi_slew.size);
+	}
+	for (unsigned i = 0; i < SWR_PINS; i++) {
+		found_pin_cfg[i] = rd(lpi.base + 0x1000 * swr_pins[i].pin);
+		found_pin_dir[i] = rd(lpi.base + 0x1000 * swr_pins[i].pin + 4);
+	}
+	found_slew = rd(lpi_slew.base);
+	pins_taken = true;
+	slew = found_slew;
+	for (unsigned i = 0; i < SWR_PINS; i++) {
+		slew = (slew & ~(3u << swr_pins[i].slew_bit)) | (1u << swr_pins[i].slew_bit);
+	}
+	if (!put(&lpi_slew, "slew rates: 1 for the four", 0, slew, 0xff)) {
+		return false;
+	}
+	for (unsigned i = 0; i < SWR_PINS; i++) {
+		/* [1:0] pull, [5:2] function, [8:6] drive (mA / 2 - 1), [9] output: function 1, 2 mA, not an output */
+		uint32_t cfg = (found_pin_cfg[i] & ~0x3ffu) | swr_pins[i].pull | 1u << 2;
+
+		if (!put(&lpi, swr_pins[i].name, 0x1000 * swr_pins[i].pin, cfg, 0x3ff) ||
+		    !put(&lpi, "its direction: in", 0x1000 * swr_pins[i].pin + 4, 0, 2)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+pins_restore(void)
+{
+	if (!pins_taken) {
+		return;
+	}
+	broken = false;
+	for (unsigned i = 0; i < SWR_PINS; i++) {
+		(void)put(&lpi, "a pin, as it was found", 0x1000 * swr_pins[i].pin, found_pin_cfg[i], 0x3ff);
+		(void)put(&lpi, "its direction, as it was found", 0x1000 * swr_pins[i].pin + 4, found_pin_dir[i], 2);
+	}
+	(void)put(&lpi_slew, "slew rates, as they were found", 0, found_slew, 0xff);
+	pins_taken = false;
+}
+
+/* ---- the TX macro's clocks, the SoundWire master ----------------------------------------------------- */
+
+#define TX_MCLK_CONTROL         0x000
+#define TX_FS_CNT_CONTROL       0x004
+#define TX_SWR_CONTROL          0x008
+#define TX_FREQ_MCLK            0x090
+#define VA_MCLK_CONTROL         0x000
+#define VA_FS_CNT_CONTROL       0x004
+#define VA_TOP_CFG0             0x080
+
+#define SWRM_COMP_CFG                   0x0004
+#define SWRM_COMP_SW_RESET              0x0008
+#define SWRM_COMP_STATUS                0x0014
+#define SWRM_INTERRUPT_EN               0x0204
+#define SWRM_INTERRUPT_CLEAR            0x0208
+#define SWRM_CPU1_INTERRUPT_EN          0x0210
+#define SWRM_CMD_FIFO_WR_CMD            0x0300
+#define SWRM_CMD_FIFO_RD_CMD            0x0304
+#define SWRM_CMD_FIFO_CMD               0x0308
+#define SWRM_CMD_FIFO_STATUS            0x030c
+#define SWRM_CMD_FIFO_CFG               0x0314
+#define SWRM_CMD_FIFO_RD_FIFO           0x0318
+#define SWRM_ENUMERATOR_CFG             0x0500
+#define SWRM_ENUMERATOR_SLAVE_DEV_ID_1(m) (0x0530 + 0x8 * (m))
+#define SWRM_ENUMERATOR_SLAVE_DEV_ID_2(m) (0x0534 + 0x8 * (m))
+#define SWRM_MCP_FRAME_CTRL_BANK0       0x101c
+#define SWRM_MCP_BUS_CTRL               0x1044
+#define SWRM_MCP_CFG                    0x1048
+#define SWRM_MCP_SLV_STATUS             0x1090
+#define SWRM_INTERRUPT_STATUS_MASK      0x1fdfd
+#define SWR_BUS_HZ                      9600000         /* MCLK_FREQ: FREQ_MCLK 1 is 9.6 MHz */
+#define SWR_ROWS                        50
+#define SWR_COLUMNS                     2
+#define SWR_FRAME_SYNC_HZ               4000
+#define CODEC_TX_ID                     0x000d01170223ull       /* the tree's wcd938x-tx-slave */
+#define SWRS_SCP_INT_STATUS_MASK_1      0x41
+
+static bool tx_clocks_taken, master_taken;
+static uint32_t found_hctl;
+static uint8_t read_id = 0;
+
+static bool
+tx_clocks_on(void)
+{
+	tx_clocks_taken = true;
+	/* bolero_clk_rsc_fs_gen_request(): the tree's qcom,fs-gen-sequence, register, mask, value */
+	return put_bits(&va_macro, "MCLK_CONTROL (fs-gen)", VA_MCLK_CONTROL, 0x01, 0x01) &&
+	       put_bits(&va_macro, "FS_CNT_CONTROL (fs-gen)", VA_FS_CNT_CONTROL, 0x03, 0x03) &&
+	       put_bits(&va_macro, "FS_CNT_CONTROL (fs-gen)", VA_FS_CNT_CONTROL, 0x03, 0x01) &&
+	       put_bits(&va_macro, "TOP_CFG0 (fs-gen)", VA_TOP_CFG0, 0x02, 0x02) &&
+	       /*
+	        * tx_macro_mclk_enable(): "9.6 MHz MCLK" -- written as Android writes it; on the phone it reads
+	        * 0 back whether the macro's clock runs or not (Android never reads it)
+	        */
+	       put(&tx_macro, "FREQ_MCLK: 9.6 MHz (it reads 0 back whatever is written)", TX_FREQ_MCLK, 1, 0) &&
+	       put_bits(&tx_macro, "MCLK_CONTROL: on", TX_MCLK_CONTROL, 0x01, 0x01) &&
+	       put_bits(&tx_macro, "FS_CNT_CONTROL: on", TX_FS_CNT_CONTROL, 0x01, 0x01) &&
+	       /* tx_macro_tx_va_mclk_enable(): the SoundWire clock, with the first reset */
+	       put_bits(&tx_macro, "SWR_CONTROL: reset", TX_SWR_CONTROL, 0x02, 0x02) &&
+	       put_bits(&tx_macro, "SWR_CONTROL: clock on", TX_SWR_CONTROL, 0x01, 0x01) &&
+	       put_bits(&tx_macro, "SWR_CONTROL: reset over", TX_SWR_CONTROL, 0x02, 0x00);
+}
+
+static void
+tx_clocks_off(void)
+{
+	if (!tx_clocks_taken) {
+		return;
+	}
+	broken = false;
+	(void)put_bits(&tx_macro, "SWR_CONTROL: clock off", TX_SWR_CONTROL, 0x01, 0x00);
+	(void)put_bits(&tx_macro, "FS_CNT_CONTROL: off", TX_FS_CNT_CONTROL, 0x01, 0x00);
+	(void)put_bits(&tx_macro, "MCLK_CONTROL: off", TX_MCLK_CONTROL, 0x01, 0x00);
+	(void)put(&tx_macro, "FREQ_MCLK: as at reset", TX_FREQ_MCLK, 0, 0);
+	(void)put_bits(&va_macro, "TOP_CFG0 (fs-gen off)", VA_TOP_CFG0, 0x02, 0x00);
+	(void)put_bits(&va_macro, "FS_CNT_CONTROL (fs-gen off)", VA_FS_CNT_CONTROL, 0x03, 0x00);
+	(void)put_bits(&va_macro, "MCLK_CONTROL (fs-gen off)", VA_MCLK_CONTROL, 0x01, 0x00);
+	tx_clocks_taken = false;
+}
+
+static uint32_t
+swr_rd(uint32_t offset)
+{
+	if (tx_swr.base == 0) {
+		tx_swr.base = ml_io_map(tx_swr.phys, tx_swr.size);
+	}
+	return rd(tx_swr.base + offset);
+}
+
+static bool
+master_on(void)
+{
+	uint32_t ssp = SWR_BUS_HZ * 2 / (SWR_ROWS * SWR_COLUMNS * SWR_FRAME_SYNC_HZ), cfg;
+	bool linked = false;
+
+	if (tx_hctl.base == 0) {
+		tx_hctl.base = ml_io_map(tx_hctl.phys, tx_hctl.size);
+	}
+	found_hctl = rd(tx_hctl.base + 0x0a8);
+	master_taken = true;
+	/* "SW workaround to gate hw_ctl for SWR version >= 1.6" */
+	if (!put(&tx_hctl, "HCTL: bit 1 cleared", 0x0a8, found_hctl & ~2u, 0x3)) {
+		return false;
+	}
+	spin_us(505);
+	/* swrm_runtime_resume() */
+	if (!put(&tx_swr, "COMP_SW_RESET", SWRM_COMP_SW_RESET, 1, 0) || !put(&tx_swr, "COMP_SW_RESET", SWRM_COMP_SW_RESET, 1, 0) ||
+	    !put(&tx_swr, "MCP_BUS_CTRL", SWRM_MCP_BUS_CTRL, 1, 0)) {
+		return false;
+	}
+	/* swrm_master_init() */
+	cfg = (swr_rd(SWRM_MCP_CFG) & ~0x3e0000u) | 0x1fu << 17;
+	if (!put(&tx_swr, "MCP_FRAME_CTRL_BANK0: 50 rows, 2 columns", SWRM_MCP_FRAME_CTRL_BANK0, 1u << 3 | 0u | (ssp - 1) << 16,
+	    0xffffffff) ||
+	    !put(&tx_swr, "ENUMERATOR_CFG: auto", SWRM_ENUMERATOR_CFG, 1, 1) ||
+	    !put(&tx_swr, "MCP_CFG: 31 pings", SWRM_MCP_CFG, cfg, 0x3e0000) ||
+	    !put(&tx_swr, "CMD_FIFO_CFG: 3 retries", SWRM_CMD_FIFO_CFG, 3, 0xff) ||
+	    !put(&tx_swr, "MCP_BUS_CTRL", SWRM_MCP_BUS_CTRL, 2, 0) ||
+	    !put(&tx_swr, "COMP_CFG: interrupts as pulses", SWRM_COMP_CFG, 2, 0) ||
+	    !put(&tx_swr, "INTERRUPT_CLEAR", SWRM_INTERRUPT_CLEAR, 0xffffffff, 0) ||
+	    !put(&tx_swr, "INTERRUPT_EN", SWRM_INTERRUPT_EN, SWRM_INTERRUPT_STATUS_MASK, 0) ||
+	    !put(&tx_swr, "CPU1_INTERRUPT_EN", SWRM_CPU1_INTERRUPT_EN, SWRM_INTERRUPT_STATUS_MASK, 0) ||
+	    !put(&tx_swr, "COMP_CFG: on", SWRM_COMP_CFG, 3, 0)) {
+		return false;
+	}
+	for (int i = 0; i < 100 && !linked; i++) {
+		linked = swr_rd(SWRM_COMP_STATUS) & 1;
+		if (!linked) {
+			spin_us(510);
+		}
+	}
+	say("mic: the SoundWire link %s (COMP_STATUS %#x)\n", linked ? "IS UP" : "DID NOT COME UP", swr_rd(SWRM_COMP_STATUS));
+	if (!linked) {
+		return false;
+	}
+	return put(&tx_swr, "CMD_FIFO_CFG: | 0x80000000", SWRM_CMD_FIFO_CFG, swr_rd(SWRM_CMD_FIFO_CFG) | 0x80000000u, 0);
+}
+
+static void
+master_off(void)
+{
+	if (!master_taken) {
+		return;
+	}
+	broken = false;
+	(void)put(&tx_swr, "COMP_CFG: off", SWRM_COMP_CFG, 0, 0);
+	(void)put(&tx_swr, "INTERRUPT_EN: none", SWRM_INTERRUPT_EN, 0, 0);
+	(void)put(&tx_swr, "CPU1_INTERRUPT_EN: none", SWRM_CPU1_INTERRUPT_EN, 0, 0);
+	(void)put(&tx_swr, "COMP_SW_RESET", SWRM_COMP_SW_RESET, 1, 0);
+	(void)put(&tx_hctl, "HCTL, as it was found", 0x0a8, found_hctl, 0x3);
+	master_taken = false;
+}
+
+/* A command to a device on the bus (SWR_REG_VAL_PACK): a register written. */
+static bool
+swr_write(uint8_t device, uint16_t reg, uint8_t value, uint8_t id)
+{
+	uint32_t command = reg | (uint32_t)id << 16 | (uint32_t)device << 20 | (uint32_t)value << 24;
+
+	for (int i = 0; i < 20 && ((swr_rd(SWRM_CMD_FIFO_STATUS) >> 8) & 0x1f) >= 16; i++) {
+		spin_us(500);
+	}
+	snprintf(last_write, sizeof(last_write), "SoundWire: device %u register %#x <- %#x", device, reg, value);
+	wr(tx_swr.base + SWRM_CMD_FIFO_WR_CMD, command);
+	spin_us(155);
+	return true;
+}
+
+/* ... and one read: false if the answer does not come (or is not this command's) */
+static bool
+swr_read(uint8_t device, uint16_t reg, uint8_t *value)
+{
+	uint32_t answer = 0;
+
+	read_id = read_id < 14 ? read_id + 1 : 0;
+	wr(tx_swr.base + SWRM_CMD_FIFO_RD_CMD, reg | (uint32_t)read_id << 16 | (uint32_t)device << 20 | 1u << 24);
+	spin_us(255);
+	for (int tries = 0; tries < 4; tries++) {
+		for (int i = 0; i < 20 && ((swr_rd(SWRM_CMD_FIFO_STATUS) >> 16) & 0x1f) == 0; i++) {
+			spin_us(500);
+		}
+		answer = swr_rd(SWRM_CMD_FIFO_RD_FIFO);
+		if (((answer >> 8) & 0xf) == read_id) {
+			*value = (uint8_t)answer;
+			return true;
+		}
+		spin_us(505);
+	}
+	say("mic: SoundWire: device %u register %#x: no answer (fifo %#x, last %#x)\n", device, reg, swr_rd(SWRM_CMD_FIFO_STATUS),
+	    answer);
+	return false;
+}
+
+static uint8_t codec_device;
+
+/* the codec's TX device, enumerated: its device number, 0 if it did not show up */
+static uint8_t
+codec_wait(void)
+{
+	for (int waited = 0; waited < 200; waited++) {
+		for (uint8_t d = 1; d <= 11; d++) {
+			uint64_t id = (uint64_t)swr_rd(SWRM_ENUMERATOR_SLAVE_DEV_ID_2(d)) << 32 | swr_rd(SWRM_ENUMERATOR_SLAVE_DEV_ID_1(d));
+			uint32_t status = (swr_rd(SWRM_MCP_SLV_STATUS) >> (2 * d)) & 3;
+
+			if ((id & 0xffffffffffffull) == CODEC_TX_ID && (status == 1 || status == 2)) {
+				say("mic: the codec's TX device is device %u on the bus (ID %#llx, status %u) after %d ms\n", d,
+				    id & 0xffffffffffffull, status, waited);
+				return d;
+			}
+		}
+		sleep_ms(1);
+	}
+	say("mic: the codec's TX device did not show up; the master has seen:\n");
+	for (uint8_t d = 1; d <= 11; d++) {
+		uint64_t id = (uint64_t)swr_rd(SWRM_ENUMERATOR_SLAVE_DEV_ID_2(d)) << 32 | swr_rd(SWRM_ENUMERATOR_SLAVE_DEV_ID_1(d));
+
+		if (id != 0) {
+			say("mic:   device %u: ID %#llx\n", d, id);
+		}
+	}
+	say("mic:   slave status %#x\n", swr_rd(SWRM_MCP_SLV_STATUS));
+	return 0;
+}
+
+static void
+codec_look(void)
+{
+	static const struct { const char *name; uint16_t reg; } regs[] = {
+		{ "DIGITAL_CHIP_ID0", 0x3401 }, { "DIGITAL_CHIP_ID1", 0x3402 }, { "DIGITAL_CHIP_ID2", 0x3403 },
+		{ "DIGITAL_CHIP_ID3", 0x3404 }, { "SCP DEVICE_ID_0", 0x0050 }, { "SCP DEVICE_ID_1", 0x0051 },
+	};
+
+	for (size_t i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		uint8_t value;
+
+		if (swr_read(codec_device, regs[i].reg, &value)) {
+			say("mic: the codec's %s (%#x) = %#x\n", regs[i].name, regs[i].reg, value);
+		}
+	}
+}
+
+/* ---- mic=3: the codec set up as Android sets it up for the main microphone ----------------------------- */
+
+#define WCD_ANA_BIAS                    0x3001
+#define WCD_ANA_TX_CH1                  0x300e
+#define WCD_ANA_TX_CH2                  0x300f
+#define WCD_ANA_MICB1                   0x3022
+#define WCD_ANA_MICB2                   0x3023
+#define WCD_ANA_MICB3                   0x3025
+#define WCD_ANA_MICB4                   0x3026
+#define WCD_BIAS_VBG_FINE_ADJ           0x3029
+#define WCD_MICB1_TEST_CTL_1            0x306b
+#define WCD_MICB1_TEST_CTL_2            0x306c
+#define WCD_MICB2_TEST_CTL_1            0x306e
+#define WCD_MICB2_TEST_CTL_2            0x306f
+#define WCD_MICB3_TEST_CTL_1            0x3071
+#define WCD_MICB3_TEST_CTL_2            0x3072
+#define WCD_MICB4_TEST_CTL_1            0x3074
+#define WCD_MICB4_TEST_CTL_2            0x3075
+#define WCD_TX_3_4_TEST_BLK_EN2         0x308f
+#define WCD_HPH_REFBUFF_UHQA_CTL        0x30dd
+#define WCD_HPH_SURGE_HPHLR_SURGE_EN    0x30e2
+#define WCD_SLEEP_CTL                   0x3103
+#define WCD_LDORXTX_CONFIG              0x312a
+#define WCD_HPH_NEW_INT_RDAC_GAIN_CTL   0x3132
+#define WCD_HPH_NEW_INT_RDAC_HD2_CTL_L  0x3140
+#define WCD_HPH_NEW_INT_RDAC_HD2_CTL_R  0x3141
+#define WCD_TXFE_ICTRL_STG2MAIN_ULP     0x31df
+#define WCD_TXFE_ICTRL_STG2CASC_ULP     0x31e1
+#define WCD_SWR_TX_CLK_RATE             0x3405
+#define WCD_CDC_ANA_CLK_CTL             0x3408
+#define WCD_CDC_DIG_CLK_CTL             0x3409
+#define WCD_CDC_TX_ANA_MODE_0_1         0x3410
+#define WCD_CDC_ANA_TX_CLK_CTL          0x3417
+#define WCD_CDC_REQ_CTL                 0x3457
+#define WCD_CDC_DMIC_CTL                0x345b
+#define WCD_INTR_LEVEL_0                0x3474
+#define WCD_EFUSE_REG_30                0x34ce
+#define WCD_TX_REQ_FB_CTL_0             0x34d0
+#define SWRS_SCP_CONTROL                0x0044
+#define SWRS_SCP_FRAME_CTRL_BANK(m)     (0x0060 + 0x10 * (m))
+#define SWRS_SCP_HOST_CLK_DIV2_CTL_BANK(m) (0x00e0 + 0x10 * (m))
+#define SWRS_DP_CHANNEL_ENABLE_BANK(n, m) (0x120 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_SAMPLE_CONTROL_1_BANK(n, m) (0x122 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_SAMPLE_CONTROL_2_BANK(n, m) (0x123 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_OFFSET_CONTROL_1_BANK(n, m) (0x124 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_OFFSET_CONTROL_2_BANK(n, m) (0x125 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_LANE_CONTROL_BANK(n, m) (0x128 + 0x100 * (n) + 0x10 * (m))
+#define SWRM_MCP_STATUS                 0x104c
+#define SWRM_MCP_FRAME_CTRL_BANK(m)     (0x101c + 0x40 * (m))
+#define SWRM_DP_PORT_CTRL_BANK(n, m)    (0x1024 + 0x100 * (n) + 0x40 * (m))
+#define SWRM_DP_PORT_CTRL_2_BANK(n, m)  (0x1028 + 0x100 * (n) + 0x40 * (m))
+#define SWRM_DP_PORT_HCTRL_BANK(n, m)   (0x1034 + 0x100 * (n) + 0x40 * (m))
+#define SWRM_DP_SAMPLECTRL2_BANK(n, m)  (0x103c + 0x100 * (n) + 0x40 * (m))
+
+static uint8_t write_id;
+
+/* a register of the codec's (device codec_device on the bus) written and, unless `check' is 0, read back */
+static bool
+codec_put(uint16_t reg, uint8_t value, uint8_t check)
+{
+	uint8_t back = 0;
+
+	if (broken) {
+		return false;
+	}
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, reg, value, write_id);
+	if (check == 0) {
+		note("mic: the codec's %#06x <- %#04x\n", reg, value);
+		return true;
+	}
+	if (!swr_read(codec_device, reg, &back) || (back & check) != (value & check)) {
+		say("mic: the codec's %#06x <- %#04x, but it reads %#04x: STOPPING HERE\n", reg, value, back);
+		broken = true;
+		return false;
+	}
+	note("mic: the codec's %#06x <- %#04x, reads back\n", reg, value);
+	return true;
+}
+
+static bool
+codec_bits(uint16_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now = 0;
+
+	if (broken || !swr_read(codec_device, reg, &now)) {
+		broken = true;
+		return false;
+	}
+	return (now & mask) == (value & mask) || codec_put(reg, (uint8_t)((now & ~mask) | (value & mask)), mask);
+}
+
+/* a command to all devices on the bus (device 15, command id 15: Android's broadcasts) */
+static void
+broadcast(uint16_t reg, uint8_t value)
+{
+	swr_write(0xf, reg, value, 0xf);
+	note("mic: SoundWire, to all: %#06x <- %#04x\n", reg, value);
+	sleep_ms(10);           /* ("10 ms for the broadcast to complete", swrm_cmd_fifo_wr_cmd()) */
+}
+
+/* to all devices, with an ordinary command id (swrm_cmd_fifo_wr_cmd(..., 0xF, 0x00, ...)) */
+static void
+to_all(uint16_t reg, uint8_t value)
+{
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(0xf, reg, value, write_id);
+	note("mic: SoundWire, to all: %#06x <- %#04x\n", reg, value);
+}
+
+/* wcd938x_bind(), wcd938x_set_micbias_data(), wcd938x_init_reg() */
+static bool
+codec_init(void)
+{
+	uint8_t efuse = 0;
+	/* the tree's qcom,cdc-micbias1..4-mv: 2750 mV, (2750 - 1000) / 50 */
+	const uint8_t vout = (2750 - 1000) / 50;
+
+	if (!codec_put(WCD_INTR_LEVEL_0, 0, 0xff) || !codec_put(WCD_INTR_LEVEL_0 + 1, 0, 0xff) ||
+	    !codec_put(WCD_INTR_LEVEL_0 + 2, 0, 0xff) ||
+	    !codec_bits(WCD_ANA_MICB1, 0x3f, vout) || !codec_bits(WCD_ANA_MICB2, 0x3f, vout) ||
+	    !codec_bits(WCD_ANA_MICB3, 0x3f, vout) || !codec_bits(WCD_ANA_MICB4, 0x3f, vout) ||
+	    !codec_bits(WCD_SLEEP_CTL, 0x0e, 0x0e) || !codec_bits(WCD_SLEEP_CTL, 0x80, 0x80)) {
+		return false;
+	}
+	sleep_ms(1);
+	if (!codec_bits(WCD_SLEEP_CTL, 0x40, 0x40)) {
+		return false;
+	}
+	sleep_ms(1);
+	if (!codec_bits(WCD_LDORXTX_CONFIG, 0x10, 0x00) || !codec_bits(WCD_BIAS_VBG_FINE_ADJ, 0xf0, 0x80) ||
+	    !codec_bits(WCD_ANA_BIAS, 0x80, 0x80) || !codec_bits(WCD_ANA_BIAS, 0x40, 0x40)) {
+		return false;
+	}
+	sleep_ms(10);
+	if (!codec_bits(WCD_ANA_BIAS, 0x40, 0x00) || !codec_bits(WCD_HPH_NEW_INT_RDAC_GAIN_CTL, 0xf0, 0x00) ||
+	    !codec_bits(WCD_HPH_NEW_INT_RDAC_HD2_CTL_L, 0x1f, 0x15) || !codec_bits(WCD_HPH_NEW_INT_RDAC_HD2_CTL_R, 0x1f, 0x15) ||
+	    !codec_bits(WCD_HPH_REFBUFF_UHQA_CTL, 0xc0, 0x80) || !codec_bits(WCD_CDC_DMIC_CTL, 0x02, 0x02) ||
+	    !codec_bits(WCD_TXFE_ICTRL_STG2CASC_ULP, 0xff, 0x14) || !codec_bits(WCD_TXFE_ICTRL_STG2MAIN_ULP, 0x1f, 0x08) ||
+	    !codec_bits(WCD_TX_REQ_FB_CTL_0, 0xff, 0x55) || !codec_bits(WCD_TX_REQ_FB_CTL_0 + 1, 0xff, 0x44) ||
+	    !codec_bits(WCD_TX_REQ_FB_CTL_0 + 2, 0xff, 0x11) || !codec_bits(WCD_TX_REQ_FB_CTL_0 + 3, 0xff, 0x00) ||
+	    !codec_bits(WCD_TX_REQ_FB_CTL_0 + 4, 0xff, 0x00) ||
+	    !codec_bits(WCD_MICB1_TEST_CTL_1, 0xe0, 0xe0) || !codec_bits(WCD_MICB2_TEST_CTL_1, 0xe0, 0xe0) ||
+	    !codec_bits(WCD_MICB3_TEST_CTL_1, 0xe0, 0xe0) || !codec_bits(WCD_MICB4_TEST_CTL_1, 0xe0, 0xe0) ||
+	    !codec_bits(WCD_TX_3_4_TEST_BLK_EN2, 0x01, 0x00) || !swr_read(codec_device, WCD_EFUSE_REG_30, &efuse) ||
+	    !codec_bits(WCD_SLEEP_CTL, 0x0e, (uint8_t)((efuse & 0x07) << 1)) ||
+	    !codec_bits(WCD_HPH_SURGE_HPHLR_SURGE_EN, 0xc0, 0x00)) {
+		return false;
+	}
+	say("mic: the codec is set up as wcd938x_init_reg() sets it up (efuse 30: %#x)\n", efuse);
+	return true;
+}
+
+/*
+ * The bus and ADC1's data port as Android has them while the phone records from its handset
+ * microphones (the HAL's "handset-mic" = "handset-dmic-endfire": ADC1, the main microphone, and
+ * ADC4, the top one, both in "low power" mode). With two ADCs on, wcd938x_codec_enable_adc() asks
+ * for twice an ADC's 4.8 MHz, 9.6 MHz, and swr-mstr-ctrl adds its ports' rates up to the same: the
+ * bus at 9.6 MHz (MCLK / 1), the frame 50 rows x 16 columns, the codec's TX clock rate "9.6 MHz".
+ * The ports then come from the 9.6 MHz tables: the codec's (the tree's qcom,swr-phy-dev-addr makes
+ * swrm_get_device_frame_shape() use swrdev_frame_params_9p6MHz: tx_wcd_9p6MHz TX1 { si 3, offsets
+ * 0 0, lane 1 }) and the master's (sm_port_map_shima, usecase 0: tx_frame_params_shima TX1 { si 7,
+ * offsets 0 0, lane 1 }). ADC1 alone is all that is on here; its port is the codec's port 0 (its
+ * DP1), channel 1, to the master's port 1, channel 1. Written into the bank not in use, then the
+ * banks switched, then the other bank.
+ *
+ * Android's tables for ADC1 alone (the "main-mic" path: a 4.8 MHz bus, si 7 on both sides) carry
+ * half of what ADC1 makes in "low power" mode: what comes out of the decimator is then a loud,
+ * clipped tone at about the bus clock / 560, whatever the microphone hears (mic_main=1 shows it).
+ */
+static uint8_t bank_now;
+static uint32_t adc_on = 1;             /* boot-arg mic_adc=0 (a test): ADC1 and its mic bias left off, the port alone */
+static uint32_t main_timing;            /* boot-arg mic_main=1 (a test): the bus and ports of Android's one-microphone tables */
+static uint32_t tap;                    /* boot-arg mic_tap=1 (a test): the vibration motor (haptic=5) runs from 2 s to 3 s of listening */
+static uint32_t test_bits;              /* boot-arg mic_test=N (tests): 1 no mic bias, 2 the ADC's input held (HPF init) */
+
+static bool
+port_config(uint8_t bank, bool first)
+{
+	uint8_t codec_interval = main_timing ? 7 : 3, master_interval = 7;
+
+	/* the codec's side (swrm_apply_port_config() first: the devices' clock halved in that bank) */
+	if (first) {
+		to_all(SWRS_SCP_HOST_CLK_DIV2_CTL_BANK(bank), 0x01);
+	}
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_CHANNEL_ENABLE_BANK(0, bank), 0x01, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_SAMPLE_CONTROL_1_BANK(0, bank), codec_interval, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_SAMPLE_CONTROL_2_BANK(0, bank), 0, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_OFFSET_CONTROL_1_BANK(0, bank), 0, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_OFFSET_CONTROL_2_BANK(0, bank), 0, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_LANE_CONTROL_BANK(0, bank), 1, write_id);
+	note("mic: the codec's data port 1, bank %u: channel 1 on, sample interval %u, offsets 0 0, lane 1\n", bank, codec_interval);
+	/* the master's port 1 */
+	return put(&tx_swr, "DP_PORT_CTRL (port 1): channel 1, offsets 0 0, interval 7", SWRM_DP_PORT_CTRL_BANK(1, bank),
+	           0x01u << 24 | 0u << 16 | 0u << 8 | master_interval, 0xffffffff) &&
+	       put(&tx_swr, "DP_SAMPLECTRL2 (port 1)", SWRM_DP_SAMPLECTRL2_BANK(1, bank), 0, 0xff) &&
+	       put(&tx_swr, "DP_PORT_CTRL_2 (port 1): lane 1", SWRM_DP_PORT_CTRL_2_BANK(1, bank), 1, 0xff) &&
+	       /* (it reads 0 back on the phone whatever is written; Android writes it and never reads it) */
+	       put(&tx_swr, "DP_PORT_HCTRL (port 1): hstop 15, hstart 0", SWRM_DP_PORT_HCTRL_BANK(1, bank), 0xf0, 0);
+}
+
+static bool
+datapath_on(void)
+{
+	/* the codec's TX clock rate: "9.6 MHz" (0) in both banks; "4.8 MHz" (1) for mic_main=1 */
+	uint8_t current = 0, bank, rate = main_timing ? 1 : 0;
+	uint32_t frame;
+
+	/* wcd938x_codec_enable_adc(): the codec's TX clock rate in the bank about to be used */
+	if (!swr_read(codec_device, SWRS_SCP_CONTROL, &current)) {
+		return false;
+	}
+	bank = (current & 0x40) ? 0 : 1;
+	if (!codec_bits(WCD_SWR_TX_CLK_RATE, bank ? 0xf0 : 0x0f, (uint8_t)(bank ? rate << 4 : rate))) {
+		return false;
+	}
+	/* swrm_slvdev_datapath_control() */
+	bank = (swr_rd(SWRM_MCP_STATUS) & 1) ? 0 : 1;
+	if (!put(&tx_swr, "CPU1_INTERRUPT_EN", SWRM_CPU1_INTERRUPT_EN, SWRM_INTERRUPT_STATUS_MASK, 0) || !port_config(bank, true)) {
+		return false;
+	}
+	/*
+	 * 50 rows, 16 columns; the bus at 9.6 MHz: MCLK / 1, "ssp period" 9.6 MHz x 2 / (50 x 16 x 4000) = 6
+	 * (mic_main=1: 4.8 MHz, MCLK / 2, 3)
+	 */
+	frame = (swr_rd(SWRM_MCP_FRAME_CTRL_BANK(bank)) & ~0xff07ffu) | 1u << 3 | 7u | (main_timing ? 1u : 0u) << 8 |
+	    (main_timing ? 3u - 1 : 6u - 1) << 16;
+	if (!put(&tx_swr, main_timing ? "MCP_FRAME_CTRL (the bank to come): 50 x 16, MCLK / 2" :
+	    "MCP_FRAME_CTRL (the bank to come): 50 x 16, MCLK / 1", SWRM_MCP_FRAME_CTRL_BANK(bank), frame, 0xff07ff)) {
+		return false;
+	}
+	broadcast(SWRS_SCP_FRAME_CTRL_BANK(bank), 1u << 3 | 7u);       /* (enable_bank_switch(): the switch itself) */
+	bank_now = (swr_rd(SWRM_MCP_STATUS) & 1);
+	say("mic: the banks switched: the master is in bank %u now (asked for %u)\n", bank_now, bank);
+	if (bank_now != bank || !port_config(bank ? 0 : 1, false)) {
+		return false;
+	}
+	/* and the codec's rate in the other bank */
+	if (!codec_bits(WCD_SWR_TX_CLK_RATE, bank ? 0x0f : 0xf0, (uint8_t)(bank ? rate : rate << 4))) {
+		return false;
+	}
+	/* (what the codec's port says it is set to, both banks; its interrupts) */
+	for (uint8_t b = 0; b < 2; b++) {
+		uint8_t v[6] = { 0 };
+
+		(void)swr_read(codec_device, SWRS_DP_CHANNEL_ENABLE_BANK(0, b), &v[0]);
+		(void)swr_read(codec_device, SWRS_DP_SAMPLE_CONTROL_1_BANK(0, b), &v[1]);
+		(void)swr_read(codec_device, SWRS_DP_OFFSET_CONTROL_1_BANK(0, b), &v[2]);
+		(void)swr_read(codec_device, SWRS_DP_LANE_CONTROL_BANK(0, b), &v[3]);
+		(void)swr_read(codec_device, SWRS_SCP_FRAME_CTRL_BANK(b), &v[4]);
+		(void)swr_read(codec_device, SWRS_SCP_HOST_CLK_DIV2_CTL_BANK(b), &v[5]);
+		note("mic: the codec's DP1, bank %u: channels %#x, interval %u, offset %u, lane %u; frame %#x, div2 %#x\n", b, v[0], v[1],
+		    v[2], v[3], v[4], v[5]);
+	}
+	{
+		uint8_t status = 0, control = 0, dp_int = 0, dp_ctl = 0;
+
+		(void)swr_read(codec_device, 0x0040, &status);
+		(void)swr_read(codec_device, SWRS_SCP_CONTROL, &control);
+		(void)swr_read(codec_device, 0x0100, &dp_int);
+		(void)swr_read(codec_device, 0x0102, &dp_ctl);
+		note("mic: the codec's SCP int status %#x, control/status %#x; DP1 int status %#x, port control %#x; the master's DP1 "
+		    "interrupt status %#x\n", status, control, dp_int, dp_ctl, swr_rd(0x1100));
+	}
+	return true;
+}
+
+/* "MIC BIAS1" (wcd938x_micbias_control(MICB_ENABLE)), then ADC1's request (wcd938x_enable_req()) in "low power" mode */
+static bool
+adc1_on(void)
+{
+	return codec_bits(WCD_CDC_DIG_CLK_CTL, 0xf0, 0xf0) && codec_bits(WCD_CDC_ANA_CLK_CTL, 0x10, 0x10) &&
+	       codec_bits(WCD_CDC_ANA_TX_CLK_CTL, 0x01, 0x01) && codec_bits(WCD_MICB1_TEST_CTL_2, 0x01, 0x01) &&
+	       codec_bits(WCD_MICB2_TEST_CTL_2, 0x01, 0x01) && codec_bits(WCD_MICB3_TEST_CTL_2, 0x01, 0x01) &&
+	       codec_bits(WCD_MICB4_TEST_CTL_2, 0x01, 0x01) && codec_bits(WCD_ANA_MICB1, 0xc0, (test_bits & 1) ? 0x00 : 0x40) &&
+	       /* "ADC1 Volume" 6 (Xiaomi's mixer paths) */
+	       codec_bits(WCD_ANA_TX_CH1, 0x1f, 6) &&
+	       codec_bits(WCD_CDC_ANA_CLK_CTL, 0x08, 0x08) && codec_bits(WCD_CDC_ANA_CLK_CTL, 0x10, 0x10) &&
+	       codec_bits(WCD_CDC_REQ_CTL, 0x02, 0x02) && codec_bits(WCD_CDC_REQ_CTL, 0x01, 0x00) &&
+	       codec_bits(WCD_ANA_TX_CH2, 0x40, 0x40) && codec_bits(WCD_CDC_TX_ANA_MODE_0_1, 0x0f, 0x05) &&
+	       codec_bits(WCD_CDC_DIG_CLK_CTL, 0x10, 0x10) && codec_bits(WCD_ANA_TX_CH2, 0x40, (test_bits & 2) ? 0x40 : 0x00);
+}
+
+/* ---- the TX macro's decimator 1 ------------------------------------------------------------------------- */
+
+#define TX_TOP_CSR_SWR_CTRL             0x088
+#define TX_SWR_MIC0_CTL                 0x0d0
+#define TX_SWR_MIC1_CTL                 0x0d4
+#define TX_SWR_MIC2_CTL                 0x0c0
+#define TX_ADC_MUX1_CFG0                0x108
+#define TX_ADC_MUX1_CFG1                0x10c
+#define TX1_PATH_CTL                    0x480
+#define TX1_PATH_CFG0                   0x484
+#define TX1_VOL_CTL                     0x48c
+#define TX1_PATH_SEC2                   0x498
+
+#define VA_CORE_ID_0                    0x0c0
+#define VA_CORE_ID_1                    0x0c4
+#define VA_SWR_MIC_CTL0                 0x0d0
+#define VA_SWR_MIC_CTL1                 0x0d4
+#define VA_SWR_MIC_CTL2                 0x0d8
+
+static uint32_t found_dec[10], found_va_mic[3];
+static uint32_t smic_input = 1;         /* boot-arg mic_input=N: TX SMIC MUX1's input (1 SWR_MIC0, Android's; 0 ZERO, a test) */
+static bool dec_taken, va_mic_taken;
+static unsigned bolero_version;         /* 20 or 21: the digital codec's own core ID (bolero_soc_codec_probe()) */
+static uint8_t hpf_cut_off;             /* the decimator's high-pass filter as it was found */
+
+static const uint32_t dec_regs[] = {
+	TX_TOP_CSR_SWR_CTRL, TX_SWR_MIC0_CTL, TX_SWR_MIC1_CTL, TX_SWR_MIC2_CTL, TX_SWR_MIC2_CTL + 4, TX_SWR_MIC2_CTL + 8,
+	TX_SWR_MIC2_CTL + 12, TX_ADC_MUX1_CFG0, TX_ADC_MUX1_CFG1, TX1_PATH_CTL,
+};
+
+/*
+ * Which bolero this is: its core ID, as bolero_soc_codec_probe() reads it (01 0F: 2.0, 02 0E: 2.1),
+ * whatever the tree says ("qcom,bolero-version" 4). 2.1 has the SoundWire mics' clock dividers in
+ * the VA macro, which va_macro_init() sets (SWR_MIC_CTL0..2: 0xEE, 0xCC); 2.0 in the TX macro,
+ * which tx_macro_enable_dec() sets.
+ */
+static bool
+bolero_look(void)
+{
+	uint32_t id0 = get(&va_macro, "CORE_ID_0", VA_CORE_ID_0) & 0xff, id1 = get(&va_macro, "CORE_ID_1", VA_CORE_ID_1) & 0xff;
+
+	bolero_version = id0 == 0x01 && id1 == 0x0f ? 20 : id0 == 0x02 && id1 == 0x0e ? 21 : 0;
+	say("mic: the digital codec is bolero %s\n", bolero_version == 20 ? "2.0" : bolero_version == 21 ? "2.1" : "OF AN UNKNOWN VERSION");
+	if (bolero_version != 21) {
+		return bolero_version == 20;
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		found_va_mic[i] = get(&va_macro, "SWR_MIC_CTL (as found)", VA_SWR_MIC_CTL0 + 4 * i);
+	}
+	va_mic_taken = true;
+	return put_bits(&va_macro, "SWR_MIC_CTL0 (va_macro_init())", VA_SWR_MIC_CTL0, 0xee, 0xcc) &&
+	       put_bits(&va_macro, "SWR_MIC_CTL1", VA_SWR_MIC_CTL1, 0xee, 0xcc) &&
+	       put_bits(&va_macro, "SWR_MIC_CTL2", VA_SWR_MIC_CTL2, 0xee, 0xcc);
+}
+
+/* the mixer controls' writes ("TX SMIC MUX1" SWR_MIC0, "TX DEC1 MUX" SWR_MIC), hw_params' rate, and the decimator's PMU */
+static bool
+dec1_on(void)
+{
+	uint32_t cfg0;
+
+	for (size_t i = 0; i < sizeof(dec_regs) / sizeof(dec_regs[0]); i++) {
+		found_dec[i] = get(&tx_macro, "(as found)", dec_regs[i]);
+	}
+	dec_taken = true;
+	if (!put_bits(&tx_macro, "TX1_TX_PATH_CFG0: an analog mic", TX1_PATH_CFG0, 0x80, 0x00) ||
+	    !put_bits(&tx_macro, smic_input == 1 ? "ADC_MUX1_CFG0: SWR_MIC0" : "ADC_MUX1_CFG0: ANOTHER INPUT (mic_input)", TX_ADC_MUX1_CFG0,
+	    0x0f, smic_input & 0x0f) ||
+	    !put_bits(&tx_macro, "ADC_MUX1_CFG1: SWR_MIC", TX_ADC_MUX1_CFG1, 0x03, 0x01) ||
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CTL: 48 kHz", TX1_PATH_CTL, 0x0f, 0x04) ||
+	    /* PRE_PMU: the decimator's mode (0), its PGA muted */
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CFG0: mode 0", TX1_PATH_CFG0, 0x06, 0x00) ||
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CTL: muted", TX1_PATH_CTL, 0x10, 0x10) ||
+	    /* POST_PMU: on; the high-pass filter at 150 Hz while it settles */
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CTL: on", TX1_PATH_CTL, 0x20, 0x20)) {
+		return false;
+	}
+	cfg0 = get(&tx_macro, "TX1_TX_PATH_CFG0", TX1_PATH_CFG0);
+	hpf_cut_off = (cfg0 & 0x60) >> 5;
+	if (hpf_cut_off != 2 && !put_bits(&tx_macro, "TX1_TX_PATH_CFG0: high-pass 150 Hz", TX1_PATH_CFG0, 0x60, 2u << 5)) {
+		return false;
+	}
+	if (hpf_cut_off != 2) {
+		if (!put_bits(&tx_macro, "TX1_TX_PATH_SEC2: filter gate", TX1_PATH_SEC2, 0x03, 0x02)) {
+			return false;
+		}
+		sleep_ms(6);
+		if (!put_bits(&tx_macro, "TX1_TX_PATH_SEC2", TX1_PATH_SEC2, 0x02, 0x00)) {
+			return false;
+		}
+	}
+	/* the gain, written again after the decimator is on ("TX_DEC1 Volume" 84: 0 dB) */
+	if (!put(&tx_macro, "TX1_TX_VOL_CTL: 0 dB", TX1_VOL_CTL, get(&tx_macro, "TX1_TX_VOL_CTL", TX1_VOL_CTL), 0xff)) {
+		return false;
+	}
+	if (bolero_version != 20) {
+		return true;
+	}
+	/* bolero 2.0 only: the SoundWire mics' clocks */
+	return put_bits(&tx_macro, "TOP_CSR_SWR_CTRL", TX_TOP_CSR_SWR_CTRL, 0x01, 0x01) &&
+	       put_bits(&tx_macro, "SWR_MIC0_CTL", TX_SWR_MIC0_CTL, 0x0e, 0x0c) &&
+	       put_bits(&tx_macro, "SWR_MIC1_CTL", TX_SWR_MIC1_CTL, 0x0e, 0x0c) &&
+	       put_bits(&tx_macro, "SWR_MIC2_CTL", TX_SWR_MIC2_CTL, 0x0e, 0x00) &&
+	       put_bits(&tx_macro, "SWR_MIC3_CTL", TX_SWR_MIC2_CTL + 4, 0x0e, 0x00) &&
+	       put_bits(&tx_macro, "SWR_MIC4_CTL", TX_SWR_MIC2_CTL + 8, 0x0e, 0x00) &&
+	       put_bits(&tx_macro, "SWR_MIC5_CTL", TX_SWR_MIC2_CTL + 12, 0x0e, 0x00);
+}
+
+/* after TX_MACRO_AMIC_UNMUTE_DELAY_MS: the PGA unmuted */
+static bool
+dec1_unmute(void)
+{
+	return put_bits(&tx_macro, "TX1_TX_PATH_CTL: unmuted", TX1_PATH_CTL, 0x10, 0x00);
+}
+
+/* after TX_MACRO_AMIC_HPF_DELAY_MS: the codec's hold on ADC1 let go, the filter back to where it was */
+static bool
+dec1_settled(void)
+{
+	return codec_bits(WCD_ANA_TX_CH2, 0x40, (test_bits & 2) ? 0x40 : 0x00) &&
+	       put_bits(&tx_macro, "TX1_TX_PATH_CFG0: high-pass as it was", TX1_PATH_CFG0, 0x60, (uint32_t)hpf_cut_off << 5) &&
+	       put_bits(&tx_macro, "TX1_TX_PATH_SEC2: filter gate", TX1_PATH_SEC2, 0x03, 0x02) &&
+	       (spin_us(21), put_bits(&tx_macro, "TX1_TX_PATH_SEC2", TX1_PATH_SEC2, 0x03, 0x01));
+}
+
+static void
+dec1_off(void)
+{
+	if (!dec_taken) {
+		return;
+	}
+	broken = false;
+	(void)put_bits(&tx_macro, "TX1_TX_PATH_CTL: muted", TX1_PATH_CTL, 0x10, 0x10);
+	(void)put_bits(&tx_macro, "TX1_TX_PATH_CTL: off", TX1_PATH_CTL, 0x20, 0x00);
+	for (size_t i = 0; i < sizeof(dec_regs) / sizeof(dec_regs[0]); i++) {
+		(void)put(&tx_macro, "(put back as found)", dec_regs[i], found_dec[i], 0);
+	}
+	dec_taken = false;
+}
+
+static void
+va_mic_off(void)
+{
+	if (!va_mic_taken) {
+		return;
+	}
+	broken = false;
+	for (unsigned i = 0; i < 3; i++) {
+		(void)put(&va_macro, "SWR_MIC_CTL (put back as found)", VA_SWR_MIC_CTL0 + 4 * i, found_va_mic[i], 0);
+	}
+	va_mic_taken = false;
+}
+
+/* ---- the DSP: the codec DMA port, a device path for recording, a stream that is read ------------------ */
+
+#define APR_SVC_ASM                             7
+#define APR_SVC_ADM                             8
+#define AFE_PORT_CMD_DEVICE_START               0x000100e5u
+#define AFE_PORT_CMD_DEVICE_STOP                0x000100e6u
+#define AFE_PORT_CMD_SET_PARAM_V2               0x000100efu
+#define AFE_MODULE_AUDIO_DEV_INTERFACE          0x0001020cu
+#define AFE_PARAM_ID_CODEC_DMA_CONFIG           0x000102b8u
+#define MIC_PORT                                0xb037          /* TX_CDC_DMA_TX_3 */
+#define ADM_CMD_DEVICE_OPEN_V5                  0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5               0x00010329u
+#define ADM_CMD_DEVICE_CLOSE_V5                 0x00010327u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5          0x00010325u
+#define ADM_PATH_LIVE_RECORDING                 2
+#define ADM_MATRIX_AUDIO_TX                     1
+#define ADM_TOPOLOGY_NONE                       0x00010312u
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS          0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS       0x00010d93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS        0x00010d94u
+#define ASM_STREAM_CMD_OPEN_READ_V3             0x00010db4u
+#define ASM_STREAM_CMD_SET_ENCDEC_PARAM         0x00010c10u
+#define ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2      0x00010da3u
+#define ASM_SESSION_CMD_RUN_V2                  0x00010daau
+#define ASM_DATA_CMD_READ_V2                    0x00010dacu
+#define ASM_DATA_EVENT_READ_DONE_V2             0x00010d9au
+#define ASM_STREAM_CMD_CLOSE                    0x00010bcdu
+#define ASM_TOPOLOGY_NONE                       0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2      0x00010da5u
+#define ASM_SHMEM_4K_POOL                       3
+#define MIC_SESSION                             2               /* (the speakers' is 1) */
+#define MIC_STREAM_PORT                         (MIC_SESSION << 8 | 1)
+#define READ_TOKEN                              0x40000000u     /* | the period */
+#define PCM_CHANNEL_FC                          3
+#define MIC_RATE                                48000
+#define MIC_PERIODS                             8
+#define MIC_PERIOD_FRAMES                       960             /* 20 ms, one channel of 16 bits */
+#define MIC_PERIOD_BYTES                        (MIC_PERIOD_FRAMES * 2)
+
+static uintptr_t mic_memory;
+static uint64_t mic_address;
+static bool memory_taken, mic_mapped, mic_copp_open, mic_stream_open, mic_port_on;
+static uint32_t mic_map_handle, mic_copp;
+static volatile uint32_t read_ready, read_errors, reads_done;
+static volatile uint32_t read_sizes[MIC_PERIODS];
+
+static bool
+mic_events(uint8_t service, __unused uint16_t port, uint32_t opcode, uint32_t token, const uint32_t *payload, uint32_t length)
+{
+	if (service != APR_SVC_ASM || !(token & READ_TOKEN) || (token & 0x3fffffff) >= MIC_PERIODS) {
+		return false;
+	}
+	if (opcode == ASM_DATA_EVENT_READ_DONE_V2) {
+		if (length < 24 || payload[0] != 0) {
+			OSIncrementAtomic((volatile SInt32 *)&read_errors);
+		}
+		read_sizes[token & 0x3fffffff] = length >= 24 ? payload[4] : 0;
+		OSIncrementAtomic((volatile SInt32 *)&reads_done);
+		OSBitOrAtomic(1u << (token & 31), &read_ready);
+		return true;
+	}
+	if (opcode == APR_BASIC_RSP_RESULT) {
+		OSIncrementAtomic((volatile SInt32 *)&read_errors);
+		OSBitOrAtomic(1u << (token & 31), &read_ready);
+		read_sizes[token & 0x3fffffff] = 0;
+		return true;
+	}
+	return false;
+}
+
+static bool
+mic_read(unsigned period)
+{
+	uint32_t read[5] = { (uint32_t)(mic_address + 4096 * period), (uint32_t)((mic_address + 4096 * period) >> 32),
+		             mic_map_handle, MIC_PERIOD_BYTES, period };
+
+	return hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, READ_TOKEN | period, ASM_DATA_CMD_READ_V2, read, sizeof(read), 0, NULL);
+}
+
+static bool
+afe_port_param(uint32_t module, uint32_t param, const void *data, uint16_t size, const char *what)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	*(uint16_t *)packet = MIC_PORT;
+	*(uint16_t *)(packet + 2) = (uint16_t)(sizeof(*p) + size);
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, AFE_PORT_CMD_SET_PARAM_V2, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+/* the stream and the path, opened, mapped and routed (msm-pcm-q6 and q6adm/q6asm at a recording's open and prepare) */
+static bool
+dsp_path_on(void)
+{
+	struct {
+		uint16_t pool, regions;
+		uint32_t property, low, high, size;
+	} __attribute__((packed)) map = { ASM_SHMEM_4K_POOL, 1, 0, 0, 0, 0 };
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) open = { 0, ADM_PATH_LIVE_RECORDING, MIC_PORT, 0xffff, ADM_TOPOLOGY_NONE, 1, 16, MIC_RATE,
+		                           { PCM_CHANNEL_FC } };
+	struct {
+		uint32_t mode, endpoint, topology, format;
+		uint16_t bits, reserved;
+	} __attribute__((packed)) reading = { 0, 0, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2, 16, 0 };
+	struct {
+		uint32_t param, size, frames_per_buffer, block_size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) encoder = { ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2, 28, 0, 20, 1, 16, MIC_RATE, 1, 0, { PCM_CHANNEL_FC } };
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps;
+		uint16_t copp[2];
+	} __attribute__((packed)) route = { ADM_MATRIX_AUDIO_TX, 1, MIC_SESSION, 1, { 0, 0 } };
+	struct hakios_apr_answer answer;
+	uint32_t bytes = 0;
+
+	if (!hakios_audio_dsp_memory(&mic_memory, &mic_address, &bytes) || bytes < MIC_PERIODS * 4096) {
+		say("mic: no memory the DSP can see\n");
+		return false;
+	}
+	memory_taken = true;
+	map.low = (uint32_t)mic_address;
+	map.high = (uint32_t)(mic_address >> 32);
+	map.size = MIC_PERIODS * 4096;
+	hakios_adsp_apr_events_second(mic_events);
+	if (!command("our periods for the microphone, mapped for the DSP", APR_SVC_ASM, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map,
+	    sizeof(map), ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, &answer)) {
+		return false;
+	}
+	mic_mapped = true;
+	mic_map_handle = answer.words[0];
+	say("mic: our %u KB at %#llx are the DSP's handle %#x\n", MIC_PERIODS * 4, mic_address, mic_map_handle);
+	if (!hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_OPEN_READ_V3, &reading, sizeof(reading), APR_WAIT_MS,
+	    &answer) || answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the stream, opened for reading: %s (%#x %#x)\n", "REFUSED OR NO ANSWER", answer.opcode, answer.words[1]);
+		return false;
+	}
+	mic_stream_open = true;
+	say("mic: the stream (session 2), opened for reading 16-bit linear PCM, no processing: done\n");
+	if (!hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_SET_ENCDEC_PARAM, &encoder, sizeof(encoder), APR_WAIT_MS,
+	    &answer) || answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the stream's format: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[1]);
+		return false;
+	}
+	say("mic: the stream's format: 1 channel of 16 bits at 48 kHz: done\n");
+	if (!hakios_adsp_apr(APR_SVC_ADM, MIC_PORT, 0, ADM_CMD_DEVICE_OPEN_V5, &open, sizeof(open), APR_WAIT_MS, &answer) ||
+	    answer.opcode != ADM_CMDRSP_DEVICE_OPEN_V5 || answer.words[0] != 0) {
+		say("mic: a device path from the port: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[0]);
+		return false;
+	}
+	mic_copp_open = true;
+	mic_copp = answer.words[1] & 0xffff;
+	route.copp[0] = (uint16_t)mic_copp;
+	say("mic: the device path from port %#x is open: COPP %u (live recording, no processing, 1 channel, 16 bits, 48 kHz)\n",
+	    MIC_PORT, mic_copp);
+	return command("the device path routed to session 2", APR_SVC_ADM, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route), 0,
+	           NULL);
+}
+
+/* the codec DMA port: TX_CDC_DMA_TX_3, one channel of 16 bits at 48 kHz from decimator 1 */
+static bool
+dsp_port_on(void)
+{
+	struct {
+		uint32_t version, rate;
+		uint16_t bits, format, channels, mask;
+	} __attribute__((packed)) config = { 1, MIC_RATE, 16, 0, 1, 1u << 1 };
+	uint16_t start[2] = { MIC_PORT, 0 };
+
+	if (!afe_port_param(AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_CODEC_DMA_CONFIG, &config, sizeof(config),
+	    "the port TX_CDC_DMA_TX_3 (0xb037): 1 channel of 16 bits at 48 kHz, decimator 1")) {
+		return false;
+	}
+	mic_port_on = command("the port 0xb037, started", APR_SVC_AFE, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+	return mic_port_on;
+}
+
+static void
+dsp_off(void)
+{
+	uint16_t stop[2] = { MIC_PORT, 0 };
+
+	if (mic_stream_open) {
+		(void)hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_CLOSE, NULL, 0, APR_WAIT_MS, NULL);
+		say("mic: the stream, closed\n");
+		mic_stream_open = false;
+	}
+	if (mic_copp_open) {
+		(void)hakios_adsp_apr(APR_SVC_ADM, (uint16_t)mic_copp, 0, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, APR_WAIT_MS, NULL);
+		say("mic: the device path, closed\n");
+		mic_copp_open = false;
+	}
+	if (mic_port_on) {
+		(void)command("the port 0xb037, stopped", APR_SVC_AFE, AFE_PORT_CMD_DEVICE_STOP, stop, sizeof(stop), 0, NULL);
+		mic_port_on = false;
+	}
+	if (mic_mapped) {
+		(void)command("our periods, unmapped", APR_SVC_ASM, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &mic_map_handle,
+		    sizeof(mic_map_handle), 0, NULL);
+		mic_mapped = false;
+	}
+	hakios_adsp_apr_events_second(NULL);
+	if (memory_taken) {
+		hakios_audio_dsp_memory_put();
+		memory_taken = false;
+	}
+}
+
+/* ---- mic=4: the microphone for Darwin ------------------------------------------------------------------- */
+
+/*
+ * What the microphone hears goes into a ring, and /dev/hakios-mic gives it to Darwin's audio server
+ * (HakiosAudio.driver's device "Codec", userland/src/audio_plugin.c): 16-bit samples, one channel,
+ * 48 kHz. The path is up only while the device is open (the audio server opens it when its input
+ * starts and closes it when it stops), and a read never waits: it gives what has come, keeping the
+ * reader about 40 ms behind the DSP (it comes in 20 ms periods), and nothing until that much is
+ * there; the audio server makes up the rest with silence.
+ */
+#define RING_FRAMES             16384           /* 341 ms; a power of two */
+#define RING_KEEP               1920            /* 40 ms: how far behind the DSP a reader is kept */
+#define RING_MOST               4800            /* 100 ms: more than this waiting, and the oldest is skipped */
+
+static int16_t *ring;
+static volatile uint64_t ring_written;          /* frames put into the ring since the device was made */
+static uint64_t ring_read;                      /* frames taken from it (one reader: the audio server) */
+static bool ring_primed;                        /* the reader is RING_KEEP behind; false after it ran dry */
+static uint64_t ring_skipped, ring_dry;         /* frames skipped, reads that found too little: said when Darwin stops */
+static volatile uint32_t darwin_wants;             /* the device is open */
+static volatile bool stopping;                  /* the run ends (hakios_mic_dsp_down()) */
+
+static void
+ring_put(const int16_t *samples, uint32_t count)
+{
+	uint64_t at = ring_written;
+
+	for (uint32_t i = 0; i < count; i++) {
+		ring[(at + i) % RING_FRAMES] = samples[i];
+	}
+	__atomic_store_n(&ring_written, at + count, __ATOMIC_RELEASE);
+}
+
+static int
+mic_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint64_t written = __atomic_load_n(&ring_written, __ATOMIC_ACQUIRE), avail, want;
+	int error = 0;
+
+	if (ring == NULL || uio_resid(uio) < 2) {
+		return 0;
+	}
+	want = (uint64_t)uio_resid(uio) / 2;
+	avail = written - ring_read;
+	if (avail > RING_MOST) {
+		ring_skipped += avail - RING_KEEP;
+		ring_read = written - RING_KEEP;
+		avail = RING_KEEP;
+	}
+	if (!ring_primed) {
+		if (avail < RING_KEEP) {
+			return 0;
+		}
+		ring_primed = true;
+	}
+	if (avail < want) {
+		ring_dry++;
+		ring_primed = false;
+	}
+	while (want > 0 && avail > 0 && error == 0) {
+		uint64_t at = ring_read % RING_FRAMES, n = want < avail ? want : avail;
+
+		n = n < RING_FRAMES - at ? n : RING_FRAMES - at;
+		error = uiomove((caddr_t)&ring[at], (int)(n * 2), uio);
+		ring_read += n;
+		want -= n;
+		avail -= n;
+	}
+	return error;
+}
+
+static int
+mic_dev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	darwin_wants = 1;
+	return 0;
+}
+
+/* (on the last close) */
+static int
+mic_dev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	darwin_wants = 0;
+	return 0;
+}
+
+static const struct cdevsw mic_cdevsw = {
+	.d_open = mic_dev_open, .d_close = mic_dev_close, .d_read = mic_dev_read, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* ---- listening ---------------------------------------------------------------------------------------------- */
+
+static uint32_t mic_secs = 10;
+
+/*
+ * The stream run, read for mic_secs (for_darwin: while Darwin has the device open): how loud it is, every
+ * second (for Darwin: the first three, then every 30th); into the recording with rec_sound_mic=1; for
+ * Darwin into the ring. False if it could not get going (the run refused, a read not sent, no read ever came
+ * back): not a failure that sets `broken', so for_darwin() counts it from this.
+ */
+static bool
+listen(bool for_darwin)
+{
+	uint32_t run[3] = { 0, 0, 0 }, frames = 0, seconds = 0, peak = 0, periods = 0, empty = 0;
+	int64_t sum = 0;
+	uint64_t squares = 0;
+	unsigned next = 0;
+	bool unmuted = false, settled = false;
+	uint64_t began = mach_absolute_time(), now, elapsed_ms;
+
+	struct hakios_apr_answer answer;
+
+	read_ready = 0;
+	reads_done = read_errors = 0;
+	if (!hakios_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), APR_WAIT_MS, &answer) ||
+	    answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the session, run: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[1]);
+		return false;
+	}
+	say("mic: the session 2, run: done\n");
+	for (unsigned p = 0; p < MIC_PERIODS; p++) {
+		if (!mic_read(p)) {
+			say("mic: a read could not be sent\n");
+			return false;
+		}
+	}
+	if (for_darwin) {
+		say("mic: LISTENING for Darwin: %u reads of 20 ms given to the DSP\n", MIC_PERIODS);
+	} else {
+		say("mic: LISTENING: %u reads of 20 ms given to the DSP; for %u s\n", MIC_PERIODS, mic_secs);
+	}
+	for (;;) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &now);
+		elapsed_ms = now / NSEC_PER_MSEC;
+		if (!unmuted && elapsed_ms >= 200) {            /* TX_MACRO_AMIC_UNMUTE_DELAY_MS */
+			unmuted = dec1_unmute();
+		}
+		if (!settled && elapsed_ms >= 300) {            /* TX_MACRO_AMIC_HPF_DELAY_MS */
+			settled = dec1_settled();
+		}
+		if (tap && elapsed_ms >= 2000 && elapsed_ms < 3000) {
+			hakios_haptic_pretend(20000);
+		} else if (tap == 1 && elapsed_ms >= 3000) {
+			hakios_haptic_pretend(0);
+			tap = 2;
+		}
+		/* (`stopping' ends every kind of run: hakios_mic_dsp_down() waits for mic_lock, which is held until this returns) */
+		if ((for_darwin ? !darwin_wants : elapsed_ms >= mic_secs * 1000ull) || stopping || broken) {
+			break;
+		}
+		if (!(read_ready & (1u << next))) {
+			if (elapsed_ms > 1500 && reads_done == 0) {
+				say("mic: NO READ HAS COME BACK in 1.5 s\n");
+				return false;
+			}
+			sleep_ms(2);
+			continue;
+		}
+		OSBitAndAtomic(~(1u << next), &read_ready);
+		{
+			int16_t *samples = (int16_t *)(mic_memory + 4096 * next);
+			uint32_t got = read_sizes[next] / 2;
+			int16_t stereo[2 * 240];
+
+			for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + MIC_PERIOD_BYTES; line += 64) {
+				__asm__ volatile ("dc ivac, %0" : : "r" (line));
+			}
+			__asm__ volatile ("dsb sy");
+			got = got > MIC_PERIOD_FRAMES ? MIC_PERIOD_FRAMES : got;
+			empty += got == 0;
+			for (uint32_t i = 0; i < got; i++) {
+				int32_t v = samples[i];
+				uint32_t a = (uint32_t)(v < 0 ? -v : v);
+
+				sum += v;
+				squares += (uint64_t)((int64_t)v * v);
+				peak = a > peak ? a : peak;
+			}
+			frames += got;
+			if (for_darwin) {
+				ring_put(samples, got);
+			}
+			if (hakios_audio_recording_mic()) {
+				for (uint32_t i = 0; i < got; i += 240) {
+					uint32_t n = got - i < 240 ? got - i : 240;
+
+					for (uint32_t j = 0; j < n; j++) {
+						stereo[2 * j] = stereo[2 * j + 1] = samples[i + j];
+					}
+					hakios_audio_record_fed(stereo, n);
+				}
+			}
+		}
+		periods++;
+		(void)mic_read(next);
+		next = (next + 1) % MIC_PERIODS;
+		if (frames >= MIC_RATE) {
+			uint64_t mean_square = squares / frames;
+			uint32_t rms = 0;
+			int db10 = -999;
+
+			while ((uint64_t)(rms + 1) * (rms + 1) <= mean_square) {
+				rms++;
+			}
+			if (rms > 0) {
+				/* 20 log10(rms / 32768), in tenths, by a table of halvings: good enough to tell loud from quiet */
+				uint32_t r = rms;
+				int tenths = 0;
+
+				while (r < 16384) {
+					r *= 2;
+					tenths -= 60;   /* 6.02 dB a halving, near enough */
+				}
+				db10 = tenths - (int)((32768 - r) * 60 / 16384);
+			}
+			seconds++;
+			if (!for_darwin || seconds <= 3 || seconds % 30 == 0) {
+				say("mic: second %u: %u frames (%u periods, %u empty), level %d.%d dBFS (rms %u), peak %u, mean %lld; "
+				    "reads %u, errors %u%s%s\n", seconds, frames, periods, empty, db10 / 10, db10 < 0 ? -db10 % 10 : db10 % 10,
+				    rms, peak, sum / (int64_t)frames, reads_done, read_errors, unmuted ? "" : " (muted)",
+				    settled ? "" : " (settling)");
+			}
+			frames = periods = empty = peak = 0;
+			sum = 0;
+			squares = 0;
+		}
+	}
+	return true;
+}
+
+static void
+undo(void)
+{
+	dsp_off();
+	dec1_off();
+	va_mic_off();
+	master_off();
+	tx_clocks_off();
+	pins_restore();
+	reset_restore();
+	clocks_off();
+}
+
+/* Everything up to the stream's run, in a recording's order; false (and `broken') if any of it fails. */
+static bool
+path_up(void)
+{
+	if (!clocks_on()) {
+		say("mic: the clocks were not all given: the blocks are not touched\n");
+		return false;
+	}
+	if (!reset_release() || !pins_on() || !tx_clocks_on() || !master_on()) {
+		return false;
+	}
+	sleep_ms(5);    /* ("5 ms for SoundWire's auto-enumeration", wcd938x_bind()) */
+	if ((codec_device = codec_wait()) == 0) {
+		return false;
+	}
+	swr_write(0xf, SWRS_SCP_INT_STATUS_MASK_1, 0x04, 0xf);  /* (swrm_runtime_resume(): broadcast) */
+	sleep_ms(10);
+	if (!quiet) {
+		codec_look();
+	}
+	if (level < 3) {
+		return true;
+	}
+	/* the stream and path, the port's format and start, the codec's widgets */
+	return bolero_look() && codec_init() && dsp_path_on() && dsp_port_on() && dec1_on() && (!adc_on || adc1_on()) &&
+	       datapath_on();
+}
+
+/*
+ * mic=4: the path up whenever Darwin opens /dev/hakios-mic, down when it closes it; after three
+ * recordings that broke off, no more until the run ends.
+ */
+static void
+for_darwin(void)
+{
+	int major = cdevsw_add(-1, &mic_cdevsw);
+	unsigned recordings = 0, failures = 0;
+
+	ring = kalloc_data(RING_FRAMES * sizeof(int16_t), Z_WAITOK | Z_ZERO);
+	if (ring == NULL || major < 0 ||
+	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-mic") == NULL) {
+		say("mic: /dev/hakios-mic cannot be made\n");
+		return;
+	}
+	say("mic: THE MICROPHONE IS DARWIN'S (/dev/hakios-mic) from here on, until the run ends: it listens only while Darwin records\n");
+	while (!stopping) {
+		uint64_t began, ns;
+		bool failed, up;
+
+		if (!darwin_wants) {
+			sleep_ms(20);
+			continue;
+		}
+		lck_mtx_lock(&mic_lock);
+		if (stopping) {
+			lck_mtx_unlock(&mic_lock);
+			break;
+		}
+		recordings++;
+		quiet = recordings > 1;
+		ring_primed = false;
+		ring_skipped = ring_dry = 0;
+		ring_read = __atomic_load_n(&ring_written, __ATOMIC_ACQUIRE);
+		began = mach_absolute_time();
+		say("mic: Darwin records (%u): the path up%s\n", recordings, quiet ? " (the lines that say all went well are not said again)" :
+		    "");
+		/*
+		 * (a bring-up or a start that fails without setting `broken' counts as a failure too: otherwise the three-recordings
+		 * limit below never applies and, while Darwin keeps the device open, the path is brought up and undone for ever)
+		 */
+		up = path_up() && listen(true);
+		failed = broken || !up;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		say("mic: Darwin's recording %u %s after %llu.%llu s; last: %s; %llu frames skipped as too late, %llu reads found too little\n",
+		    recordings, failed ? "BROKE OFF" : "ended", ns / NSEC_PER_SEC, ns % NSEC_PER_SEC / (NSEC_PER_SEC / 10), last_write,
+		    ring_skipped, ring_dry);
+		undo();
+		lck_mtx_unlock(&mic_lock);
+		if (failed) {
+			broken = false;
+			if (++failures >= 3) {
+				say("mic: three recordings broke off: the microphone stays off until the run ends\n");
+				break;
+			}
+			/* (not again until Darwin has closed the device and opened it again) */
+			while (darwin_wants && !stopping) {
+				sleep_ms(20);
+			}
+		}
+	}
+}
+
+static void
+mic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	say("mic: level %u: %s\n", level, level == 1 ? "a look, after the LPASS's votes and clocks; nothing written to the codec" :
+	    level == 2 ? "the codec brought up to answer on SoundWire, nothing of it set; then all undone" :
+	    level == 3 ? "the main microphone, as Android records from it, listened to; then all undone" :
+	    "the main microphone for Darwin (/dev/hakios-mic), up while Darwin records");
+	if (level == 4) {
+		for_darwin();
+	} else {
+		lck_mtx_lock(&mic_lock);
+		if (level == 1) {
+			if (clocks_on()) {
+				sleep_ms(10);
+				look();
+			} else {
+				say("mic: the clocks were not all given: the blocks are not touched\n");
+			}
+		} else {
+			if (path_up() && level >= 3) {
+				listen(false);
+			}
+			say("mic: %s; last: %s\n", broken ? "STOPPED" : level >= 3 ? "listened" : "done", last_write);
+		}
+		undo();
+		lck_mtx_unlock(&mic_lock);
+	}
+	running = false;
+	say("mic: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_mic_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("mic", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 4 ? 4 : level;
+	PE_parse_boot_argn("mic_secs", &mic_secs, sizeof(mic_secs));
+	PE_parse_boot_argn("mic_input", &smic_input, sizeof(smic_input));
+	PE_parse_boot_argn("mic_adc", &adc_on, sizeof(adc_on));
+	PE_parse_boot_argn("mic_main", &main_timing, sizeof(main_timing));
+	PE_parse_boot_argn("mic_test", &test_bits, sizeof(test_bits));
+	PE_parse_boot_argn("mic_tap", &tap, sizeof(tap));
+	mic_secs = mic_secs < 1 ? 1 : mic_secs > 600 ? 600 : mic_secs;
+	running = true;
+	if (kernel_thread_start(mic_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+hakios_mic_dsp_down(void)
+{
+	stopping = true;
+	if (running) {
+		lck_mtx_lock(&mic_lock);
+		undo();
+		lck_mtx_unlock(&mic_lock);
+	}
+}
diff --git a/bsd/dev/hakios.mpss.c b/bsd/dev/hakios.mpss.c
new file mode 100644
index 0000000..880c9de
--- /dev/null
+++ b/bsd/dev/hakios.mpss.c
@@ -0,0 +1,6395 @@
+/*
+ * The modem of the POCO X5 Pro (redwood), started, and asked about the network: step 1 of
+ * cellular. Every address below belongs to this phone, and nothing here is touched unless a
+ * boot-arg asks for it.
+ *
+ * The modem ("MPSS", Android's "modem") is a Hexagon of its own inside the SoC, exactly as the
+ * Wi-Fi's and the audio's are (hakios.wifi.c, hakios.adsp.c): it stays in reset until somebody
+ * loads its signed image -- modem.mdt and modem.b00 to modem.b29 from /vendor/firmware_mnt/image
+ * of its Android, 85 MB, in the system image under /fw (MODEM=1 SYSTEM=1 userland/build.sh, from
+ * fw-modem/) -- into the 246 MB reserved for it and asks TrustZone to authenticate and start it.
+ * From there everything is conversation through the shared memory: SMP2P for "up", "given up",
+ * "stopped"; GLINK for channels; QRTR on the channel "IPCRTR" for the modem's services, which
+ * speak QMI (drivers/modem/hakios.qmi.c knows the protocol; here only two of its messages are made by
+ * hand): the device management service is asked to put the modem online, and the network access
+ * service what network it is on and how strong the signal is (drivers/modem/hakios.nas.c). What this
+ * learns goes to sysctl kern.hakios.cellular_* for the rest of the system; calls, SMS and data
+ * are for the steps after this one.
+ *
+ * The way is the modem's, which is the Wi-Fi DSP's: hakios.adsp.c's comments say why each
+ * thing is done so; this file is that one with the modem's numbers (dt: qcom,mss@4080000,
+ * qcom,smp2p-modem, qcom,glink/modem, reserved-memory mpss@8b800000):
+ *   - processor 1 in the shared memory; its SMP2P items 435 (its) and 428 (ours); its last words
+ *     in item 421; GLINK's three items in our partition with it
+ *   - its doorbells are IPCC client 2 (MPSS): signal 0 GLINK, signal 2 SMP2P
+ *   - TrustZone knows it as image 4; its memory is 0x8b800000, 246 MB, of which the image takes
+ *     the first 85 (TrustZone is told of all of it: the modem uses the rest)
+ *   - its rails are CX and MSS (cx.lvl and mss.lvl), asked for at level 384 while it boots
+ *   - the always-on processor is told of it as "modem"
+ *   - the channel is IPCRTR only; the modem's others (DS, DATA*, glink_ssr) are left unanswered
+ *   - the ports of QRTR are the Wi-Fi driver's (sys/hakios.qrtr.h): what the NAS client needs
+ * The modem and the Wi-Fi DSP may run at the same time: the mailbox to the always-on
+ * processor and the lock for allocating in the shared memory are shared, each behind a lock.
+ *
+ * Boot-arg modem_step=N performs steps 1 to N and stops; modem=1 is all of them, on a thread
+ * beside the system's start, and the modem stays on, its network state asked every two seconds.
+ *
+ *   1  reads   the shared memory: our partition with the modem, its items, whether it has run
+ *   2  reads   the firmware on the root (or in the small image): is it whole, does it fit
+ *   3  writes  the always-on processor's mailbox open, unless it is
+ *   4  asks    TrustZone to take the image's header (image 4) and where the image will be; a
+ *              modem that a kernel before this one left running is asked to stop and shut down first
+ *   5  writes  the image into the modem's memory, and reads it back
+ *   6  writes  our SMP2P item (428) into the shared memory, and our two marks of GLINK to zero
+ *   7  asks    RPMh for the modem's rails, writes "modem: on" to the always-on processor, asks
+ *              TrustZone to authenticate and start the modem, and watches for its first words
+ *   8  reads   GLINK's queues
+ *   9  writes  our side of GLINK: the versions, the channel "IPCRTR" opened both ways, our intents;
+ *              from here a thread of ours listens to the modem
+ *  10  talks   QRTR on that channel: hello both ways, and the services the modem tells of
+ *  11  talks   QMI: DMS "operating mode online" (modem_online=0: not), then NAS "serving system"
+ *              and "signal info" every second for modem_nas_wait seconds (default 30), or until
+ *              the modem says it is registered and how strong the signal is
+ *
+ * What is started is stopped: when the steps are over (unless modem_keep=1, and then when the run
+ * ends), and on a panic's way back to the loader. More boot-args: modem_new=K, modem_pause=MS,
+ * modem_wait=S (step 7's watch, default 10), modem_listen=S (step 10, default 3), modem_again=1,
+ * modem_return=1, as the modem's.
+ *
+ * Nothing here writes a clock or changes a pin. One request goes to RPMh (the two rails), as
+ * Linux's remoteproc makes it; the SIM is not touched, no call is made, no data session opened.
+ */
