+++ b/bsd/miscfs/apfs/libdeflate/lib/arm/crc32_pmull_helpers.h
@@ -0,0 +1,156 @@
+/*
+ * arm/crc32_pmull_helpers.h - helper functions for CRC-32 folding with PMULL
+ *
+ * Copyright 2022 Eric Biggers
+ *
