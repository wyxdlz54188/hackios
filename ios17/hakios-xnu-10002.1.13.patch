+	case _PC_PIPE_BUF:
+		*ap->a_retval = PIPE_BUF;
+		return 0;
+	case _PC_CHOWN_RESTRICTED:
+	case _PC_NO_TRUNC:
+		*ap->a_retval = 200112;
+		return 0;
+	case _PC_CASE_SENSITIVE:
+	case _PC_CASE_PRESERVING:
+		*ap->a_retval = 1;
+		return 0;
+	case _PC_FILESIZEBITS:
+		*ap->a_retval = 64;
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
