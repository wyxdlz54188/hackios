# Target: iOS 17.0.0 -- the numbers this port is pinned to.
#
# The kernel HakiOS builds is Apple's open-source XNU. Upstream's patch (xnu/hakios.patch) is written
# against xnu-8796.121.2, the XNU of iOS 16.5. This directory holds the same port rebased onto
# xnu-10002.1.13, the XNU of iOS 17.0.
#
# What pins the two together is not a version string: the Darwin user space the kernel runs must be the
# one its syscalls, mach traps and boot-arguments match. That is why the XNU tag and the IPSW build are
# named together here.

# --- the user space (yours: this file names it, it does not contain it) -----------------------
# iOS 17.0 does not run on A11 (iPhone X, the reference phone of upstream's 16.5 image): it needs A12
# or newer, so the userland source changes with the version, not just the kernel. iPhone11,2 (XS) is
# the smallest A12 device and the one this port aims at first.
IPSW_VERSION=17.0.0
IPSW_BUILD=21A329
IPSW_DEVICE=iPhone11,2
IPSW_FILE=iPhone11,2,iPhone11,4,iPhone11,6,iPhone11,8_17.0.0_21A329_Restore.ipsw
# upstream's unpack.sh pins the 16.5 image by name and size and names its DMGs; that is what has to be
# redone for this one (docs/port-checklist.md, step "user space"):
#   ROOTFS_DMG / CRYPTEX_DMG / APP_CRYPTEX_DMG   the IPSW's members for 21A329
#   CACHE=21A329__iPhone11,2                     the dyld shared cache directory
#   the size check at the top of sysimage/unpack.sh

# --- the kernel --------------------------------------------------------------------------------
DARWIN=23.0.0
XNU_TAG=xnu-10002.1.13
# the commit the annotated tag points at (what a checkout of the tag gives); apply.sh refuses another
XNU_BASE=1031c584a5e37aff177559b9f69dbd3c8c3fd30a
XNU_URL=https://github.com/apple-oss-distributions/xnu.git

# what upstream's patch was against: the 16.5 kernel, kept here so the rebase can be reproduced
XNU_FROM_TAG=xnu-8796.121.2
XNU_FROM_BASE=c54f35ca767986246321eb901baf8f5ff7923f6a

# the common tree this patch goes into (its VERSION file says 2.3.4-hakios); the kernel's own version
# string is made from that file, from CONFIG_SOC of the configuration, and from git -- see
# docs/versioning.md of the common tree.
PORT_VERSION=2.3.4-hakios
