 STATIC
-VOID
-LogPayload ()
+BOOLEAN
+PayloadWindowMapped (
+  VOID
+  )
 {
-  XNU_PAYLOAD_HEADER *Header = (XNU_PAYLOAD_HEADER *)XNU_PAYLOAD_BASE;
+  EFI_STATUS             Status;
+  EFI_MEMORY_DESCRIPTOR *Map;
+  UINTN                  MapSize = 0;
+  UINTN                  MapKey;
+  UINTN                  DescSize;
+  UINT32                 DescVersion;
+  BOOLEAN                Found = FALSE;
 
-  Log ("[payload]\n");
-  Log ("base=%lx magic=%08x size=%x\n", (UINT64)XNU_PAYLOAD_BASE, Header->Magic, Header->Size);
+  Status = gBS->GetMemoryMap (&MapSize, NULL, &MapKey, &DescSize, &DescVersion);
+  if (Status != EFI_BUFFER_TOO_SMALL) {
+    return FALSE;
+  }
 
+  MapSize += SIZE_4KB;
+  Map      = AllocatePool (MapSize);
+  if (Map == NULL) {
+    return FALSE;
+  }
+
+  if (!EFI_ERROR (gBS->GetMemoryMap (&MapSize, Map, &MapKey, &DescSize, &DescVersion))) {
+    UINT64 NeedStart = (UINT64)XNU_PAYLOAD_BASE;
+    UINT64 NeedEnd   = NeedStart + XNU_PAYLOAD_MAX_SIZE;
+
+    for (UINTN Offset = 0; Offset < MapSize; Offset += DescSize) {
+      EFI_MEMORY_DESCRIPTOR *Desc  = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Offset);
+      UINT64                 Start = Desc->PhysicalStart;
+      UINT64                 End   = Start + EFI_PAGES_TO_SIZE (Desc->NumberOfPages);
+
+      if (NeedStart >= Start && NeedEnd <= End) {
+        Found = TRUE;
+        break;
+      }
+    }
+  }
+
+  FreePool (Map);
+  return Found;
+}
+
+STATIC
+VOID
+LogPayload (
+  VOID
+  )
+{
+  Log ("[payload]\n");
+  Log ("window=%016lx+%08x mapped=%d\n", (UINT64)XNU_PAYLOAD_BASE, XNU_PAYLOAD_MAX_SIZE,
+       PayloadWindowMapped ());
 }
 
