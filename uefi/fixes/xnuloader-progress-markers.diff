--- a/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.c
+++ b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.c
@@ -86,6 +86,32 @@ FindPartition (
   return NULL;
 }
 
+//
+// Progress markers: one sector at block 0 of the log partition, rewritten at every step. After a crash
+// the last letter says where the firmware stopped; the log itself lives from block 1 on, so a marker is
+// never lost to a partial log write.
+//
+STATIC
+VOID
+Mark (
+  IN CHAR8 Letter
+  )
+{
+  EFI_BLOCK_IO_PROTOCOL *BlockIo;
+  UINT8                  Sector[512];
+
+  BlockIo = FindPartition (XNU_LOG_PARTITION);
+  if (BlockIo == NULL) {
+    return;
+  }
+
+  ZeroMem (Sector, sizeof (Sector));
+  AsciiSPrint ((CHAR8 *)Sector, sizeof (Sector), "XNUMARK %c\n", Letter);
+  if (!EFI_ERROR (BlockIo->WriteBlocks (BlockIo, BlockIo->Media->MediaId, 0, sizeof (Sector), Sector))) {
+    BlockIo->FlushBlocks (BlockIo);
+  }
+}
+
 STATIC
 VOID
 LogCpu ()
@@ -267,7 +293,7 @@ FlushLog ()
   BlockSize = BlockIo->Media->BlockSize;
   WriteSize = ALIGN_VALUE (mLogLen + 1, BlockSize);
 
-  Status = BlockIo->WriteBlocks (BlockIo, BlockIo->Media->MediaId, 0, WriteSize, mLog);
+  Status = BlockIo->WriteBlocks (BlockIo, BlockIo->Media->MediaId, 1, WriteSize, mLog);
   if (!EFI_ERROR (Status)) {
     BlockIo->FlushBlocks (BlockIo);
   }
@@ -286,7 +312,9 @@ StartPayloadLoader ()
   UINT8              *Cursor;
   UINT8              *End;
 
+  Mark ('L');
