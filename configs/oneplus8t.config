# HakiOS fragment: the OnePlus 8T (oneplus8t, SM8250 "kona", devices/oneplus8t) -- what is true of this
# phone and of no other with the same SoC.
#
# Step 2 of docs/porting/index.md: the first boot carries nothing of the phone's hardware. Every phone
# driver of the common tree is left OUT OF THE KERNEL here (not switched off at boot): its addresses,
# pins and rails are the reference phone's (POCO X5 Pro 5G, sc7280), and a driver of another phone
# touching this one is the last thing wanted on a first boot. The SoC's own drivers stay in
# soc/configs/sm8250.config; each one comes back here, in the order docs/port-checklist.md gives, when
# it has been made to work on this phone -- and then its status line in device.conf says so.
#
# The chip this phone actually carries, for whoever writes the driver:
#   display   SDE + DSI, panel oplus20828samsung_amb655x_1080_2400_cmd (Samsung AMB655, 1080x2400, cmd mode)
#   touch     Synaptics S3908, i2c@a94000 address 0x4B, one virtual "touchpanel" input device
#   storage   UFS 3.1 256 GB on 1d84000.ufshc (A/B, super, userdata = sda28)
#   gpu       Adreno 650 (kgsl calls it Adreno650v3), a650_gmu.bin / a650_sqe.fw / a650_zap.*
#   wifi/bt   QCA6390: qcom,cnss-qca6390@b0000000 over PCIe, bt on slim@3ac0000 (qcom,btfmslim_slave)
#   audio     WCD938x codec + Bolero (rx/tx macros), ALSA card "kona-mtp-snd-card"
#   haptic    PM8150B haptics (spmi0-03, qcom,haptics@c000), ff-memless, not the Awinic AW86927
#   modem     SDX55 ("mdm"), IPA region at 0x1e00000; soc.args has this phone's IPA/SMEM numbers
#   thermal   the vendor tree's own zones and trip points (thermal_zone*), addresses are kona's
#   pmic      PM8150 / PM8150B / PM8150L on spmi@c440000

CONFIG_DEVICE="oneplus8t"

# --- the phone's drivers, out of the kernel until each is ported -------------------------------
# The common configuration turns these boot-arguments on (CONFIG_UFS=2, CONFIG_MODEM=y, ...); a
# boot-argument that only a driver left out would read is a configuration problem, so they go too.
# CONFIG_UFS is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
